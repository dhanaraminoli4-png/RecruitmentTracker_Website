        }

        .assessment-status.submitted {
            background: var(--iv-green-soft) !important;
            color: var(--iv-green) !important;
        }

    .no-assessment {
        color: #98a9b7 !important;
        font-size: 8px !important;
    }

    /* FOOTER */
    .interview-card-footer {
        margin-top: auto !important;
        padding: 9px 10px !important;
        gap: 7px !important;
        background: #ffffff !important;
    }

    .footer-left {
        gap: 6px !important;
        min-width: 0 !important;
    }

    .interview-status {
        padding: 4px 7px !important;
        font-size: 7px !important;
        font-weight: 800 !important;
    }

        .interview-status.scheduled {
            background: var(--iv-blue-soft) !important;
            color: #347eb6 !important;
        }

        .interview-status.in-progress {
            background: var(--iv-amber-soft) !important;
            color: var(--iv-amber) !important;
        }

        .interview-status.completed {
            background: var(--iv-green-soft) !important;
            color: var(--iv-green) !important;
        }

        .interview-status.cancelled {
            background: var(--iv-red-soft) !important;
            color: var(--iv-red) !important;
        }

    .past-label {
        color: #b47c33 !important;
        font-size: 7px !important;
    }

    .view-interview-btn {
        min-height: 31px !important;
        padding: 0 9px !important;
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        border-radius: 8px !important;
        background: var(--iv-blue) !important;
        color: #ffffff !important;
        border: 1px solid var(--iv-blue) !important;
        font-size: 8px !important;
        font-weight: 850 !important;
        box-shadow: 0 6px 13px rgba(63,155,243,.18) !important;
    }

        .view-interview-btn:hover {
            background: var(--iv-blue-hover) !important;
            border-color: var(--iv-blue-hover) !important;
            color: #ffffff !important;
            transform: translateY(-1px) !important;
