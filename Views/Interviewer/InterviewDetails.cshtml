<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".star-rating-control").forEach(function (group) {
            const radios = Array.from(group.querySelectorAll('input[type="radio"]'));
            const stars = Array.from(group.querySelectorAll(".rating-star"));
            const valueLabel = group.querySelector(".rating-value");

            function paint(value) {
                stars.forEach(function (star) {
                    const starValue = Number(star.dataset.value || 0);
                    star.classList.toggle("filled", starValue <= value);
                });

                if (valueLabel) {
                    valueLabel.textContent = value + "/5";
                }
            }

            const selected = radios.find(function (radio) { return radio.checked; });
            paint(selected ? Number(selected.value) : 0);

            stars.forEach(function (star) {
                star.addEventListener("mouseenter", function () {
                    paint(Number(star.dataset.value || 0));
                });
            });

            group.addEventListener("mouseleave", function () {
                const current = radios.find(function (radio) { return radio.checked; });
                paint(current ? Number(current.value) : 0);
            });

            radios.forEach(function (radio) {
                radio.addEventListener("change", function () {
                    paint(Number(radio.value));
                });
            });
        });
    });
</script>

