@using System.Text.Json
@model RecruitmentTracker.Models.Interview

@{
    ViewData["Title"] = "Interview Details";

    var application = Model.JobApplication;
    var candidate = application?.Candidate;
    var vacancy = application?.JobVacancy;

    var candidateName =
        candidate?.FullName
        ?? "Unknown Candidate";

    var candidateEmail =
        candidate?.Email
        ?? "";

    var assessment =
        Model.Assessments?
            .FirstOrDefault();

    var myFeedback =
        ViewBag.MyFeedback
        as RecruitmentTracker.Models.InterviewFeedback;

    var currentInterviewerId =
        ViewBag.CurrentInterviewerId
        as string;

    var assessmentSubmitted =
        assessment != null &&
        assessment.Status == "Submitted";

    var assessmentSubmittedByMe =
        assessment != null &&
        assessment.ConductedByInterviewerId ==
            currentInterviewerId;
}


<div class="interview-details-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="details-header">

        <div>

            <a asp-controller="Interviewer"
               asp-action="MyInterviews"
               class="back-link">

                ← Back to My Interviews

            </a>


            <h1>
                Interview Details
            </h1>

            <p>
                Review the candidate, complete the assigned
                assessment and submit your interview feedback.
            </p>

        </div>


        <span class="interview-status-badge">

            @Model.Status

        </span>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="page-alert success">
            @TempData["Success"]
        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="page-alert error">
            @TempData["Error"]
        </div>
    }


    <!-- =========================================================
         CANDIDATE SUMMARY
         ========================================================= -->

    <div class="details-card">

        <div class="card-heading">

            <div class="heading-icon">
                C
            </div>

            <div>
                <h2>Candidate Information</h2>

                <p>
                    Candidate and interview information.
                </p>
            </div>

        </div>


        <div class="candidate-summary">

            <div class="candidate-main">

                <div class="candidate-avatar">

                    @(candidateName.Length > 0
                                        ? candidateName.Substring(0, 1).ToUpper()
                                        : "?")

                </div>


                <div>

                    <h3>
                        @candidateName
                    </h3>

                    <span>
                        @candidateEmail
                    </span>

                    <strong>
                        @(vacancy?.JobTitle
                                                ?? "Unknown Position")
                    </strong>

                </div>

            </div>


            <div class="summary-grid">

                <div>
                    <span>Interview Round</span>

                    <strong>
                        @(Model.InterviewRound?.Name
                                                ?? "—")
                    </strong>
                </div>


                <div>
                    <span>Interview Type</span>

                    <strong>
                        @(Model.InterviewType?.Name
                                                ?? "—")
                    </strong>
                </div>


                <div>
                    <span>Date</span>

                    <strong>
                        @Model.InterviewDate
                        .ToString("dd MMM yyyy")
                    </strong>
                </div>


                <div>
                    <span>Time</span>

                    <strong>
                        @(Model.InterviewTime
                                                .ToString("hh\\:mm"))
                    </strong>
                </div>


                <div>
                    <span>Duration</span>

                    <strong>
                        @Model.DurationMinutes minutes
                    </strong>
                </div>


                <div>
                    <span>Location</span>

                    <strong>

                        @if (!string.IsNullOrWhiteSpace(
                                                Model.Location))
                        {
                            @Model.Location
                        }
                        else if (!string.IsNullOrWhiteSpace(
                        Model.MeetingLink))
                        {
                            @("Online Interview")
                        }
                        else
                        {
                            @("—")
                        }

                    </strong>

                </div>

            </div>

        </div>

    </div>

    <!-- =========================================================
         CANDIDATE RESOURCES
         ========================================================= -->

    <div class="details-card resource-card">

        <div class="card-heading">

            <div class="heading-icon">
                ✦
            </div>

            <div>
                <h2>Candidate Resources</h2>
                <p>Open the candidate CV or view the complete AI screening analysis.</p>
            </div>

        </div>

        <div class="resource-actions">

            <div class="resource-item">
                <div class="resource-icon cv-icon">CV</div>
                <div class="resource-copy">
                    <strong>Candidate CV</strong>
                    <span>Open the CV submitted with this application.</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(application?.CVFilePath))
                {
                    <a asp-controller="Interviewer"
                       asp-action="ViewCV"
                       asp-route-interviewId="@Model.Id"
                       target="_blank"
                       class="resource-btn dark">
                        View CV
                    </a>
                }
                else
                {
                    <span class="resource-unavailable">Not available</span>
                }
            </div>

            <div class="resource-item">
                <div class="resource-icon ai-icon">AI</div>
                <div class="resource-copy">
                    <strong>AI Analysis</strong>
                    <span>View the full original AI analysis page and requirement matches.</span>
                </div>

                <a asp-controller="Interviewer"
                   asp-action="AIAnalysis"
                   asp-route-interviewId="@Model.Id"
                   class="resource-btn purple">
                    View AI Analysis
                </a>
            </div>

        </div>

    </div>

    <!-- =========================================================
         ASSESSMENT
         ========================================================= -->

    <div class="details-card">

        <div class="card-heading">

            <div class="heading-icon assessment-icon">
                A
            </div>

            <div>

                <h2>
                    Assigned Assessment
                </h2>

                <p>
                    Complete the assessment during the interview
                    and manually record the final result.
                </p>

            </div>

        </div>


        @if (assessment == null)
        {
            <div class="no-assessment-state">

                <div class="empty-circle">
                    !
                </div>

                <h3>
                    No assessment assigned
                </h3>

                <p>
                    HR did not assign an assessment
                    to this interview.
                </p>

            </div>
        }
        else
        {
            var template =
            assessment.AssessmentTemplate;

            var questions =
            template?.Questions?
            .OrderBy(x =>
            x.DisplayOrder)
            .ToList()

            ?? new List<RecruitmentTracker.Models.AssessmentQuestion>();


            <div class="assessment-information">

                <div>

                    <h3>
                        @(template?.Name
                                            ?? "Assessment")
                </h3>


                @if (!string.IsNullOrWhiteSpace(
                                template?.Description))
                    {
                        <p>
                            @template.Description
                        </p>
                    }

            </div>


            <span class="assessment-badge @(assessmentSubmitted ? "done" : "pending")">

                @(assessmentSubmitted
                                ? "Submitted"
                                : "Pending")

            </span>

            </div>


        @if (!string.IsNullOrWhiteSpace(
                template?.Instructions))
            {
                <div class="assessment-instructions">

                    <strong>
                        Instructions
                    </strong>

                    <p>
                        @template.Instructions
                    </p>

                </div>
            }


            @if (assessmentSubmitted &&
                    !assessmentSubmittedByMe)
            {
                <div class="locked-message">

                    This assessment has already been submitted
                    by another assigned interviewer.

                </div>
            }
            else
            {
                <form asp-controller="Interviewer"
                      asp-action="SubmitAssessment"
                      method="post">

                    @Html.AntiForgeryToken()


                    <input type="hidden"
                           name="assessmentId"
                           value="@assessment.Id" />


                    <!-- =============================================
                         QUESTIONS
                         ============================================= -->

                    <div class="questions-section">

                        <div class="section-title">

                            <h3>
                                Assessment Questions
                            </h3>

                            <span>
                                @questions.Count item(s)
                            </span>

                        </div>


                        @if (!questions.Any())
                        {
                            <div class="question-empty">

                                No assessment questions
                                have been added.

                            </div>
                        }
                        else
                        {
                            @for (var i = 0;
                                            i < questions.Count;
                                            i++)
                            {
                                var question =
                                questions[i];

                                var existingAnswer =
                                assessment.Answers?
                                .FirstOrDefault(x =>
                                x.AssessmentQuestionId ==
                                question.Id);

                                var answerValue =
                                existingAnswer?.AnswerText
                                ?? "";

                                var answerScore =
                                existingAnswer?.Score;


                                <div class="assessment-question">

                                    <input type="hidden"
                                           name="questionIds[@i]"
                                           value="@question.Id" />


                                    <div class="question-top">

                                        <div class="question-number">
                                            @(i + 1)
                                        </div>


                                        <div class="question-name">

                                            <strong>
                                                @question.QuestionText
                                            </strong>


                                            <div class="question-meta">

                                                <span>
                                                    @GetQuestionLabel(
                                                    question.QuestionType)
                                </span>


                                @if (question.IsRequired)
                                            {
                                                <span class="required-tag">
                                                    Required
                                                </span>
                                            }


                                            @if (question.MaximumMarks.HasValue)
                                            {
                                                <span>
                                                    Max:
                                                    @question.MaximumMarks
                                                    marks
                                                </span>
                                            }

                                        </div>

                                    </div>

                                </div>


                                <div class="question-answer">


                                    @if (question.QuestionType ==
                                                            "ShortText")
                                    {
                                        <input type="text"
                                               name="answerTexts[@i]"
                                               value="@answerValue"
                                               placeholder="Enter interviewer answer / notes..." />
                                    }
                                    else if (question.QuestionType ==
                                    "Rating")
                                    {
                                        <select name="answerTexts[@i]">

                                            <option value="">
                                                Select Rating
                                            </option>

                                            @for (var rating = 1;
                                                                        rating <= 5;
                                                                        rating++)
                                            {
                                                if (answerValue ==
                                                rating.ToString())
                                                {
                                                    <option value="@rating"
                                                            selected>
                                                        @rating / 5
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@rating">
                                                        @rating / 5
                                                    </option>
                                                }
                                            }

                                        </select>
                                    }
                                    else if (question.QuestionType ==
                                    "YesNo")
                                    {
                                        <select name="answerTexts[@i]">

                                            <option value="">
                                                Select Answer
                                            </option>


                                            @if (answerValue == "Yes")
                                            {
                                                <option value="Yes"
                                                        selected>
                                                    Yes
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="Yes">
                                                    Yes
                                                </option>
                                            }


                                            @if (answerValue == "No")
                                            {
                                                <option value="No"
                                                        selected>
                                                    No
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="No">
                                                    No
                                                </option>
                                            }

                                        </select>
                                    }
                                    else if (question.QuestionType ==
                                    "MultipleChoice")
                                    {
                                        List<string> options =
                                        new List<string>();


                                        try
                                        {
                                            options =
                                            JsonSerializer
                                            .Deserialize<List<string>>(
                                            question.OptionsJson
                                            )
                                            ?? new List<string>();
                                        }
                                        catch
                                        {
                                            options =
                                            new List<string>();
                                        }


                                        <select name="answerTexts[@i]">

                                            <option value="">
                                                Select Option
                                            </option>


                                            @foreach (var option
                                                                        in options)
                                            {
                                                if (answerValue ==
                                                option)
                                                {
                                                    <option value="@option"
                                                            selected>
                                                        @option
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@option">
                                                        @option
                                                    </option>
                                                }
                                            }

                                        </select>
                                    }
                                    else
                                    {
                                        <textarea name="answerTexts[@i]"
                                  rows="5"
                                  placeholder="Enter interviewer notes, response or evaluation...">@answerValue</textarea>
                                    }


                                    @if (question.MaximumMarks.HasValue)
                                    {
                                        <div class="question-score">

                                            <label>
                                                Question Score
                                            </label>


                                            <div>

                                                <input type="number"
                                                       name="answerScores[@i]"
                                                       value="@(answerScore?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                       min="0"
                                                       max="@question.MaximumMarks"
                                                       step="0.5"
                                                       placeholder="Score" />

                                                <span>
                                                    /
                                                    @question.MaximumMarks
                                                </span>

                                            </div>

                                        </div>
                                    }
                                    else
                                    {
                                        <input type="hidden"
                                               name="answerScores[@i]"
                                               value="" />
                                    }

                                </div>

                            </div>
                        }
                    }

                </div>


                <!-- =============================================
                     MANUAL RESULT
                     ============================================= -->

                <div class="assessment-result-section">

                    <div class="section-title">

                        <h3>
                            Assessment Result
                        </h3>

                        <span>
                            Manually completed by interviewer
                        </span>

                    </div>


                    <div class="result-grid">


                        <!-- SCORE -->

                        <div class="form-field">

                            <label>
                                Score
                            </label>

                            <input type="number"
                                   name="score"
                                   value="@(assessment.Score?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                   min="0"
                                   step="0.5"
                                   placeholder="e.g. 88" />

                        </div>


                        <!-- MAX SCORE -->

                        <div class="form-field">

                            <label>
                                Maximum Score
                            </label>

                            <input type="number"
                                   name="maxScore"
                                   value="@(assessment.MaxScore?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                   min="0.5"
                                   step="0.5"
                                   placeholder="e.g. 100" />

                        </div>


                        <!-- RESULT -->

                        <div class="form-field">

                            <label>
                                Assessment Result
                                <span>*</span>
                            </label>


                            <select name="resultStatus"
                                    required>

                                <option value="">
                                    Select Result
                                </option>


                                @if (assessment.ResultStatus ==
                                                            "Pass")
                                {
                                    <option value="Pass"
                                            selected>
                                        Pass
                                    </option>
                                }
                                else
                                {
                                    <option value="Pass">
                                        Pass
                                    </option>
                                }


                                @if (assessment.ResultStatus ==
                                                            "Fail")
                                {
                                    <option value="Fail"
                                            selected>
                                        Fail
                                    </option>
                                }
                                else
                                {
                                    <option value="Fail">
                                        Fail
                                    </option>
                                }

                            </select>

                        </div>


                        <!-- DATE -->

                        <div class="form-field">

                            <label>
                                Assessment Date
                            </label>

                            <input type="date"
                                   name="assessmentDate"
                                   value="@(
                                   assessment.AssessmentDate
                                       ?.ToString("yyyy-MM-dd")
                                   ?? DateTime.Today
                                       .ToString("yyyy-MM-dd")
                                                                                                                                                            )" />

                    </div>

                    </div>


                    <div class="form-field">

                        <label>
                            Assessment Comments
                        </label>

                        <textarea name="comments"
                              rows="4"
                              placeholder="Add comments about the candidate's assessment performance...">@assessment.Comments</textarea>

                    </div>


                    <div class="assessment-submit-row">

                    @if (assessmentSubmittedByMe)
                        {
                            <span class="already-submitted">
                                You submitted this assessment on
                                @(assessment.SubmittedDate?
                                                        .ToString("dd MMM yyyy HH:mm"))
                    </span>
                                        }


                    <button type="submit"
                            class="primary-btn">

                        @(assessmentSubmittedByMe
                                                ? "Update Assessment"
                                                : "Submit Assessment")

                    </button>

                    </div>

                </div>

            </form>
                }
                }

    </div>



    <!-- =========================================================
         INTERVIEW FEEDBACK
         ========================================================= -->

    <div class="details-card feedback-card">

        <div class="card-heading">
            <div class="heading-icon feedback-icon">★</div>
            <div>
                <h2>Interview Feedback</h2>
                <p>Rate the candidate and record strengths, weaknesses and general comments.</p>
            </div>
        </div>

        <form asp-controller="Interviewer"
              asp-action="SubmitFeedback"
              method="post"
              class="feedback-form">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="interviewId"
                   value="@Model.Id" />

            <div class="feedback-content cute-feedback">

                <div class="star-rating-list">
                    @StarRating("Technical Rating", "technicalRating", myFeedback?.TechnicalRating ?? 0)
                    @StarRating("Problem Solving Rating", "problemSolvingRating", myFeedback?.ProblemSolvingRating ?? 0)
                    @StarRating("Communication Rating", "communicationRating", myFeedback?.CommunicationRating ?? 0)
                    @StarRating("Role / Cultural Fit Rating", "roleFitRating", myFeedback?.RoleFitRating ?? 0)
                    @StarRating("Professionalism Rating", "professionalismRating", myFeedback?.ProfessionalismRating ?? 0)
                    @StarRating("Overall Rating", "overallRating", myFeedback?.OverallRating ?? 0)
                </div>

                <div class="feedback-field">
                    <label>Recommendation <span>*</span></label>
                    <select name="recommendation" required>
                        <option value="">Select Recommendation</option>
                        @foreach (var recommendation in new[]
                                                {
                                                "Strong Pass",
                                                "Pass",
                                                "Borderline",
                                                "Fail"
                                                })
                        {
                            if (myFeedback?.Recommendation == recommendation)
                            {
                                <option value="@recommendation" selected>@recommendation</option>
                            }
                            else
                            {
                                <option value="@recommendation">@recommendation</option>
                            }
                        }
                    </select>
                </div>

                <div class="feedback-field">
                    <label>Strengths <span>*</span></label>
                    <textarea name="strengths"
                              rows="4"
                              required
                              placeholder="Good technical skills, clear communication, positive attitude, relevant experience...">@myFeedback?.Strengths</textarea>
                </div>

                <div class="feedback-field">
                    <label>Weaknesses</label>
                    <textarea name="weaknesses"
                              rows="4"
                              placeholder="Areas that could be improved or need more exposure...">@myFeedback?.Weaknesses</textarea>
                </div>

                <div class="feedback-field">
                    <label>General Comments</label>
                    <textarea name="comments"
                              rows="5"
                              placeholder="Add your overall interview notes and final observations...">@myFeedback?.Comments</textarea>
                </div>

                <div class="feedback-footer cute-footer">
                    @if (myFeedback != null)
                    {
                        <span>
                            Last saved @myFeedback.SubmittedDate.ToString("dd MMM yyyy · HH:mm")
                        </span>
                    }

                    <button type="submit" class="primary-btn feedback-save-btn">
                        @(myFeedback == null ? "Save Feedback" : "Update Feedback")
                    </button>
                </div>

            </div>

        </form>

    </div>

    <!-- =========================================================
         IMPORTANT NOTE
         ========================================================= -->

    <div class="decision-note">

        <strong>
            Interview Round Decision
        </strong>

        <p>
            Your assessment result and recommendation are used
            as supporting information. The Hiring Manager makes
            the final Pass / Fail decision for this interview round.
        </p>

    </div>

</div>



@functions {

    string GetQuestionLabel(
        string type)
    {
        return type switch
        {
            "ShortText" =>
                "Short Answer",

            "LongText" =>
                "Long Answer",

            "Rating" =>
                "Rating",

            "YesNo" =>
                "Yes / No",

            "MultipleChoice" =>
                "Multiple Choice",

            "CodingTask" =>
                "Coding Task",

            "PracticalTask" =>
                "Practical Task",

            "Notes" =>
                "Interviewer Notes",

            _ =>
                type
        };
    }


    string FormatJson(
        string? json)
    {
        if (string.IsNullOrWhiteSpace(
            json))
        {
            return "";
        }


        try
        {
            using var document =
                JsonDocument.Parse(
                    json
                );


            return JsonSerializer.Serialize(
                document.RootElement,
                new JsonSerializerOptions
                {
                    WriteIndented = true
                }
            );
        }
        catch
        {
            return json;
        }
    }


    Microsoft.AspNetCore.Html.IHtmlContent StarRating(
        string label,
        string name,
        int selectedValue)
    {
        var html =
            $@"
            <div class=""star-rating-row"">
                <label class=""star-rating-label"">
                    {label} <span>*</span>
                </label>

                <div class=""star-rating-control"" data-rating-group=""{name}"">";

        for (var i = 1; i <= 5; i++)
        {
            var id = $"{name}_{i}";
            var isChecked = selectedValue == i ? "checked" : "";

            html +=
                $@"
                    <input type=""radio""
                           id=""{id}""
                           name=""{name}""
                           value=""{i}""
                           {isChecked}
                           required />
                    <label for=""{id}""
                           class=""rating-star""
                           data-value=""{i}"">★</label>";
        }

        var shownValue = selectedValue > 0 ? selectedValue.ToString() : "0";

        html +=
            $@"
                    <span class=""rating-value"">{shownValue}/5</span>
                </div>
            </div>";

        return new Microsoft.AspNetCore.Html.HtmlString(html);
    }
}



<style>

    .interview-details-page {
        max-width: 1180px;
        margin: 0 auto;
        padding: 30px;
        color: #172033;
    }


    /* HEADER */

    .details-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }

    .back-link {
        display: inline-block;
        margin-bottom: 10px;
        color: #667085;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

    .details-header h1 {
        margin: 0;
        font-size: 29px;
        color: #111827;
        font-weight: 750;
    }

    .details-header p {
        margin: 6px 0 0;
        font-size: 13px;
        color: #7b8495;
    }

    .interview-status-badge {
        background: #eff8ff;
        color: #175cd3;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }


    /* ALERT */

    .page-alert {
        margin-bottom: 18px;
        padding: 12px 15px;
        border-radius: 10px;
        font-size: 13px;
    }

        .page-alert.success {
            background: #ecfdf3;
            color: #067647;
            border: 1px solid #abefc6;
        }

        .page-alert.error {
            background: #fef3f2;
            color: #b42318;
            border: 1px solid #fecdca;
        }


    /* CARD */

    .details-card {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 16px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 2px 9px rgba(15,23,42,.04);
    }

    .card-heading {
        padding: 19px 21px;
        border-bottom: 1px solid #edf0f3;
        display: flex;
        gap: 13px;
        align-items: center;
    }

        .card-heading h2 {
            margin: 0;
            font-size: 17px;
            color: #101828;
        }

        .card-heading p {
            margin: 4px 0 0;
            color: #8a94a6;
            font-size: 12px;
        }

    .heading-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
    }

    .assessment-icon {
        background: #ecfdf5;
        color: #047857;
    }

    .feedback-icon {
        background: #fff7ed;
        color: #c2410c;
    }


    /* CANDIDATE */

    .candidate-summary {
        padding: 21px;
    }

    .candidate-main {
        display: flex;
        gap: 14px;
        align-items: center;
        margin-bottom: 22px;
    }

    .candidate-avatar {
        width: 51px;
        height: 51px;
        border-radius: 13px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
