@model IEnumerable<RecruitmentTracker.Models.AssessmentTemplate>

@{
    ViewData["Title"] = "Assessments";

    var assessments =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.AssessmentTemplate>();

    var total =
        assessments.Count;

    var active =
        assessments.Count(x => x.IsActive);

    var inactive =
        assessments.Count(x => !x.IsActive);

    var totalQuestions =
        assessments.Sum(x => x.Questions?.Count ?? 0);

    var search =
        ViewBag.Search as string ?? "";

    int? selectedJobId =
        ViewBag.JobId as int?;

    var jobs =
        ViewBag.Jobs
            as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
        ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}


<div class="assessment-page">


    <!-- =========================================================
         TOP OVERVIEW CARD
         ========================================================= -->

    <section class="assessment-overview-card">


        <div class="overview-heading">


            <div>

                <div class="overview-eyebrow">
                    INTERVIEW WORKSPACE
                </div>

                <h1>
                    Assessment Templates
                </h1>

                <p>
                    Build and manage structured assessments
                    for your interview rounds.
                </p>

            </div>


            <a asp-controller="Assessment"
               asp-action="Create"
               class="create-assessment-btn">

                <span class="create-plus">
                    +
                </span>

                Create Assessment

            </a>


        </div>


        <!-- STATS -->




    </section>



    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="assessment-alert assessment-alert-success">

            <span>✓</span>

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="assessment-alert assessment-alert-error">

            <span>!</span>

            @TempData["Error"]

        </div>
    }



    <!-- =========================================================
         MAIN DASHBOARD GRID
         ========================================================= -->

    <div class="assessment-dashboard">


        <!-- =====================================================
             LEFT: ASSESSMENT CARDS
             ===================================================== -->

        <section class="assessment-content-card">






            <!-- STATUS TABS -->

            <div class="assessment-tabs">


                <button type="button"
                        class="assessment-tab active"
                        data-status="all">

                    All

                    <span>
                        @total
                    </span>

                </button>


                <button type="button"
                        class="assessment-tab"
                        data-status="active">

                    Active

                    <span>
                        @active
                    </span>

                </button>


                <button type="button"
                        class="assessment-tab"
                        data-status="inactive">

                    Inactive

                    <span>
                        @inactive
                    </span>

                </button>


            </div>



            @if (!assessments.Any())
            {

                <div class="assessment-empty">


                    <div class="empty-illustration">

                        <div class="empty-sheet">
                            ✓
                        </div>

                        <div class="empty-dot dot-one"></div>
                        <div class="empty-dot dot-two"></div>
                        <div class="empty-dot dot-three"></div>

                    </div>


                    <h3>
                        No assessments found
                    </h3>


                    <p>
                        Create your first assessment template
                        for an interview round.
                    </p>


                    <a asp-controller="Assessment"
                       asp-action="Create"
                       class="empty-create-btn">

                        + Create Assessment

                    </a>


                </div>

            }
            else
            {

                <div class="assessment-grid"
                     id="assessmentGrid">


                    @foreach (var assessment in assessments)
                    {
                        var statusValue =
                        assessment.IsActive
                        ? "active"
                        : "inactive";

                        var questionCount =
                        assessment.Questions?.Count ?? 0;


                        <article class="simple-assessment-card"
                                 data-status="@statusValue">


                            <div class="simple-card-top">





                                <div class="simple-card-actions-menu">

                                    •••

                                </div>


                            </div>


                            <div class="simple-card-content">


                                <div class="simple-card-title-row">


                                    <div>


                                        <h3>
                                            @assessment.Name
                                        </h3>


                                        <p>
                                            @(assessment.Description
                                                                                ?? "Assessment template for this interview round.")
                                                                                                                               </p>


                                    </div>


                                    <span class="simple-status @(assessment.IsActive ? "active" : "inactive")">

                                        @(assessment.IsActive
                                                                        ? "Active"
                                                                        : "Inactive")

                                    </span>


                                </div>



                                <div class="simple-info-row">


                                    <span class="simple-info-icon">
                                        ▦
                                    </span>


                                    <span>

                                        @(assessment.JobVacancy?.JobTitle
                                                                        ?? "No vacancy")

                            </span>


                                </div>



                                <div class="simple-info-row">


                                    <span class="simple-info-icon">
                                        ◉
                                    </span>


                                    <span>

                                @if (assessment.InterviewRound != null)
                                        {
                                            @($"Round {assessment.InterviewRound.SequenceNumber} — {assessment.InterviewRound.Name}")
                                        }
                                        else
                                        {
                                            @("No interview round")
                                        }

                                </span>


                            </div>



                            <div class="simple-card-bottom">


                                <div class="simple-question-info">

                                    <strong>
                                        @questionCount
                                    </strong>

                                    <span>
                                        @(questionCount == 1 ? "" : "s")
                                    </span>

                                </div>


                                <div class="simple-card-buttons">


                                    <a asp-controller="Assessment"
                                       asp-action="Edit"
                                       asp-route-id="@assessment.Id"
                                       class="simple-view-btn">

                                        Edit



                                    </a>


                                    <form asp-controller="Assessment"
                                          asp-action="ToggleStatus"
                                          asp-route-id="@assessment.Id"
                                          method="post">

                                        @Html.AntiForgeryToken()


                                        <button type="submit"
                                                class="simple-icon-btn"
                                                title="@(assessment.IsActive ? "Deactivate" : "Activate")">

                                            @(assessment.IsActive
                                                                                    ? "◌"
                                                                                    : "✓")

                                    </button>

                                        </form>


                                        <form asp-controller="Assessment"
                                              asp-action="Delete"
                                              asp-route-id="@assessment.Id"
                                              method="post">

                                            @Html.AntiForgeryToken()


                                            <button type="submit"
                                                    class="simple-icon-btn danger"
                                                    onclick="return confirm('Delete this assessment template?')"
                                                    title="Delete">

                                                ×

                                            </button>

                                        </form>


                                    </div>


                                </div>


                            </div>


                        </article>
                                }




                </div>

            }


        </section>



        <!-- =====================================================
             RIGHT COLUMN
             ===================================================== -->

        <aside class="assessment-sidebar">


            <!-- =================================================
                 FILTER CARD
                 ================================================= -->

            <section class="filter-panel">


                <div class="filter-panel-header">


                    <div class="filter-icon">
                        ⌕
                    </div>


                    <div>

                        <h3>
                            Filter Assessments
                        </h3>

                        <p>
                            Find templates quickly
                        </p>

                    </div>


                </div>



                <form method="get"
                      asp-controller="Assessment"
                      asp-action="Index"
                      class="assessment-filter-form">


                    <!-- SEARCH -->

                    <div class="filter-field">


                        <label>
                            Search
                        </label>


                        <div class="pretty-search">


                            <span>
                                ⌕
                            </span>


                            <input type="text"
                                   name="search"
                                   value="@search"
                                   placeholder="Search assessment..." />


                        </div>


                    </div>



                    <!-- VACANCY -->

                    <div class="filter-field">


                        <label>
                            Vacancy
                        </label>


                        <div class="pretty-select-wrap">


                            <select name="jobId">


                                <option value="">
                                    All Vacancies
                                </option>


                                @foreach (var job in jobs)
                                {

                                    if (
                                    selectedJobId.HasValue &&
                                    job.Value ==
                                    selectedJobId.Value.ToString()
                                    )
                                    {

                                        <option value="@job.Value"
                                                selected>

                                            @job.Text

                                        </option>

                                    }
                                    else
                                    {

                                        <option value="@job.Value">

                                            @job.Text

                                        </option>

                                    }

                                }


                            </select>


                        </div>


                    </div>



                    <button type="submit"
                            class="apply-filter-btn">

                        Apply Filters

                        <span>
                            →
                        </span>

                    </button>


                    <a asp-controller="Assessment"
                       asp-action="Index"
                       class="reset-filter-btn">

                        Reset Filters

                    </a>


                </form>


            </section>



            <!-- =================================================
                 QUICK STATUS FILTER
                 ================================================= -->
            <!-- =================================================
                 DECORATIVE INFO BANNER
                 ================================================= -->

            <section class="assessment-banner">


                <div class="banner-copy">


                    <span class="banner-star">
                        ✦
                    </span>


                    <h3>
                        Structured interviews,
                        better decisions.
                    </h3>


                    <p>
                        Assign different assessments to
                        specific vacancies and interview rounds.
                    </p>


                    <a asp-controller="Assessment"
                       asp-action="Create">

                        Build a template

                        <span>
                            →
                        </span>

                    </a>


                </div>


                <div class="banner-art">


                    <div class="art-sheet sheet-back"></div>


                    <div class="art-sheet sheet-front">

                        <span class="art-line wide"></span>
                        <span class="art-line"></span>
                        <span class="art-line small"></span>

                        <span class="art-check">
                            ✓
                        </span>

                    </div>


                    <div class="art-circle"></div>


                </div>


            </section>


        </aside>


    </div>


</div>



<style>

    /* ============================================================
               PAGE
               ============================================================ */

    .assessment-page {
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px;
        color: #202033;
        position: relative;
    }


        .assessment-page::before {
            content: "";
            position: fixed;
            width: 380px;
            height: 380px;
            right: -140px;
            top: 160px;
            border-radius: 50%;
            background: rgba(177, 224, 214, .13);
            filter: blur(5px);
            pointer-events: none;
            z-index: -1;
        }


        .assessment-page::after {
            content: "";
            position: fixed;
            width: 330px;
            height: 330px;
            left: -100px;
            bottom: -100px;
            border-radius: 50%;
            background: rgba(166, 149, 238, .10);
            pointer-events: none;
            z-index: -1;
        }



    /* ============================================================
               OVERVIEW
               ============================================================ */

    .assessment-overview-card {
        background: #ffffff;
        border: 1px solid #e9e8ed;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 24px rgba(28, 31, 44, .045);
        margin-bottom: 20px;
    }


    .overview-heading {
        min-height: 103px;
        padding: 22px 25px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        border-bottom: 1px solid #efeff3;
    }


    .overview-eyebrow {
        margin-bottom: 5px;
        color: #a0a5b1;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: 1px;
    }


    .overview-heading h1 {
        margin: 0;
        color: #17172b;
        font-size: 25px;
        font-weight: 800;
        letter-spacing: -.3px;
    }


    .overview-heading p {
        margin: 6px 0 0;
        color: #9298a6;
        font-size: 10px;
    }



    /* CREATE */

    .create-assessment-btn {
        min-height: 42px;
        padding: 0 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border-radius: 11px;
        background: #0b1f3a;
        color: #ffffff;
        box-shadow: 0 5px 14px rgba(11, 31, 58, .12);
        text-decoration: none;
        font-size: 10px;
        font-weight: 750;
        transition: transform .18s ease, box-shadow .18s ease, background .18s ease;
    }


        .create-assessment-btn:hover {
            color: #ffffff;
            background: #17385d;
            transform: translateY(-2px);
            box-shadow: 0 9px 20px rgba(11, 31, 58, .16);
        }


    .create-plus {
        font-size: 17px;
        font-weight: 400;
        line-height: 1;
    }



    /* ============================================================
               OVERVIEW STATS
               ============================================================ */

    .assessment-overview-stats {
        min-height: 92px;
        padding: 16px 24px;
        display: grid;
        grid-template-columns: minmax(150px, 1fr) 1px minmax(150px, 1fr) 1px minmax(150px, 1fr) 1px minmax(150px, 1fr);
        align-items: center;
        gap: 20px;
    }


    .overview-stat {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .overview-divider {
        width: 1px;
        height: 40px;
        background: #eeeef2;
    }


    .stat-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        font-weight: 800;
    }


    .stat-purple {
        background: #eeeaff;
        color: #6c56dc;
    }


    .stat-green {
        background: #e4f5ec;
        color: #4b9b75;
    }


    .stat-blue {
        background: #e4f2fb;
        color: #4c8eb8;
    }


    .stat-coral {
        background: #ffe9e8;
        color: #cf6b68;
    }


    .stat-text {
        color: #727887;
        font-size: 9px;
        font-weight: 650;
    }


    .stat-number {
        margin-top: 3px;
        color: #1e1e2d;
        font-size: 21px;
        font-weight: 800;
    }



    /* ============================================================
               ALERTS
               ============================================================ */

    .assessment-alert {
        margin-bottom: 16px;
        padding: 11px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border-radius: 10px;
        font-size: 9px;
        font-weight: 650;
    }


    .assessment-alert-success {
        background: #eaf8f0;
        border: 1px solid #ccebd9;
        color: #33785a;
    }


    .assessment-alert-error {
        background: #fff0f0;
        border: 1px solid #f4cccc;
        color: #a64646;
    }



    /* ============================================================
               DASHBOARD GRID
               ============================================================ */

    .assessment-dashboard {
        display: grid;
        grid-template-columns: minmax(0, 1.65fr) minmax(290px, .75fr);
        gap: 18px;
        align-items: start;
    }



    /* ============================================================
               ASSESSMENT LIBRARY
               ============================================================ */

    .assessment-content-card {
        background: #ffffff;
        border: 1px solid #e9e8ed;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 6px 22px rgba(28, 31, 44, .04);
    }


    .content-card-header {
        min-height: 72px;
        padding: 16px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #efeff3;
    }


        .content-card-header h2 {
            margin: 0;
            color: #1a1a2d;
            font-size: 15px;
            font-weight: 800;
        }


        .content-card-header p {
            margin: 3px 0 0;
            color: #a0a5b1;
            font-size: 8px;
        }


    .library-header-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #f2efff;
        color: #725ce2;
        font-size: 14px;
    }



    /* ============================================================
               TABS
               ============================================================ */

    .assessment-tabs {
        padding: 11px 18px 0;
        display: flex;
        gap: 6px;
        border-bottom: 1px solid #efeff3;
    }


    .assessment-tab {
        min-height: 37px;
        padding: 0 11px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        position: relative;
        border: none;
        background: transparent;
        color: #969ca8;
        font-size: 9px;
        font-weight: 700;
        cursor: pointer;
    }


        .assessment-tab span {
            min-width: 18px;
            height: 18px;
            padding: 0 5px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #f1f2f5;
            color: #858c99;
            font-size: 7px;
        }


        .assessment-tab::after {
            content: "";
            position: absolute;
            left: 8px;
            right: 8px;
            bottom: -1px;
            height: 2px;
            border-radius: 5px;
            background: transparent;
        }


        .assessment-tab.active {
            color: #25253a;
        }


            .assessment-tab.active::after {
                background: #806cf4;
            }


            .assessment-tab.active span {
                background: #eeeaff;
                color: #6752d9;
            }



    /* ============================================================
           SIMPLE ASSESSMENT GRID
           ============================================================ */

    .assessment-grid {
        padding: 16px;
        display: grid;
        grid-template-columns: repeat( 3, minmax(220px, 1fr) );
        gap: 14px;
    }


    /* ============================================================
           SIMPLE CARD
           ============================================================ */

    .simple-assessment-card {
        min-height: 245px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        background: #ffffff;
        border: 1px solid #ececf1;
        border-radius: 14px;
        box-shadow: 0 3px 10px rgba(20, 25, 45, .035);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }


        .simple-assessment-card:hover {
            transform: translateY(-3px);
            border-color: #ded8ff;
            box-shadow: 0 10px 22px rgba(45, 38, 82, .08);
        }


    /* ============================================================
           TOP
           ============================================================ */

    .simple-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 13px;
    }


    .simple-card-icon {
        width: 30px;
        height: 30px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #f2efff;
        color: #6754d9;
        font-size: 11px;
        font-weight: 800;
    }


    .simple-card-actions-menu {
        color: #b0b4bd;
        font-size: 15px;
        letter-spacing: 2px;
    }


    /* ============================================================
           CONTENT
           ============================================================ */

    .simple-card-content {
        flex: 1;
        display: flex;
        flex-direction: column;
    }


    .simple-card-title-row {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }


        .simple-card-title-row h3 {
            margin: 0;
            color: #222333;
            font-size: 13px;
            font-weight: 800;
            line-height: 1.25;
        }


        .simple-card-title-row p {
            margin: 6px 0 0;
            color: #969ca8;
            font-size: 8px;
            line-height: 1.45;
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }


    /* ============================================================
           STATUS
           ============================================================ */

    .simple-status {
        height: 21px;
        padding: 0 7px;
        flex: 0 0 auto;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 7px;
        font-weight: 750;
    }


        .simple-status.active {
            background: #e3f5ed;
            color: #4a8e6d;
        }


        .simple-status.inactive {
            background: #f0f1f4;
            color: #858b96;
        }


    /* ============================================================
           DETAILS
           ============================================================ */

    .simple-info-row {
        margin-top: 11px;
        display: flex;
        align-items: center;
        gap: 7px;
        color: #697385;
        font-size: 8px;
    }


    .simple-info-icon {
        width: 20px;
        height: 20px;
        flex: 0 0 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        background: #f4f3fa;
        color: #7564d9;
        font-size: 8px;
    }


    /* ============================================================
           BOTTOM
           ============================================================ */

    .simple-card-bottom {
        margin-top: auto;
        padding-top: 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        border-top: 1px solid #f0f1f4;
    }


    .simple-question-info {
        display: flex;
        align-items: baseline;
        gap: 4px;
    }


        .simple-question-info strong {
            color: #242536;
            font-size: 12px;
            font-weight: 800;
        }


        .simple-question-info span {
            color: #9aa0ac;
            font-size: 7px;
        }


    /* ============================================================
           ACTIONS
           ============================================================ */

    .simple-card-buttons {
        display: flex;
        align-items: center;
        gap: 5px;
    }


        .simple-card-buttons form {
            margin: 0;
        }


    .simple-view-btn {
        min-height: 30px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border-radius: 8px;
        background: #55b7a1;
        color: #ffffff;
        text-decoration: none;
        font-size: 8px;
        font-weight: 700;
        transition: transform .15s ease, background .15s ease;
    }


        .simple-view-btn:hover {
            color: #ffffff;
            background: #439e8b;
            transform: translateY(-1px);
        }


    .simple-icon-btn {
        width: 30px;
        height: 30px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2e4e9;
        border-radius: 8px;
        background: #ffffff;
        color: #6f7887;
        font-size: 10px;
        cursor: pointer;
        transition: background .15s ease, transform .15s ease;
    }


        .simple-icon-btn:hover {
            background: #f6f6f9;
            transform: translateY(-1px);
        }


        .simple-icon-btn.danger {
            color: #c96568;
            border-color: #f0d2d3;
        }


    /* ============================================================
           RESPONSIVE
           ============================================================ */

    @@media (max-width: 1150px) {

        .assessment-grid {
            grid-template-columns: repeat( 2, minmax(220px, 1fr) );
        }
    }


    @@media (max-width: 700px) {

        .assessment-grid {
            grid-template-columns: 1fr;
        }
    }


    /* ============================================================
               FOOTER ACTIONS
               ============================================================ */

    .template-footer {
        padding: 10px 12px;
        display: flex;
        align-items: center;
        gap: 6px;
        border-top: 1px solid #efeff3;
        background: #fcfcfd;
    }


        .template-footer form {
            margin: 0;
        }


    .template-action {
        min-height: 31px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
        border: 1px solid #e0e2e8;
        border-radius: 8px;
        background: #ffffff;
        color: #5e6778;
        font-size: 8px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .15s ease, background .15s ease, color .15s ease;
    }


        .template-action:hover {
            color: #303747;
            background: #f7f7fa;
            transform: translateY(-1px);
        }


        .template-action.primary {
