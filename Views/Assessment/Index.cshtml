<script>

    (() => {


        const cards =
            Array.from(
                document.querySelectorAll(
                    ".assessment-template-card"
                )
            );


        const topTabs =
            Array.from(
                document.querySelectorAll(
                    ".assessment-tab"
                )
            );


        const quickFilters =
            Array.from(
                document.querySelectorAll(
                    ".quick-filter-option"
                )
            );


        function applyStatusFilter(
            status) {


            cards.forEach(
                card => {


                    const cardStatus =
                        card.dataset.status;


                    const visible =
                        status === "all" ||
                        cardStatus === status;


                    card.classList.toggle(
                        "filtered-out",
                        !visible
                    );

                }
            );


            topTabs.forEach(
                button => {


                    button.classList.toggle(
                        "active",
                        button.dataset.status ===
                            status
                    );

                }
            );


            quickFilters.forEach(
                button => {


                    button.classList.toggle(
                        "active",
                        button.dataset.statusFilter ===
                            status
                    );

                }
            );
        }


        topTabs.forEach(
            button => {


                button.addEventListener(
                    "click",
                    function () {


                        applyStatusFilter(
                            this.dataset.status
                        );

                    }
                );

            }
        );


        quickFilters.forEach(
            button => {


                button.addEventListener(
                    "click",
                    function () {


                        applyStatusFilter(
                            this.dataset.statusFilter
                        );

                    }
                );

            }
        );


    })();

</script>


