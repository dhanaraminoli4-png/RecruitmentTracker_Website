@{
    ViewData["Title"] = "HR Dashboard";

    var recentVacancies =
        (IEnumerable<RecruitmentTracker.Models.JobVacancy>)
        (ViewBag.RecentVacancies
        ?? new List<RecruitmentTracker.Models.JobVacancy>());

    var activeVacancies =
        Convert.ToInt32(
            ViewBag.ActiveVacancies ?? 0
        );

    var totalApplications =
        Convert.ToInt32(
            ViewBag.TotalApplications ?? 0
        );

    var closingSoon =
        Convert.ToInt32(
            ViewBag.ClosingSoon ?? 0
        );

    var maxMetric =
        Math.Max(
            1,
            Math.Max(
                activeVacancies,
                Math.Max(
                    totalApplications,
                    closingSoon
                )
            )
        );

    var activeWidth =
        Math.Max(
            8,
            (int)Math.Round(
                activeVacancies * 100.0 / maxMetric
            )
        );

    var applicationsWidth =
        Math.Max(
            8,
            (int)Math.Round(
                totalApplications * 100.0 / maxMetric
            )
        );

    var closingWidth =
        Math.Max(
            8,
            (int)Math.Round(
                closingSoon * 100.0 / maxMetric
            )
        );
}


<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .hr-dashboard-page {
        min-height: calc(100vh - 70px);
        padding: 22px;
        background: linear-gradient( 135deg, #f7fbff 0%, #eef7ff 52%, #f9fcff 100% );
        color: #2b435e;
    }


    .hr-dashboard-container {
        max-width: 1450px;
        margin: 0 auto;
    }


    /* =========================================================
           TOP BAR
           ========================================================= */

    .hr-dashboard-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        margin-bottom: 18px;
    }


    .hr-dashboard-title-wrap {
        min-width: 0;
    }


    .hr-dashboard-eyebrow {
        margin-bottom: 5px;
        color: #83a7c5;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .12em;
        text-transform: uppercase;
    }


    .hr-dashboard-title {
        margin: 0;
        color: #244361;
        font-size: 31px;
        font-weight: 800;
        letter-spacing: -1px;
    }


    .hr-dashboard-subtitle {
        margin: 6px 0 0;
        color: #91a8bb;
        font-size: 11px;
    }


    .hr-dashboard-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .hr-dashboard-search {
        width: 300px;
        height: 42px;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 0 13px;
        border: 1px solid #deebf5;
        border-radius: 12px;
        background: rgba(255,255,255,.95);
        box-shadow: 0 8px 24px rgba(73, 129, 176, .05);
    }


        .hr-dashboard-search span {
            color: #a5b8c8;
            font-size: 14px;
        }


        .hr-dashboard-search input {
            width: 100%;
            border: none;
            outline: none;
            background: transparent;
            color: #45627c;
            font-size: 11px;
        }


            .hr-dashboard-search input::placeholder {
                color: #b5c5d2;
            }


    .hr-new-vacancy-btn {
        height: 42px;
        padding: 0 17px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px solid #59a6f4;
        border-radius: 12px;
        background: linear-gradient( 135deg, #67b8ff, #4694ed );
        color: #ffffff;
        font-size: 10px;
        font-weight: 750;
        text-decoration: none;
        box-shadow: 0 10px 23px rgba(72, 147, 232, .18);
        transition: .18s ease;
    }


        .hr-new-vacancy-btn:hover {
            color: #ffffff;
            transform: translateY(-2px);
            box-shadow: 0 13px 27px rgba(72, 147, 232, .24);
        }


    /* =========================================================
           HERO
           ========================================================= */

    .hr-hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.55fr) minmax(280px, .65fr);
        gap: 15px;
        margin-bottom: 15px;
    }


    .hr-welcome-card {
        position: relative;
        min-height: 225px;
        padding: 28px 30px;
        overflow: hidden;
        border: 1px solid #dcebf6;
        border-radius: 23px;
        background: linear-gradient( 135deg, rgba(255,255,255,.98) 0%, rgba(236,247,255,.98) 100% );
        box-shadow: 0 12px 32px rgba(67, 122, 169, .06);
    }


        .hr-welcome-card::before {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            top: -105px;
            right: -70px;
            border-radius: 50%;
            background: rgba(92, 171, 250, .12);
        }


        .hr-welcome-card::after {
            content: "";
            position: absolute;
            width: 145px;
            height: 145px;
            right: 100px;
            bottom: -90px;
            border-radius: 50%;
            background: rgba(143, 208, 255, .11);
        }


    .hr-welcome-content {
        position: relative;
        z-index: 2;
        max-width: 650px;
    }


    .hr-workspace-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 17px;
        padding: 6px 10px;
        border: 1px solid #dcecf7;
        border-radius: 999px;
        background: rgba(255,255,255,.88);
        color: #6c97b8;
        font-size: 9px;
        font-weight: 750;
    }


        .hr-workspace-pill::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #56a5f5;
            box-shadow: 0 0 0 4px rgba(86,165,245,.11);
        }


    .hr-welcome-card h2 {
        margin: 0;
        max-width: 610px;
        color: #23415f;
        font-size: clamp(29px, 3.6vw, 46px);
        line-height: 1.04;
        letter-spacing: -1.7px;
        font-weight: 800;
    }


    .hr-welcome-card p {
        max-width: 520px;
        margin: 13px 0 0;
        color: #8aa3b7;
        font-size: 11px;
        line-height: 1.65;
    }


    .hr-welcome-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 21px;
    }


    .hr-soft-btn {
        min-height: 38px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #dceaf4;
        border-radius: 10px;
        background: #ffffff;
        color: #537895;
        font-size: 10px;
        font-weight: 700;
        text-decoration: none;
        transition: .18s ease;
    }


        .hr-soft-btn:hover {
            color: #3373a5;
            border-color: #bad7ec;
            transform: translateY(-2px);
        }


    /* =========================================================
           BLUE SUMMARY CARD
           ========================================================= */

    .hr-blue-card {
        min-height: 225px;
        padding: 23px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        border-radius: 23px;
        background: linear-gradient( 155deg, #66b5ff 0%, #4f9bf2 53%, #438be1 100% );
        color: #ffffff;
        box-shadow: 0 16px 33px rgba(70, 145, 229, .20);
    }


    .hr-blue-card-label {
        color: rgba(255,255,255,.82);
        font-size: 9px;
        font-weight: 750;
        letter-spacing: .07em;
        text-transform: uppercase;
    }


    .hr-blue-card-value {
        margin-top: 8px;
        font-size: 43px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -2px;
    }


    .hr-blue-card-caption {
        margin-top: 4px;
        color: rgba(255,255,255,.78);
        font-size: 9px;
    }


    .hr-blue-ring {
        width: 112px;
        height: 112px;
        margin: 0 auto 4px;
        display: grid;
        place-items: center;
        border: 13px solid rgba(255,255,255,.26);
        border-top-color: rgba(255,255,255,.90);
        border-radius: 50%;
        transform: rotate(22deg);
    }


        .hr-blue-ring span {
            transform: rotate(-22deg);
            color: #ffffff;
            font-size: 18px;
            font-weight: 800;
        }


    /* =========================================================
           STATS
           ========================================================= */

    .hr-stat-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 15px;
    }


    .hr-stat-card {
        min-height: 105px;
        padding: 16px 17px;
        display: flex;
        align-items: center;
        gap: 13px;
        border: 1px solid #e1edf6;
        border-radius: 17px;
        background: rgba(255,255,255,.96);
        box-shadow: 0 8px 24px rgba(64,119,165,.045);
    }


    .hr-stat-icon {
        width: 45px;
        height: 45px;
        flex: 0 0 45px;
        display: grid;
        place-items: center;
        border-radius: 13px;
        background: #ebf6ff;
        color: #4f9cec;
        font-size: 17px;
        font-weight: 800;
    }


    .hr-stat-copy span {
        display: block;
        color: #92a9bb;
        font-size: 9px;
        font-weight: 700;
    }


    .hr-stat-copy strong {
        display: block;
        margin-top: 5px;
        color: #2e4c68;
        font-size: 25px;
        line-height: 1;
        font-weight: 800;
        letter-spacing: -.7px;
    }


    /* =========================================================
           MAIN GRID
           ========================================================= */

    .hr-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.45fr) minmax(300px, .72fr);
        gap: 15px;
        align-items: start;
    }


    .hr-panel {
        overflow: hidden;
        border: 1px solid #dfebf5;
        border-radius: 20px;
        background: rgba(255,255,255,.97);
        box-shadow: 0 10px 29px rgba(66,121,166,.05);
    }


    .hr-panel-header {
        padding: 18px 20px 14px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid #edf3f8;
    }


        .hr-panel-header h3 {
            margin: 0;
            color: #2d4b68;
            font-size: 14px;
            font-weight: 800;
        }


        .hr-panel-header p {
            margin: 4px 0 0;
            color: #9cafbf;
            font-size: 9px;
        }


    .hr-panel-link {
        color: #5599dc;
        font-size: 9px;
        font-weight: 750;
        text-decoration: none;
    }


        .hr-panel-link:hover {
            color: #357ebf;
        }


    /* =========================================================
           OVERVIEW
           ========================================================= */

    .hr-overview {
        padding: 20px;
    }


    .hr-overview-row {
        display: grid;
        grid-template-columns: 115px minmax(0, 1fr) 48px;
        gap: 11px;
        align-items: center;
        margin-bottom: 16px;
    }


        .hr-overview-row:last-of-type {
            margin-bottom: 0;
        }


    .hr-overview-label {
        color: #68849c;
        font-size: 9px;
        font-weight: 700;
    }


    .hr-overview-track {
        height: 10px;
        overflow: hidden;
        border-radius: 999px;
        background: #edf5fb;
    }


    .hr-overview-fill {
        height: 100%;
        min-width: 8%;
        border-radius: inherit;
        background: linear-gradient( 90deg, #86cbff, #4e9cef );
    }


    .hr-overview-value {
        color: #385a76;
        font-size: 10px;
        font-weight: 800;
        text-align: right;
    }


    .hr-overview-note {
        margin-top: 18px;
        padding: 12px 13px;
        border-radius: 11px;
        background: #f5faff;
        color: #8da5b9;
        font-size: 9px;
        line-height: 1.55;
    }


    /* =========================================================
           QUICK ACTIONS
           ========================================================= */

    .hr-quick-actions {
        padding: 11px;
    }


    .hr-quick-action {
        min-height: 60px;
        padding: 10px 11px;
        display: flex;
        align-items: center;
        gap: 11px;
        border-radius: 12px;
        color: inherit;
        text-decoration: none;
        transition: .18s ease;
    }


        .hr-quick-action:hover {
            background: #f4f9fd;
            transform: translateX(2px);
        }


    .hr-quick-icon {
        width: 37px;
        height: 37px;
        flex: 0 0 37px;
        display: grid;
        place-items: center;
        border-radius: 10px;
        background: #eaf5fe;
        color: #4d9cec;
        font-size: 13px;
        font-weight: 800;
    }


    .hr-quick-copy {
        min-width: 0;
        flex: 1;
    }


        .hr-quick-copy strong {
            display: block;
            color: #36546f;
            font-size: 10px;
            font-weight: 750;
        }


        .hr-quick-copy span {
            display: block;
            margin-top: 3px;
            color: #9eb1c0;
            font-size: 8px;
        }


    .hr-quick-arrow {
        color: #acbdca;
        font-size: 12px;
    }


    /* =========================================================
           VACANCIES
           ========================================================= */

    .hr-vacancy-panel {
        margin-top: 15px;
    }


    .hr-vacancy-list {
        padding: 4px 15px 12px;
    }


    .hr-vacancy-row {
        min-height: 66px;
        padding: 9px 5px;
        display: grid;
        grid-template-columns: minmax(0, 1fr) 135px 95px 30px;
        gap: 11px;
        align-items: center;
        border-bottom: 1px solid #edf3f8;
        color: inherit;
        text-decoration: none;
    }


        .hr-vacancy-row:last-child {
            border-bottom: none;
        }


        .hr-vacancy-row:hover {
            background: #f8fbfe;
        }


    .hr-vacancy-main {
        min-width: 0;
    }


        .hr-vacancy-main strong {
            display: block;
            overflow: hidden;
            color: #395570;
            font-size: 10px;
            font-weight: 750;
            white-space: nowrap;
            text-overflow: ellipsis;
        }


        .hr-vacancy-main span {
            display: block;
            margin-top: 4px;
            color: #9daebe;
            font-size: 8px;
        }


    .hr-vacancy-date span {
        display: block;
        color: #a2b3c0;
        font-size: 7px;
        margin-bottom: 3px;
    }


    .hr-vacancy-date strong {
        color: #627f97;
        font-size: 8px;
    }


    .hr-vacancy-status {
        justify-self: start;
        padding: 5px 8px;
        border-radius: 999px;
        background: #e8f7f0;
        color: #4c8b6e;
        font-size: 7px;
        font-weight: 800;
        text-transform: uppercase;
    }


        .hr-vacancy-status.closed {
            background: #eef3f7;
            color: #7e96aa;
        }


    .hr-vacancy-open {
        width: 28px;
        height: 28px;
        display: grid;
        place-items: center;
        border-radius: 8px;
        background: #edf6fd;
        color: #5597d6;
        font-size: 10px;
    }


    .hr-dashboard-empty {
        margin: 13px;
        padding: 32px 18px;
        border: 1px dashed #cddfeb;
        border-radius: 14px;
        background: #f9fcff;
        text-align: center;
    }


        .hr-dashboard-empty strong {
            display: block;
            color: #58748e;
            font-size: 10px;
        }


        .hr-dashboard-empty span {
            display: block;
            margin-top: 5px;
            color: #9db0bf;
            font-size: 8px;
        }


    /* =========================================================
           FOOTER
           ========================================================= */

    .hr-dashboard-footer {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 17px 4px 0;
        color: #a0b1bf;
        font-size: 8px;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1000px) {

        .hr-dashboard-topbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .hr-dashboard-actions {
            width: 100%;
        }

        .hr-dashboard-search {
            flex: 1;
            width: auto;
        }

        .hr-hero-grid,
        .hr-main-grid {
            grid-template-columns: 1fr;
        }

        .hr-blue-card {
            min-height: 185px;
        }

        .hr-blue-ring {
            margin-left: 0;
        }
    }


    @@media (max-width: 760px) {

        .hr-dashboard-page {
            padding: 14px;
        }

        .hr-dashboard-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .hr-dashboard-search,
        .hr-new-vacancy-btn {
            width: 100%;
        }

        .hr-stat-grid {
            grid-template-columns: 1fr;
        }

        .hr-welcome-card {
            min-height: auto;
            padding: 23px 19px;
        }

        .hr-vacancy-row {
            grid-template-columns: minmax(0, 1fr) 82px 28px;
        }

        .hr-vacancy-date {
            display: none;
        }
    }


    @@media (max-width: 520px) {

        .hr-vacancy-row {
            grid-template-columns: minmax(0, 1fr) 28px;
        }

        .hr-vacancy-status {
            display: none;
        }

        .hr-dashboard-footer {
            flex-direction: column;
        }
    }
</style>


<div class="hr-dashboard-page">

    <div class="hr-dashboard-container">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="hr-dashboard-topbar">

            <div class="hr-dashboard-title-wrap">

                <div class="hr-dashboard-eyebrow">
                    HireTrack · HR Workspace
                </div>

                <h1 class="hr-dashboard-title">
                    Recruitment Dashboard
                </h1>

                <p class="hr-dashboard-subtitle">
                    Manage vacancies, applications and interviews from one clean workspace.
                </p>

            </div>


            <div class="hr-dashboard-actions">

                <div class="hr-dashboard-search">

                    <span>
                        ⌕
                    </span>

                    <input type="text"
                           id="dashboardVacancySearch"
                           placeholder="Search recent vacancies..."
                           oninput="filterDashboardVacancies()" />

                </div>


                <a asp-controller="Vacancy"
                   asp-action="Create"
                   class="hr-new-vacancy-btn">

                    <span>
                        ＋
                    </span>

                    New Vacancy

                </a>

            </div>

        </div>



        <!-- =====================================================
             HERO
             ===================================================== -->

        <div class="hr-hero-grid">


            <section class="hr-welcome-card">

                <div class="hr-welcome-content">

                    <div class="hr-workspace-pill">
                        Recruitment workspace is active
                    </div>


                    <h2>
                        Build your next team with a clearer hiring workflow.
                    </h2>


                    <p>
                        Review candidates, manage vacancies and schedule interviews
                        while keeping the full recruitment process in one place.
                    </p>


                    <div class="hr-welcome-actions">

                        <a asp-controller="HRApplication"
                           asp-action="Management"
                           class="hr-soft-btn">

                            View Applications

                        </a>


                        <a asp-controller="Interview"
                           asp-action="Index"
                           class="hr-soft-btn">

                            Manage Interviews

                        </a>


                        <a asp-controller="Vacancy"
                           asp-action="Index"
                           class="hr-soft-btn">

                            Browse Vacancies

                        </a>

                    </div>

                </div>

            </section>



            <section class="hr-blue-card">

                <div>

                    <div class="hr-blue-card-label">
                        Active recruitment
                    </div>

                    <div class="hr-blue-card-value">
                        @activeVacancies
                    </div>

                    <div class="hr-blue-card-caption">
                        vacancies currently open
                    </div>

                </div>


                <div class="hr-blue-ring">
                    <span>HR</span>
                </div>

            </section>

        </div>



        <!-- =====================================================
             STATS
             ===================================================== -->

        <section class="hr-stat-grid">


            <div class="hr-stat-card">

                <div class="hr-stat-icon">
                    ▣
                </div>

                <div class="hr-stat-copy">

                    <span>
                        Active Vacancies
                    </span>

                    <strong>
                        @activeVacancies
                    </strong>

                </div>

            </div>



            <div class="hr-stat-card">

                <div class="hr-stat-icon">
                    ◎
                </div>

                <div class="hr-stat-copy">

                    <span>
                        Applications
                    </span>

                    <strong>
                        @totalApplications
                    </strong>

                </div>

            </div>



            <div class="hr-stat-card">

                <div class="hr-stat-icon">
                    ◷
                </div>

                <div class="hr-stat-copy">

                    <span>
                        Closing Soon
                    </span>

                    <strong>
                        @closingSoon
                    </strong>

                </div>

            </div>

        </section>



        <!-- =====================================================
             MAIN DASHBOARD
             ===================================================== -->

        <div class="hr-main-grid">


            <!-- OVERVIEW -->

            <section class="hr-panel">

                <div class="hr-panel-header">

                    <div>

                        <h3>
                            Recruitment Overview
                        </h3>

                        <p>
                            Current workload comparison.
                        </p>

                    </div>

                </div>


                <div class="hr-overview">


                    <div class="hr-overview-row">

                        <div class="hr-overview-label">
                            Active Vacancies
                        </div>

                        <div class="hr-overview-track">

                            <div class="hr-overview-fill"
                                 style="width:@activeWidth%">
                            </div>

                        </div>

                        <div class="hr-overview-value">
                            @activeVacancies
                        </div>

                    </div>



                    <div class="hr-overview-row">

                        <div class="hr-overview-label">
                            Applications
                        </div>

                        <div class="hr-overview-track">

                            <div class="hr-overview-fill"
                                 style="width:@applicationsWidth%">
                            </div>

                        </div>

                        <div class="hr-overview-value">
                            @totalApplications
                        </div>

                    </div>



                    <div class="hr-overview-row">

                        <div class="hr-overview-label">
                            Closing Soon
                        </div>

                        <div class="hr-overview-track">

                            <div class="hr-overview-fill"
                                 style="width:@closingWidth%">
                            </div>

                        </div>

                        <div class="hr-overview-value">
                            @closingSoon
                        </div>

                    </div>


                    <div class="hr-overview-note">
                        These bars compare the current dashboard totals only.
                    </div>

                </div>

            </section>



            <!-- QUICK ACTIONS -->

            <section class="hr-panel">

                <div class="hr-panel-header">

                    <div>

                        <h3>
                            Quick Actions
                        </h3>

                        <p>
                            Common HR tasks.
                        </p>

                    </div>

                </div>


                <div class="hr-quick-actions">


                    <a asp-controller="Vacancy"
                       asp-action="Create"
                       class="hr-quick-action">

                        <div class="hr-quick-icon">
                            ＋
                        </div>

                        <div class="hr-quick-copy">

                            <strong>
                                Create Vacancy
                            </strong>

                            <span>
                                Publish a new role
                            </span>

                        </div>

                        <span class="hr-quick-arrow">
                            →
                        </span>

                    </a>



                    <a asp-controller="HRApplication"
                       asp-action="Management"
                       class="hr-quick-action">

                        <div class="hr-quick-icon">
                            ◎
                        </div>

                        <div class="hr-quick-copy">

                            <strong>
                                Review Applications
                            </strong>

                            <span>
                                Screen and shortlist candidates
                            </span>

                        </div>

                        <span class="hr-quick-arrow">
                            →
                        </span>

                    </a>



                    <a asp-controller="Interview"
                       asp-action="Index"
                       class="hr-quick-action">

                        <div class="hr-quick-icon">
                            ◷
                        </div>

                        <div class="hr-quick-copy">

                            <strong>
                                Manage Interviews
                            </strong>

                            <span>
                                Schedule and track interviews
                            </span>

                        </div>

                        <span class="hr-quick-arrow">
                            →
                        </span>

                    </a>



                    <a asp-controller="Vacancy"
                       asp-action="Index"
                       class="hr-quick-action">

                        <div class="hr-quick-icon">
                            ▤
                        </div>

                        <div class="hr-quick-copy">

                            <strong>
                                Manage Vacancies
                            </strong>

                            <span>
                                Open your recruitment campaigns
                            </span>

                        </div>

                        <span class="hr-quick-arrow">
                            →
                        </span>

                    </a>

                </div>

            </section>

        </div>



        <!-- =====================================================
             RECENT VACANCIES
             ===================================================== -->

        <section class="hr-panel hr-vacancy-panel">

            <div class="hr-panel-header">

                <div>

                    <h3>
                        Recent Vacancies
                    </h3>

                    <p>
                        Your latest recruitment campaigns.
                    </p>

                </div>


                <a asp-controller="Vacancy"
                   asp-action="Index"
                   class="hr-panel-link">

                    View all vacancies →

                </a>

            </div>


            @if (recentVacancies.Any())
            {
                <div class="hr-vacancy-list"
                     id="dashboardVacancyList">

                    @foreach (var vacancy in recentVacancies)
                    {
                        var searchable =
                        (
                        $"{vacancy.JobTitle} " +
                        $"{vacancy.JobCode}"
                        )
                        .ToLowerInvariant();


                        <a asp-controller="Vacancy"
                           asp-action="Manage"
                           asp-route-id="@vacancy.Id"
                           class="hr-vacancy-row"
                           data-search="@searchable">

                            <div class="hr-vacancy-main">

                                <strong>
                                    @vacancy.JobTitle
                                </strong>

                                <span>
                                    @(string.IsNullOrWhiteSpace(
                                                                vacancy.JobCode)

                                                                ? "No job code"

                                                                : vacancy.JobCode)
                                                                              </span>

                            </div>


                            <div class="hr-vacancy-date">

                                <span>
                                    Closing
                                </span>

                                <strong>
                                    @vacancy.ClosingDate.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <span class="hr-vacancy-status @(vacancy.IsActive ? "" : "closed")">

                                @(vacancy.IsActive
                                                        ? "Live"
                                                        : "Archived")

                    </span>


                            <span class="hr-vacancy-open">
                                →
                            </span>

                        </a>
                                }

                </div>
            }
            else
            {
                <div class="hr-dashboard-empty">

                    <strong>
                        No recent vacancies
                    </strong>

                    <span>
                        Create your first vacancy to begin recruiting.
                    </span>

                </div>
            }

        </section>



        <!-- =====================================================
             FOOTER
             ===================================================== -->

        <div class="hr-dashboard-footer">

            <span>
                © @DateTime.Now.Year HireTrack
            </span>

            <span>
                HR Workspace · Recruitment Management
            </span>

        </div>

    </div>

</div>


<script>

    function filterDashboardVacancies() {

        const input =
            document.getElementById(
                "dashboardVacancySearch"
            );


        const search =
            (
                input?.value
                || ""
            )
            .trim()
            .toLowerCase();


        document
            .querySelectorAll(
                "#dashboardVacancyList .hr-vacancy-row"
            )
            .forEach(
                row => {

                    const searchable =
                        (
                            row.dataset.search
                            || ""
                        )
                        .toLowerCase();


                    row.style.display =
                        !search ||
                        searchable.includes(search)

                            ? ""

                            : "none";
                }
            );
    }

</script>
