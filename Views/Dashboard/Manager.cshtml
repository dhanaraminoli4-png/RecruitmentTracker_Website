@{ ViewData["Title"] = "Hiring Manager Dashboard"; }
<div class="page-heading"><div><div class="section-label">HIRING MANAGER WORKSPACE</div><h1>Candidate decisions</h1><p>Review the shortlist handed over by HR and keep every decision attached to its original application.</p></div><a asp-controller="HiringManager" asp-action="Applications" class="btn btn-primary">Open candidate queue</a></div>
<div class="hero-panel mb-4"><div class="section-label" style="color:#9fb4d0">HR HANDOFF</div><h2 class="mt-2">Your review queue stays connected.</h2><p>Applications are never removed when you make a decision. The Hiring Manager decision is stored separately from the candidate-facing Sprint 1 status.</p></div>
<div class="row g-3"><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="stat-icon mb-3">◎</div><h5>Candidate queue</h5><p class="text-muted">Review every candidate HR has shortlisted for your attention.</p><a asp-controller="HiringManager" asp-action="Applications" class="btn btn-primary">View candidates</a></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="stat-icon mb-3">◷</div><h5>Decision history</h5><p class="text-muted">Completed decisions remain attached to the application for auditability.</p></div></div></div><div class="col-md-4"><div class="card h-100"><div class="card-body"><div class="stat-icon mb-3">✓</div><h5>Sprint 1 boundary</h5><p class="text-muted">Candidate-facing status remains <strong>Shortlisted</strong> while internal HM decisions are recorded.</p></div></div></div></div>
