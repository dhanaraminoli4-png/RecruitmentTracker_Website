<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->
@if (selectedStatus == "review")
{
    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("candidateForm");

            if (!form) {
                return;
            }


            const selectAllCheckbox =
                document.getElementById("selectAllCheckbox");

            const selectAllBtn =
                document.getElementById("selectAllBtn");

            const selectionText =
                document.getElementById("selectionText");

            const checkboxes =
                Array.from(
                    document.querySelectorAll(".candidate-checkbox")
                );


            function updateSelection() {

                const selected =
                    checkboxes.filter(
                        checkbox => checkbox.checked
                    );

                const count =
                    selected.length;


                if (count === 0) {

                    selectionText.textContent =
                        "Select candidates to pass.";

                }
                else
                {

                    selectionText.textContent =
                        count +
                        " candidate(s) selected.";

                }


                const allSelected =
                    checkboxes.length > 0 &&
                    selected.length === checkboxes.length;


                if (selectAllCheckbox) {

                    selectAllCheckbox.checked =
                        allSelected;

                }


                if (selectAllBtn) {

                    selectAllBtn.textContent =
                        allSelected
                            ? "Deselect All"
                            : "Select All";

                }

            }


            /* =====================================================
               SELECT ALL CHECKBOX
               ===================================================== */

            if (selectAllCheckbox) {

                selectAllCheckbox.addEventListener(
                    "change",
                    function () {

                        checkboxes.forEach(
                            checkbox => {

                                checkbox.checked =
                                    selectAllCheckbox.checked;

                            }
                        );

                        updateSelection();

                    }
                );

            }


            /* =====================================================
               SELECT ALL BUTTON
               ===================================================== */

            if (selectAllBtn) {

                selectAllBtn.addEventListener(
                    "click",
                    function () {

                        const allSelected =
                            checkboxes.length > 0 &&
                            checkboxes.every(
                                checkbox => checkbox.checked
                            );


                        checkboxes.forEach(
                            checkbox => {

                                checkbox.checked =
                                    !allSelected;

                            }
                        );

                        updateSelection();

                    }
                );

            }


            /* =====================================================
               INDIVIDUAL CHECKBOXES
               ===================================================== */

            checkboxes.forEach(
                checkbox => {

                    checkbox.addEventListener(
                        "change",
                        updateSelection
                    );

                }
            );


            /* =====================================================
               FORM SUBMIT
               ===================================================== */

            form.addEventListener(
                "submit",
                function (event) {

                    const selected =
                        checkboxes.filter(
                            checkbox => checkbox.checked
                        );


                    if (selected.length === 0) {

                        event.preventDefault();

                        alert(
                            "Please select at least one candidate."
                        );

                        return;

                    }


                    const vacancyIds =
                        selected.map(
                            checkbox =>
                                checkbox.dataset.vacancyId
                        );


                    const firstVacancyId =
                        vacancyIds[0];


                    const differentVacancy =
                        vacancyIds.some(
                            id =>
                                id !== firstVacancyId
                        );


                    if (differentVacancy) {

                        event.preventDefault();

                        alert(
                            "Please select candidates from the same job vacancy."
                        );

                        return;

                    }


                    document.getElementById("vacancyId").value =
                        firstVacancyId;

                }
            );


            updateSelection();

        });

    </script>
}


@if (selectedStatus == "passed")
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("sendToHiringManagerForm");
            const selectAllBtn = document.getElementById("hmSelectAllBtn");
            const selectionText = document.getElementById("hmSelectionText");
            const checkboxes = Array.from(document.querySelectorAll(".hm-candidate-checkbox"));

            if (!form) return;

            function updateHmSelection() {
                const count = checkboxes.filter(x => x.checked).length;
                selectionText.textContent = count === 0
                    ? "Select passed candidates to send to the Hiring Manager."
                    : count + " candidate(s) selected.";
            }

            checkboxes.forEach(x => x.addEventListener("change", updateHmSelection));

            if (selectAllBtn) {
                selectAllBtn.addEventListener("click", function () {
                    const shouldSelect = checkboxes.some(x => !x.checked);
                    checkboxes.forEach(x => x.checked = shouldSelect);
                    updateHmSelection();
                    selectAllBtn.textContent = shouldSelect ? "Clear All" : "Select All";
                });
            }

            form.addEventListener("submit", function (event) {
                const selected = checkboxes.filter(x => x.checked);
                if (selected.length === 0) {
                    event.preventDefault();
                    alert("Please select at least one candidate.");
                    return;
                }

                if (!confirm(`Send ${selected.length} selected candidate(s) to the Hiring Manager for interview approval?`)) {
                    event.preventDefault();
                }
            });

            updateHmSelection();
        });
    </script>


}

<script>
    function toggleFilters() {
