@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Recruitment Reports";

    var rows =
        Model?.ToList()
        ?? new List<dynamic>();

    var vacancies =
        ViewBag.Vacancies
        as IEnumerable<RecruitmentTracker.Models.JobVacancy>
        ?? Enumerable.Empty<RecruitmentTracker.Models.JobVacancy>();

    int? selectedVacancyId =
        ViewBag.SelectedVacancyId as int?;

    var selectedVacancyTitle =
        ViewBag.SelectedVacancyTitle
        ?? "All Vacancies";

    var fromDate =
        ViewBag.FromDate as string;

    var toDate =
        ViewBag.ToDate as string;
}

<style>
    :root {
        --report-blue: #3f9bf3;
        --report-blue-hover: #2f8de8;
        --report-blue-soft: rgba(234,247,255,.72);
        --report-bg: #edf3f8;
        --report-glass: rgba(255,255,255,.66);
        --report-glass-strong: rgba(255,255,255,.82);
        --report-line: rgba(213,226,237,.86);
        --report-text: #213c57;
        --report-text-2: #567087;
        --report-muted: #8ca0b2;
        --report-green: #36a777;
        --report-green-soft: rgba(234,248,241,.82);
        --report-red: #c7616d;
        --report-red-soft: rgba(255,240,242,.82);
        --report-amber: #b88736;
        --report-amber-soft: rgba(255,247,232,.82);
        --report-shadow: 0 18px 48px rgba(51,78,102,.10);
        --report-shadow-soft: 0 8px 24px rgba(51,78,102,.07);
    }

    * {
        box-sizing: border-box;
    }

    .report-page {
        min-height: calc(100vh - 80px);
        padding: 34px 34px 60px;
        background: radial-gradient(circle at 8% 4%, rgba(91,163,221,.16), transparent 25%), radial-gradient(circle at 90% 8%, rgba(173,201,225,.18), transparent 22%), linear-gradient(180deg, #edf3f8 0%, #f4f7fa 100%);
        color: var(--report-text);
    }

    .report-shell {
        max-width: 1450px;
        margin: 0 auto;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .report-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 22px;
    }

    .report-eyebrow {
        margin-bottom: 6px;
        color: var(--report-blue);
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 1.15px;
        text-transform: uppercase;
    }

    .report-header h1 {
        margin: 0;
        color: #203a53;
        font-size: 31px;
        font-weight: 850;
        letter-spacing: -.45px;
    }

    .report-header p {
        max-width: 670px;
        margin: 7px 0 0;
        color: var(--report-muted);
        font-size: 13px;
        line-height: 1.6;
    }

    .report-header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
    }

    .report-btn {
        min-height: 43px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border-radius: 11px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: .18s ease;
    }

        .report-btn.secondary {
            border: 1px solid rgba(210,224,235,.92);
            background: rgba(255,255,255,.68);
            backdrop-filter: blur(12px);
            color: #657d92;
        }

            .report-btn.secondary:hover {
                background: rgba(255,255,255,.88);
                color: #3f7fae;
                transform: translateY(-1px);
            }

        .report-btn.primary {
            border: 1px solid var(--report-blue);
            background: var(--report-blue);
            color: #fff;
            box-shadow: 0 10px 22px rgba(63,155,243,.20);
        }

            .report-btn.primary:hover {
                background: var(--report-blue-hover);
                border-color: var(--report-blue-hover);
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 13px 26px rgba(47,141,232,.24);
            }

    /* =========================================================
           GLASS CARD
           ========================================================= */

    .glass-card {
        border: 1px solid var(--report-line);
        border-radius: 20px;
        background: var(--report-glass);
        backdrop-filter: blur(18px);
        -webkit-backdrop-filter: blur(18px);
        box-shadow: var(--report-shadow-soft);
    }

    /* =========================================================
           FILTERS
           ========================================================= */

    .filter-panel {
        padding: 21px 22px;
        margin-bottom: 16px;
    }

    .filter-heading {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 17px;
    }

        .filter-heading h3 {
            margin: 0;
            color: #2d4b66;
            font-size: 15px;
            font-weight: 850;
        }

        .filter-heading p {
            margin: 5px 0 0;
            color: var(--report-muted);
            font-size: 10px;
        }

    .reset-btn {
        color: #71889d;
        text-decoration: none;
        font-size: 10px;
        font-weight: 750;
    }

        .reset-btn:hover {
            color: var(--report-blue-hover);
        }

    .filter-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr .75fr;
        gap: 13px;
        align-items: end;
    }

    .filter-field label {
        display: block;
        margin-bottom: 6px;
        color: #566f85;
        font-size: 10px;
        font-weight: 800;
    }

    .report-control {
        width: 100%;
        height: 43px;
        padding: 0 12px;
        border: 1px solid rgba(205,220,232,.92);
        border-radius: 10px;
        background: rgba(255,255,255,.70);
        backdrop-filter: blur(10px);
        color: #405a72;
        font-size: 11px;
        outline: none;
    }

        .report-control:focus {
            border-color: #8bc4ef;
            box-shadow: 0 0 0 4px rgba(63,155,243,.09);
            background: rgba(255,255,255,.88);
        }

    .run-report-btn {
        width: 100%;
        height: 43px;
        border: 1px solid var(--report-blue);
        border-radius: 10px;
        background: var(--report-blue);
        color: #fff;
        font-size: 11px;
        font-weight: 850;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(63,155,243,.18);
        transition: .18s ease;
    }

        .run-report-btn:hover {
            background: var(--report-blue-hover);
            border-color: var(--report-blue-hover);
            transform: translateY(-1px);
        }

    /* =========================================================
           SCOPE
           ========================================================= */

    .report-scope {
        margin-bottom: 23px;
        padding: 11px 14px;
        display: flex;
        align-items: center;
        gap: 9px;
        border-radius: 12px;
        border: 1px solid rgba(214,226,236,.80);
        background: rgba(255,255,255,.46);
        backdrop-filter: blur(14px);
        color: #71879a;
        font-size: 10px;
    }

        .report-scope strong {
            color: #3b586f;
            font-weight: 850;
        }

        .report-scope small {
            margin-left: auto;
            color: #8fa2b2;
        }

    /* =========================================================
           SECTION HEADINGS
           ========================================================= */

    .report-section-heading {
        margin: 28px 0 12px;
    }

        .report-section-heading:first-of-type {
            margin-top: 0;
        }

        .report-section-heading span {
            display: block;
            margin-bottom: 5px;
            color: var(--report-blue);
            font-size: 9px;
            font-weight: 850;
            letter-spacing: .9px;
            text-transform: uppercase;
        }

        .report-section-heading h2 {
            margin: 0;
            color: #28465f;
            font-size: 18px;
            font-weight: 850;
        }

        .report-section-heading p {
            margin: 5px 0 0;
            color: var(--report-muted);
            font-size: 10px;
        }

    /* =========================================================
           EXECUTIVE SUMMARY
           ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0,1fr));
        gap: 12px;
    }

    .summary-stat {
        min-height: 118px;
        padding: 16px;
        border: 1px solid var(--report-line);
        border-radius: 16px;
        background: var(--report-glass);
        backdrop-filter: blur(16px);
        box-shadow: var(--report-shadow-soft);
    }

        .summary-stat span {
            display: block;
            color: #8da1b2;
            font-size: 8px;
            font-weight: 850;
            letter-spacing: .55px;
            text-transform: uppercase;
        }

        .summary-stat strong {
            display: block;
            margin-top: 7px;
            color: #27455e;
            font-size: 27px;
            font-weight: 850;
        }

        .summary-stat small {
            display: block;
            margin-top: 4px;
            color: #9aacba;
            font-size: 8px;
            line-height: 1.4;
        }

        .summary-stat.success {
            border-bottom: 3px solid #58b88c;
        }

        .summary-stat.warning {
            border-bottom: 3px solid #dbaf5f;
        }

    /* =========================================================
           FUNNEL
           ========================================================= */

    .dashboard-card {
        overflow: hidden;
        border: 1px solid var(--report-line);
        border-radius: 20px;
        background: var(--report-glass);
        backdrop-filter: blur(18px);
        box-shadow: var(--report-shadow-soft);
    }

    .card-heading {
        padding: 18px 20px;
        border-bottom: 1px solid rgba(222,232,240,.72);
    }

        .card-heading h3 {
            margin: 0;
            color: #2d4c67;
            font-size: 15px;
            font-weight: 850;
        }

        .card-heading p {
            margin: 5px 0 0;
            color: var(--report-muted);
            font-size: 10px;
        }

    .funnel-list {
        padding: 20px;
    }

    .funnel-item {
        display: grid;
        grid-template-columns: 150px 1fr 58px;
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
    }

        .funnel-item:last-child {
            margin-bottom: 0;
        }

    .funnel-info {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        color: #657d92;
        font-size: 10px;
    }

        .funnel-info strong {
            color: #38556d;
        }

    .funnel-track {
        height: 9px;
        overflow: hidden;
        border-radius: 999px;
        background: rgba(221,231,239,.76);
    }

    .funnel-fill {
        height: 100%;
        border-radius: inherit;
        background: linear-gradient(90deg,#7dbef0,#3f9bf3);
    }

    .funnel-item > small {
        color: #8fa2b2;
        text-align: right;
        font-size: 9px;
    }

    /* =========================================================
           TABLE
           ========================================================= */

    .table-card {
        margin-top: 0;
    }

    .table-card-header {
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border-bottom: 1px solid rgba(222,232,240,.72);
    }

        .table-card-header h3 {
            margin: 0;
            color: #2d4c67;
            font-size: 15px;
            font-weight: 850;
        }

        .table-card-header p {
            margin: 5px 0 0;
            color: var(--report-muted);
            font-size: 10px;
        }

    .table-count {
        min-width: 76px;
        padding: 7px 9px;
        border-radius: 999px;
        background: rgba(238,246,252,.80);
        color: #71899e;
        text-align: center;
        font-size: 9px;
        font-weight: 750;
    }

    .table-responsive {
        overflow-x: auto;
    }

    .report-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 980px;
    }

        .report-table th {
            padding: 12px 13px;
            background: rgba(244,248,251,.72);
            color: #7f94a7;
            font-size: 8px;
            font-weight: 850;
            letter-spacing: .45px;
            text-align: left;
            white-space: nowrap;
            border-bottom: 1px solid rgba(219,230,238,.84);
        }

        .report-table td {
            padding: 14px 13px;
            color: #526c82;
            font-size: 10px;
            border-bottom: 1px solid rgba(231,238,244,.85);
            vertical-align: middle;
        }

        .report-table tbody tr:hover td {
            background: rgba(248,252,255,.58);
        }

    .vacancy-cell strong {
        display: block;
        color: #304e67;
        font-size: 11px;
        font-weight: 850;
    }

    .vacancy-cell span,
    .vacancy-cell small {
        display: block;
        margin-top: 3px;
        color: #8ba0b2;
        font-size: 8px;
    }

    .result-number.pass {
        color: var(--report-green);
        font-weight: 850;
    }

    .result-number.fail {
        color: var(--report-red);
        font-weight: 850;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 800;
    }

        .status-pill.live {
            background: var(--report-green-soft);
            color: var(--report-green);
        }

        .status-pill.archived {
            background: rgba(238,242,246,.80);
            color: #74889a;
        }

    .report-empty {
        padding: 52px 20px;
        text-align: center;
        color: #91a4b4;
        font-size: 10px;
    }

    /* =========================================================
           PDF NOTE
           ========================================================= */

    .pdf-standard-note {
        margin-top: 18px;
        padding: 13px 15px;
        border-radius: 13px;
        border: 1px solid rgba(211,224,234,.82);
        background: rgba(255,255,255,.46);
        backdrop-filter: blur(14px);
        color: #778c9f;
        font-size: 9px;
        line-height: 1.55;
    }

        .pdf-standard-note strong {
            color: #45637d;
        }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1150px) {
        .summary-grid {
            grid-template-columns: repeat(3,1fr);
        }

        .filter-grid {
            grid-template-columns: 1fr 1fr;
        }
    }

    @@media (max-width: 700px) {
        .report-page {
            padding: 22px 14px 42px;
        }

        .report-header {
            flex-direction: column;
        }

        .report-header-actions {
            width: 100%;
        }

        .report-btn {
            flex: 1;
        }

        .summary-grid {
            grid-template-columns: 1fr 1fr;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .funnel-item {
            grid-template-columns: 1fr;
        }

            .funnel-item > small {
                text-align: left;
            }

        .report-scope {
            align-items: flex-start;
            flex-wrap: wrap;
        }

            .report-scope small {
                width: 100%;
                margin-left: 0;
            }
    }
</style>

<div class="report-page">

    <div class="report-shell">

        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="report-header">

            <div>

                <div class="report-eyebrow">
                    HR WORKSPACE · REPORTING
                </div>

                <h1>
                    Recruitment Report
                </h1>

                <p>
                    A concise company-style report covering recruitment activity,
                    candidate progression, interview outcomes and vacancy performance.
                </p>

            </div>

            <div class="report-header-actions">

                <a asp-controller="HRApplication"
                   asp-action="Management"
                   class="report-btn secondary">
                    Application Management
                </a>

                <a asp-controller="HRApplication"
                   asp-action="ExportReportsPdf"
                   asp-route-vacancyId="@ViewBag.SelectedVacancyId"
                   asp-route-fromDate="@ViewBag.FromDate"
                   asp-route-toDate="@ViewBag.ToDate"
                   class="report-btn primary">
                    Export PDF
                </a>

            </div>

        </div>


        <!-- =====================================================
             FILTERS
             ===================================================== -->

        <form method="get"
              asp-controller="HRApplication"
              asp-action="Reports"
              class="filter-panel glass-card">

            <div class="filter-heading">

                <div>

                    <h3>
                        Report Filters
                    </h3>

                    <p>
                        Select the vacancy and reporting period.
                    </p>

                </div>

                <a asp-action="Reports"
                   class="reset-btn">
                    Reset
                </a>

            </div>

            <div class="filter-grid">

                <div class="filter-field">

                    <label>
                        Job Vacancy
                    </label>

                    <select name="vacancyId"
                            class="report-control">

                        <option value="">
                            All Vacancies
                        </option>

                        @foreach (var vacancy in vacancies)
                        {
                            if (selectedVacancyId.HasValue &&
                            selectedVacancyId.Value == vacancy.Id)
                            {
                                <option value="@vacancy.Id"
                                        selected>
                                    @vacancy.JobTitle
                                </option>
                            }
                            else
                            {
                                <option value="@vacancy.Id">
                                    @vacancy.JobTitle
                                </option>
                            }
                        }

                    </select>

                </div>

                <div class="filter-field">

                    <label>
                        From Date
                    </label>

                    <input type="date"
                           name="fromDate"
                           value="@ViewBag.FromDate"
                           class="report-control" />

                </div>

                <div class="filter-field">

                    <label>
                        To Date
                    </label>

                    <input type="date"
                           name="toDate"
                           value="@ViewBag.ToDate"
                           class="report-control" />

                </div>

                <div class="filter-action">

                    <button type="submit"
                            class="run-report-btn">
                        Run Report
                    </button>

                </div>

            </div>

        </form>


        <!-- =====================================================
             REPORT SCOPE
             ===================================================== -->

        <div class="report-scope">

            <span>
                Report scope
            </span>

            <strong>
                @selectedVacancyTitle
            </strong>

            <small>
                @(string.IsNullOrWhiteSpace(fromDate)
                                ? "Beginning"
                                : fromDate)
                →
                @(string.IsNullOrWhiteSpace(toDate)
                                ? "Today"
                                : toDate)
            </small>

        </div>


        <!-- =====================================================
             EXECUTIVE SUMMARY
             ===================================================== -->

        <div class="report-section-heading">

            <span>
                EXECUTIVE SUMMARY
            </span>

            <h2>
                Key Recruitment Metrics
            </h2>

            <p>
                Only the main measures needed in a standard company recruitment report.
            </p>

        </div>

        <div class="summary-grid">

            <div class="summary-stat">

                <span>
                    Applications
                </span>

                <strong>
                    @ViewBag.TotalApplications
                </strong>

                <small>
                    Total received
                </small>

            </div>

            <div class="summary-stat">

                <span>
                    HR Reviewed
                </span>

                <strong>
                    @ViewBag.HRReviewed
                </strong>

                <small>
                    Reviewed by HR
                </small>

            </div>

            <div class="summary-stat">

                <span>
                    Sent to HM
                </span>

                <strong>
                    @ViewBag.Shortlisted
                </strong>

                <small>
                    Forwarded for decision
                </small>

            </div>

            <div class="summary-stat success">

                <span>
                    HM Approved
                </span>

                <strong>
                    @ViewBag.HMApproved
                </strong>

                <small>
                    Approved for interview
                </small>

            </div>

            <div class="summary-stat">

                <span>
                    Completed Interviews
                </span>

                <strong>
                    @ViewBag.CompletedInterviews
                </strong>

                <small>
                    Completed rounds
                </small>

            </div>

            <div class="summary-stat warning">

                <span>
                    Passed Rounds
                </span>

                <strong>
                    @ViewBag.PassedRounds
                </strong>

                <small>
                    Successful interview rounds
                </small>

            </div>

        </div>


        <!-- =====================================================
             RECRUITMENT FUNNEL
             ===================================================== -->

        <div class="report-section-heading">

            <span>
                PIPELINE ANALYSIS
            </span>

            <h2>
                Recruitment Funnel
            </h2>

        </div>

        <div class="dashboard-card">

            <div class="card-heading">

                <h3>
                    Candidate Progression
                </h3>

                <p>
                    Movement through the main recruitment stages.
                </p>

            </div>

            <div class="funnel-list">

                <div class="funnel-item">

                    <div class="funnel-info">
                        <span>Applications</span>
                        <strong>@ViewBag.TotalApplications</strong>
                    </div>

                    <div class="funnel-track">
                        <div class="funnel-fill"
                             style="width:100%">
                        </div>
                    </div>

                    <small>100%</small>

                </div>

                <div class="funnel-item">

                    <div class="funnel-info">
                        <span>HR Reviewed</span>
                        <strong>@ViewBag.HRReviewed</strong>
                    </div>

                    <div class="funnel-track">
                        <div class="funnel-fill"
                             style="width:@(ViewBag.HRReviewedPercent)%">
                        </div>
                    </div>

                    <small>
                        @ViewBag.HRReviewedPercent%
                    </small>

                </div>

                <div class="funnel-item">

                    <div class="funnel-info">
                        <span>Sent to HM</span>
                        <strong>@ViewBag.Shortlisted</strong>
                    </div>

                    <div class="funnel-track">
                        <div class="funnel-fill"
                             style="width:@(ViewBag.ShortlistedPercent)%">
                        </div>
                    </div>

                    <small>
                        @ViewBag.ShortlistedPercent%
                    </small>

                </div>

                <div class="funnel-item">

                    <div class="funnel-info">
                        <span>HM Approved</span>
                        <strong>@ViewBag.HMApproved</strong>
                    </div>

                    <div class="funnel-track">
                        <div class="funnel-fill"
                             style="width:@(ViewBag.HMApprovedPercent)%">
                        </div>
                    </div>

                    <small>
                        @ViewBag.HMApprovedPercent%
                    </small>

                </div>

                <div class="funnel-item">

                    <div class="funnel-info">
                        <span>Interviews</span>
                        <strong>@ViewBag.TotalInterviews</strong>
                    </div>

                    <div class="funnel-track">
                        <div class="funnel-fill"
                             style="width:@(Math.Min(100, (double)ViewBag.InterviewPercent))%">
                        </div>
                    </div>

                    <small>
                        @ViewBag.InterviewPercent%
                    </small>

                </div>

            </div>

        </div>


        <!-- =====================================================
             VACANCY PERFORMANCE
             ===================================================== -->

        <div class="report-section-heading">

            <span>
                VACANCY SUMMARY
            </span>

            <h2>
                Vacancy Performance
            </h2>

            <p>
                The essential vacancy-level figures needed for management review.
            </p>

        </div>

        <div class="dashboard-card table-card">

            <div class="table-card-header">

                <div>

                    <h3>
                        Recruitment Activity by Vacancy
                    </h3>

                    <p>
                        Applications, review progress, approvals and interview outcomes.
                    </p>

                </div>

                <div class="table-count">
                    @rows.Count vacancy(s)
                </div>

            </div>

            @if (!rows.Any())
            {
                <div class="report-empty">
                    No report data was found for the selected period.
                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="report-table">

                        <thead>
                            <tr>
                                <th>VACANCY</th>
                                <th>APPLICATIONS</th>
                                <th>HR REVIEWED</th>
                                <th>SENT TO HM</th>
                                <th>HM APPROVED</th>
                                <th>INTERVIEWS</th>
                                <th>PASSED</th>
                                <th>FAILED</th>
                                <th>STATUS</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var row in rows)
                            {
                                <tr>

                                    <td>
                                        <div class="vacancy-cell">

                                            <strong>
                                                @row.JobTitle
                                            </strong>

                                            <span>
                                                @row.Location
                                            </span>

                                            <small>
                                                @row.CreatedDate.ToString("dd MMM yyyy")
                                                →
                                                @row.ClosingDate.ToString("dd MMM yyyy")
                                            </small>

                                        </div>
                                    </td>

                                    <td>
                                        <strong>@row.Applications</strong>
                                    </td>

                                    <td>
                                        @row.HRReviewed
                                    </td>

                                    <td>
                                        @row.Shortlisted
                                    </td>

                                    <td>
                                        @row.HMApproved
                                    </td>

                                    <td>
                                        @row.Interviews
                                    </td>

                                    <td>
                                        <span class="result-number pass">
                                            @row.PassedRounds
                                        </span>
                                    </td>

                                    <td>
                                        <span class="result-number fail">
                                            @row.FailedRounds
                                        </span>
                                    </td>

                                    <td>
                                        @if (row.IsActive)
                                        {
                                            <span class="status-pill live">
                                                Live
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill archived">
                                                Archived
                                            </span>
                                        }
                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>


        <div class="pdf-standard-note">

            <strong>Standard PDF structure:</strong>
            Company/report title, reporting period and scope, executive summary,
            recruitment funnel, vacancy performance table, interview outcomes and
            report generation date. Extra dashboard-only cards are intentionally
            excluded from the PDF-style report.

        </div>

    </div>

</div>
