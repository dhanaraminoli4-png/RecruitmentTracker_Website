@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Recruitment Reports";

    var rows =
        Model?.ToList()
        ?? new List<dynamic>();


    var vacancies =
        ViewBag.Vacancies
        as IEnumerable<RecruitmentTracker.Models.JobVacancy>
        ?? Enumerable.Empty<RecruitmentTracker.Models.JobVacancy>();


    int? selectedVacancyId =
        ViewBag.SelectedVacancyId as int?;


    var selectedVacancyTitle =
        ViewBag.SelectedVacancyTitle
        ?? "All Vacancies";
}


<div class="report-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="report-header">

        <div>

            <div class="report-eyebrow">
                HR WORKSPACE · REPORTING
            </div>

            <h1>
                Recruitment Reports
            </h1>

            <p>
                Monitor recruitment performance from application
                screening through interviews and hiring manager decisions.
            </p>

        </div>


        <div class="report-header-actions">

            <a asp-controller="HRApplication"
               asp-action="ExportReportsPdf"
               asp-route-vacancyId="@ViewBag.SelectedVacancyId"
               asp-route-fromDate="@ViewBag.FromDate"
               asp-route-toDate="@ViewBag.ToDate"
               class="export-pdf-btn">

                Export PDF

            </a>


            <a asp-controller="HRApplication"
               asp-action="Management"
               class="report-back-btn">

                Application Management

            </a>

        </div>

    </div>



    <!-- =========================================================
         FILTERS
         ========================================================= -->

    <form method="get"
          asp-controller="HRApplication"
          asp-action="Reports"
          class="filter-panel">


        <div class="filter-heading">

            <div>

                <h3>
                    Report Filters
                </h3>

                <p>
                    Filter the recruitment report by vacancy
                    and application date range.
                </p>

            </div>


            <a asp-action="Reports"
               class="reset-btn">

                Reset

            </a>

        </div>



        <div class="filter-grid">


            <div class="filter-field">

                <label>
                    Job Vacancy
                </label>


                <select name="vacancyId"
                        class="report-control">

                    <option value="">
                        All Vacancies
                    </option>


                    @foreach (var vacancy in vacancies)
                    {
                        if (selectedVacancyId.HasValue &&
                        selectedVacancyId.Value ==
                        vacancy.Id)
                        {
                            <option value="@vacancy.Id"
                                    selected>

                                @vacancy.JobTitle

                            </option>
                        }
                        else
                        {
                            <option value="@vacancy.Id">

                                @vacancy.JobTitle

                            </option>
                        }
                    }

                </select>

            </div>



            <div class="filter-field">

                <label>
                    From Date
                </label>

                <input type="date"
                       name="fromDate"
                       value="@ViewBag.FromDate"
                       class="report-control" />

            </div>



            <div class="filter-field">

                <label>
                    To Date
                </label>

                <input type="date"
                       name="toDate"
                       value="@ViewBag.ToDate"
                       class="report-control" />

            </div>



            <div class="filter-action">

                <button type="submit"
                        class="run-report-btn">

                    Run Report

                </button>

            </div>


        </div>

    </form>



    <!-- =========================================================
         REPORT SCOPE
         ========================================================= -->

    <div class="report-scope">

        <span>
            Currently viewing
        </span>

        <strong>
            @selectedVacancyTitle
        </strong>

        @if (!string.IsNullOrWhiteSpace(
                ViewBag.FromDate as string) ||
                !string.IsNullOrWhiteSpace(
                ViewBag.ToDate as string))
        {
            <small>

                @(
                            string.IsNullOrWhiteSpace(
                            ViewBag.FromDate as string)
                            ? "Beginning"
                            : ViewBag.FromDate
                            )

                →

                @(
                            string.IsNullOrWhiteSpace(
                            ViewBag.ToDate as string)
                            ? "Today"
                            : ViewBag.ToDate
                            )

        </small>
                }

    </div>



    <!-- =========================================================
         APPLICATION KPI CARDS
         ========================================================= -->

    <div class="report-section-heading">

        <div>

            <span>
                APPLICATION PIPELINE
            </span>

            <h2>
                Recruitment Overview
            </h2>

        </div>

    </div>



    <div class="stats-grid">


        <div class="report-stat">

            <span>
                TOTAL APPLICATIONS
            </span>

            <strong>
                @ViewBag.TotalApplications
            </strong>

            <small>
                Received in selected period
            </small>

        </div>



        <div class="report-stat">

            <span>
                AI PASSED
            </span>

            <strong>
                @ViewBag.Passed
            </strong>

            <small>
                AI screening passed
            </small>

        </div>



        <div class="report-stat">

            <span>
                HR REVIEWED
            </span>

            <strong>
                @ViewBag.HRReviewed
            </strong>

            <small>
                Manually reviewed by HR
            </small>

        </div>



        <div class="report-stat">

            <span>
                SENT TO HM
            </span>

            <strong>
                @ViewBag.Shortlisted
            </strong>

            <small>
                Forwarded to Hiring Manager
            </small>

        </div>


    </div>



    <!-- =========================================================
         HM KPI CARDS
         ========================================================= -->

    <div class="report-section-heading spacing-top">

        <div>

            <span>
                HIRING MANAGER
            </span>

            <h2>
                Candidate Decisions
            </h2>

        </div>

    </div>



    <div class="stats-grid three">


        <div class="report-stat">

            <span>
                HM PENDING
            </span>

            <strong>
                @ViewBag.HMPending
            </strong>

            <small>
                Waiting for HM decision
            </small>

        </div>



        <div class="report-stat success-stat">

            <span>
                HM APPROVED
            </span>

            <strong>
                @ViewBag.HMApproved
            </strong>

            <small>
                Approved for interview
            </small>

        </div>



        <div class="report-stat danger-stat">

            <span>
                HM REJECTED
            </span>

            <strong>
                @ViewBag.HMRejected
            </strong>

            <small>
                Rejected by Hiring Manager
            </small>

        </div>


    </div>



    <!-- =========================================================
         INTERVIEW KPIs
         ========================================================= -->

    <div class="report-section-heading spacing-top">

        <div>

            <span>
                INTERVIEW PROCESS
            </span>

            <h2>
                Interview Performance
            </h2>

        </div>

    </div>



    <div class="stats-grid">


        <div class="report-stat">

            <span>
                TOTAL INTERVIEWS
            </span>

            <strong>
                @ViewBag.TotalInterviews
            </strong>

            <small>
                Interview rounds created
            </small>

        </div>



        <div class="report-stat">

            <span>
                COMPLETED
            </span>

            <strong>
                @ViewBag.CompletedInterviews
            </strong>

            <small>
                Completed interview rounds
            </small>

        </div>



        <div class="report-stat warning-stat">

            <span>
                PENDING DECISION
            </span>

            <strong>
                @ViewBag.PendingInterviewDecision
            </strong>

            <small>
                Awaiting HM decision
            </small>

        </div>



        <div class="report-stat">

            <span>
                FEEDBACK SUBMITTED
            </span>

            <strong>
                @ViewBag.FeedbackSubmitted
            </strong>

            <small>
                Interview feedback completed
            </small>

        </div>


    </div>



    <!-- =========================================================
         INTERVIEW RESULT CARDS
         ========================================================= -->

    <div class="result-grid">


        <div class="result-card passed">

            <div>

                <span>
                    PASSED ROUNDS
                </span>

                <strong>
                    @ViewBag.PassedRounds
                </strong>

            </div>

            <small>
                Candidates who passed interview rounds
            </small>

        </div>



        <div class="result-card failed">

            <div>

                <span>
                    FAILED ROUNDS
                </span>

                <strong>
                    @ViewBag.FailedRounds
                </strong>

            </div>

            <small>
                Candidates who failed interview rounds
            </small>

        </div>


    </div>



    <!-- =========================================================
         RECRUITMENT FUNNEL
         ========================================================= -->

    <div class="dashboard-card funnel-card">


        <div class="card-heading">

            <div>

                <span>
                    PIPELINE ANALYSIS
                </span>

                <h2>
                    Recruitment Funnel
                </h2>

                <p>
                    Candidate progression through the main
                    recruitment stages.
                </p>

            </div>

        </div>



        <div class="funnel-list">


            <div class="funnel-item">

                <div class="funnel-info">

                    <span>
                        Applications
                    </span>

                    <strong>
                        @ViewBag.TotalApplications
                    </strong>

                </div>

                <div class="funnel-track">

                    <div class="funnel-fill"
                         style="width:100%">
                    </div>

                </div>

                <small>
                    100%
                </small>

            </div>



            <div class="funnel-item">

                <div class="funnel-info">

                    <span>
                        HR Reviewed
                    </span>

                    <strong>
                        @ViewBag.HRReviewed
                    </strong>

                </div>

                <div class="funnel-track">

                    <div class="funnel-fill"
                         style="width:@(ViewBag.HRReviewedPercent)%">
                    </div>

                </div>

                <small>
                    @ViewBag.HRReviewedPercent%
                </small>

            </div>



            <div class="funnel-item">

                <div class="funnel-info">

                    <span>
                        Sent to HM
                    </span>

                    <strong>
                        @ViewBag.Shortlisted
                    </strong>

                </div>

                <div class="funnel-track">

                    <div class="funnel-fill"
                         style="width:@(ViewBag.ShortlistedPercent)%">
                    </div>

                </div>

                <small>
                    @ViewBag.ShortlistedPercent%
                </small>

            </div>



            <div class="funnel-item">

                <div class="funnel-info">

                    <span>
                        HM Approved
                    </span>

                    <strong>
                        @ViewBag.HMApproved
                    </strong>

                </div>

                <div class="funnel-track">

                    <div class="funnel-fill"
                         style="width:@(ViewBag.HMApprovedPercent)%">
                    </div>

                </div>

                <small>
                    @ViewBag.HMApprovedPercent%
                </small>

            </div>



            <div class="funnel-item">

                <div class="funnel-info">

                    <span>
                        Interviews
                    </span>

                    <strong>
                        @ViewBag.TotalInterviews
                    </strong>

                </div>

                <div class="funnel-track">

                    <div class="funnel-fill"
                         style="width:@(Math.Min(100, (double)ViewBag.InterviewPercent))%">
                    </div>

                </div>

                <small>
                    @ViewBag.InterviewPercent%
                </small>

            </div>


        </div>


    </div>



    <!-- =========================================================
         VACANCY PERFORMANCE
         ========================================================= -->

    <div class="dashboard-card">


        <div class="card-heading">

            <div>

                <span>
                    VACANCY ANALYSIS
                </span>

                <h2>
                    Vacancy Performance
                </h2>

                <p>
                    Recruitment activity and interview outcomes
                    for each vacancy.
                </p>

            </div>


            <div class="table-count">

                @rows.Count vacancy(s)

            </div>

        </div>



        @if (!rows.Any())
        {
            <div class="report-empty">

                <h3>
                    No report data
                </h3>

                <p>
                    No applications were found for the selected
                    reporting period or vacancy.
                </p>

            </div>
        }
        else
        {
            <div class="table-responsive">

                <table class="report-table">


                    <thead>

                        <tr>

                            <th>
                                VACANCY
                            </th>

                            <th>
                                APPLICATIONS
                            </th>

                            <th>
                                AI PASSED
                            </th>

                            <th>
                                HR REVIEWED
                            </th>

                            <th>
                                SENT TO HM
                            </th>

                            <th>
                                HM APPROVED
                            </th>

                            <th>
                                INTERVIEWS
                            </th>

                            <th>
                                PASSED
                            </th>

                            <th>
                                FAILED
                            </th>

                            <th>
                                STATUS
                            </th>

                        </tr>

                    </thead>



                    <tbody>


                        @foreach (var row in rows)
                        {
                            <tr>


                                <td>

                                    <div class="vacancy-cell">

                                        <strong>
                                            @row.JobTitle
                                        </strong>

                                        <span>
                                            @row.Location
                                        </span>

                                        <small>

                                            @row.CreatedDate
                                            .ToString("dd MMM yyyy")

                                            →

                                            @row.ClosingDate
                                            .ToString("dd MMM yyyy")

                                        </small>

                                    </div>

                                </td>



                                <td>
                                    <strong>
                                        @row.Applications
                                    </strong>
                                </td>


                                <td>
                                    @row.Passed
                                </td>


                                <td>
                                    @row.HRReviewed
                                </td>


                                <td>
                                    @row.Shortlisted
                                </td>


                                <td>
                                    @row.HMApproved
                                </td>


                                <td>
                                    @row.Interviews
                                </td>


                                <td>

                                    <span class="result-number pass">

                                        @row.PassedRounds

                                    </span>

                                </td>


                                <td>

                                    <span class="result-number fail">

                                        @row.FailedRounds

                                    </span>

                                </td>


                                <td>

                                    @if (row.IsActive)
                                    {
                                        <span class="status-pill live">

                                            Live

                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill archived">

                                            Archived

                                        </span>
                                    }

                                </td>


                            </tr>
                        }


                    </tbody>


                </table>

            </div>
        }


    </div>


</div>



<style>

    /* =========================================================
               PAGE
               ========================================================= */

    .report-page {
        max-width: 1400px;
        margin: 0 auto;
        padding: 32px;
        color: #172033;
    }


    .report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }


    .report-eyebrow,
    .report-section-heading span,
    .card-heading > div > span {
        display: block;
        font-size: 9px;
        font-weight: 750;
        letter-spacing: .09em;
        color: #98a2b3;
        margin-bottom: 6px;
    }


    .report-header h1 {
        margin: 0;
        color: #101828;
        font-size: 30px;
        font-weight: 750;
    }


    .report-header p {
        max-width: 670px;
        margin: 7px 0 0;
        color: #7b8495;
        font-size: 12px;
        line-height: 1.6;
    }


    .report-back-btn {
        border: 1px solid #d8dee8;
        background: white;
        color: #475467;
        padding: 10px 14px;
        border-radius: 9px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 650;
    }

    .report-header-actions {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    .export-pdf-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 39px;
        padding: 9px 15px;
        border-radius: 9px;
        background: #111827;
        color: white;
        text-decoration: none;
        font-size: 11px;
        font-weight: 650;
        border: 1px solid #111827;
        transition: all .2s ease;
    }


        .export-pdf-btn:hover {
            background: #1f2937;
            border-color: #1f2937;
            color: white;
        }




    /* =========================================================
               FILTERS
               ========================================================= */

    .filter-panel {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 14px;
        padding: 19px 21px;
        margin-bottom: 16px;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }


    .filter-heading {
        display: flex;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
    }


        .filter-heading h3 {
            margin: 0;
            color: #101828;
            font-size: 14px;
        }


        .filter-heading p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: 10px;
        }


    .reset-btn {
        text-decoration: none;
        color: #667085;
        font-size: 10px;
        font-weight: 650;
    }


    .filter-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr 1fr .8fr;
        gap: 13px;
        align-items: end;
    }


    .filter-field label {
        display: block;
        margin-bottom: 6px;
        color: #475467;
        font-size: 10px;
        font-weight: 650;
    }


    .report-control {
        width: 100%;
        height: 41px;
        box-sizing: border-box;
        border: 1px solid #d0d5dd;
        border-radius: 8px;
        background: white;
        padding: 0 11px;
        color: #344054;
        font-size: 11px;
        outline: none;
    }


    .run-report-btn {
        width: 100%;
        height: 41px;
        border: 0;
        border-radius: 8px;
        background: #111827;
        color: white;
        cursor: pointer;
        font-size: 11px;
        font-weight: 650;
    }


    .report-scope {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 25px;
        padding: 9px 12px;
        border-radius: 8px;
        background: #f8fafc;
        color: #667085;
        font-size: 10px;
    }


        .report-scope strong {
            color: #344054;
        }


        .report-scope small {
            margin-left: auto;
            color: #98a2b3;
        }



    /* =========================================================
               SECTION
               ========================================================= */

    .report-section-heading {
        margin-bottom: 12px;
    }


        .report-section-heading h2 {
            margin: 0;
            color: #101828;
            font-size: 17px;
        }


    .spacing-top {
        margin-top: 28px;
    }



    /* =========================================================
               STAT CARDS
               ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 13px;
    }


        .stats-grid.three {
            grid-template-columns: repeat(3, minmax(0,1fr));
        }


    .report-stat {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 13px;
        padding: 17px 18px;
    }


        .report-stat > span {
            display: block;
            color: #98a2b3;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .04em;
        }


        .report-stat strong {
            display: block;
            margin-top: 5px;
            color: #101828;
            font-size: 25px;
        }


        .report-stat small {
            display: block;
            margin-top: 3px;
            color: #98a2b3;
            font-size: 9px;
        }


    .success-stat {
        border-bottom: 3px solid #12b76a;
    }


    .danger-stat {
        border-bottom: 3px solid #f04438;
    }


    .warning-stat {
        border-bottom: 3px solid #f79009;
    }



    /* =========================================================
               RESULTS
               ========================================================= */

    .result-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
        margin-top: 13px;
    }


    .result-card {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 13px;
        padding: 16px 18px;
    }


        .result-card > div {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }


        .result-card span {
            font-size: 9px;
            color: #667085;
            font-weight: 700;
        }


        .result-card strong {
            font-size: 24px;
        }


        .result-card small {
            display: block;
            color: #98a2b3;
            font-size: 9px;
            margin-top: 5px;
        }


        .result-card.passed strong {
            color: #067647;
        }


        .result-card.failed strong {
            color: #b42318;
        }



    /* =========================================================
               DASHBOARD CARDS
               ========================================================= */

    .dashboard-card {
        margin-top: 27px;
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }


    .card-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f3;
    }


        .card-heading h2 {
            margin: 0;
            color: #101828;
            font-size: 15px;
        }


        .card-heading p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: 10px;
        }


    .table-count {
        color: #667085;
        font-size: 10px;
    }



    /* =========================================================
               FUNNEL
               ========================================================= */

    .funnel-list {
        padding: 20px;
    }


    .funnel-item {
        display: grid;
        grid-template-columns: 145px 1fr 55px;
        gap: 14px;
        align-items: center;
        margin-bottom: 16px;
    }


        .funnel-item:last-child {
            margin-bottom: 0;
        }


    .funnel-info {
        display: flex;
        justify-content: space-between;
        gap: 8px;
        font-size: 10px;
    }


        .funnel-info span {
            color: #667085;
        }


        .funnel-info strong {
            color: #344054;
        }


    .funnel-track {
        height: 9px;
        background: #f2f4f7;
        border-radius: 999px;
        overflow: hidden;
    }


    .funnel-fill {
        height: 100%;
        border-radius: inherit;
        background: #344054;
    }


    .funnel-item > small {
        text-align: right;
        color: #98a2b3;
        font-size: 9px;
    }



    /* =========================================================
               TABLE
               ========================================================= */

    .report-table {
        width: 100%;
        border-collapse: collapse;
    }


        .report-table th {
            padding: 12px 13px;
            background: #f8fafc;
            color: #667085;
            font-size: 8px;
            letter-spacing: .04em;
            white-space: nowrap;
            border-bottom: 1px solid #e4e7ec;
        }


        .report-table td {
            padding: 14px 13px;
            color: #475467;
            font-size: 10px;
            border-bottom: 1px solid #edf0f3;
            vertical-align: middle;
        }


        .report-table tbody tr:last-child td {
            border-bottom: none;
        }


    .vacancy-cell strong {
        display: block;
        color: #101828;
        font-size: 11px;
    }


    .vacancy-cell span {
        display: block;
        margin-top: 3px;
        color: #667085;
        font-size: 9px;
    }


    .vacancy-cell small {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 8px;
    }


    .result-number {
        font-weight: 700;
    }


        .result-number.pass {
            color: #067647;
        }


        .result-number.fail {
            color: #b42318;
        }


    .status-pill {
        padding: 5px 8px;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 700;
    }


        .status-pill.live {
