@model IEnumerable<dynamic>
@{ ViewData["Title"] = "Recruitment Reports"; }
<div class="page-heading"><div><div class="section-label">HR WORKSPACE · REPORTING</div><h1>Recruitment reports</h1><p>Review historical vacancy activity and application outcomes by date range.</p></div><a asp-action="Management" class="btn btn-outline-primary">Application management</a></div>
<form method="get" asp-action="Reports" class="filter-panel mb-4"><div class="filter-title"><div><strong>Reporting period</strong><span>Use this to answer questions such as “what openings were active last month?”</span></div><a asp-action="Reports" class="btn btn-sm btn-light">Reset</a></div><div class="row g-3 align-items-end"><div class="col-md-4"><label class="form-label">From date</label><input type="date" name="fromDate" value="@ViewBag.FromDate" class="form-control" /></div><div class="col-md-4"><label class="form-label">To date</label><input type="date" name="toDate" value="@ViewBag.ToDate" class="form-control" /></div><div class="col-md-4"><button type="submit" class="btn btn-primary w-100">Run report</button></div></div></form>
<div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><div class="stat-label">APPLICATIONS</div><div class="stat-value">@ViewBag.TotalApplications</div><span class="stat-foot">In selected period</span></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">AI PASSED</div><div class="stat-value">@ViewBag.Passed</div><span class="stat-foot">70% or above</span></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">HR REVIEWED</div><div class="stat-value">@ViewBag.HRReviewed</div><span class="stat-foot">Manually reviewed</span></div></div><div class="col-md-3"><div class="stat-card"><div class="stat-label">SHORTLISTED</div><div class="stat-value">@ViewBag.Shortlisted</div><span class="stat-foot">Forwarded to HM</span></div></div></div>
<div class="table-wrap"><div class="table-toolbar"><div><strong>Vacancy performance</strong><span>Vacancies with applications in the selected period.</span></div></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Vacancy</th><th>Posted</th><th>Closing</th><th>Applications</th><th>AI passed</th><th>HR reviewed</th><th>Shortlisted</th><th>Status</th></tr></thead><tbody>
@foreach (var row in Model)
{
    <tr><td><strong>@row.JobTitle</strong><div class="text-muted small">@row.Location</div></td><td>@row.CreatedDate.ToString("dd MMM yyyy")</td><td>@row.ClosingDate.ToString("dd MMM yyyy")</td><td><strong>@row.Applications</strong></td><td>@row.Passed</td><td>@row.HRReviewed</td><td>@row.Shortlisted</td><td><span class="badge @(row.IsActive ? "status-shortlisted" : "status-applied")">@(row.IsActive ? "Live" : "Archived")</span></td></tr>
}
</tbody></table></div></div>
