@model RecruitmentTracker.Models.JobVacancy

@{
    ViewData["Title"] = "Create Vacancy";
}

<style>

    .create-vacancy-page {
        max-width: 900px;
        margin: 0 auto;
        padding: 35px 30px 70px;
    }

    .create-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .create-header-content {
        min-width: 0;
    }

    .section-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1px;
        color: #75809a;
        margin-bottom: 8px;
        text-transform: uppercase;
    }

    .create-header h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #252b36;
    }

    .create-header p {
        margin: 8px 0 0;
        color: #8b929e;
        font-size: 13px;
        line-height: 1.6;
    }

    .form-section {
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 18px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(30, 41, 59, 0.035);
    }

    .form-section-header {
        padding: 20px 24px 17px;
        border-bottom: 1px solid #eef0f3;
    }

        .form-section-header h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: #2d333d;
        }

        .form-section-header p {
            margin: 5px 0 0;
            font-size: 10px;
            color: #969da7;
        }

    .form-section-body {
        padding: 24px;
    }

    .form-group {
        margin-bottom: 21px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

    .form-label {
        display: block;
        margin-bottom: 7px;
        font-size: 11px;
        font-weight: 600;
        color: #3c434e;
    }

    .required-mark {
        color: #e05252;
        margin-left: 2px;
    }

    .form-control,
    .form-select {
        width: 100%;
        min-height: 44px;
        border: 1px solid #dfe3e8;
        border-radius: 10px;
        font-size: 12px;
        color: #303640;
        padding: 10px 13px;
        box-shadow: none;
        box-sizing: border-box;
    }

        .form-control::placeholder {
            color: #adb3bc;
        }

        .form-control:focus,
        .form-select:focus {
            border-color: #0b1f3a;
            box-shadow: 0 0 0 3px rgba(11, 31, 58, 0.08);
            outline: none;
        }

    textarea.form-control {
        min-height: 145px;
        resize: vertical;
        line-height: 1.6;
    }

    .short-textarea {
        min-height: 120px !important;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .field-help {
        margin-top: 6px;
        font-size: 9px;
        line-height: 1.5;
        color: #9ba2ad;
    }

    .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 9px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        background: #ffffff;
        border: 1px solid #e4e7ec;
        border-radius: 16px;
        padding: 16px 20px;
        box-shadow: 0 4px 15px rgba(30, 41, 59, 0.035);
    }

    .cancel-button,
    .publish-button {
        min-height: 42px;
        padding: 9px 19px;
        border-radius: 9px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none;
        border: none;
    }

    .cancel-button {
        color: #68717e;
        background: #f4f5f7;
    }

        .cancel-button:hover {
            color: #424a55;
            background: #eaecf0;
        }

    .publish-button {
        color: #ffffff;
        background: #0b1f3a;
    }

        .publish-button:hover {
            background: #142d4c;
            color: #ffffff;
        }

    @@media (max-width: 700px) {

        .create-vacancy-page {
            padding: 25px 18px 50px;
        }

        .create-header {
            flex-direction: column;
        }

        .field-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .form-section-body {
            padding: 20px;
        }

        .form-actions {
            justify-content: stretch;
            flex-direction: column-reverse;
        }

        .cancel-button,
        .publish-button {
            width: 100%;
            text-align: center;
        }
    }

    /* =========================================================
       COVER LETTER OPTION
       ========================================================= */

    .cover-letter-option {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 16px 18px;
        border: 1px solid #e1e5eb;
        border-radius: 12px;
        background: #fafbfc;
    }

    .cover-letter-info {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .cover-letter-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: #edf2f7;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 17px;
    }

    .cover-letter-title {
        color: #2d333d;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .cover-letter-description {
        color: #8b929e;
        font-size: 10px;
    }

    .cover-letter-help {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-top: 10px;
        padding-left: 2px;
    }

        .cover-letter-help strong {
            color: #526174;
            font-size: 9px;
            font-weight: 700;
        }

        .cover-letter-help span {
            color: #9ba2ad;
            font-size: 9px;
        }


    /* =========================================================
       TOGGLE SWITCH
       ========================================================= */

    .switch {
        position: relative;
        display: inline-block;
        width: 43px;
        height: 24px;
        flex-shrink: 0;
        margin: 0;
    }

        .switch input {
            opacity: 0;
            width: 0;
            height: 0;
        }

    .slider {
        position: absolute;
        cursor: pointer;
        inset: 0;
        background: #d8dee7;
        border-radius: 30px;
        transition: .2s ease;
    }

        .slider:before {
            content: "";
            position: absolute;
            width: 18px;
            height: 18px;
            left: 3px;
            top: 3px;
            background: white;
            border-radius: 50%;
            box-shadow: 0 1px 3px rgba(0,0,0,.15);
            transition: .2s ease;
        }

    .switch input:checked + .slider {
        background: #0b1f3a;
    }

        .switch input:checked + .slider:before {
            transform: translateX(19px);
        }
</style>


<div class="create-vacancy-page">

    <!-- HEADER -->

    <div class="create-header">

        <div class="create-header-content">

            <div class="section-label">
                HR WORKSPACE · VACANCIES
            </div>

            <h1>
                Create a vacancy
            </h1>

            <p>
                Add the details candidates need to understand
                the role and apply confidently.
            </p>

        </div>

        <a asp-action="Index"
           class="btn btn-outline-primary">

            ← Back to vacancies

        </a>

    </div>


    <!-- IMPORTANT: FORM STARTS HERE -->

    <form asp-action="Create"
          method="post">

        <!-- ROLE INFORMATION -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Role Information
                </h3>

                <p>
                    Basic information about the position.
                </p>

            </div>

            <div class="form-section-body">

                <!-- JOB TITLE -->

                <div class="form-group">

                    <label asp-for="JobTitle"
                           class="form-label">

                        Job Title
                        <span class="required-mark">*</span>

                    </label>

                    <input asp-for="JobTitle"
                           class="form-control"
                           placeholder="e.g. Cybersecurity Analyst" />

                    <span asp-validation-for="JobTitle"
                          class="text-danger">
                    </span>

                </div>


                <!-- DEPARTMENT -->

                <div class="form-group">

                    <label asp-for="Department"
                           class="form-label">

                        Department

                    </label>

                    <select asp-for="Department"
                            class="form-select">

                        <option value="">
                            Select department
                        </option>

                        <option value="Information Technology">
                            Information Technology
                        </option>

                        <option value="Human Resources">
                            Human Resources
                        </option>

                        <option value="Finance">
                            Finance
                        </option>

                        <option value="Marketing">
                            Marketing
                        </option>

                        <option value="Sales">
                            Sales
                        </option>

                        <option value="Operations">
                            Operations
                        </option>

                        <option value="Data & Analytics">
                            Data & Analytics
                        </option>

                        <option value="Administration">
                            Administration
                        </option>

                        <option value="Other">
                            Other
                        </option>

                    </select>

                    <div class="field-help">
                        Select the department responsible for this position.
                    </div>

                </div>

            </div>

        </div>


        <!-- WORK DETAILS -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Work Details
                </h3>

                <p>
                    Tell candidates where and how they will work.
                </p>

            </div>

            <div class="form-section-body">

                <div class="field-row">

                    <!-- LOCATION -->

                    <div class="form-group">

                        <label asp-for="Location"
                               class="form-label">

                            Location
                            <span class="required-mark">*</span>

                        </label>

                        <input asp-for="Location"
                               class="form-control"
                               placeholder="e.g. Colombo" />

                        <span asp-validation-for="Location"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- EMPLOYMENT TYPE -->

                    <div class="form-group">

                        <label asp-for="EmploymentType"
                               class="form-label">

                            Employment Type
                            <span class="required-mark">*</span>

                        </label>

                        <select asp-for="EmploymentType"
                                class="form-select">

                            <option value="">
                                Select employment type
                            </option>

                            <option value="Full-Time">
                                Full-Time
                            </option>

                            <option value="Part-Time">
                                Part-Time
                            </option>

                            <option value="Contract">
                                Contract
                            </option>

                            <option value="Internship">
                                Internship
                            </option>

                        </select>

                        <span asp-validation-for="EmploymentType"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <div class="field-row">

                    <!-- SALARY -->

                    <div class="form-group">

                        <label asp-for="Salary"
                               class="form-label">

                            Salary / Budget

                        </label>

                        <input asp-for="Salary"
                               class="form-control"
                               type="number"
                               step="10000"
                               min="0"
                               placeholder="e.g. 150000" />

                        <div class="field-help">
                            Optional. Enter the monthly salary or budget.
                        </div>

                        <span asp-validation-for="Salary"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CLOSING DATE -->

                    <div class="form-group">

                        <label asp-for="ClosingDate"
                               class="form-label">

                            Application Closing Date
                            <span class="required-mark">*</span>

                        </label>

                        <input asp-for="ClosingDate"
                               class="form-control"
                               type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" />

                        <span asp-validation-for="ClosingDate"
                              class="text-danger">
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- JOB DESCRIPTION -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Job Description
                </h3>

                <p>
                    Give candidates a clear understanding of the role.
                </p>

            </div>

            <div class="form-section-body">

                <div class="form-group">

                    <label asp-for="Description"
                           class="form-label">

                        Description
                        <span class="required-mark">*</span>

                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="7"
                              placeholder="Describe the position, team, purpose of the role and what the successful candidate will do..."></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>


        <!-- RESPONSIBILITIES -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Responsibilities
                </h3>

                <p>
                    Describe the main responsibilities of the successful candidate.
                </p>

            </div>

            <div class="form-section-body">

                <div class="form-group">

                    <label asp-for="Responsibilities"
                           class="form-label">

                        Key Responsibilities

                    </label>

                    <textarea asp-for="Responsibilities"
                              class="form-control"
                              rows="7"
                              placeholder="• Monitor networks and security alerts
• Investigate cybersecurity incidents
• Conduct vulnerability assessments
• Maintain security reports
• Assist with security audits
• Work with IT teams to resolve vulnerabilities"></textarea>

                    <div class="field-help">
                        Add each major responsibility on a separate line.
                    </div>

                </div>

            </div>

        </div>


        <!-- REQUIREMENTS -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Candidate Requirements
                </h3>

                <p>
                    Separate essential requirements from preferred skills.
                </p>

            </div>

            <div class="form-section-body">

                <!-- REQUIRED -->

                <div class="form-group">

                    <label asp-for="Requirements"
                           class="form-label">

                        Required Qualifications & Skills
                        <span class="required-mark">*</span>

                    </label>

                    <textarea asp-for="Requirements"
                              class="form-control"
                              rows="7"
                              placeholder="• Bachelor's degree in Cybersecurity, IT or related field
• Knowledge of networking and security principles
• Understanding of cybersecurity threats
• Knowledge of security controls
• Strong analytical and problem-solving skills"></textarea>

                    <div class="field-help">
                        Add the qualifications and skills a candidate must have.
                    </div>

                    <span asp-validation-for="Requirements"
                          class="text-danger">
                    </span>

                </div>


                <!-- PREFERRED -->

                <div class="form-group">

                    <label asp-for="PreferredRequirements"
                           class="form-label">

                        Preferred Qualifications & Skills

                    </label>

                    <textarea asp-for="PreferredRequirements"
                              class="form-control short-textarea"
                              rows="5"
                              placeholder="• Experience with SIEM tools
• Knowledge of penetration testing
• Familiarity with Wireshark or Nmap
• Security+ or CEH certification
• Previous cybersecurity experience"></textarea>

                    <div class="field-help">
                        Optional skills or experience that would be an advantage.
                    </div>

                </div>

            </div>

        </div>

        <!-- COVER LETTER -->

        <div class="form-section">

            <div class="form-section-header">

                <h3>
                    Application Documents
                </h3>

                <p>
                    Choose which documents candidates need to provide.
                </p>

            </div>

            <div class="form-section-body">

                <div class="cover-letter-option">

                    <div class="cover-letter-info">

                        <div class="cover-letter-icon">
                            📄
                        </div>

                        <div>

                            <div class="cover-letter-title">
                                Cover Letter
                            </div>

                            <div class="cover-letter-description">
                                Allow candidates to upload a cover letter with their application.
                            </div>

                        </div>

                    </div>


                    <label class="switch">

                        <input asp-for="RequiresCoverLetter"
                               type="checkbox" />

                        <span class="slider"></span>

                    </label>

                </div>


                <div class="cover-letter-help">

                    <strong>Optional setting</strong>

                    <span>
                        When enabled, candidates will be required to upload a cover letter
                        when applying for this vacancy.
                    </span>

                </div>

            </div>

        </div>


        <!-- ACTIONS -->

        <div class="form-actions">

            <a asp-action="Index"
               class="cancel-button">

                Cancel

            </a>

            <button type="submit"
                    class="publish-button">

                Publish Vacancy

            </button>

        </div>



        <!-- IMPORTANT: FORM ENDS HERE -->



    </form>

  

    

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}