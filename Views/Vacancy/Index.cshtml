@model IEnumerable<RecruitmentTracker.Models.JobVacancy>

@{
    ViewData["Title"] = "Job Postings";

    var counts = ViewBag.ApplicationCounts as IDictionary<int, int>
                 ?? new Dictionary<int, int>();

    var status = ViewBag.Status as string ?? "active";

    var totalCount = ViewBag.TotalCount ?? 0;
    var liveCount = ViewBag.LiveCount ?? 0;
    var archivedCount = ViewBag.ArchivedCount ?? 0;
}

<style>
    /* =========================================================
           PAGE
        ========================================================= */

    .jobs-page {
        min-height: calc(100vh - 70px);
        padding: 32px;
        background: radial-gradient(circle at 0% 0%, rgba(122, 190, 255, .18), transparent 28%), radial-gradient(circle at 100% 100%, rgba(84, 162, 255, .13), transparent 25%), #edf6ff;
        font-family: "Inter", "Segoe UI", sans-serif;
        color: #243b53;
    }

    .jobs-shell {
        max-width: 1500px;
        margin: 0 auto;
        background: rgba(255, 255, 255, .84);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, .9);
        border-radius: 28px;
        box-shadow: 0 18px 55px rgba(61, 120, 180, .10);
        padding: 28px;
    }


    /* =========================================================
           TOP HEADER
        ========================================================= */

    .jobs-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-bottom: 25px;
    }

    .jobs-title-area {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .jobs-title-icon {
        width: 56px;
        height: 56px;
        border-radius: 17px;
        background: linear-gradient(145deg, #4aa4ff, #2387f3);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 12px 28px rgba(43, 145, 246, .22);
    }

        .jobs-title-icon svg {
            width: 26px;
            height: 26px;
        }

    .jobs-eyebrow {
        font-size: 11px;
        letter-spacing: 1.3px;
        font-weight: 800;
        color: #4f9ee8;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .jobs-title-area h1 {
        margin: 0;
        color: #17324d;
        font-size: 30px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .jobs-title-area p {
        margin: 6px 0 0;
        color: #8ca0b4;
        font-size: 13px;
    }


    /* =========================================================
           CREATE BUTTON
        ========================================================= */

    .create-job-btn {
        height: 48px;
        padding: 0 20px;
        border: none;
        border-radius: 14px;
        background: linear-gradient(135deg, #4da6ff, #2688ed);
        color: white;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 10px 24px rgba(38, 136, 237, .22);
        transition: .2s ease;
        white-space: nowrap;
    }

        .create-job-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 14px 30px rgba(38, 136, 237, .28);
        }

        .create-job-btn svg {
            width: 18px;
            height: 18px;
        }


    /* =========================================================
           STAT CARDS
        ========================================================= */

    .jobs-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }

    .job-stat-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 20px;
        border: 1px solid #edf4fb;
        box-shadow: 0 8px 25px rgba(73, 117, 157, .06);
        display: flex;
        align-items: center;
        gap: 16px;
        transition: .2s ease;
    }

        .job-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(73, 117, 157, .10);
        }

    .stat-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .stat-icon svg {
            width: 22px;
            height: 22px;
        }

    .stat-blue {
        color: #308ee9;
        background: #eaf5ff;
    }

    .stat-green {
        color: #27a577;
        background: #eaf9f3;
    }

    .stat-grey {
        color: #748ca4;
        background: #f0f4f8;
    }

    .stat-data span {
        color: #91a4b7;
        font-size: 11px;
        font-weight: 600;
    }

    .stat-data strong {
        display: block;
        margin-top: 3px;
        color: #1d3853;
        font-size: 24px;
        line-height: 1;
        font-weight: 800;
    }


    /* =========================================================
           TOOLBAR
        ========================================================= */

    .jobs-toolbar {
        background: white;
        border: 1px solid #edf3f8;
        border-radius: 18px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        box-shadow: 0 8px 25px rgba(72, 118, 158, .05);
    }

    .search-form {
        display: flex;
        gap: 10px;
        flex: 1;
    }

    .search-box {
        position: relative;
        flex: 1;
    }

        .search-box svg {
            position: absolute;
            width: 17px;
            height: 17px;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9aafc3;
        }

        .search-box input {
            width: 100%;
            height: 44px;
            border: 1px solid #e4edf5;
            background: #f9fcff;
            border-radius: 13px;
            padding: 0 15px 0 43px;
            color: #314a61;
            font-size: 13px;
            outline: none;
            transition: .2s;
        }

            .search-box input::placeholder {
                color: #a0b1c1;
            }

            .search-box input:focus {
                background: #fff;
                border-color: #62aff5;
                box-shadow: 0 0 0 4px rgba(69, 157, 239, .10);
            }

    .search-btn,
    .filter-btn {
        height: 44px;
        padding: 0 17px;
        border-radius: 13px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s;
    }

    .search-btn {
        border: 0;
        background: #3d98ef;
        color: white;
    }

        .search-btn:hover {
            background: #2587e5;
        }

    .filter-btn {
        border: 1px solid #e1ebf4;
        background: #fff;
        color: #5d748a;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

        .filter-btn svg {
            width: 15px;
            height: 15px;
        }

        .filter-btn:hover {
            background: #f4f9fe;
            border-color: #9bcaf4;
            color: #318ddd;
        }


    /* =========================================================
           TABS
        ========================================================= */

    .jobs-tabs {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px;
        width: fit-content;
        border-radius: 14px;
        background: #edf5fc;
        margin-bottom: 18px;
    }

    .job-tab {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 15px;
        border-radius: 10px;
        text-decoration: none;
        color: #7890a6;
        font-size: 12px;
        font-weight: 700;
        transition: .2s ease;
    }

        .job-tab:hover {
            color: #358edc;
        }

        .job-tab strong {
            min-width: 22px;
            height: 22px;
            padding: 0 6px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: rgba(255,255,255,.7);
            font-size: 10px;
        }

        .job-tab.active {
            background: white;
            color: #318de2;
            box-shadow: 0 3px 12px rgba(52, 132, 202, .10);
        }


    /* =========================================================
           FILTER BOX
        ========================================================= */

    .filter-panel {
        display: none;
        background: white;
        border: 1px solid #eaf1f7;
        border-radius: 18px;
        padding: 19px;
        margin-bottom: 18px;
        box-shadow: 0 8px 28px rgba(70, 110, 145, .06);
    }

        .filter-panel.show {
            display: block;
        }

    .filter-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
    }

        .filter-header strong {
            color: #203e59;
            font-size: 14px;
        }

        .filter-header p {
            margin: 3px 0 0;
            color: #9aabba;
            font-size: 11px;
        }

    .filter-grid {
        display: flex;
        align-items: end;
        gap: 12px;
    }

    .filter-field {
        width: 210px;
    }

        .filter-field label {
            display: block;
            color: #698096;
            font-size: 11px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .filter-field input {
            width: 100%;
            height: 40px;
            border: 1px solid #e1ebf3;
            border-radius: 11px;
            padding: 0 11px;
            color: #435d73;
            font-size: 12px;
            outline: none;
            background: #fbfdff;
        }

            .filter-field input:focus {
                border-color: #63adf0;
            }

    .apply-filter-btn {
        height: 40px;
        border: 0;
        border-radius: 11px;
        padding: 0 16px;
        background: #3e98ef;
        color: white;
        font-size: 11px;
        font-weight: 700;
    }

    .reset-filter {
        height: 40px;
        display: inline-flex;
        align-items: center;
        padding: 0 15px;
        border-radius: 11px;
        border: 1px solid #e2ebf3;
        color: #74889a;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
        background: white;
    }


    /* =========================================================
           TABLE CARD
        ========================================================= */

    .jobs-card {
        background: white;
        border: 1px solid #edf3f8;
        border-radius: 21px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(72, 112, 149, .06);
    }

    .jobs-card-header {
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #edf2f6;
    }

        .jobs-card-header h3 {
            margin: 0;
            color: #203b55;
            font-size: 16px;
            font-weight: 800;
        }

        .jobs-card-header p {
            margin: 4px 0 0;
            color: #9aabba;
            font-size: 11px;
        }

    .table-wrap {
        width: 100%;
        overflow-x: auto;
    }

    .jobs-table {
        width: 100%;
        min-width: 1100px;
        border-collapse: collapse;
    }

        .jobs-table thead {
            background: #f7fbfe;
        }

        .jobs-table th {
            padding: 13px 16px;
            color: #8196aa;
            text-transform: uppercase;
            font-size: 9px;
            letter-spacing: .8px;
            font-weight: 800;
            text-align: left;
            border-bottom: 1px solid #edf3f8;
            white-space: nowrap;
        }

        .jobs-table td {
            padding: 15px 16px;
            border-bottom: 1px solid #f0f4f7;
            color: #5d7488;
            font-size: 12px;
            vertical-align: middle;
        }

        .jobs-table tbody tr {
            transition: .15s ease;
        }

            .jobs-table tbody tr:hover {
                background: #fbfdff;
            }

            .jobs-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================================================
           JOB CELL
        ========================================================= */

    .job-cell {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 235px;
    }

    .job-avatar {
        width: 41px;
        height: 41px;
        border-radius: 13px;
        background: linear-gradient(145deg, #e9f5ff, #dceeff);
        color: #348fe3;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 800;
        flex-shrink: 0;
    }

    .job-cell strong {
        display: block;
        color: #25405a;
        font-size: 12.5px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .job-cell small {
        color: #9cafbf;
        font-size: 9.5px;
    }

    .row-number {
        color: #a4b4c3;
        font-weight: 700;
    }

    .salary {
        color: #2b4660;
        font-weight: 700;
    }

    .applications-link {
        color: #328fe5;
        font-weight: 700;
        text-decoration: none;
    }

        .applications-link:hover {
            text-decoration: underline;
        }


    /* =========================================================
           BADGES
        ========================================================= */

    .type-pill {
        display: inline-flex;
        padding: 6px 10px;
        border-radius: 20px;
        background: #eff6fc;
        color: #607e98;
        font-size: 10px;
        font-weight: 700;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

        .status-pill::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-live {
        background: #e9f9f1;
        color: #2ba276;
    }

    .status-closed {
        background: #f0f3f6;
        color: #788a9a;
    }

    .deadline strong {
        display: block;
        color: #526b80;
        font-size: 11px;
    }

    .deadline small {
        color: #9badbd;
        font-size: 9px;
    }

    .deadline .expired {
        color: #df6a73;
    }


    /* =========================================================
           ACTIONS
        ========================================================= */

    .action-group {
        display: flex;
        align-items: center;
        gap: 6px;
        white-space: nowrap;
    }

    .table-action {
        height: 32px;
        padding: 0 11px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #e2ebf3;
        background: white;
        color: #657d91;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .table-action:hover {
            border-color: #a8cdf1;
            color: #318ddd;
            background: #f7fbff;
        }

    .view-action {
        background: #eaf5ff;
        border-color: #d9edff;
        color: #318de1;
    }

    .delete-action {
        color: #d45d67;
        background: #fff8f8;
        border-color: #f5dfe1;
    }

        .delete-action:hover {
            color: #bf4853;
            border-color: #edbfc4;
            background: #fff4f5;
        }


    /* =========================================================
           ALERT
        ========================================================= */

    .jobs-alert {
        border: 0;
        border-radius: 14px;
        font-size: 12px;
        margin-bottom: 18px;
    }


    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-state {
        text-align: center;
        padding: 70px 20px;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        border-radius: 20px;
        background: #eaf5ff;
        color: #3894ea;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .empty-icon svg {
            width: 27px;
            height: 27px;
        }

    .empty-state h4 {
        color: #28445e;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .empty-state p {
        color: #94a7b8;
        font-size: 12px;
        margin-bottom: 18px;
    }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 1000px) {
        .jobs-stats {
            grid-template-columns: 1fr;
        }

        .jobs-top {
            align-items: flex-start;
        }

        .jobs-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .search-form {
            width: 100%;
        }
    }

    @@media (max-width: 700px) {
        .jobs-page {
            padding: 15px;
        }

        .jobs-shell {
            padding: 17px;
            border-radius: 20px;
        }

        .jobs-top {
            flex-direction: column;
        }

        .create-job-btn {
            width: 100%;
        }

        .jobs-title-area h1 {
            font-size: 25px;
        }

        .filter-grid {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-field {
            width: 100%;
        }

        .search-form {
            flex-direction: column;
        }

        .jobs-tabs {
            width: 100%;
            overflow-x: auto;
        }
    }
</style>


<div class="jobs-page">

    <div class="jobs-shell">


        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="jobs-top">

            <div class="jobs-title-area">

                <div class="jobs-title-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <rect x="3" y="7" width="18" height="13" rx="2"></rect>
                        <path d="M8 7V5.5A1.5 1.5 0 0 1 9.5 4h5A1.5 1.5 0 0 1 16 5.5V7"></path>
                        <path d="M3 12h18"></path>
                        <path d="M10 12v2h4v-2"></path>
                    </svg>
                </div>

                <div>
                    <div class="jobs-eyebrow">
                        Recruitment workspace
                    </div>

                    <h1>Job Postings</h1>

                    <p>
                        Create, manage and review all your open positions.
                    </p>
                </div>

            </div>


            <a asp-action="Create"
               class="create-job-btn">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">
                    <path d="M12 5v14M5 12h14"></path>
                </svg>

                Create Job Posting

            </a>

        </div>


        <!-- =====================================================
             STAT CARDS
        ====================================================== -->

        <div class="jobs-stats">

            <div class="job-stat-card">

                <div class="stat-icon stat-blue">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                        <path d="M8 9h8M8 13h8M8 17h5"></path>
                    </svg>
                </div>

                <div class="stat-data">
                    <span>Total job postings</span>
                    <strong>@totalCount</strong>
                </div>

            </div>


            <div class="job-stat-card">

                <div class="stat-icon stat-green">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <circle cx="12" cy="12" r="8"></circle>
                        <path d="m8.5 12 2.2 2.2 4.8-5"></path>
                    </svg>
                </div>

                <div class="stat-data">
                    <span>Published</span>
                    <strong>@liveCount</strong>
                </div>

            </div>


            <div class="job-stat-card">

                <div class="stat-icon stat-grey">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <path d="M4 7h16"></path>
                        <path d="M6 7v12h12V7"></path>
                        <path d="M9 4h6l1 3H8l1-3Z"></path>
                    </svg>
                </div>

                <div class="stat-data">
                    <span>Unpublished</span>
                    <strong>@archivedCount</strong>
                </div>

            </div>

        </div>


        <!-- =====================================================
             ALERTS
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success jobs-alert">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger jobs-alert">
                @TempData["Error"]
            </div>
        }


        <!-- =====================================================
             SEARCH
        ====================================================== -->

        <div class="jobs-toolbar">

            <form method="get"
                  asp-action="Index"
                  class="search-form">

                <input type="hidden"
                       name="status"
                       value="@status" />

                <div class="search-box">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <circle cx="11" cy="11" r="7"></circle>
                        <path d="m20 20-4-4"></path>
                    </svg>

                    <input type="text"
                           name="search"
                           value="@ViewBag.Search"
                           placeholder="Search job title, location or code..." />

                </div>

                <button type="submit"
                        class="search-btn">
                    Search
                </button>

            </form>


            <button type="button"
                    class="filter-btn"
                    onclick="togglePostingFilters()">

                <svg viewBox="0 0 24 24"
                     fill="none"
                     stroke="currentColor"
                     stroke-width="2">
                    <path d="M4 6h16M7 12h10M10 18h4"></path>
                </svg>

                Filters

            </button>

        </div>


        <!-- =====================================================
             TABS
        ====================================================== -->

        <div class="jobs-tabs">

            <a asp-action="Index"
               asp-route-status="all"
               class="job-tab @(status == "all" ? "active" : "")">

                All

                <strong>@totalCount</strong>

            </a>


            <a asp-action="Index"
               asp-route-status="active"
               class="job-tab @(status == "active" ? "active" : "")">

                Published

                <strong>@liveCount</strong>

            </a>


            <a asp-action="Index"
               asp-route-status="closed"
               class="job-tab @(status == "closed" ? "active" : "")">

                Unpublished

                <strong>@archivedCount</strong>

            </a>

        </div>


        <!-- =====================================================
             FILTER PANEL
        ====================================================== -->

        <div id="postingFilterPanel"
             class="filter-panel">

            <form method="get"
                  asp-action="Index">

                <input type="hidden"
                       name="status"
                       value="@status" />

                <input type="hidden"
                       name="search"
                       value="@ViewBag.Search" />


                <div class="filter-header">

                    <div>
                        <strong>Filter job postings</strong>

                        <p>
                            Narrow the results using posting dates.
                        </p>
                    </div>


                    <a asp-action="Index"
                       class="reset-filter">
                        Reset
                    </a>

                </div>


                <div class="filter-grid">

                    <div class="filter-field">

                        <label>Posted from</label>

                        <input type="date"
                               name="fromDate"
                               value="@ViewBag.FromDate" />

                    </div>


                    <div class="filter-field">

                        <label>Posted to</label>

                        <input type="date"
                               name="toDate"
                               value="@ViewBag.ToDate" />

                    </div>


                    <button type="submit"
                            class="apply-filter-btn">
                        Apply filters
                    </button>

                </div>

            </form>

        </div>


        <!-- =====================================================
             TABLE CARD
        ====================================================== -->

        <div class="jobs-card">

            <div class="jobs-card-header">

                <div>
                    <h3>Job posting overview</h3>

                    <p>
                        @totalCount
                        @(totalCount == 1 ? "position" : "positions")
                        currently displayed
                    </p>
                </div>

            </div>


            @if (!Model.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <rect x="4" y="4" width="16" height="16" rx="3"></rect>
                            <path d="M12 8v8M8 12h8"></path>
                        </svg>
                    </div>

                    <h4>No job postings found</h4>

                    <p>
                        Try another search or create a new vacancy.
                    </p>

                    <a asp-action="Create"
                       class="create-job-btn">
                        Create Job Posting
                    </a>

                </div>
            }
            else
            {
                <div class="table-wrap">

                    <table class="jobs-table">

                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Job Posting</th>
                                <th>Location</th>
                                <th>Salary</th>
                                <th>Applications</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th>Deadline</th>
                                <th>Actions</th>
                            </tr>
                        </thead>


                        <tbody>

                            @{
                                var number = 1;
                            }


                            @foreach (var vacancy in Model)
                            {
                                var appCount =
                                counts.TryGetValue(vacancy.Id, out var c)
                                ? c
                                : 0;

                                var expired =
                                vacancy.ClosingDate.Date < DateTime.Today;

                                var isLive =
                                vacancy.IsActive && !expired;


                                <tr>

                                    <td>
                                        <span class="row-number">
                                            @number
                                        </span>
                                    </td>


                                    <td>

                                        <div class="job-cell">

                                            <div class="job-avatar">

                                                @if (!string.IsNullOrWhiteSpace(vacancy.JobTitle))
                                                {
                                                    @vacancy.JobTitle.Substring(0, 1).ToUpper()
                                                }
                                                else
                                                {
                                                    <span>J</span>
                                                }

                                            </div>

                                            <div>

                                                <strong>
                                                    @vacancy.JobTitle
                                                </strong>

                                                <small>
                                                    @vacancy.JobCode
                                                    ·
                                                    Posted @vacancy.CreatedDate.ToString("dd MMM yyyy")
                                                </small>

                                            </div>

                                        </div>

                                    </td>


                                    <td>
                                        @vacancy.Location
                                    </td>


                                    <td>

                                        @if (vacancy.Salary.HasValue)
                                        {
                                            <span class="salary">
                                                Rs. @vacancy.Salary.Value.ToString("N0")
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color:#9cafbf;">
                                                Not specified
                                            </span>
                                        }

                                </td>


                                <td>

                                    <a asp-controller="JobApplication"
                                       asp-action="Index"
                                       asp-route-vacancyId="@vacancy.Id"
                                       class="applications-link">

                                        @appCount
                                        @(appCount == 1
                                                                            ? "application"
                                                                            : "applications")

                                </a>

                                    </td>


                                    <td>

                                        <span class="type-pill">
                                            @vacancy.EmploymentType
                                        </span>

                                    </td>


                                    <td>

                                @if (isLive)
                                        {
                                            <span class="status-pill status-live">
                                                Published
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="status-pill status-closed">
                                                Unpublished
                                            </span>
                                        }

                                    </td>


                                    <td>

                                        <div class="deadline">

                                            <strong>
                                                @vacancy.ClosingDate.ToString("dd MMM yyyy")
                                            </strong>

                                            @if (expired)
                                            {
                                                <small class="expired">
                                                    Expired
                                                </small>
                                            }
                                            else
                                            {
                                                <small>
                                                    Closing date
                                                </small>
                                            }

                                    </div>

                                </td>


                                <td>

                                    <div class="action-group">

                                        <a asp-action="Details"
                                           asp-route-id="@vacancy.Id"
                                           class="table-action view-action">
                                            View
                                        </a>


                                        <form asp-action="ToggleStatus"
                                              method="post"
                                              class="d-inline">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@vacancy.Id" />

                                            <button type="submit"
                                                    class="table-action">

                                                @(vacancy.IsActive
                                                                                            ? "Unpublish"
                                                                                            : "Reopen")

                                        </button>

                                            </form>


                                    @if (appCount == 0)
                                            {
                                                <a asp-action="Delete"
                                                   asp-route-id="@vacancy.Id"
                                                   class="table-action delete-action">

                                                    Delete

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>

                                number++;
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>


<script>
    function togglePostingFilters() {
        const panel = document.getElementById("postingFilterPanel");

        if (panel) {
            panel.classList.toggle("show");
        }
    }
</script>