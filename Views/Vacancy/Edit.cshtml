@model RecruitmentTracker.Models.JobVacancy
@{ ViewData["Title"] = "Edit Vacancy"; }
<div class="page-heading"><div><div class="section-label">HR WORKSPACE · VACANCY</div><h1>Edit vacancy</h1><p>Update the recruitment brief without affecting existing applications.</p></div><a asp-action="Manage" asp-route-id="@Model.Id" class="btn btn-outline-primary">← Vacancy overview</a></div>
<form asp-action="Edit" method="post"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedDate" />
<div class="row g-4"><div class="col-lg-8"><div class="card"><div class="card-body"><div class="mb-3"><label asp-for="JobTitle" class="form-label"></label><input asp-for="JobTitle" class="form-control form-control-lg" /><span asp-validation-for="JobTitle" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="8"></textarea><span asp-validation-for="Description" class="text-danger"></span></div><div><label asp-for="Requirements" class="form-label"></label><textarea asp-for="Requirements" class="form-control" rows="8"></textarea><span asp-validation-for="Requirements" class="text-danger"></span></div></div></div></div>
<div class="col-lg-4"><div class="card"><div class="card-body"><div class="mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control" /><span asp-validation-for="Location" class="text-danger"></span></div><div class="mb-3"><label asp-for="EmploymentType" class="form-label"></label><select asp-for="EmploymentType" class="form-select"><option>Full-Time</option><option>Part-Time</option><option>Contract</option><option>Internship</option></select></div><div class="mb-3"><label asp-for="Salary" class="form-label"></label><input asp-for="Salary" class="form-control" type="number" step="0.01" /></div><div class="mb-3"><label asp-for="ClosingDate" class="form-label"></label><input asp-for="ClosingDate" class="form-control" type="date" /><span asp-validation-for="ClosingDate" class="text-danger"></span></div>

<div class="form-check form-switch mb-4"><input asp-for="IsActive" class="form-check-input" /><label asp-for="IsActive" class="form-check-label">Vacancy is active</label></div><button class="btn btn-primary w-100" type="submit">Save changes</button></div></div></div></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
