@model IEnumerable<RecruitmentTracker.Models.ApplicationUser>

@{
    ViewData["Title"] = "Role Management";

    var userRoles =
        ViewBag.UserRoles as Dictionary<string, string>
        ?? new Dictionary<string, string>();

    var search = ViewBag.Search as string ?? "";

    var users = Model?.ToList()
        ?? new List<RecruitmentTracker.Models.ApplicationUser>();
}

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .roles-page {
        background: #f5f7fb;
        min-height: calc(100vh - 80px);
        padding: 25px 45px 60px;
    }

    .roles-wrapper {
        max-width: 1500px;
        margin: 0 auto;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .role-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
    }

    .role-heading-label {
        color: #718096;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        text-transform: uppercase;
    }

    .role-header h1 {
        color: #0b1f3a;
        font-size: 26px;
        font-weight: 700;
        margin: 2px 0 3px;
    }

    .role-header p {
        color: #718096;
        margin: 0;
        font-size: 12px;
    }


    /* =========================================================
           SEARCH
           ========================================================= */

    .role-search {
        display: flex;
        align-items: center;
        gap: 8px;
        min-width: 430px;
    }

        .role-search input {
            height: 45px;
            background: white;
            border: 1px solid #d8e0ea;
            border-radius: 9px;
            padding: 0 14px;
            color: #26374d;
            font-size: 12px;
            width: 100%;
        }

            .role-search input::placeholder {
                color: #9aa6b5;
            }

            .role-search input:focus {
                outline: none;
                border-color: #0b1f3a;
                box-shadow: 0 0 0 3px rgba(11, 31, 58, .08);
            }

    .search-btn {
        height: 45px;
        padding: 0 17px;
        border: none;
        border-radius: 9px;
        background: #0b1f3a;
        color: white;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .search-btn:hover {
            background: #132f55;
        }


    /* =========================================================
           TABLE CARD
           ========================================================= */

    .roles-table-wrap {
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 5px 22px rgba(11, 31, 58, .05);
    }


    /* =========================================================
           TABLE TOOLBAR
           ========================================================= */

    .roles-table-toolbar {
        padding: 21px 24px;
        border-bottom: 1px solid #edf0f4;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .roles-table-toolbar strong {
            display: block;
            color: #0b1f3a;
            font-size: 18px;
            font-weight: 700;
            margin-bottom: 3px;
        }

        .roles-table-toolbar span {
            display: block;
            color: #8a96a6;
            font-size: 12px;
        }


    /* =========================================================
           TABLE
           ========================================================= */

    .role-table {
        width: 100%;
        min-width: 750px;
        border-collapse: collapse;
        margin-bottom: 0;
    }

        .role-table thead {
            background: #0b1f3a;
        }

        .role-table th {
            padding: 13px 20px;
            text-align: left;
            color: white;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .7px;
            text-transform: uppercase;
            border-bottom: 1px solid #18365f;
            white-space: nowrap;
        }

        .role-table td {
            padding: 17px 20px;
            color: #526174;
            font-size: 12px;
            border-bottom: 1px solid #edf0f4;
            vertical-align: middle;
        }

        .role-table tbody tr {
            transition: .15s ease;
        }

            .role-table tbody tr:hover {
                background: #fafbfd;
            }

            .role-table tbody tr:last-child td {
                border-bottom: none;
            }


    /* =========================================================
           EMAIL
           ========================================================= */

    .user-email {
        color: #0b1f3a;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================================================
           ROLE BADGE
           ========================================================= */

    .role-badge {
        display: inline-flex;
        align-items: center;
        padding: 5px 10px;
        border-radius: 20px;
        background: #edf2f7;
        color: #0b1f3a;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }


    /* =========================================================
           ROLE FORM
           ========================================================= */

    .role-form {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .role-select {
        height: 36px;
        min-width: 165px;
        border: 1px solid #d8e0ea;
        border-radius: 8px;
        padding: 0 10px;
        background: white;
        color: #26374d;
        font-size: 11px;
    }

        .role-select:focus {
            outline: none;
            border-color: #0b1f3a;
            box-shadow: 0 0 0 3px rgba(11, 31, 58, .06);
        }

    .assign-btn {
        height: 36px;
        padding: 0 13px;
        border: 1px solid #0b1f3a;
        border-radius: 8px;
        background: #0b1f3a;
        color: white;
        font-size: 10px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

        .assign-btn:hover {
            background: #132f55;
            border-color: #132f55;
        }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .empty-state {
        padding: 65px 25px;
        text-align: center;
        background: white;
    }

        .empty-state h5 {
            color: #0b1f3a;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .empty-state p {
            color: #718096;
            font-size: 12px;
            margin: 0;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .roles-page {
            padding: 25px 20px 50px;
        }

        .role-header {
            flex-direction: column;
            align-items: stretch;
        }

        .role-search {
            min-width: 0;
            width: 100%;
        }

        .roles-table-wrap {
            overflow-x: auto;
        }
    }


    @@media (max-width: 600px) {

        .role-search {
            flex-direction: column;
            align-items: stretch;
        }

        .search-btn {
            width: 100%;
        }

        .roles-table-toolbar {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .role-form {
            align-items: stretch;
            flex-direction: column;
        }

        .role-select,
        .assign-btn {
            width: 100%;
        }
    }

</style>


<div class="roles-page">

    <div class="roles-wrapper">


        <!-- =====================================================
             HEADER
             ===================================================== -->

        <div class="role-header">

            <div>

                <div class="role-heading-label">
                    ADMIN WORKSPACE · USER ROLES
                </div>

                <h1>
                    Role Management
                </h1>

                <p>
                    Manage user roles and access across the recruitment system.
                </p>

            </div>


            <!-- SEARCH EMAIL -->

            <form method="get"
                  asp-action="Index"
                  class="role-search">

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search by email..." />

                <button type="submit"
                        class="search-btn">
                    Search
                </button>

            </form>

        </div>


        <!-- =====================================================
             TABLE
             ===================================================== -->

        <div class="roles-table-wrap">


            <!-- TABLE TOOLBAR -->

          
            </div>


            @if (!users.Any())
            {
                <div class="empty-state">

                    <h5>
                        No users found
                    </h5>

                    <p>
                        Try searching with a different email address.
                    </p>

                </div>
            }
            else
            {

                <div class="table-responsive">

                    <table class="table role-table align-middle">

                        <thead>

                            <tr>

                                <th>
                                    Email
                                </th>

                                <th>
                                    Current Role
                                </th>

                                <th>
                                    Change Role
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var user in users)
                            {
                                var currentRole =
                                userRoles.ContainsKey(user.Id)
                                ? userRoles[user.Id]
                                : "Candidate";


                                <tr>


                                    <!-- EMAIL -->

                                    <td>

                                        <div class="user-email">
                                            @user.Email
                                        </div>

                                    </td>


                                    <!-- CURRENT ROLE -->

                                    <td>

                                        <span class="role-badge">
                                            @currentRole
                                        </span>

                                    </td>


                                    <!-- CHANGE ROLE -->

                                    <td>

                                        <form asp-action="AssignRole"
                                              method="post"
                                              class="role-form">

                                            <input type="hidden"
                                                   name="userId"
                                                   value="@user.Id" />

                                            <select name="role"
                                                    class="role-select">

                                                <option value="Candidate"
                                                        selected="@(currentRole == "Candidate")">
                                                    Candidate
                                                </option>

                                                <option value="HR"
                                                        selected="@(currentRole == "HR")">
                                                    HR
                                                </option>

                                                <option value="Interviewer"
                                                        selected="@(currentRole == "Interviewer")">
                                                    Interviewer
                                                </option>

                                                <option value="HiringManager"
                                                        selected="@(currentRole == "HiringManager")">
                                                    Hiring Manager
                                                </option>

                                            </select>

                                            <button type="submit"
                                                    class="assign-btn">
                                                Assign Role
                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            }

        </div>

    </div>

</div>