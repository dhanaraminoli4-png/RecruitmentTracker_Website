@model IEnumerable<RecruitmentTracker.Models.Interview>

@{
    ViewData["Title"] = "Interview Reviews";

    var interviews =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.Interview>();


    var jobs =
        ViewBag.Jobs
        as List<RecruitmentTracker.Models.JobVacancy>
        ?? new List<RecruitmentTracker.Models.JobVacancy>();


    int? selectedJobId =
        ViewBag.SelectedJobId as int?;


    var selectedJobTitle =
        ViewBag.SelectedJobTitle
        ?? "All Job Vacancies";


    var selectedJobCode =
        ViewBag.SelectedJobCode
        ?? "";


    var pendingCount =
        interviews.Count(x =>
            x.RoundResult == "Pending");


    var passedCount =
        interviews.Count(x =>
            x.RoundResult == "Passed");


    var failedCount =
        interviews.Count(x =>
            x.RoundResult == "Failed");
}


<div class="hm-review-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="hm-header">

        <div>

            <div class="hm-eyebrow">
                HIRING MANAGER · INTERVIEW PROCESS
            </div>

            <h1>
                Interview Reviews
            </h1>

            <p>
                Review assessments, interviewer feedback
                and make interview round decisions.
            </p>

        </div>


        <a asp-controller="HiringManager"
           asp-action="Applications"
           class="hm-back-btn">

            Back to Candidate Approvals

        </a>

    </div>



    <!-- =========================================================
         JOB VACANCY FILTER
         ========================================================= -->

    <div class="hm-filter-card">


        <div class="hm-filter-heading">

            <div>

                <span class="hm-filter-label">
                    JOB VACANCY
                </span>

                <h3>
                    Filter Interview Reviews
                </h3>

                <p>
                    Select a vacancy to view only interviews
                    belonging to that recruitment campaign.
                </p>

            </div>

        </div>



        <form asp-controller="HiringManager"
              asp-action="InterviewReviews"
              method="get"
              class="hm-filter-form">


            <div class="hm-filter-field">

                <label>
                    Job Vacancy
                </label>


                <select name="jobId"
                        class="hm-job-select"
                        onchange="this.form.submit()">


                    <option value="">
                        All Job Vacancies
                    </option>


                    @foreach (var job in jobs)
                    {
                        if (selectedJobId.HasValue &&
                        selectedJobId.Value == job.Id)
                        {
                            <option value="@job.Id"
                                    selected>
                                @job.JobTitle
                                @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                {
                                    @: · @job.JobCode
                                }
                            </option>
                        }
                        else
                        {
                            <option value="@job.Id">
                                @job.JobTitle
                                @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                {
                                    @: · @job.JobCode
                                }
                            </option>
                        }
                    }

                </select>

            </div>


        </form>


        <div class="hm-selected-job">

            <div>

                <span>
                    Currently viewing
                </span>

                <strong>
                    @selectedJobTitle
                </strong>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                        selectedJobCode))
            {
                <span class="hm-job-code">
                    @selectedJobCode
                </span>
            }


            @if (selectedJobId.HasValue)
            {
                <a asp-controller="HiringManager"
                   asp-action="InterviewReviews"
                   class="hm-clear-filter">

                    Clear Filter

                </a>
            }

        </div>

    </div>



    <!-- =========================================================
         STATS
         ========================================================= -->

    <div class="hm-stats">


        <div class="hm-stat-card">

            <span>
                Total Interviews
            </span>

            <strong>
                @interviews.Count
            </strong>

            <small>
                @selectedJobTitle
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Pending Decision
            </span>

            <strong>
                @pendingCount
            </strong>

            <small>
                Requires HM review
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Passed
            </span>

            <strong>
                @passedCount
            </strong>

            <small>
                Passed interview rounds
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Failed
            </span>

            <strong>
                @failedCount
            </strong>

            <small>
                Failed interview rounds
            </small>

        </div>


    </div>



    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="hm-alert success">

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="hm-alert error">

            @TempData["Error"]

        </div>
    }



    <!-- =========================================================
         INTERVIEW LIST HEADER
         ========================================================= -->

    <div class="hm-list-heading">

        <div>

            <h2>
                @selectedJobTitle
            </h2>

            <p>
                @interviews.Count interview(s) found
            </p>

        </div>

    </div>



    <!-- =========================================================
         EMPTY STATE
         ========================================================= -->
    @if (!interviews.Any())
    {
        <div class="hm-empty">

            <div class="hm-empty-icon">
                ✓
            </div>

            <h3>
                No interview reviews found
            </h3>


            @if (selectedJobId.HasValue)
            {
                <p>
                    There are currently no interviews
                    for the selected vacancy.
                </p>
            }
            else
            {
                <p>
                    Interview rounds will appear here
                    once candidates have been scheduled.
                </p>
            }

        </div>
    }
    else
    {
        <!-- =====================================================
             INTERVIEW CARDS
             ===================================================== -->

        <div class="hm-review-list">


            @foreach (var interview in interviews)
            {
                var application =
                interview.JobApplication;


                var candidate =
                application?.Candidate;


                var vacancy =
                application?.JobVacancy;


                var candidateName =
                candidate?.FullName
                ?? "Unknown Candidate";


                var initials =
                !string.IsNullOrWhiteSpace(
                candidateName)

                ? candidateName
                .Substring(0, 1)
                .ToUpper()

                : "?";


                var assessment =
                interview.Assessments?
                .FirstOrDefault();


                var feedbackCount =
                interview.Feedbacks?.Count
                ?? 0;


                var readyForDecision =
                interview.Status ==
                "Completed";


                var roundResult =
                interview.RoundResult
                ?? "Pending";


                var roundResultClass =
                roundResult.ToLower();


                <div class="hm-review-card">


                    <!-- =============================================
                         TOP
                         ============================================= -->

                    <div class="hm-card-top">


                        <div class="hm-card-candidate">


                            <div class="hm-avatar">

                                @initials

                            </div>


                            <div>

                                <h3>
                                    @candidateName
                                </h3>


                                <span>
                                    @(candidate?.Email ?? "")
                                </span>


                                <strong>
                                    @(vacancy?.JobTitle
                                                                ?? "Unknown Position")
                        </strong>


                        @if (!string.IsNullOrWhiteSpace(
                                                vacancy?.JobCode))
                                {
                                    <small>
                                        @vacancy.JobCode
                                    </small>
                                }


                        </div>

                    </div>



                    <span class="hm-result-badge @roundResultClass">

                        @roundResult

                    </span>


                </div>



                <!-- =============================================
                     INTERVIEW DETAILS
                     ============================================= -->

                <div class="hm-card-grid">


                    <div>

                        <span>
                            Interview Round
                        </span>

                        <strong>
                            @(interview.InterviewRound?.Name
                                                    ?? "—")
                                                       </strong>

                    </div>



                    <div>

                        <span>
                            Type
                        </span>

                        <strong>
                            @(interview.InterviewType?.Name
                                                    ?? "—")
                    </strong>

                        </div>



                        <div>

                            <span>
                                Date
                            </span>

                            <strong>
                                @interview.InterviewDate
                                .ToString("dd MMM yyyy")
                            </strong>

                        </div>



                        <div>

                            <span>
                                Interview Status
                            </span>

                            <strong>
                                @interview.Status
                            </strong>

                        </div>


                    </div>



                    <!-- =============================================
                         REVIEW DETAILS
                         ============================================= -->

                    <div class="hm-review-data">


                        <div class="hm-data-item">

                            <span>
                                Assessment
                            </span>


                    @if (assessment != null)
                            {
                                <strong>

                                    @(assessment.AssessmentTemplate?.Name
                                                            ?? "Assessment")

                    </strong>

                                <small>
                                    @assessment.Status
                                </small>
                                        }
                            else
                            {
                                <strong>
                                    No Assessment
                                </strong>
                            }

                    </div>



                    <div class="hm-data-item">

                        <span>
                            Assessment Result
                        </span>

                        <strong>
                            @(assessment?.ResultStatus
                                                    ?? "—")
                    </strong>

                        </div>



                        <div class="hm-data-item">

                            <span>
                                Feedback Received
                            </span>

                            <strong>
                                @feedbackCount
                            </strong>

                        </div>



                        <div class="hm-data-item">

                            <span>
                                Round Result
                            </span>

                            <strong class="hm-result-text @roundResultClass">

                                @roundResult

                            </strong>

                        </div>


                    </div>



                    <!-- =============================================
                         FOOTER
                         ============================================= -->

                    <div class="hm-card-footer">


                        <div>

                    @if (
                                        readyForDecision &&
                                        roundResult == "Pending")
                            {
                                <span class="hm-ready-badge">

                                    Ready for HM Decision

                                </span>
                            }
                            else if (!readyForDecision)
                            {
                                <span class="hm-waiting-badge">

                                    Waiting for Interviewer

                                </span>
                            }
                            else
                            {
                                <span class="hm-decided-badge">

                                    Decision Recorded

                                </span>
                            }

                        </div>



                        <a asp-controller="HiringManager"
                           asp-action="InterviewReview"
                           asp-route-id="@interview.Id"
                           class="hm-view-btn">

                            Review Interview

                        </a>


                    </div>


                </div>
            }


        </div>
    }


</div>



<style>


    /* =========================================================
           PAGE
           ========================================================= */

    .hm-review-page {
        max-width: 1250px;
        margin: 0 auto;
        padding: 32px;
        color: #172033;
    }



    /* =========================================================
           HEADER
           ========================================================= */

    .hm-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 24px;
    }


    .hm-eyebrow {
        color: #98a2b3;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .09em;
        margin-bottom: 7px;
    }


    .hm-header h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 750;
        color: #101828;
    }


    .hm-header p {
        margin: 7px 0 0;
        color: #7b8495;
        font-size: 13px;
    }


    .hm-back-btn {
        text-decoration: none;
        border: 1px solid #d8dee8;
        background: white;
        color: #475467;
        padding: 10px 15px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 650;
    }


        .hm-back-btn:hover {
            color: #101828;
            background: #f9fafb;
        }



    /* =========================================================
           FILTER
           ========================================================= */

    .hm-filter-card {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 14px;
        padding: 19px 21px;
        margin-bottom: 22px;
        box-shadow: 0 2px 8px rgba(15,23,42,.03);
    }


    .hm-filter-heading {
        margin-bottom: 15px;
    }


    .hm-filter-label {
        color: #98a2b3;
        font-size: 9px;
        font-weight: 750;
        letter-spacing: .08em;
    }


    .hm-filter-heading h3 {
        margin: 5px 0 3px;
        color: #101828;
        font-size: 15px;
        font-weight: 700;
    }


    .hm-filter-heading p {
        margin: 0;
        color: #98a2b3;
        font-size: 11px;
    }


    .hm-filter-form {
        display: flex;
        align-items: end;
        gap: 12px;
    }


    .hm-filter-field {
        width: min(430px, 100%);
    }


        .hm-filter-field label {
            display: block;
            margin-bottom: 6px;
            color: #475467;
            font-size: 11px;
            font-weight: 650;
        }


    .hm-job-select {
        width: 100%;
        height: 42px;
        border: 1px solid #d0d5dd;
        border-radius: 9px;
        background: white;
        padding: 0 12px;
        color: #344054;
        font-size: 12px;
        outline: none;
    }


        .hm-job-select:focus {
            border-color: #98a2b3;
            box-shadow: 0 0 0 3px rgba(152,162,179,.12);
        }


    .hm-selected-job {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 15px;
        padding-top: 14px;
        border-top: 1px solid #edf0f3;
    }


        .hm-selected-job div {
            flex: 1;
        }


        .hm-selected-job span {
            display: block;
            color: #98a2b3;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }


        .hm-selected-job strong {
            display: block;
            margin-top: 3px;
            color: #344054;
            font-size: 12px;
        }


    .hm-job-code {
        flex: none !important;
        padding: 5px 9px;
        border-radius: 999px;
        background: #f2f4f7;
        color: #475467 !important;
        font-size: 9px !important;
    }


    .hm-clear-filter {
        text-decoration: none;
        font-size: 10px;
        font-weight: 650;
        color: #667085;
    }


        .hm-clear-filter:hover {
            color: #101828;
        }



    /* =========================================================
           STATS
           ========================================================= */

    .hm-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
        margin-bottom: 22px;
    }


    .hm-stat-card {
        background: white;
        border: 1px solid #e4e7ec;
        border-radius: 13px;
        padding: 16px 18px;
    }


        .hm-stat-card > span {
            display: block;
            color: #98a2b3;
            font-size: 10px;
            margin-bottom: 5px;
        }


        .hm-stat-card strong {
            color: #111827;
            font-size: 24px;
        }


        .hm-stat-card small {
            display: block;
            color: #98a2b3;
            font-size: 9px;
            margin-top: 3px;
        }



    /* =========================================================
           LIST HEADING
           ========================================================= */

    .hm-list-heading {
        margin-bottom: 13px;
    }


        .hm-list-heading h2 {
            margin: 0;
            color: #101828;
            font-size: 17px;
            font-weight: 700;
        }


        .hm-list-heading p {
            margin: 4px 0 0;
            color: #98a2b3;
            font-size: 10px;
        }



    /* =========================================================
           ALERTS
           ========================================================= */

    .hm-alert {
        padding: 12px 15px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-size: 12px;
    }


        .hm-alert.success {
            background: #ecfdf3;
            border: 1px solid #abefc6;
            color: #067647;
        }


        .hm-alert.error {
            background: #fef3f2;
            border: 1px solid #fecdca;
            color: #b42318;
        }



    /* =========================================================
           CARDS
           ========================================================= */

    .hm-review-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }


    .hm-review-card {
        border: 1px solid #e4e7ec;
        border-radius: 15px;
        overflow: hidden;
        background: white;
        box-shadow: 0 2px 8px rgba(15,23,42,.04);
    }


    .hm-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-right: 20px;
        border-bottom: 1px solid #edf0f3;
    }


    .hm-card-candidate {
        display: flex;
        gap: 13px;
        align-items: center;
        padding: 18px 20px;
    }


    .hm-avatar {
        width: 45px;
        height: 45px;
        border-radius: 11px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 750;
        font-size: 16px;
        flex-shrink: 0;
    }


    .hm-card-candidate h3 {
        margin: 0;
        font-size: 14px;
        color: #101828;
    }


    .hm-card-candidate span {
        display: block;
        margin-top: 3px;
        font-size: 11px;
        color: #98a2b3;
    }


    .hm-card-candidate strong {
        display: block;
        margin-top: 5px;
        font-size: 12px;
        color: #475467;
    }


    .hm-card-candidate small {
        display: block;
        margin-top: 2px;
        color: #98a2b3;
        font-size: 9px;
    }



    /* =========================================================
           RESULT BADGE
           ========================================================= */

    .hm-result-badge {
        padding: 6px 10px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 700;
    }


        .hm-result-badge.pending {
            background: #fffaeb;
            color: #b54708;
        }


        .hm-result-badge.passed {
            background: #ecfdf3;
            color: #067647;
        }


        .hm-result-badge.failed {
            background: #fef3f2;
            color: #b42318;
        }



    /* =========================================================
           INTERVIEW GRID
           ========================================================= */

    .hm-card-grid {
        padding: 16px 20px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        border-bottom: 1px solid #edf0f3;
    }


        .hm-card-grid span,
        .hm-data-item > span {
            display: block;
            color: #98a2b3;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: 5px;
        }


        .hm-card-grid strong,
        .hm-data-item strong {
            color: #344054;
            font-size: 12px;
        }



    /* =========================================================
           REVIEW DATA
           ========================================================= */

    .hm-review-data {
        padding: 16px 20px;
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        background: #fbfcfd;
        border-bottom: 1px solid #edf0f3;
    }


    .hm-data-item small {
        display: block;
        margin-top: 3px;
        font-size: 9px;
        color: #98a2b3;
    }


    .hm-result-text.pending {
        color: #b54708;
    }


    .hm-result-text.passed {
        color: #067647;
    }


    .hm-result-text.failed {
        color: #b42318;
    }



    /* =========================================================
           FOOTER
           ========================================================= */

    .hm-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 13px 20px;
    }


    .hm-ready-badge,
    .hm-waiting-badge,
    .hm-decided-badge {
        padding: 5px 9px;
        border-radius: 999px;
        font-size: 9px;
        font-weight: 650;
    }


    .hm-ready-badge {
        background: #ecfdf3;
        color: #067647;
    }


    .hm-waiting-badge {
        background: #fffaeb;
        color: #b54708;
    }


    .hm-decided-badge {
        background: #f2f4f7;
        color: #475467;
    }


    .hm-view-btn {
        background: #111827;
        color: white;
        text-decoration: none;
        padding: 9px 14px;
        border-radius: 8px;
        font-size: 10px;
        font-weight: 650;
    }


        .hm-view-btn:hover {
            color: white;
            opacity: .9;
        }



    /* =========================================================
           EMPTY
           ========================================================= */

    .hm-empty {
        border: 1px dashed #d0d5dd;
        border-radius: 14px;
        padding: 50px 20px;
        background: white;
        text-align: center;
    }


    .hm-empty-icon {
        width: 47px;
        height: 47px;
        border-radius: 12px;
        background: #eef2ff;
        color: #4f46e5;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto auto 10px;
        font-size: 20px;
    }


    .hm-empty h3 {
        margin: 0;
        font-size: 14px;
        color: #344054;
    }


    .hm-empty p {
        margin: 5px 0 0;
        font-size: 11px;
        color: #98a2b3;
    }



    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 850px) {

        .hm-stats,
        .hm-card-grid,
        .hm-review-data {
            grid-template-columns: 1fr 1fr;
        }


        .hm-header {
            flex-direction: column;
        }
    }


    @@media (max-width: 600px) {

        .hm-stats,
        .hm-card-grid,
        .hm-review-data {
            grid-template-columns: 1fr;
        }


        .hm-selected-job {
            align-items: flex-start;
            flex-direction: column;
        }


        .hm-filter-field {
            width: 100%;
        }
    }

</style>