@model IEnumerable<RecruitmentTracker.Models.Interview>

@{
    ViewData["Title"] = "Interview Reviews";

    var interviews =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.Interview>();


    var jobs =
        ViewBag.Jobs
        as List<RecruitmentTracker.Models.JobVacancy>
        ?? new List<RecruitmentTracker.Models.JobVacancy>();


    int? selectedJobId =
        ViewBag.SelectedJobId as int?;


    var selectedJobTitle =
        ViewBag.SelectedJobTitle
        ?? "All Job Vacancies";


    var selectedJobCode =
        ViewBag.SelectedJobCode
        ?? "";


    var pendingCount =
        interviews.Count(x =>
            x.RoundResult == "Pending");


    var passedCount =
        interviews.Count(x =>
            x.RoundResult == "Passed");


    var failedCount =
        interviews.Count(x =>
            x.RoundResult == "Failed");
}


<div class="hm-review-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="hm-header">

        <div>

            <div class="hm-eyebrow">
                HIRING MANAGER · INTERVIEW PROCESS
            </div>

            <h1>
                Interview Reviews
            </h1>

            <p>
                Review assessments, interviewer feedback
                and make interview round decisions.
            </p>

        </div>


        <a asp-controller="HiringManager"
           asp-action="Applications"
           class="hm-back-btn">

            Back to Candidate Approvals

        </a>

    </div>



    <!-- =========================================================
         JOB VACANCY FILTER
         ========================================================= -->

    <div class="hm-filter-card">


        <div class="hm-filter-heading">

            <div>

                <span class="hm-filter-label">
                    JOB VACANCY
                </span>

                <h3>
                    Filter Interview Reviews
                </h3>

                <p>
                    Select a vacancy to view only interviews
                    belonging to that recruitment campaign.
                </p>

            </div>

        </div>



        <form asp-controller="HiringManager"
              asp-action="InterviewReviews"
              method="get"
              class="hm-filter-form">


            <div class="hm-filter-field">

                <label>
                    Job Vacancy
                </label>


                <select name="jobId"
                        class="hm-job-select"
                        onchange="this.form.submit()">


                    <option value="">
                        All Job Vacancies
                    </option>


                    @foreach (var job in jobs)
                    {
                        if (selectedJobId.HasValue &&
                        selectedJobId.Value == job.Id)
                        {
                            <option value="@job.Id"
                                    selected>
                                @job.JobTitle
                                @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                {
                                    @: · @job.JobCode
                                }
                            </option>
                        }
                        else
                        {
                            <option value="@job.Id">
                                @job.JobTitle
                                @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                {
                                    @: · @job.JobCode
                                }
                            </option>
                        }
                    }

                </select>

            </div>


        </form>


        <div class="hm-selected-job">

            <div>

                <span>
                    Currently viewing
                </span>

                <strong>
                    @selectedJobTitle
                </strong>

            </div>


            @if (!string.IsNullOrWhiteSpace(
                        selectedJobCode))
            {
                <span class="hm-job-code">
                    @selectedJobCode
                </span>
            }


            @if (selectedJobId.HasValue)
            {
                <a asp-controller="HiringManager"
                   asp-action="InterviewReviews"
                   class="hm-clear-filter">

                    Clear Filter

                </a>
            }

        </div>

    </div>



    <!-- =========================================================
         STATS
         ========================================================= -->

    <div class="hm-stats">


        <div class="hm-stat-card">

            <span>
                Total Interviews
            </span>

            <strong>
                @interviews.Count
            </strong>

            <small>
                @selectedJobTitle
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Pending Decision
            </span>

            <strong>
                @pendingCount
            </strong>

            <small>
                Requires HM review
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Passed
            </span>

            <strong>
                @passedCount
            </strong>

            <small>
                Passed interview rounds
            </small>

        </div>



        <div class="hm-stat-card">

            <span>
                Failed
            </span>

            <strong>
                @failedCount
            </strong>

            <small>
                Failed interview rounds
            </small>

        </div>


    </div>



    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="hm-alert success">

            @TempData["Success"]

        </div>
    }


    @if (TempData["Error"] != null)
    {
        <div class="hm-alert error">

            @TempData["Error"]

        </div>
    }



    <!-- =========================================================
         INTERVIEW LIST HEADER
         ========================================================= -->

    <div class="hm-list-heading">

        <div>

            <h2>
                @selectedJobTitle
            </h2>

            <p>
                @interviews.Count interview(s) found
            </p>

        </div>

    </div>



    <!-- =========================================================
         EMPTY STATE
         ========================================================= -->
    @if (!interviews.Any())
    {
        <div class="hm-empty">

            <div class="hm-empty-icon">
                ✓
            </div>

            <h3>
                No interview reviews found
            </h3>


            @if (selectedJobId.HasValue)
            {
                <p>
                    There are currently no interviews
                    for the selected vacancy.
                </p>
            }
            else
            {
                <p>
                    Interview rounds will appear here
                    once candidates have been scheduled.
                </p>
            }

        </div>
    }
    else
    {
        <!-- =====================================================
             INTERVIEW CARDS
             ===================================================== -->

        <div class="hm-review-list">


            @foreach (var interview in interviews)
            {
                var application =
                interview.JobApplication;


                var candidate =
                application?.Candidate;


                var vacancy =
                application?.JobVacancy;


                var candidateName =
                candidate?.FullName
                ?? "Unknown Candidate";


                var initials =
                !string.IsNullOrWhiteSpace(
                candidateName)

                ? candidateName
                .Substring(0, 1)
                .ToUpper()

                : "?";


                var assessment =
                interview.Assessments?
                .FirstOrDefault();


                var feedbackCount =
                interview.Feedbacks?.Count
                ?? 0;


                var readyForDecision =
                interview.Status ==
                "Completed";


                var roundResult =
                interview.RoundResult
                ?? "Pending";


                var roundResultClass =
                roundResult.ToLower();


                <div class="hm-review-card">


                    <!-- =============================================
                         TOP
                         ============================================= -->

                    <div class="hm-card-top">


                        <div class="hm-card-candidate">


                            <div class="hm-avatar">

                                @initials

                            </div>


                            <div>

                                <h3>
                                    @candidateName
                                </h3>


                                <span>
                                    @(candidate?.Email ?? "")
                                </span>


                                <strong>
                                    @(vacancy?.JobTitle
                                                                ?? "Unknown Position")
                        </strong>


                        @if (!string.IsNullOrWhiteSpace(
                                                vacancy?.JobCode))
                                {
                                    <small>
                                        @vacancy.JobCode
                                    </small>
                                }


                        </div>

                    </div>



                    <span class="hm-result-badge @roundResultClass">

                        @roundResult

                    </span>


                </div>



                <!-- =============================================
                     INTERVIEW DETAILS
                     ============================================= -->

                <div class="hm-card-grid">


                    <div>

                        <span>
                            Interview Round
                        </span>

                        <strong>
                            @(interview.InterviewRound?.Name
                                                    ?? "—")
                                                       </strong>

                    </div>



                    <div>

                        <span>
                            Type
                        </span>

                        <strong>
                            @(interview.InterviewType?.Name
                                                    ?? "—")
                    </strong>

                        </div>



                        <div>

                            <span>
                                Date
                            </span>

                            <strong>
                                @interview.InterviewDate
                                .ToString("dd MMM yyyy")
                            </strong>

                        </div>



                        <div>

                            <span>
                                Interview Status
                            </span>

                            <strong>
                                @interview.Status
                            </strong>

                        </div>


                    </div>



                    <!-- =============================================
                         REVIEW DETAILS
                         ============================================= -->

                    <div class="hm-review-data">


                        <div class="hm-data-item">

                            <span>
                                Assessment
                            </span>


                    @if (assessment != null)
                            {
                                <strong>

                                    @(assessment.AssessmentTemplate?.Name
                                                            ?? "Assessment")

                    </strong>

                                <small>
                                    @assessment.Status
                                </small>
                                        }
                            else
                            {
                                <strong>
                                    No Assessment
                                </strong>
                            }

                    </div>



                    <div class="hm-data-item">

                        <span>
                            Assessment Result
                        </span>

                        <strong>
                            @(assessment?.ResultStatus
                                                    ?? "—")
                    </strong>

                        </div>



                        <div class="hm-data-item">

                            <span>
                                Feedback Received
                            </span>

                            <strong>
                                @feedbackCount
                            </strong>

                        </div>



                        <div class="hm-data-item">

                            <span>
                                Round Result
                            </span>

                            <strong class="hm-result-text @roundResultClass">

                                @roundResult

                            </strong>

                        </div>


                    </div>



                    <!-- =============================================
                         FOOTER
                         ============================================= -->

                    <div class="hm-card-footer">


                        <div>

                    @if (
                                        readyForDecision &&
                                        roundResult == "Pending")
                            {
                                <span class="hm-ready-badge">

                                    Ready for HM Decision

                                </span>
                            }
                            else if (!readyForDecision)
                            {
                                <span class="hm-waiting-badge">

                                    Waiting for Interviewer

                                </span>
                            }
                            else
                            {
                                <span class="hm-decided-badge">

                                    Decision Recorded

                                </span>
                            }

                        </div>



                        <a asp-controller="HiringManager"
                           asp-action="InterviewReview"
                           asp-route-id="@interview.Id"
                           class="hm-view-btn">

                            Review Interview

                        </a>


                    </div>


                </div>
            }


        </div>
    }


</div>



<style>

    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');


    /* =========================================================
           PAGE
        ========================================================= */

    .hm-review-page {
        max-width: 1450px;
        min-height: calc(100vh - 60px);
        margin: 0 auto;
        padding: 30px;
        font-family: 'Inter', sans-serif;
        color: #34516d;
        background: linear-gradient( 135deg, #f8fbff 0%, #eef7ff 45%, #f8fbff 100% );
    }


        .hm-review-page *,
        .hm-review-page select,
        .hm-review-page button,
        .hm-review-page input {
            font-family: 'Inter', sans-serif;
        }



    /* =========================================================
           HEADER
        ========================================================= */

    .hm-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 27px;
    }


    .hm-eyebrow {
        margin-bottom: 8px;
        color: #68a9e8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .11em;
        text-transform: uppercase;
    }


    .hm-header h1 {
        margin: 0;
        color: #183c67;
        font-size: 38px;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.04em;
    }


    .hm-header p {
        max-width: 650px;
        margin: 9px 0 0;
        color: #879db2;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.65;
    }


    .hm-back-btn {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 18px;
        background: rgba(255,255,255,.95);
        border: 1px solid #dceaf5;
        border-radius: 12px;
        color: #63809b;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 5px 18px rgba(65,112,153,.05);
        white-space: nowrap;
        transition: .2s ease;
    }


        .hm-back-btn:hover {
            color: #3389d8;
            border-color: #cce5f8;
            background: #f7fbff;
            transform: translateY(-2px);
        }



    /* =========================================================
           FILTER CARD
        ========================================================= */

    .hm-filter-card {
        position: relative;
        margin-bottom: 24px;
        padding: 24px 26px;
        overflow: hidden;
        background: linear-gradient( 135deg, #ffffff, #f8fcff );
        border: 1px solid #e0edf7;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(76,125,170,.07);
    }


        .hm-filter-card::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -75px;
            top: -85px;
            border-radius: 50%;
            background: rgba(96,177,244,.07);
            pointer-events: none;
        }


    .hm-filter-heading {
        position: relative;
        z-index: 2;
        margin-bottom: 18px;
    }


    .hm-filter-label {
        color: #68aae8;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .10em;
        text-transform: uppercase;
    }


    .hm-filter-heading h3 {
        margin: 6px 0 4px;
        color: #294b69;
        font-size: 19px;
        font-weight: 750;
        letter-spacing: -0.025em;
    }


    .hm-filter-heading p {
        margin: 0;
        color: #96a8b9;
        font-size: 13px;
        line-height: 1.55;
    }



    /* =========================================================
           FILTER FORM
        ========================================================= */

    .hm-filter-form {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-end;
        gap: 14px;
    }


    .hm-filter-field {
        width: min(500px, 100%);
    }


        .hm-filter-field label {
            display: block;
            margin-bottom: 8px;
            color: #617b94;
            font-size: 13px;
            font-weight: 600;
        }


    .hm-job-select {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        outline: none;
        background: white;
        border: 1px solid #dbe8f2;
        border-radius: 11px;
        color: #506d86;
        font-size: 14px;
        font-weight: 500;
        transition: .2s ease;
    }


        .hm-job-select:hover {
            border-color: #bedcf2;
        }


        .hm-job-select:focus {
            border-color: #75b8ec;
            box-shadow: 0 0 0 4px rgba(80,164,231,.10);
        }



    /* =========================================================
           SELECTED JOB
        ========================================================= */

    .hm-selected-job {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 14px;
        margin-top: 18px;
        padding-top: 17px;
        border-top: 1px solid #edf3f8;
    }


        .hm-selected-job > div {
            flex: 1;
        }


        .hm-selected-job span {
            display: block;
            color: #9babb9;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }


        .hm-selected-job strong {
            display: block;
            margin-top: 5px;
            color: #496781;
            font-size: 14px;
            font-weight: 650;
        }


    .hm-job-code {
        flex: none !important;
        padding: 7px 11px;
        background: #edf7ff;
        color: #4c96d9 !important;
        border-radius: 999px;
        font-size: 10px !important;
        font-weight: 700 !important;
    }


    .hm-clear-filter {
        color: #609ed6;
        font-size: 12px;
        font-weight: 650;
        text-decoration: none;
    }


        .hm-clear-filter:hover {
            color: #3487cf;
        }



    /* =========================================================
           STATS
        ========================================================= */

    .hm-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 16px;
        margin-bottom: 28px;
    }


    .hm-stat-card {
        position: relative;
        min-height: 140px;
        padding: 21px 22px;
        overflow: hidden;
        background: rgba(255,255,255,.97);
        border: 1px solid #e2edf6;
        border-radius: 17px;
        box-shadow: 0 8px 28px rgba(76,124,167,.055);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }


        .hm-stat-card:hover {
            transform: translateY(-2px);
            border-color: #d2e6f5;
            box-shadow: 0 12px 32px rgba(65,124,178,.09);
        }


        .hm-stat-card::after {
            content: "";
            position: absolute;
            width: 75px;
            height: 75px;
            right: -20px;
            top: -20px;
            border-radius: 50%;
            background: rgba(80,167,239,.06);
        }


        .hm-stat-card > span {
            display: block;
            margin-bottom: 9px;
            color: #8ea3b6;
            font-size: 12px;
            font-weight: 600;
        }


        .hm-stat-card strong {
            display: block;
            color: #244b6d;
            font-size: 32px;
            font-weight: 800;
            letter-spacing: -0.04em;
        }


        .hm-stat-card small {
            display: block;
            margin-top: 8px;
            color: #9dacba;
            font-size: 11px;
            line-height: 1.4;
        }



    /* =========================================================
           ALERTS
        ========================================================= */

    .hm-alert {
        margin-bottom: 20px;
        padding: 14px 17px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 500;
    }


        .hm-alert.success {
            background: #effbf3;
            border: 1px solid #d5f1df;
            color: #4a9561;
        }


        .hm-alert.error {
            background: #fff3f3;
            border: 1px solid #f3dada;
            color: #c25f5f;
        }



    /* =========================================================
           LIST HEADING
        ========================================================= */

    .hm-list-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        margin: 0 2px 15px;
    }


        .hm-list-heading h2 {
            margin: 0;
            color: #254765;
            font-size: 23px;
            font-weight: 750;
            letter-spacing: -0.025em;
        }


        .hm-list-heading p {
            margin: 5px 0 0;
            color: #98aabd;
            font-size: 13px;
        }



    /* =========================================================
           INTERVIEW LIST
        ========================================================= */

    .hm-review-list {
        display: flex;
        flex-direction: column;
        gap: 18px;
    }



    /* =========================================================
           INTERVIEW CARD
        ========================================================= */

    .hm-review-card {
        overflow: hidden;
        background: rgba(255,255,255,.98);
        border: 1px solid #e1edf6;
        border-radius: 19px;
        box-shadow: 0 9px 30px rgba(75,124,168,.065);
        transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease;
    }


        .hm-review-card:hover {
            transform: translateY(-2px);
            border-color: #d3e7f6;
            box-shadow: 0 14px 38px rgba(66,126,179,.095);
        }



    /* =========================================================
           CANDIDATE TOP
        ========================================================= */

    .hm-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding-right: 24px;
        border-bottom: 1px solid #edf3f8;
        background: linear-gradient( 135deg, #ffffff, #f9fcff );
    }


    .hm-card-candidate {
        display: flex;
        align-items: center;
        gap: 17px;
        padding: 22px 24px;
    }


    .hm-avatar {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient( 135deg, #69b9ff, #3f91e9 );
        color: white;
        font-size: 20px;
        font-weight: 800;
        box-shadow: 0 8px 20px rgba(60,145,228,.20);
    }


    .hm-card-candidate h3 {
        margin: 0;
        color: #294a68;
        font-size: 18px;
        font-weight: 750;
        letter-spacing: -0.025em;
    }


    .hm-card-candidate span {
        display: block;
        margin-top: 4px;
        color: #9aabb9;
        font-size: 13px;
    }


    .hm-card-candidate strong {
        display: block;
        margin-top: 7px;
        color: #58748d;
        font-size: 14px;
        font-weight: 600;
    }


    .hm-card-candidate small {
        display: block;
        margin-top: 3px;
        color: #a7b4c0;
        font-size: 11px;
    }



    /* =========================================================
           RESULT BADGES
        ========================================================= */

    .hm-result-badge {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .025em;
        white-space: nowrap;
    }


        .hm-result-badge.pending {
            background: #fff7e9;
            color: #d2943c;
        }


        .hm-result-badge.passed {
            background: #edf9f1;
            color: #53a36a;
        }


        .hm-result-badge.failed {
            background: #fff0f0;
            color: #ca6363;
        }



    /* =========================================================
           INTERVIEW DETAILS
        ========================================================= */

    .hm-card-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 0;
        padding: 0;
        border-bottom: 1px solid #edf3f8;
    }


        .hm-card-grid > div {
            min-height: 90px;
            padding: 19px 22px;
            border-right: 1px solid #edf3f8;
        }


            .hm-card-grid > div:last-child {
                border-right: 0;
            }


        .hm-card-grid span,
        .hm-data-item > span {
            display: block;
            margin-bottom: 7px;
            color: #9cadbc;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }


        .hm-card-grid strong,
        .hm-data-item strong {
            color: #506e87;
            font-size: 14px;
            font-weight: 650;
        }



    /* =========================================================
           REVIEW DATA
        ========================================================= */

    .hm-review-data {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 0;
        padding: 0;
        background: #f8fbfe;
        border-bottom: 1px solid #edf3f8;
    }


    .hm-data-item {
        min-height: 90px;
        padding: 19px 22px;
        border-right: 1px solid #e7f0f7;
    }


        .hm-data-item:last-child {
            border-right: 0;
        }


        .hm-data-item small {
            display: block;
            margin-top: 5px;
            color: #9faebb;
            font-size: 11px;
        }


    .hm-result-text.pending {
        color: #d0933d;
    }


    .hm-result-text.passed {
        color: #54a36b;
    }


    .hm-result-text.failed {
        color: #c86262;
    }



    /* =========================================================
           CARD FOOTER
        ========================================================= */

    .hm-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 16px 22px;
        background: white;
