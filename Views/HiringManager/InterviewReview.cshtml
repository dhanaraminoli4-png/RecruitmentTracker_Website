@model RecruitmentTracker.Models.Interview

@{
    ViewData["Title"] = "Interview Review";

    var application = Model.JobApplication;
    var candidate = application?.Candidate;
    var vacancy = application?.JobVacancy;

    var candidateName =
        !string.IsNullOrWhiteSpace(candidate?.FullName)
            ? candidate!.FullName!
            : "Unknown Candidate";

    var initials =
        !string.IsNullOrWhiteSpace(candidateName)
            ? candidateName.Substring(0, 1).ToUpperInvariant()
            : "?";

    var assessments =
        Model.Assessments?.ToList()
        ?? new List<RecruitmentTracker.Models.InterviewAssessment>();

    var feedbacks =
        Model.Feedbacks?.ToList()
        ?? new List<RecruitmentTracker.Models.InterviewFeedback>();

    var roundResult =
        string.IsNullOrWhiteSpace(Model.RoundResult)
            ? "Pending"
            : Model.RoundResult;
}

<div class="hm-detail-page">

    <div class="hm-detail-header">
        <div>
            <div class="hm-eyebrow">HIRING MANAGER · INTERVIEW REVIEW</div>
            <h1>@candidateName</h1>
            <p>
                Review the completed assessment, question-by-question evaluation
                and interviewer feedback before making the round decision.
            </p>
        </div>

        <a asp-controller="HiringManager"
           asp-action="InterviewReviews"
           class="hm-back-btn">
            ← Back to Interview Reviews
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="hm-alert success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="hm-alert error">@TempData["Error"]</div>
    }

    <section class="summary-card">
        <div class="candidate-summary">
            <div class="candidate-avatar">@initials</div>

            <div class="candidate-summary-text">
                <h2>@candidateName</h2>
                <span>@(candidate?.Email ?? "")</span>
                <strong>@(vacancy?.JobTitle ?? "Unknown Position")</strong>

                @if (!string.IsNullOrWhiteSpace(vacancy?.JobCode))
                {
                    <small>@vacancy.JobCode</small>
                }
            </div>

            <span class="round-result-badge @roundResult.ToLower()">
                @roundResult
            </span>
        </div>

        <div class="summary-grid">
            <div class="summary-item">
                <span>Interview Round</span>
                <strong>@(Model.InterviewRound?.Name ?? "—")</strong>
            </div>

            <div class="summary-item">
                <span>Interview Type</span>
                <strong>@(Model.InterviewType?.Name ?? "—")</strong>
            </div>

            <div class="summary-item">
                <span>Date</span>
                <strong>@(Model.InterviewDate.ToString("dd MMM yyyy"))</strong>
            </div>

            <div class="summary-item">
                <span>Time</span>
                <strong>@(Model.InterviewTime.ToString(@"hh\:mm"))</strong>
            </div>

            <div class="summary-item">
                <span>Duration</span>
                <strong>@Model.DurationMinutes min</strong>
            </div>

            <div class="summary-item">
                <span>Status</span>
                <strong>@Model.Status</strong>
            </div>

            <div class="summary-item">
                <span>Location</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.Location) ? "—" : Model.Location)</strong>
            </div>

            <div class="summary-item">
                <span>Feedback Status</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.FeedbackStatus) ? "—" : Model.FeedbackStatus)</strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.MeetingLink))
        {
            <div class="meeting-row">
                <span>Meeting Link</span>
                <a href="@Model.MeetingLink" target="_blank" rel="noopener noreferrer">
                    Open Meeting Link
                </a>
            </div>
        }
    </section>

    <div class="section-heading">
        <div>
            <span>ASSESSMENT EVIDENCE</span>
            <h2>Assessment Results</h2>
        </div>

        <p>
            View the exact questions or practical tasks, the recorded interviewer
            evaluation, and the score awarded for each item.
        </p>
    </div>

    @if (assessments.Any())
    {
        @foreach (var assessment in assessments)
        {
            var answers =
            assessment.Answers?
            .OrderBy(a => a.AssessmentQuestion?.DisplayOrder ?? int.MaxValue)
            .ThenBy(a => a.AssessmentQuestionId)
            .ToList()
            ?? new List<RecruitmentTracker.Models.AssessmentAnswer>();

            <section class="assessment-card">
                <div class="assessment-header">
                    <div>
                        <span class="section-kicker">ASSESSMENT</span>
                        <h3>@(assessment.AssessmentTemplate?.Name ?? "Assessment")</h3>

                        @if (!string.IsNullOrWhiteSpace(assessment.AssessmentTemplate?.Description))
                        {
                            <p>@assessment.AssessmentTemplate.Description</p>
                        }
                    </div>

                    <div class="assessment-result-area">
                        @if (assessment.Score.HasValue && assessment.MaxScore.HasValue)
                        {
                            <strong>
                                @assessment.Score.Value.ToString("0.##") / @assessment.MaxScore.Value.ToString("0.##")
                            </strong>
                        }
                        else
                        {
                            <strong>—</strong>
                        }

                    <span class="assessment-result-badge @(assessment.ResultStatus?.ToLower() ?? "pending")">
                        @(assessment.ResultStatus ?? "Pending")
                    </span>
                </div>
            </div>

            <div class="assessment-meta">
                <div>
                    <span>Status</span>
                    <strong>@assessment.Status</strong>
                </div>

                <div>
                    <span>Assessment Date</span>
                    <strong>
                        @(assessment.AssessmentDate.HasValue
                                            ? assessment.AssessmentDate.Value.ToString("dd MMM yyyy")
                                            : "—")
                                              </strong>
                                          </div>

                <div>
                    <span>Evaluated By</span>
                    <strong>
                        @(assessment.ConductedByInterviewer?.FullName
                                            ?? assessment.ConductedByInterviewer?.Email
                                            ?? "—")
                                               </strong>
                                           </div>

                <div>
                    <span>Submitted</span>
                    <strong>
                        @(assessment.SubmittedDate.HasValue
                                            ? assessment.SubmittedDate.Value.ToString("dd MMM yyyy HH:mm")
                                            : "—")
                </strong>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(assessment.Comments))
                {
                    <div class="overall-comment">
                        <span>Overall Assessment Comment</span>
                        <p>@assessment.Comments</p>
                    </div>
                }

                @if (answers.Any())
                {
                    <div class="question-list">
                        @{
                            var questionNumber = 0;
                        }

                        @foreach (var answer in answers)
                        {
                            questionNumber++;

                            var question = answer.AssessmentQuestion;
                            var questionType = question?.QuestionType ?? "Question";

                            var isPractical =
                            questionType == "CodingTask" ||
                            questionType == "PracticalTask";

                            <article class="question-card @(isPractical ? "practical-question" : "")">
                                <div class="question-top">
                                    <div class="question-title-area">
                                        <div class="question-meta-row">
                                            <span class="question-number">Question @questionNumber</span>

                                            <span class="question-type-badge @(isPractical ? "practical" : "")">
                                                @GetQuestionTypeLabel(questionType)
                                            </span>

                                            @if (question?.IsRequired == true)
                                            {
                                                <span class="required-badge">Required</span>
                                            }
                                        </div>

                                        <h4>@(question?.QuestionText ?? "Assessment Question")</h4>
                                    </div>

                                    <div class="question-score">
                                        @if (answer.Score.HasValue)
                                        {
                                            <strong>@answer.Score.Value.ToString("0.##")</strong>

                                            @if (question?.MaximumMarks != null)
                                            {
                                                <span>/ @question.MaximumMarks.Value.ToString("0.##")</span>
                                            }
                                        }
                                        else
                                        {
                                            <strong>—</strong>
                                        }
                                </div>
                            </div>

                            <div class="evaluation-box">
                                <span>
                                    @(isPractical
                                                            ? "Interviewer Evaluation / Practical Result"
                                                            : "Interviewer Notes / Candidate Response")
                    </span>

                    @if (!string.IsNullOrWhiteSpace(answer.AnswerText))
                                    {
                                        <p>@answer.AnswerText</p>
                                    }
                                    else
                                    {
                                        <p class="muted-text">No written evaluation was recorded.</p>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="empty-section">
                        No question-level responses were recorded for this assessment.
                    </div>
                }
            </section>
        }
    }
    else
    {
        <div class="empty-section">
            No assessment was assigned to this interview.
        </div>
    }

    <div class="section-heading feedback-heading">
        <div>
            <span>INTERVIEWER EVALUATION</span>
            <h2>Interviewer Feedback</h2>
        </div>

        <p>
            Structured ratings and written feedback submitted by the interviewer.
        </p>
    </div>

    @if (feedbacks.Any())
    {
        @foreach (var feedback in feedbacks)
        {
            <section class="feedback-card">
                <div class="feedback-header">
                    <div>
                        <span class="section-kicker">INTERVIEWER</span>
                        <h3>
                            @(feedback.Interviewer?.FullName
                                                ?? feedback.Interviewer?.Email
                                                ?? "Interviewer")
                                                             </h3>
                                                             <small>
                                                                 Submitted @(feedback.SubmittedDate.ToString("dd MMM yyyy · HH:mm"))
                                                             </small>
                                                         </div>

                    <div class="recommendation-box">
                        <span>Recommendation</span>
                        <strong>@feedback.Recommendation</strong>
                    </div>
                </div>

                <div class="rating-grid">
                    <div class="rating-box">
                        <span>Technical Knowledge</span>
                        <strong>@feedback.TechnicalRating / 5</strong>
                        <small>@GetStars(feedback.TechnicalRating)</small>
                    </div>

                    <div class="rating-box">
                        <span>Problem Solving</span>
                        <strong>@feedback.ProblemSolvingRating / 5</strong>
                        <small>@GetStars(feedback.ProblemSolvingRating)</small>
                    </div>

                    <div class="rating-box">
                        <span>Communication</span>
                        <strong>@feedback.CommunicationRating / 5</strong>
                        <small>@GetStars(feedback.CommunicationRating)</small>
                    </div>

                    <div class="rating-box">
                        <span>Role / Cultural Fit</span>
                        <strong>@feedback.RoleFitRating / 5</strong>
                        <small>@GetStars(feedback.RoleFitRating)</small>
                    </div>

                    <div class="rating-box">
                        <span>Professionalism</span>
                        <strong>@feedback.ProfessionalismRating / 5</strong>
                        <small>@GetStars(feedback.ProfessionalismRating)</small>
                    </div>

                    <div class="rating-box overall">
                        <span>Overall Rating</span>
                        <strong>@feedback.OverallRating / 5</strong>
                        <small>@GetStars(feedback.OverallRating)</small>
                    </div>
                </div>

                <div class="written-feedback-grid">
                    <div class="written-box strengths-box">
                        <span>Strengths</span>
                        <p>
                            @(string.IsNullOrWhiteSpace(feedback.Strengths)
                                                ? "No strengths were recorded."
                                                : feedback.Strengths)
                                                                 </p>
                                                             </div>

                    <div class="written-box weaknesses-box">
                        <span>Weaknesses / Areas to Improve</span>
                        <p>
                            @(string.IsNullOrWhiteSpace(feedback.Weaknesses)
                                                ? "No weaknesses were recorded."
                                                : feedback.Weaknesses)
                                                                  </p>
                                                              </div>
                                                          </div>

                <div class="written-box comments-box">
                    <span>General Comments</span>
                    <p>
                        @(string.IsNullOrWhiteSpace(feedback.Comments)
                                        ? "No additional comments were recorded."
                                        : feedback.Comments)
            </p>
        </div>
    </section>
        }
    }
    else
    {
        <div class="empty-section">
            No interviewer feedback has been submitted yet.
        </div>
    }

    <section class="decision-card">
        <div class="decision-header">
            <div>
                <span class="section-kicker">HIRING MANAGER DECISION</span>
                <h2>Interview Round Decision</h2>
                <p>
                    Assessment scores and interviewer recommendations are supporting
                    evidence only. Record the Hiring Manager's decision for this round.
                </p>
            </div>

            <span class="round-result-badge @roundResult.ToLower()">
                @roundResult
            </span>
        </div>

        @if (roundResult == "Pending")
        {
            @if (Model.Status == "Completed")
            {
                <form asp-controller="HiringManager"
                      asp-action="DecideRound"
                      method="post"
                      class="decision-form">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="interviewId"
                           value="@Model.Id" />

                    <div class="decision-notes-field">
                        <label for="notes">Decision Notes</label>

                        <textarea id="notes"
                          name="notes"
                          rows="5"
                          placeholder="Add the reason for the decision, key evidence from the assessment and interviewer feedback..."></textarea>
                    </div>

                    <div class="decision-actions">
                        <button type="submit"
                                name="decision"
                                value="Pass"
                                class="decision-btn pass-btn">
                            Pass Round
                        </button>

                        <button type="submit"
                                name="decision"
                                value="Fail"
                                class="decision-btn fail-btn"
                                onclick="return confirm('Fail this interview round? The candidate will not progress to the next round.');">
                            Fail Round
                        </button>
                    </div>
                </form>
            }
            else
            {
                <div class="decision-waiting">
                    <strong>Waiting for interviewer completion</strong>
                    <p>
                        The round decision becomes available after all required
                        assessments and assigned interviewer feedback are submitted.
                    </p>
                </div>
            }
        }
        else
        {
            <div class="decision-recorded">
                <div>
                    <span>Recorded Decision</span>
                    <strong>@roundResult</strong>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.RoundDecisionNotes))
                {
                    <div>
                        <span>Decision Notes</span>
                        <p>@Model.RoundDecisionNotes</p>
                    </div>
                }
            </div>
        }
    </section>
</div>

@functions {

    string GetQuestionTypeLabel(string type)
    {
        return type switch
        {
            "ShortText" => "Short Answer",
            "LongText" => "Long Answer",
            "Rating" => "Rating",
            "YesNo" => "Yes / No",
            "MultipleChoice" => "Multiple Choice",
            "CodingTask" => "Coding Task",
            "PracticalTask" => "Practical Task",
            "Notes" => "Interviewer Notes",
            _ => type
        };
    }

    string GetStars(int rating)
    {
        var safeRating = Math.Clamp(rating, 0, 5);

        return new string('★', safeRating)
            + new string('☆', 5 - safeRating);
    }
}

<style>

@@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');

    .hm-detail-page,
    .hm-detail-page button,
    .hm-detail-page input,
    .hm-detail-page textarea,
    .hm-detail-page select,
    .hm-detail-page a {
        font-family: 'Inter', sans-serif;
    }

    /* =========================================================
           PAGE
        ========================================================= */

    .hm-detail-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 30px;
        color: #34516d;
        min-height: calc(100vh - 60px);
        background: linear-gradient( 135deg, #f8fbff 0%, #eef7ff 45%, #f8fbff 100% );
    }



    /* =========================================================
           HEADER
        ========================================================= */

    .hm-detail-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 24px;
    }


    .hm-eyebrow,
    .section-kicker {
        display: block;
        margin-bottom: 7px;
        color: #69a9e8;
        font-size: 9px;
        font-weight: 800;
        letter-spacing: .11em;
        text-transform: uppercase;
    }


    .hm-detail-header h1 {
        margin: 0;
        color: #183c67;
        font-size: 31px;
        font-weight: 750;
        line-height: 1.2;
    }


    .hm-detail-header p {
        max-width: 720px;
        margin: 8px 0 0;
        color: #8da2b8;
        font-size: 12px;
        line-height: 1.7;
    }


    .hm-back-btn {
        display: inline-flex;
        align-items: center;
        min-height: 42px;
        padding: 0 16px;
        text-decoration: none;
        border: 1px solid #deebf6;
        background: rgba(255,255,255,.95);
        color: #64809a;
        border-radius: 11px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
        box-shadow: 0 5px 20px rgba(66,110,150,.05);
        transition: .2s;
    }


        .hm-back-btn:hover {
            color: #348ad9;
            border-color: #c9e4f8;
            background: #f5fbff;
            transform: translateY(-1px);
        }



    /* =========================================================
           ALERTS
        ========================================================= */

    .hm-alert {
        padding: 13px 16px;
        margin-bottom: 17px;
        border-radius: 11px;
        font-size: 11px;
        box-shadow: 0 5px 20px rgba(77,116,150,.04);
    }


        .hm-alert.success {
            background: #effbf3;
            border: 1px solid #d5f2de;
            color: #4b9561;
        }


        .hm-alert.error {
            background: #fff4f4;
            border: 1px solid #f4dada;
            color: #c45f5f;
        }



    /* =========================================================
           COMMON MAIN CARDS
        ========================================================= */

    .summary-card,
    .assessment-card,
    .feedback-card,
    .decision-card {
        background: rgba(255,255,255,.97);
        border: 1px solid #e2edf6;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 10px 35px rgba(77,125,168,.07);
    }



    /* =========================================================
           CANDIDATE SUMMARY
        ========================================================= */

    .candidate-summary {
        position: relative;
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf3f8;
        background: linear-gradient( 135deg, #ffffff 0%, #f4faff 100% );
    }


        .candidate-summary::after {
            content: "";
            position: absolute;
            width: 170px;
            height: 170px;
            right: -60px;
            top: -70px;
            border-radius: 50%;
            background: rgba(110,183,246,.08);
            pointer-events: none;
        }


    .candidate-avatar {
        width: 53px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 15px;
        background: linear-gradient( 135deg, #69b8ff, #3c91e9 );
        color: white;
        font-weight: 800;
        font-size: 17px;
        box-shadow: 0 7px 18px rgba(62,148,231,.22);
    }


    .candidate-summary-text {
        flex: 1;
        min-width: 0;
    }


        .candidate-summary-text h2 {
            margin: 0;
            color: #244665;
            font-size: 16px;
            font-weight: 750;
        }


        .candidate-summary-text span {
            display: block;
            margin-top: 4px;
            color: #9aacbd;
            font-size: 10px;
        }


        .candidate-summary-text strong {
            display: block;
            margin-top: 8px;
            color: #56738d;
            font-size: 11px;
        }


        .candidate-summary-text small {
            display: block;
            margin-top: 3px;
            color: #a5b3c0;
            font-size: 8px;
        }



    /* =========================================================
           RESULT BADGES
        ========================================================= */

    .round-result-badge,
    .assessment-result-badge {
        position: relative;
        z-index: 2;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 6px 11px;
        border-radius: 999px;
        background: #fff8e9;
        color: #d09739;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .04em;
        white-space: nowrap;
    }


        .round-result-badge.passed,
        .assessment-result-badge.pass,
        .assessment-result-badge.passed {
            background: #edf9f1;
            color: #58a870;
        }


        .round-result-badge.failed,
        .assessment-result-badge.fail,
        .assessment-result-badge.failed {
            background: #fff0f0;
            color: #cd6868;
        }



    /* =========================================================
           SUMMARY GRID
        ========================================================= */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        background: #fff;
    }


    .summary-item {
        position: relative;
        min-height: 78px;
        padding: 17px 20px;
        border-right: 1px solid #edf3f8;
        border-bottom: 1px solid #edf3f8;
    }


        .summary-item:nth-child(4n) {
            border-right: 0;
        }


        .summary-item span,
        .meeting-row > span,
        .assessment-meta span,
        .overall-comment > span,
        .evaluation-box > span,
        .written-box > span,
        .decision-recorded span,
        .recommendation-box span {
            display: block;
            margin-bottom: 5px;
            color: #a1b0bf;
            font-size: 8px;
            font-weight: 750;
            letter-spacing: .06em;
            text-transform: uppercase;
        }


        .summary-item strong {
            color: #47647e;
            font-size: 11px;
            font-weight: 700;
        }



    /* =========================================================
           MEETING LINK
        ========================================================= */

    .meeting-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 14px 20px;
        background: #fbfdff;
    }


        .meeting-row > span {
            margin: 0;
        }


        .meeting-row a {
            display: inline-flex;
            align-items: center;
            min-height: 34px;
            padding: 0 12px;
            text-decoration: none;
            background: #edf7ff;
            color: #4c9ee8;
            border-radius: 8px;
            font-size: 9px;
            font-weight: 750;
            transition: .2s;
        }


            .meeting-row a:hover {
                background: #e2f2ff;
                color: #3189dc;
            }



    /* =========================================================
           SECTION HEADINGS
        ========================================================= */

    .section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 25px;
        margin: 30px 2px 13px;
    }


        .section-heading > div > span {
            display: block;
            margin-bottom: 5px;
            color: #73abe0;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .1em;
        }


        .section-heading h2 {
            margin: 0;
            color: #254867;
            font-size: 18px;
            font-weight: 750;
        }


        .section-heading p {
            max-width: 540px;
            margin: 0;
            color: #98aabd;
            font-size: 9px;
            line-height: 1.6;
            text-align: right;
        }



    /* =========================================================
           ASSESSMENTS
        ========================================================= */

    .assessment-card + .assessment-card,
    .feedback-card + .feedback-card {
        margin-top: 16px;
    }


    .assessment-header,
    .feedback-header,
    .decision-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 22px;
        border-bottom: 1px solid #edf3f8;
        background: linear-gradient( 135deg, #ffffff, #f9fcff );
    }


        .assessment-header h3,
        .feedback-header h3,
        .decision-header h2 {
            margin: 0;
            color: #274967;
            font-size: 14px;
            font-weight: 750;
        }


        .assessment-header p,
        .decision-header p {
            max-width: 720px;
            margin: 6px 0 0;
            color: #9babbc;
            font-size: 9px;
            line-height: 1.6;
        }


    .assessment-result-area {
        min-width: 110px;
        text-align: right;
    }


        .assessment-result-area > strong {
            display: block;
            margin-bottom: 6px;
            color: #2c4e6e;
            font-size: 20px;
            font-weight: 750;
        }



    /* =========================================================
           ASSESSMENT META
        ========================================================= */

    .assessment-meta {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        background: #fbfdff;
        border-bottom: 1px solid #edf3f8;
    }


        .assessment-meta > div {
            padding: 14px 20px;
            border-right: 1px solid #edf3f8;
        }


            .assessment-meta > div:last-child {
                border-right: 0;
            }


        .assessment-meta strong {
            color: #607990;
            font-size: 9px;
        }



    /* =========================================================
           OVERALL COMMENT
        ========================================================= */

    .overall-comment {
        padding: 16px 20px;
        background: #f7fbff;
        border-bottom: 1px solid #edf3f8;
    }


        .overall-comment p,
        .evaluation-box p,
        .written-box p,
        .decision-recorded p {
            margin: 0;
            color: #60778d;
            font-size: 10px;
            line-height: 1.7;
            white-space: pre-wrap;
        }



    /* =========================================================
           QUESTIONS
        ========================================================= */

    .question-list {
        display: flex;
        flex-direction: column;
        gap: 13px;
        padding: 20px;
    }


    .question-card {
        overflow: hidden;
        background: white;
        border: 1px solid #e4eef6;
        border-radius: 13px;
        box-shadow: 0 5px 18px rgba(65,105,143,.035);
        transition: transform .2s, box-shadow .2s;
    }


        .question-card:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(65,105,143,.07);
        }


        .question-card.practical-question {
            border-color: #cfe7fb;
        }


    .question-top {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        padding: 15px 17px;
        background: #f9fcff;
        border-bottom: 1px solid #edf3f8;
    }


    .practical-question
    .question-top {
        background: linear-gradient( 135deg, #f6fbff, #eef7ff );
    }


    .question-title-area {
        flex: 1;
        min-width: 0;
    }


    .question-meta-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-bottom: 8px;
    }


    .question-number {
        color: #7991a8;
        font-size: 8px;
        font-weight: 800;
    }


    .question-type-badge,
    .required-badge {
        padding: 4px 8px;
        border-radius: 999px;
        font-size: 7px;
        font-weight: 750;
    }


    .question-type-badge {
        background: #edf6fd;
        color: #5d91bd;
    }


        .question-type-badge.practical {
            background: #eaf4ff;
            color: #418fd7;
        }


    .required-badge {
        background: #fff5e9;
        color: #d2954e;
    }


    .question-top h4 {
        margin: 0;
        color: #47647d;
        font-size: 11px;
        font-weight: 650;
        line-height: 1.55;
        white-space: pre-wrap;
    }


    .question-score {
        min-width: 80px;
        align-self: center;
        text-align: right;
    }


        .question-score strong {
            color: #378ddb;
            font-size: 20px;
            font-weight: 750;
        }


        .question-score span {
            color: #9eb0c0;
            font-size: 9px;
            font-weight: 600;
        }


    .evaluation-box {
        padding: 15px 17px;
        background: white;
    }


    .muted-text {
        color: #a8b5c1 !important;
        font-style: italic;
    }



    /* =========================================================
           FEEDBACK
        ========================================================= */

    .feedback-header small {
        display: block;
        margin-top: 5px;
        color: #a1b0bf;
        font-size: 8px;
    }


    .recommendation-box {
        min-width: 140px;
        padding: 11px 13px;
        background: #eef7ff;
        border: 1px solid #d4eafa;
        border-radius: 11px;
    }


        .recommendation-box strong {
            color: #438fd6;
            font-size: 11px;
        }



    /* =========================================================
           RATINGS
        ========================================================= */

    .rating-grid {
        display: grid;
        grid-template-columns: repeat(6, minmax(0,1fr));
        gap: 10px;
        padding: 18px 20px;
        border-bottom: 1px solid #edf3f8;
    }


    .rating-box {
        min-height: 92px;
        padding: 13px;
        background: #f9fcff;
        border: 1px solid #e5eff7;
        border-radius: 12px;
    }


        .rating-box.overall {
            background: linear-gradient( 135deg, #eaf6ff, #f6fbff );
            border-color: #cfe7fb;
        }


        .rating-box > span {
            display: block;
            margin-bottom: 6px;
            color: #99aabc;
            font-size: 7px;
            line-height: 1.4;
        }


        .rating-box strong {
            display: block;
            color: #52708a;
            font-size: 12px;
        }


        .rating-box.overall strong {
            color: #378cda;
        }


        .rating-box small {
            display: block;
            margin-top: 7px;
            color: #efb652;
            font-size: 11px;
            letter-spacing: 1px;
        }



    /* =========================================================
           WRITTEN FEEDBACK
        ========================================================= */

    .written-feedback-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        padding: 18px 20px 0;
    }


    .written-box {
        padding: 15px 16px;
        background: #fafcff;
        border: 1px solid #e5eef6;
        border-radius: 12px;
    }


    .strengths-box {
        background: #f4fbf7;
        border-color: #daf1e2;
    }


        .strengths-box > span {
            color: #6da47e;
        }


    .weaknesses-box {
        background: #fffafa;
        border-color: #f4e2e2;
    }


        .weaknesses-box > span {
            color: #c18383;
        }


    .comments-box {
        margin: 12px 20px 19px;
        background: #f8fbfe;
    }



    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-section {
        padding: 40px 20px;
        background: rgba(255,255,255,.96);
        border: 1px dashed #cfe0ee;
        border-radius: 16px;
        color: #9cacbc;
        text-align: center;
        font-size: 10px;
        box-shadow: 0 8px 25px rgba(72,120,162,.04);
    }



    /* =========================================================
           DECISION SECTION
        ========================================================= */

    .decision-card {
        margin-top: 30px;
        border-color: #dcebf7;
        box-shadow: 0 12px 38px rgba(64,124,177,.09);
    }


    .decision-header {
        background: linear-gradient( 135deg, #f4faff, #ffffff );
    }


    .decision-form {
        padding: 21px 22px 22px;
    }


    .decision-notes-field label {
        display: block;
        margin-bottom: 7px;
        color: #698197;
        font-size: 9px;
        font-weight: 750;
    }


    .decision-notes-field textarea {
        width: 100%;
        min-height: 120px;
        padding: 13px 14px;
        resize: vertical;
        outline: none;
        background: #fbfdff;
        color: #4c667e;
        border: 1px solid #dce9f3;
        border-radius: 11px;
        font-family: inherit;
        font-size: 10px;
        line-height: 1.6;
        transition: .2s;
    }


        .decision-notes-field textarea:focus {
            background: white;
            border-color: #87c3f2;
            box-shadow: 0 0 0 4px rgba(86,165,231,.09);
        }


        .decision-notes-field textarea::placeholder {
            color: #b4c0cb;
        }


    .decision-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 15px;
    }


    .decision-btn {
        min-width: 125px;
        border: 0;
        border-radius: 10px;
        padding: 11px 18px;
        cursor: pointer;
        font-size: 10px;
        font-weight: 750;
        transition: transform .2s, box-shadow .2s;
    }


        .decision-btn:hover {
            transform: translateY(-1px);
        }


    .pass-btn {
        background: linear-gradient( 135deg, #62c887, #44ad6a );
        color: white;
        box-shadow: 0 7px 17px rgba(72,176,110,.18);
    }


    .fail-btn {
        background: linear-gradient( 135deg, #e87979, #cc5c5c );
        color: white;
        box-shadow: 0 7px 17px rgba(201,88,88,.17);
    }



    /* =========================================================
           WAITING DECISION
        ========================================================= */

    .decision-waiting {
        padding: 19px 21px;
        background: #fffaf0;
    }


        .decision-waiting strong {
            color: #c58c3f;
            font-size: 10px;
        }


        .decision-waiting p {
            margin: 5px 0 0;
            color: #a38863;
            font-size: 9px;
            line-height: 1.6;
        }



    /* =========================================================
           RECORDED DECISION
        ========================================================= */

    .decision-recorded {
        display: grid;
        grid-template-columns: 180px 1fr;
        gap: 20px;
        padding: 20px 22px;
        background: #fbfdff;
    }


        .decision-recorded strong {
            color: #4e6b84;
            font-size: 11px;
        }



    /* =========================================================
           EXTRA POLISH
        ========================================================= */

    .summary-card,
    .assessment-card,
    .feedback-card,
    .decision-card,
    .question-card,
    .rating-box,
    .written-box {
        transition: box-shadow .2s ease, border-color .2s ease;
