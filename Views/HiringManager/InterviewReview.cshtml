            margin-top: 7px;
            color: #475467;
            font-size: 12px;
        }

        .candidate-summary-text small {
            display: block;
            margin-top: 2px;
            color: #98a2b3;
            font-size: 9px;
        }

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .summary-item {
        padding: 15px 20px;
        border-bottom: 1px solid #edf0f3;
    }

