        align-items: center;
        gap: 14px;
        padding: 19px 20px;
        border-bottom: 1px solid #edf0f3;
    }

    .candidate-avatar {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: #eef2ff;
