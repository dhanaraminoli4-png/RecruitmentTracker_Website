    }

    .question-type-badge {
        background: #f2f4f7;
        color: #475467;
    }

        .question-type-badge.practical {
            background: #eef4ff;
            color: #3538cd;
        }

    .required-badge {
        background: #fff6ed;
        color: #c4320a;
    }

    .question-top h4 {
        margin: 0;
        color: #344054;
        font-size: 12px;
        line-height: 1.5;
        white-space: pre-wrap;
    }

    .question-score {
        min-width: 80px;
        text-align: right;
        align-self: center;
