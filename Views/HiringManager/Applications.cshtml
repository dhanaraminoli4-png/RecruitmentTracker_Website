@model IEnumerable<RecruitmentTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Candidate Review";

    var applications =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.JobApplication>();

    var jobs =
        ViewBag.Jobs as
        List<RecruitmentTracker.Models.JobVacancy>
        ?? new List<RecruitmentTracker.Models.JobVacancy>();

    int? selectedJobId = ViewBag.SelectedJobId;

    string selectedStatus =
        ViewBag.SelectedStatus as string ?? "all";

    string selectedJobTitle =
        ViewBag.SelectedJobTitle as string ?? "All Jobs";

    string selectedJobCode =
        ViewBag.SelectedJobCode as string ?? "";

    var pendingCount =
        applications.Count(a =>
            !a.HiringManagerReviewed);

    var approvedCount =
        applications.Count(a =>
            a.HiringManagerReviewed &&
            a.HiringManagerDecision ==
            "ApprovedForInterview");

    var rejectedCount =
        applications.Count(a =>
            a.HiringManagerReviewed &&
            a.HiringManagerDecision ==
            "Rejected");
}

<style>

    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap');


    /* =========================================================
           PAGE
        ========================================================= */

    .hm-page {
        min-height: calc(100vh - 80px);
        padding: 30px 45px 60px;
        background: linear-gradient( 135deg, #f8fbff 0%, #eef7ff 45%, #f8fbff 100% );
        font-family: 'Inter', sans-serif;
    }


    .hm-wrapper {
        max-width: 1450px;
        margin: 0 auto;
    }


    .hm-page *,
    .hm-page button,
    .hm-page input,
    .hm-page select,
    .hm-page a {
        font-family: 'Inter', sans-serif;
    }



    /* =========================================================
           HEADER
        ========================================================= */

    .hm-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 27px;
    }


    .hm-label {
        margin-bottom: 8px;
        color: #68a9e8;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .11em;
        text-transform: uppercase;
    }


    .hm-header h1 {
        margin: 0 0 7px;
        color: #183c67;
        font-size: 38px;
        font-weight: 800;
        line-height: 1.15;
        letter-spacing: -0.04em;
    }


    .hm-header p {
        max-width: 650px;
        margin: 0;
        color: #879db2;
        font-size: 15px;
        font-weight: 400;
        line-height: 1.65;
    }



    /* =========================================================
           FILTER CARD
        ========================================================= */

    .hm-filter-card {
        position: relative;
        margin-bottom: 24px;
        padding: 24px 26px;
        overflow: hidden;
        background: linear-gradient( 135deg, #ffffff, #f8fcff );
        border: 1px solid #e0edf7;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(76,125,170,.07);
    }


        .hm-filter-card::after {
            content: "";
            position: absolute;
            width: 190px;
            height: 190px;
            right: -75px;
            top: -85px;
            border-radius: 50%;
            background: rgba(96,177,244,.07);
            pointer-events: none;
        }


    .hm-filter-row {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: flex-end;
        gap: 14px;
        flex-wrap: wrap;
    }


    .hm-filter-group {
        min-width: 280px;
    }


        .hm-filter-group label {
            display: block;
            margin-bottom: 8px;
            color: #617b94;
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .04em;
        }


    .hm-select {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        outline: none;
        background: white;
        border: 1px solid #dbe8f2;
        border-radius: 11px;
        color: #506d86;
        font-size: 14px;
        font-weight: 500;
        transition: .2s ease;
    }


        .hm-select:hover {
            border-color: #bedcf2;
        }


        .hm-select:focus {
            border-color: #75b8ec;
            box-shadow: 0 0 0 4px rgba(80,164,231,.10);
        }



    /* =========================================================
           FILTER BUTTONS
        ========================================================= */

    .filter-btn,
    .clear-btn {
        min-height: 48px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 19px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        transition: .2s ease;
    }


    .filter-btn {
        border: none;
        background: linear-gradient( 135deg, #64b6ff, #368ce7 );
        color: white;
        box-shadow: 0 7px 18px rgba(54,141,229,.18);
    }


        .filter-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 22px rgba(54,141,229,.24);
        }


    .clear-btn {
        border: 1px solid #dbe8f2;
        background: white;
        color: #66829b;
        text-decoration: none;
    }


        .clear-btn:hover {
            color: #3488d5;
            border-color: #cbe3f5;
            background: #f8fcff;
        }



    /* =========================================================
           STATS
        ========================================================= */

    .hm-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0,1fr));
        gap: 16px;
        margin-bottom: 27px;
    }


    .hm-stat {
        position: relative;
        min-height: 135px;
        padding: 22px;
        overflow: hidden;
        background: rgba(255,255,255,.97);
        border: 1px solid #e2edf6;
        border-radius: 17px;
        box-shadow: 0 8px 28px rgba(76,124,167,.055);
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }


        .hm-stat:hover {
            transform: translateY(-2px);
            border-color: #d3e7f5;
            box-shadow: 0 12px 32px rgba(65,124,178,.09);
        }


        .hm-stat::after {
            content: "";
            position: absolute;
            width: 80px;
            height: 80px;
            right: -20px;
            top: -20px;
            border-radius: 50%;
            background: rgba(80,167,239,.06);
        }


    .hm-stat-label {
        margin-bottom: 10px;
        color: #8ea3b6;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .07em;
    }


    .hm-stat-value {
        color: #244b6d;
        font-size: 32px;
        font-weight: 800;
        letter-spacing: -0.04em;
    }



    /* =========================================================
           TABLE CARD
        ========================================================= */

    .hm-table-card {
        overflow: hidden;
        background: rgba(255,255,255,.98);
        border: 1px solid #e1edf6;
        border-radius: 20px;
        box-shadow: 0 10px 34px rgba(75,124,168,.07);
    }



    /* =========================================================
           TABLE HEADER
        ========================================================= */

    .hm-table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 22px 24px;
        border-bottom: 1px solid #edf3f8;
        background: linear-gradient( 135deg, #ffffff, #f9fcff );
    }


        .hm-table-header h4 {
            margin: 0;
            color: #254765;
            font-size: 22px;
            font-weight: 750;
            letter-spacing: -0.025em;
        }


        .hm-table-header p {
            margin: 5px 0 0;
            color: #98aabd;
            font-size: 13px;
        }


    .hm-count {
        padding: 7px 12px;
        background: #edf7ff;
        color: #4c96d9;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }



    /* =========================================================
           BULK TOOLBAR
        ========================================================= */

    .bulk-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 16px 22px;
        border-bottom: 1px solid #edf3f8;
        background: #f8fbfe;
    }


    .bulk-text {
        color: #7890a6;
        font-size: 13px;
    }


    .bulk-actions {
        display: flex;
        gap: 9px;
        flex-wrap: wrap;
    }


    .bulk-btn {
        min-height: 38px;
        padding: 0 14px;
        border-radius: 9px;
        font-size: 12px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }


    .select-btn {
        background: white;
        border: 1px solid #dbe8f2;
        color: #627d96;
    }


        .select-btn:hover {
            color: #358ad7;
            border-color: #cce4f7;
        }


    .approve-btn {
        background: #edf9f1;
        border: 1px solid #cfead8;
        color: #52996a;
    }


        .approve-btn:hover {
            background: #e2f6e9;
        }


    .reject-btn {
        background: #fff1f1;
        border: 1px solid #f2d5d5;
        color: #c66363;
    }


        .reject-btn:hover {
            background: #ffe7e7;
        }



    /* =========================================================
           TABLE
        ========================================================= */

    .table-responsive {
        overflow-x: auto;
    }


    .hm-table {
        width: 100%;
        min-width: 1120px;
        margin: 0;
        border-collapse: collapse;
    }


        .hm-table thead {
            background: linear-gradient( 135deg, #3f93df, #67b6fb );
        }


        .hm-table th {
            padding: 15px 15px;
            color: white;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-align: left;
            white-space: nowrap;
        }


        .hm-table td {
            padding: 17px 15px;
            border-bottom: 1px solid #edf3f8;
            vertical-align: middle;
            color: #5d748a;
            font-size: 13px;
        }


        .hm-table tbody tr {
            transition: .15s ease;
        }


            .hm-table tbody tr:hover {
                background: #f8fcff;
            }



    /* =========================================================
           CHECKBOXES
        ========================================================= */

    .select-column {
        width: 48px;
        text-align: center;
    }


    .candidate-checkbox,
    #selectAllCheckbox {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #4c9ee8;
    }



    /* =========================================================
           CANDIDATE
        ========================================================= */

    .candidate-box {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 220px;
    }


    .candidate-avatar {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: linear-gradient( 135deg, #69b8ff, #3f91e9 );
        color: white;
        font-size: 15px;
        font-weight: 800;
        box-shadow: 0 6px 15px rgba(62,148,231,.17);
    }


    .candidate-name {
        color: #294a68;
        font-size: 14px;
        font-weight: 700;
        letter-spacing: -0.015em;
    }


    .candidate-email {
        margin-top: 4px;
        color: #9dadbb;
        font-size: 11px;
    }



    /* =========================================================
           JOB
        ========================================================= */

    .job-name {
        color: #49677f;
        font-size: 13px;
        font-weight: 650;
    }


    .job-code {
        margin-top: 4px;
        color: #9faeba;
        font-size: 11px;
    }



    /* =========================================================
           AI SCORE
        ========================================================= */

    .score-value {
        color: #2c5578;
        font-size: 14px;
        font-weight: 750;
    }


    .score-bar {
        width: 95px;
        height: 7px;
        margin-top: 7px;
        overflow: hidden;
        background: #e8f0f6;
        border-radius: 999px;
    }


    .score-fill {
        height: 100%;
        background: linear-gradient( 90deg, #61b3fb, #368de8 );
        border-radius: 999px;
    }



    /* =========================================================
           BADGES
        ========================================================= */

    .hm-badge {
        display: inline-flex;
        align-items: center;
        padding: 7px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }


    .badge-pending {
        background: #fff7e9;
        color: #d0933d;
    }


    .badge-approved {
        background: #edf9f1;
        color: #54a36b;
    }


    .badge-rejected {
        background: #fff0f0;
        color: #c86262;
    }



    /* =========================================================
           ACTION BUTTONS
        ========================================================= */

    .action-buttons {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }


    .action-btn {
        min-height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0 12px;
        border: 1px solid #dce8f2;
        background: white;
        color: #647f97;
        border-radius: 9px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 650;
        transition: .2s ease;
    }


        .action-btn:hover {
            color: #358bd8;
            background: #f5fbff;
            border-color: #cbe4f6;
            transform: translateY(-1px);
        }


    .review-btn {
        border-color: transparent;
        background: linear-gradient( 135deg, #64b6ff, #368ce7 );
        color: white;
        box-shadow: 0 6px 15px rgba(54,141,229,.16);
    }


        .review-btn:hover {
            color: white;
            background: linear-gradient( 135deg, #58affc, #2e83dd );
            border-color: transparent;
            box-shadow: 0 8px 18px rgba(54,141,229,.22);
        }



    /* =========================================================
           EMPTY
        ========================================================= */

    .hm-empty {
        padding: 65px 24px;
        text-align: center;
    }


        .hm-empty h5 {
            margin: 0;
            color: #34536f;
            font-size: 18px;
            font-weight: 700;
        }


        .hm-empty p {
            margin: 8px 0 0;
            color: #96a8b9;
            font-size: 14px;
        }



    /* =========================================================
           BOOTSTRAP ALERT OVERRIDES
        ========================================================= */

    .hm-page .alert {
        margin-bottom: 20px;
        padding: 14px 17px;
        border-radius: 11px;
        font-size: 13px;
        box-shadow: 0 5px 18px rgba(72,113,149,.04);
    }


    .hm-page .alert-success {
        background: #effbf3;
        border-color: #d5f1df;
        color: #4a9561;
    }


    .hm-page .alert-danger {
        background: #fff3f3;
        border-color: #f3dada;
        color: #c25f5f;
    }



    /* =========================================================
           RESPONSIVE - TABLET
        ========================================================= */

    @@media (max-width: 1000px) {

        .hm-page {
            padding: 25px 22px 50px;
        }


        .hm-stats {
            grid-template-columns: repeat(2, minmax(0,1fr));
        }


        .hm-filter-group {
            flex: 1;
            min-width: 230px;
        }
    }



    /* =========================================================
           RESPONSIVE - MOBILE
        ========================================================= */

    @@media (max-width: 700px) {

        .hm-page {
            padding: 18px;
        }


        .hm-header {
            flex-direction: column;
        }


            .hm-header h1 {
                font-size: 30px;
            }


            .hm-header p {
                font-size: 14px;
            }


        .hm-filter-card {
            padding: 20px;
        }


        .hm-filter-row {
            flex-direction: column;
            align-items: stretch;
        }


        .hm-filter-group {
            width: 100%;
            min-width: 0;
        }


        .filter-btn,
        .clear-btn {
            width: 100%;
        }


        .hm-stats {
            grid-template-columns: 1fr;
        }


        .hm-table-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .bulk-toolbar {
            align-items: stretch;
            flex-direction: column;
        }


        .bulk-actions {
            width: 100%;
        }


        .bulk-btn {
            flex: 1;
        }
    }



    /* =========================================================
           SMALL MOBILE
        ========================================================= */

    @@media (max-width: 480px) {

        .hm-page {
            padding: 14px;
        }


        .hm-header h1 {
            font-size: 27px;
        }


        .hm-stat-value {
            font-size: 29px;
        }


        .bulk-actions {
            flex-direction: column;
        }


        .bulk-btn {
            width: 100%;
        }
    }
</style>

<div class="hm-page">
    <div class="hm-wrapper">

        <div class="hm-header">
            <div>
                <div class="hm-label">
                    HIRING MANAGER WORKSPACE
                </div>

                <h1>Candidate Review</h1>

                <p>
                    Review candidates forwarded by HR and approve
                    suitable candidates for interviews.
                </p>
            </div>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">
                @TempData["Success"]
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- JOB + STATUS FILTER -->
        <div class="hm-filter-card">

            <form method="get"
                  asp-controller="HiringManager"
                  asp-action="Applications">

                <div class="hm-filter-row">

                    <!-- JOB VACANCY -->
                    <div class="hm-filter-group">

                        <label>JOB VACANCY</label>

                        <select name="jobId"
                                class="hm-select"
                                onchange="this.form.submit()">

                            <option value="">
                                All Job Vacancies
                            </option>

                            @foreach (var job in jobs)
                            {
                                if (selectedJobId == job.Id)
                                {
                                    <option value="@job.Id" selected>
                                        @job.JobTitle
                                        @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                        {
                                            <text> - @job.JobCode</text>
                                        }
                                    </option>
                                }
                                else
                                {
                                    <option value="@job.Id">
                                        @job.JobTitle
                                        @if (!string.IsNullOrWhiteSpace(job.JobCode))
                                        {
                                            <text> - @job.JobCode</text>
                                        }
                                    </option>
                                }
                            }

                        </select>

                    </div>


                    <!-- HM DECISION -->
                    <div class="hm-filter-group">

                        <label>HM DECISION</label>

                        <select name="status"
                                class="hm-select">

                            @if (selectedStatus == "all")
                            {
                                <option value="all" selected>
                                    All Candidates
                                </option>
                            }
                            else
                            {
                                <option value="all">
                                    All Candidates
                                </option>
                            }

                            @if (selectedStatus == "pending")
                            {
                                <option value="pending" selected>
                                    Pending Review
                                </option>
                            }
                            else
                            {
                                <option value="pending">
                                    Pending Review
                                </option>
                            }

                            @if (selectedStatus == "approved")
                            {
                                <option value="approved" selected>
                                    Approved for Interview
                                </option>
                            }
                            else
                            {
                                <option value="approved">
                                    Approved for Interview
                                </option>
                            }

                            @if (selectedStatus == "rejected")
                            {
                                <option value="rejected" selected>
                                    Rejected
                                </option>
                            }
                            else
                            {
                                <option value="rejected">
                                    Rejected
                                </option>
                            }

                        </select>

                    </div>


                    <button type="submit"
                            class="filter-btn">
                        Apply Filter
                    </button>


                    <a asp-controller="HiringManager"
                       asp-action="Applications"
                       class="clear-btn">
                        Clear
                    </a>

                </div>

            </form>

        </div>

        <!-- STATS -->
        <div class="hm-stats">

            <div class="hm-stat">
                <div class="hm-stat-label">
                    CURRENT RESULTS
                </div>

                <div class="hm-stat-value">
                    @applications.Count
                </div>
            </div>

            <div class="hm-stat">
                <div class="hm-stat-label">
                    PENDING REVIEW
                </div>

                <div class="hm-stat-value">
                    @pendingCount
                </div>
            </div>

            <div class="hm-stat">
                <div class="hm-stat-label">
                    APPROVED FOR INTERVIEW
                </div>

                <div class="hm-stat-value">
                    @approvedCount
                </div>
            </div>

            <div class="hm-stat">
                <div class="hm-stat-label">
                    REJECTED
                </div>

                <div class="hm-stat-value">
                    @rejectedCount
                </div>
            </div>

        </div>

        <div class="hm-table-card">

            <div class="hm-table-header">

                <div>
                    <h4>Candidate Queue</h4>

                    <p>
                        Select a job before using bulk
                        approval or rejection.
                    </p>
                </div>

                <span class="hm-count">
                    @applications.Count candidate@(applications.Count == 1 ? "" : "s")
                </span>

            </div>

            @if (!applications.Any())
            {
                <div class="hm-empty">

                    <h5>No candidates found</h5>

                    <p>
                        No forwarded candidates match
                        the selected filters.
                    </p>

                </div>
            }
            else
            {
                <form method="post"
                      id="bulkCandidateForm">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           name="jobId"
                           value="@selectedJobId" />

                    @if (selectedJobId.HasValue)
                    {
                        <div class="bulk-toolbar">

                            <div class="bulk-text"
                                 id="selectionText">
                                Select candidates from this job
                                to approve or reject.
                            </div>

                            <div class="bulk-actions">

                                <button type="button"
                                        id="selectAllBtn"
                                        class="bulk-btn select-btn">
                                    Select All
                                </button>

                                <button type="submit"
                                        formaction="@Url.Action("BulkApprove", "HiringManager")"
                                        class="bulk-btn approve-btn">
                                    Approve Selected
                                </button>

                                <button type="submit"
                                        formaction="@Url.Action("BulkReject", "HiringManager")"
                                        class="bulk-btn reject-btn">
                                    Reject Selected
                                </button>

                            </div>

                        </div>
                    }

                    <div class="table-responsive">

                        <table class="hm-table">

                            <thead>
                                <tr>

                                    @if (selectedJobId.HasValue)
                                    {
                                        <th class="select-column">
                                            <input type="checkbox"
                                                   id="selectAllCheckbox" />
                                        </th>
                                    }

                                    <th>CANDIDATE</th>
                                    <th>POSITION</th>
                                    <th>AI MATCH</th>
                                    <th>HM DECISION</th>
                                    <th>ACTIONS</th>

                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var application in applications)
                                {
                                    var candidateName =
                                    application.Candidate?.FullName
                                    ?? "Unknown Candidate";

                                    var candidateEmail =
                                    application.Candidate?.Email
                                    ?? "-";

                                    var firstLetter =
                                    !string.IsNullOrWhiteSpace(candidateName)
                                    ? candidateName.Substring(0, 1).ToUpper()
                                    : "?";

                                    <tr>

                                        @if (selectedJobId.HasValue)
                                        {
                                            <td class="select-column">

                                                <input type="checkbox"
                                                       class="candidate-checkbox"
                                                       name="selectedIds"
                                                       value="@application.Id" />

                                            </td>
                                        }

                                    <td>
                                        <div class="candidate-box">

                                            <div class="candidate-avatar">
                                                @firstLetter
                                            </div>

                                            <div>
                                                <div class="candidate-name">
                                                    @candidateName
                                                </div>

                                                <div class="candidate-email">
                                                    @candidateEmail
                                                </div>
                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <div class="job-name">
                                            @(application.JobVacancy?.JobTitle
                                                                                    ?? "Unknown Position")
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(
                                                                        application.JobVacancy?.JobCode))
                                            {
                                                <div class="job-code">
                                                    @application.JobVacancy.JobCode
                                                </div>
                                            }
                                        </td>

                                        <td>

                                            <div class="score-value">
                                                @application.AIScore.ToString("0.0")%
                                            </div>

                                            <div class="score-bar">

                                                <div class="score-fill"
                                                     style="width:@Math.Min(application.AIScore, 100)%">
                                                </div>

                                            </div>

                                        </td>

                                        <td>

                                            @if (!application.HiringManagerReviewed)
                                            {
                                                <span class="hm-badge badge-pending">
                                                    Pending Review
                                                </span>
                                            }
                                            else if (
                                            application.HiringManagerDecision ==
                                            "ApprovedForInterview")
                                            {
                                                <span class="hm-badge badge-approved">
                                                    Approved for Interview
                                                </span>
                                            }
                                            else if (
                                            application.HiringManagerDecision ==
                                            "Rejected")
                                            {
                                                <span class="hm-badge badge-rejected">
                                                    Rejected
                                                </span>
                                            }

                                        </td>

                                        <td>

                                            <div class="action-buttons">

                                                <a asp-controller="HiringManager"
                                                   asp-action="Review"
                                                   asp-route-id="@application.Id"
                                                   class="action-btn review-btn">
                                                    Review
                                                </a>

                                                <a asp-controller="HiringManager"
                                                   asp-action="AIAnalysis"
                                                   asp-route-id="@application.Id"
                                                   class="action-btn">
                                                    AI Analysis
                                                </a>

                                                @if (!string.IsNullOrWhiteSpace(
                                                                                        application.CVFilePath))
                                                {
                                                    <a asp-controller="HiringManager"
                                                       asp-action="ViewCV"
                                                       asp-route-id="@application.Id"
                                                       target="_blank"
                                                       class="action-btn">
                                                        CV
                                                    </a>
                                                }

                                                @if (!string.IsNullOrWhiteSpace(
                                                                                        application.CoverLetterFilePath))
                                                {
                                                    <a asp-controller="HiringManager"
                                                       asp-action="ViewCoverLetter"
                                                       asp-route-id="@application.Id"
                                                       target="_blank"
                                                       class="action-btn">
                                                        Cover Letter
                                                    </a>
                                                }

                                            </div>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </form>
            }

        </div>

    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const form =
            document.getElementById("bulkCandidateForm");

        if (!form) {
            return;
        }

        const checkboxes =
            Array.from(
                document.querySelectorAll(
                    ".candidate-checkbox"
                )
            );

        const selectAll =
            document.getElementById(
                "selectAllCheckbox"
            );

        const selectAllBtn =
            document.getElementById(
                "selectAllBtn"
            );

        const selectionText =
            document.getElementById(
                "selectionText"
            );

        function updateSelection() {

            const selected =
                checkboxes.filter(x => x.checked);

            if (selectionText) {
                selectionText.textContent =
                    selected.length === 0
                    ? "Select candidates from this job to approve or reject."
                    : selected.length +
                      " candidate(s) selected.";
            }

            if (selectAll) {
                selectAll.checked =
                    checkboxes.length > 0 &&
                    selected.length ===
                    checkboxes.length;
            }
        }

        checkboxes.forEach(x => {
            x.addEventListener(
                "change",
                updateSelection
            );
        });

        if (selectAll) {
            selectAll.addEventListener(
                "change",
                function () {

                    checkboxes.forEach(x =>
                        x.checked =
                            selectAll.checked);

                    updateSelection();
                }
            );
        }

        if (selectAllBtn) {
            selectAllBtn.addEventListener(
                "click",
                function () {

                    const shouldSelect =
                        checkboxes.some(
                            x => !x.checked
                        );

                    checkboxes.forEach(
                        x => x.checked =
                            shouldSelect
                    );

                    selectAllBtn.textContent =
                        shouldSelect
                        ? "Clear All"
                        : "Select All";

                    updateSelection();
                }
            );
        }

        form.addEventListener(
            "submit",
            function (event) {

                const selected =
                    checkboxes.filter(
                        x => x.checked
                    );

                if (selected.length === 0) {

                    event.preventDefault();

                    alert(
                        "Please select at least one candidate."
                    );

                    return;
                }

                const submitter =
                    event.submitter;

                if (submitter &&
                    submitter.formAction
                        .toLowerCase()
                        .includes("bulkreject")) {

                    if (!confirm(
                        "Reject " +
                        selected.length +
                        " selected candidate(s)?"
                    )) {
                        event.preventDefault();
                    }
                }
                else {

                    if (!confirm(
                        "Approve " +
                        selected.length +
                        " selected candidate(s) for interview?"
                    )) {
                        event.preventDefault();
                    }
                }
            }
        );

        updateSelection();
    });
</script>