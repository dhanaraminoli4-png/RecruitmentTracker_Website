@model RecruitmentTracker.Models.JobVacancy

@{
    ViewData["Title"] = "Apply";

    var vacancy =
        ViewBag.Vacancy
        as RecruitmentTracker.Models.JobVacancy;

    var candidate =
        ViewBag.Candidate
        as RecruitmentTracker.Models.ApplicationUser;

    var profile =
        ViewBag.CandidateProfile
        as RecruitmentTracker.Models.CandidateProfile;

    var candidateName =
        candidate?.FullName
        ?? "Candidate";

    var candidateEmail =
        candidate?.Email
        ?? "";

    var candidatePhone =
        profile?.PhoneNumber
        ?? "";

    var hasProfileCV =
        profile != null &&
        !string.IsNullOrWhiteSpace(
            profile.DefaultCVPath);

    var profileCVName =
        profile?.DefaultCVFileName
        ?? "Saved profile CV";
}


<style>

    :root {
        --navy: #0b1f3a;
        --navy-light: #142d4c;
        --text: #172033;
        --muted: #6b7280;
        --border: #d9dee7;
    }


    .apply-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 40px 25px 70px;
    }


    .page-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 30px;
    }


    .section-label {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #75809a;
        margin-bottom: 8px;
    }


    .page-heading h1 {
        margin: 0;
        font-size: 30px;
        font-weight: 700;
        color: var(--navy);
    }


    .page-heading p {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
    }


    .header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
    }


    .back-btn,
    .profile-btn {
        text-decoration: none;
        color: var(--navy);
        border: 1px solid var(--border);
        padding: 10px 17px;
        border-radius: 9px;
        background: #fff;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }


    .profile-btn {
        background: var(--navy);
        color: #fff;
        border-color: var(--navy);
    }


    .back-btn:hover {
        background: #f5f7fa;
        color: var(--navy);
    }


    .profile-btn:hover {
        background: var(--navy-light);
        color: #fff;
    }


    .apply-alert {
        padding: 12px 15px;
        margin-bottom: 18px;
        border-radius: 9px;
        font-size: 11px;
    }


        .apply-alert.error {
            background: #fef3f2;
            border: 1px solid #fecdca;
            color: #b42318;
        }


    .apply-card {
        background: #fff;
        border: 1px solid #e4e7ec;
        border-radius: 18px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(30, 41, 59, .035);
    }


    .card-header {
        padding: 20px 24px 17px;
        border-bottom: 1px solid #eef0f3;
    }


        .card-header h3 {
            margin: 0;
            font-size: 16px;
            font-weight: 700;
            color: var(--navy);
        }


        .card-header p {
            margin: 5px 0 0;
            font-size: 11px;
            color: #969da7;
        }


    .card-body {
        padding: 24px;
    }


    .job-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 15px;
    }


    .job-item {
        background: #f8fafc;
        border: 1px solid #edf0f4;
        border-radius: 12px;
        padding: 15px 16px;
    }


    .job-label {
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #89919d;
        margin-bottom: 6px;
    }


    .job-value {
        font-size: 13px;
        font-weight: 600;
        color: #252b36;
        word-break: break-word;
    }


    .content-section {
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #eef0f3;
    }


        .content-section h4 {
            margin: 0 0 9px;
            font-size: 13px;
            font-weight: 700;
            color: var(--navy);
        }


    .content-text {
        font-size: 12px;
        color: #626b78;
        line-height: 1.75;
        white-space: pre-line;
        margin: 0;
    }


    /* =========================================================
           PROFILE SUMMARY
           ========================================================= */

    .profile-summary {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
    }


    .profile-summary-item {
        padding: 14px 15px;
        border: 1px solid #edf0f3;
        border-radius: 11px;
        background: #f8fafc;
    }


        .profile-summary-item span {
            display: block;
            margin-bottom: 5px;
            color: #89919d;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .7px;
            font-weight: 700;
        }


        .profile-summary-item strong {
            display: block;
            color: #252b36;
            font-size: 12px;
            font-weight: 650;
        }


    .profile-note {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 16px;
        padding: 12px 14px;
        border-radius: 10px;
        background: #f3f6fa;
        color: #687386;
        font-size: 10px;
    }


        .profile-note a {
            color: var(--navy);
            font-weight: 700;
            text-decoration: none;
            white-space: nowrap;
        }


    /* =========================================================
           CV CHOICE
           ========================================================= */

    .cv-choice-list {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }


    .cv-option {
        display: block;
        border: 1px solid #e1e5eb;
        border-radius: 13px;
        padding: 16px;
        cursor: pointer;
        transition: .2s;
    }


        .cv-option:hover {
            border-color: #aab4c1;
            background: #fbfcfd;
        }


    .cv-option-row {
        display: flex;
        align-items: flex-start;
        gap: 11px;
    }


    .cv-option input[type="radio"] {
        margin-top: 3px;
        accent-color: var(--navy);
    }


    .cv-option-content {
        flex: 1;
    }


        .cv-option-content strong {
            display: block;
            color: #252b36;
            font-size: 12px;
        }


        .cv-option-content span {
            display: block;
            margin-top: 4px;
            color: #87909d;
            font-size: 10px;
            line-height: 1.5;
        }


    .saved-cv-file {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 12px;
        padding: 10px 12px;
        border-radius: 9px;
        background: #f4f6f9;
    }


    .saved-cv-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        background: #e8edf4;
        color: var(--navy);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 8px;
        font-weight: 800;
    }


    .saved-cv-file div:nth-child(2) {
        flex: 1;
    }


    .saved-cv-file strong {
        font-size: 10px;
    }


    .saved-cv-file span {
        margin-top: 2px;
        font-size: 9px;
    }


    .saved-cv-file a {
        color: var(--navy);
        font-size: 9px;
        font-weight: 700;
        text-decoration: none;
    }


    .alternate-cv-area {
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #eef0f3;
        display: none;
    }


        .alternate-cv-area.show {
            display: block;
        }


    .upload-section {
        margin-top: 24px;
    }


        .upload-section h3 {
            margin: 0 0 9px;
            font-size: 14px;
            font-weight: 700;
            color: var(--navy);
        }


    .upload-box {
        border: 1.5px dashed #9ca9ba;
        border-radius: 14px;
        padding: 21px;
        background: rgba(11,31,58,.035);
    }


        .upload-box p {
            margin: 0 0 13px;
            color: #7a8492;
            font-size: 11px;
        }


    .file-input {
        width: 100%;
        font-size: 11px;
        color: #727b88;
    }


        .file-input::file-selector-button {
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: 9px 16px;
            margin-right: 10px;
            font-size: 11px;
            font-weight: 600;
            cursor: pointer;
        }


    .no-profile-cv {
        padding: 13px 15px;
        margin-bottom: 12px;
        border-radius: 10px;
        background: #fffaeb;
        border: 1px solid #fedf89;
        color: #b54708;
        font-size: 10px;
        line-height: 1.55;
    }


    .submit-area {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        margin-top: 30px;
        padding-top: 22px;
        border-top: 1px solid #e8ebef;
    }


    .submit-copy strong {
        display: block;
        color: #344054;
        font-size: 11px;
    }


    .submit-copy span {
        display: block;
        margin-top: 3px;
        color: #98a2b3;
        font-size: 9px;
    }


    .submit-btn {
        min-height: 43px;
        padding: 10px 24px;
        border: none;
        border-radius: 9px;
        background: var(--navy);
        color: #fff;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }


        .submit-btn:hover {
            background: var(--navy-light);
        }


    @@media (max-width: 750px) {

        .apply-page {
            padding: 25px 18px 50px;
        }

        .page-heading,
        .submit-area {
            flex-direction: column;
            align-items: stretch;
        }

        .header-actions {
            width: 100%;
            flex-direction: column;
        }

            .header-actions a {
                text-align: center;
            }

        .job-grid,
        .profile-summary {
            grid-template-columns: 1fr;
        }

        .card-body {
            padding: 20px;
        }

        .submit-btn {
            width: 100%;
        }
    }

</style>


<div class="apply-page">


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class="page-heading">

        <div>

            <div class="section-label">
                APPLICATION
            </div>

            <h1>
                Apply for @vacancy?.JobTitle
            </h1>

            <p>
                @vacancy?.Location · @vacancy?.EmploymentType
            </p>

        </div>


        <div class="header-actions">

            <a asp-controller="CandidateProfile"
               asp-action="Profile"
               class="profile-btn">

                My Profile

            </a>

            <a asp-action="Vacancies"
               class="back-btn">

                ← Back to Jobs

            </a>

        </div>

    </div>


    @if (TempData["Error"] != null)
    {
        <div class="apply-alert error">
            @TempData["Error"]
        </div>
    }



    <!-- =====================================================
         JOB DETAILS
         ===================================================== -->

    <div class="apply-card">

        <div class="card-header">

            <h3>
                Job Details
            </h3>

            <p>
                Review the position before submitting your application.
            </p>

        </div>


        <div class="card-body">

            <div class="job-grid">


                <div class="job-item">

                    <div class="job-label">
                        Job Title
                    </div>

                    <div class="job-value">
                        @vacancy?.JobTitle
                    </div>

                </div>


                <div class="job-item">

                    <div class="job-label">
                        Department
                    </div>

                    <div class="job-value">

                        @if (!string.IsNullOrWhiteSpace(
                                                vacancy?.Department))
                        {
                            @vacancy.Department
                        }
                        else
                        {
                            @:Not specified
                        }

                    </div>

                </div>


                <div class="job-item">

                    <div class="job-label">
                        Location
                    </div>

                    <div class="job-value">
                        @vacancy?.Location
                    </div>

                </div>


                <div class="job-item">

                    <div class="job-label">
                        Employment Type
                    </div>

                    <div class="job-value">
                        @vacancy?.EmploymentType
                    </div>

                </div>


                <div class="job-item">

                    <div class="job-label">
                        Salary / Budget
                    </div>

                    <div class="job-value">

                        @if (vacancy?.Salary != null)
                        {
                            @:Rs. @vacancy.Salary
                        }
                        else
                        {
                            @:Not specified
                        }

                    </div>

                </div>


                <div class="job-item">

                    <div class="job-label">
                        Closing Date
                    </div>

                    <div class="job-value">

                        @if (vacancy != null)
                        {
                            @(vacancy.ClosingDate.ToString("dd MMM yyyy"))
                        }
                                                
                        else
                        {
                            @:Not specified
                        }

                    </div>

                </div>

            </div>


            @if (vacancy != null &&
                        !string.IsNullOrWhiteSpace(
                        vacancy.Description))
            {
                <div class="content-section">

                    <h4>
                        About the Role
                    </h4>

                    <p class="content-text">
                        @vacancy.Description
                    </p>

                </div>
            }


            @if (vacancy != null &&
                        !string.IsNullOrWhiteSpace(
                        vacancy.Responsibilities))
            {
                <div class="content-section">

                    <h4>
                        Responsibilities
                    </h4>

                    <p class="content-text">
                        @vacancy.Responsibilities
                    </p>

                </div>
            }


            @if (vacancy != null &&
                        !string.IsNullOrWhiteSpace(
                        vacancy.Requirements))
            {
                <div class="content-section">

                    <h4>
                        Required Qualifications & Skills
                    </h4>

                    <p class="content-text">
                        @vacancy.Requirements
                    </p>

                </div>
            }


            @if (vacancy != null &&
                        !string.IsNullOrWhiteSpace(
                        vacancy.PreferredRequirements))
            {
                <div class="content-section">

                    <h4>
                        Preferred Qualifications & Skills
                    </h4>

                    <p class="content-text">
                        @vacancy.PreferredRequirements
                    </p>

                </div>
            }

        </div>

    </div>



    <!-- =====================================================
         SAVED CANDIDATE PROFILE
         ===================================================== -->

    <div class="apply-card">

        <div class="card-header">

            <h3>
                Your Candidate Profile
            </h3>

            <p>
                These details are loaded automatically from your
                saved HireTrack profile.
            </p>

        </div>


        <div class="card-body">


            <div class="profile-summary">


                <div class="profile-summary-item">

                    <span>
                        Full Name
                    </span>

                    <strong>
                        @candidateName
                    </strong>

                </div>


                <div class="profile-summary-item">

                    <span>
                        Email Address
                    </span>

                    <strong>
                        @candidateEmail
                    </strong>

                </div>


                <div class="profile-summary-item">

                    <span>
                        Phone Number
                    </span>

                    <strong>
                        @candidatePhone
                    </strong>

                </div>


                <div class="profile-summary-item">

                    <span>
                        Current Position
                    </span>

                    <strong>
                        @(string.IsNullOrWhiteSpace(
                                                profile?.CurrentPosition)
                                                ? "Not provided"
                                                : profile.CurrentPosition)
                    </strong>

                </div>


            </div>


            <div class="profile-note">

                <span>
                    Need to change these details?
                    Update your profile once and the new details
                    will be reused for future applications.
                </span>


                <a asp-controller="CandidateProfile"
                   asp-action="Profile">

                    Edit Profile

                </a>

            </div>


        </div>

    </div>



    <!-- =====================================================
         APPLICATION FORM
         ===================================================== -->

    <div class="apply-card">

        <div class="card-header">

            <h3>
                Application Documents
            </h3>

            <p>
                Use your saved profile CV or upload a different
                version specifically for this job.
            </p>

        </div>


        <div class="card-body">


            <form asp-action="Apply"
                  asp-controller="Application"
                  method="post"
                  enctype="multipart/form-data"
                  id="applicationForm">

                @Html.AntiForgeryToken()


                <input type="hidden"
                       name="vacancyId"
                       value="@vacancy?.Id" />



                <!-- =================================================
                     CV
                     ================================================= -->

                <div class="upload-section">

                    <h3>
                        CV / Resume
                    </h3>


                    @if (hasProfileCV)
                    {
                        <div class="cv-choice-list">


                            <label class="cv-option">

                                <div class="cv-option-row">

                                    <input type="radio"
                                           name="useProfileCV"
                                           value="true"
                                           checked
                                           onchange="updateCVChoice()" />


                                    <div class="cv-option-content">

                                        <strong>
                                            Use my saved profile CV
                                        </strong>

                                        <span>
                                            Recommended. HireTrack will use your
                                            default profile resume for this application.
                                        </span>


                                        <div class="saved-cv-file">

                                            <div class="saved-cv-icon">
                                                CV
                                            </div>


                                            <div>

                                                <strong>
                                                    @profileCVName
                                                </strong>

                                                <span>
                                                    Current default CV
                                                </span>

                                            </div>


                                            <a asp-controller="CandidateProfile"
                                               asp-action="ViewCV"
                                               target="_blank"
                                               onclick="event.stopPropagation();">

                                                View

                                            </a>

                                        </div>

                                    </div>

                                </div>

                            </label>



                            <label class="cv-option">

                                <div class="cv-option-row">

                                    <input type="radio"
                                           name="useProfileCV"
                                           value="false"
                                           onchange="updateCVChoice()" />


                                    <div class="cv-option-content">

                                        <strong>
                                            Upload a different CV
                                        </strong>

                                        <span>
                                            Use another resume only for this vacancy.
                                            Your saved profile CV will not be changed.
                                        </span>

                                    </div>

                                </div>


                                <div id="alternateCvArea"
                                     class="alternate-cv-area">

                                    <input type="file"
                                           id="alternateCvFile"
                                           name="cvFile"
                                           class="file-input"
                                           accept=".pdf,.doc,.docx" />

                                </div>

                            </label>


                        </div>
                    }
                    else
                    {
                        <div class="no-profile-cv">

                            You do not currently have a default CV
                            saved in your profile. You can upload a CV
                            for this application below, or add one to
                            My Profile for future applications.

                        </div>


                        <input type="hidden"
                               name="useProfileCV"
                               value="false" />


                        <div class="upload-box">

                            <p>
                                Upload your CV in PDF, DOC or DOCX format.
                                Maximum size: 5 MB.
                            </p>

                            <input type="file"
                                   name="cvFile"
                                   class="file-input"
                                   accept=".pdf,.doc,.docx"
                                   required />

                        </div>
                    }

                </div>



                <!-- =================================================
                     COVER LETTER
                     ================================================= -->
                @if (vacancy != null &&
                                vacancy.RequiresCoverLetter)
                {
                    <div class="upload-section">

                        <h3>

                            Cover Letter

                            <span class="required-mark">
                                *
                            </span>

                        </h3>


                        <div class="upload-box">

                            <p>
                                A cover letter is required for this vacancy.
                                PDF, DOC or DOCX · Maximum 5 MB.
                            </p>


                            <input type="file"
                                   name="coverLetterFile"
                                   class="file-input"
                                   accept=".pdf,.doc,.docx"
                                   required />

                        </div>

                    </div>
                }
                else
                {
                    <div class="upload-section">

                        <h3>
                            Cover Letter
                            <span style="font-weight:400;color:#98a2b3;font-size:10px;">
                                · Optional
                            </span>
                        </h3>


                        <div class="upload-box">

                            <p>
                                You can optionally attach a cover letter
                                for this vacancy.
                            </p>


                            <input type="file"
                                   name="coverLetterFile"
                                   class="file-input"
                                   accept=".pdf,.doc,.docx" />

                        </div>

                    </div>
                }



                <!-- =================================================
                     SUBMIT
                     ================================================= -->

                <div class="submit-area">


                    <div class="submit-copy">

                        <strong>
                            Ready to apply?
                        </strong>

                        <span>
                            Your saved profile details and selected CV
                            will be attached to this application.
                        </span>

                    </div>


                    <button type="submit"
                            class="submit-btn">

                        Submit Application

                    </button>


                </div>


            </form>


        </div>

    </div>


</div>



@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <script>

        function updateCVChoice() {

            const selected =
                document.querySelector(
                    'input[name="useProfileCV"]:checked'
                );


            const alternateArea =
                document.getElementById(
                    'alternateCvArea'
                );


            const alternateFile =
                document.getElementById(
                    'alternateCvFile'
                );


            if (!selected ||
                !alternateArea ||
                !alternateFile) {

                return;
            }


            const useProfile =
                selected.value === 'true';


            if (useProfile) {

                alternateArea.classList.remove(
                    'show'
                );

                alternateFile.required =
                    false;

                alternateFile.value =
                    '';

            }
            else {

                alternateArea.classList.add(
                    'show'
                );

                alternateFile.required =
                    true;

            }

        }


        document.addEventListener(
            'DOMContentLoaded',
            updateCVChoice
        );

    </script>

}
