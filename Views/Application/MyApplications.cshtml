        border-color: #e4e8ec !important;
    }

    .status-shortlisted {
        background: #edf6ff !important;
        color: #397fae !important;
        border-color: #cde5f6 !important;
    }

    .status-interview {
        background: #fff4e7 !important;
        color: #b67b31 !important;
        border-color: #f0d4ae !important;
    }

    .status-passed,
    .status-hired {
        background: #eaf9f2 !important;
        color: #40966f !important;
        border-color: #c6e8d7 !important;
    }

    .status-rejected {
        background: #fff0f2 !important;
        color: #bb5d68 !important;
        border-color: #efcbd0 !important;
    }

    /* =========================================================
           PROGRESS SECTION
           ========================================================= */

    .progress-section {
        padding: 22px 23px 23px !important;
    }

    .progress-heading {
        margin-bottom: 16px !important;
    }

        .progress-heading strong {
            color: #314a61 !important;
            font-size: 15px !important;
            font-weight: 900 !important;
        }

        .progress-heading span {
            color: #8ea0b0 !important;
            font-size: 11px !important;
        }

    /* =========================================================
           VERTICAL DELIVERY-STYLE TIMELINE
           ========================================================= */

    .progress-timeline {
        display: block !important;
        overflow: visible !important;
        padding: 4px 0 6px !important;
    }

    .progress-step {
        position: relative !important;
        min-width: 0 !important;
        width: 100% !important;
        min-height: 72px !important;
        padding: 5px 0 14px 0 !important;
        display: grid !important;
        grid-template-columns: 34px minmax(0,1fr) !important;
        gap: 12px !important;
        align-items: flex-start !important;
        opacity: .55 !important;
    }

        .progress-step.completed,
        .progress-step.current,
        .progress-step.success,
        .progress-step.failed {
            opacity: 1 !important;
        }

        .progress-step:hover {
            transform: none !important;
        }

        .progress-step:not(:last-child)::after {
            content: "" !important;
            position: absolute !important;
            top: 37px !important;
            left: 15px !important;
            width: 2px !important;
            height: calc(100% - 22px) !important;
            right: auto !important;
            bottom: auto !important;
            background: #dfe7ec !important;
            z-index: 0 !important;
        }

        .progress-step.completed:not(:last-child)::after,
        .progress-step.success:not(:last-child)::after {
            background: #9edec3 !important;
        }

        .progress-step.failed:not(:last-child)::after {
            background: #efb5bc !important;
        }

    .step-dot {
        width: 30px !important;
        height: 30px !important;
        min-width: 30px !important;
        border: 2px solid #dce6ec !important;
        background: #fff !important;
        box-shadow: none !important;
        position: relative !important;
        z-index: 2 !important;
    }

    .progress-step.completed .step-dot,
    .progress-step.success .step-dot {
        background: var(--app-mint-strong) !important;
        border-color: var(--app-mint-strong) !important;
        box-shadow: none !important;
    }

        .progress-step.completed .step-dot::before,
        .progress-step.success .step-dot::before {
            content: "✓";
            color: white;
            font-size: 12px;
            font-weight: 900;
            position: absolute;
            inset: 0;
            display: grid;
            place-items: center;
        }

    .progress-step.current .step-dot {
        border: 3px solid #65bde9 !important;
        background: #fff !important;
        box-shadow: 0 0 0 4px rgba(101,189,233,.12) !important;
        animation: pulseCurrentCute 1.8s ease-in-out infinite !important;
    }

    .progress-step.failed .step-dot {
        background: #d97984 !important;
        border-color: #d97984 !important;
        box-shadow: none !important;
    }

    .step-content {
        margin: 0 !important;
        padding: 1px 12px 0 0 !important;
    }

        .step-content strong {
            color: #334d64 !important;
            font-size: 14px !important;
            font-weight: 900 !important;
            line-height: 1.35 !important;
        }

        .step-content span {
