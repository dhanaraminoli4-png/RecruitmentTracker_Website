        font-size: 9px !important;
        font-weight: 850 !important;
    }

        .meeting-link:hover {
            background: var(--app-blue-hover) !important;
        }

    /* =========================================================
           OUTCOME
           ========================================================= */

    .outcome-box {
        margin-top: 18px !important;
        padding: 15px 16px !important;
        border-radius: 13px !important;
        font-size: 11px !important;
        line-height: 1.6 !important;
    }

        .outcome-box.hired {
            background: #eaf9f2 !important;
            border-color: #c7e8d8 !important;
            color: #3f936e !important;
        }

        .outcome-box.rejected {
            background: #fff0f2 !important;
            border-color: #efcbd0 !important;
            color: #b45b66 !important;
        }

        .outcome-box.waiting {
            background: #f5f8fa !important;
            border-color: #e1e8ee !important;
            color: #718697 !important;
        }

    /* EMPTY */
    .empty-state {
        border-color: var(--app-line) !important;
        border-radius: 22px !important;
        background: #fff !important;
        box-shadow: var(--app-shadow-soft) !important;
    }

    .empty-state-icon {
        background: var(--app-blue-soft) !important;
        color: var(--app-blue-hover) !important;
    }

    @@keyframes pulseCurrentCute {
        0%, 100% {
            box-shadow: 0 0 0 4px rgba(101,189,233,.12);
        }

        50% {
            box-shadow: 0 0 0 8px rgba(101,189,233,.05);
        }
    }

    @@media (max-width: 900px) {
        .application-header {
            min-height: auto !important;
        }

            .application-header::after {
                display: none;
            }

            .application-header h1 {
                font-size: 42px !important;
            }
    }

    @@media (max-width: 650px) {
        .applications-page {
            padding: 16px !important;
        }

        .application-header {
            padding: 25px 20px !important;
        }

            .application-header h1 {
                font-size: 36px !important;
            }

        .application-card-header {
            align-items: flex-start !important;
        }

        .interview-grid {
            grid-template-columns: 1fr !important;
        }
    }
</style>
