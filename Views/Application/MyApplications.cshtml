    }

    .applications-wrapper {
        max-width: 1400px !important;
    }

    /* =========================================================
           HERO HEADER
           ========================================================= */

    .application-header {
        position: relative !important;
        min-height: 270px !important;
        padding: 36px 40px !important;
        margin-bottom: 24px !important;
        overflow: hidden !important;
        align-items: center !important;
        border: 1px solid var(--app-line) !important;
        border-radius: 28px !important;
        background: radial-gradient(circle at 77% 50%, rgba(227,239,255,.95) 0 20%, transparent 20.5%), radial-gradient(circle at 82% 50%, rgba(240,246,255,.98) 0 31%, transparent 31.5%), radial-gradient(circle at 91% 70%, rgba(245,184,210,.72) 0 7%, transparent 7.5%), radial-gradient(circle at 84% 16%, rgba(223,244,234,.92) 0 5%, transparent 5.5%), #ffffff !important;
        box-shadow: var(--app-shadow) !important;
    }

        .application-header::before {
            content: "";
