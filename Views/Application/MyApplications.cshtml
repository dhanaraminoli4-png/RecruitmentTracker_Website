        font-weight: 850 !important;
        box-shadow: 0 9px 19px rgba(16,40,74,.16) !important;
    }

        .find-job-button:hover {
            background: #173c68 !important;
            transform: translateY(-1px) !important;
        }

    /* =========================================================
           APPLICATION CARDS
           ========================================================= */

    .application-list {
        gap: 22px !important;
    }

    .application-card {
        border: 1px solid var(--app-line) !important;
