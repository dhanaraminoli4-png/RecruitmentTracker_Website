@model RecruitmentTracker.Models.OfferTemplate

@{
    ViewData["Title"] = "View Offer Template";

    var variables =
        (Model.Variables ?? "")
            .Split(
                ',',
                StringSplitOptions.RemoveEmptyEntries
            )
            .Select(x => x.Trim())
            .Where(x => !string.IsNullOrWhiteSpace(x))
            .ToList();
}

<style>
    :root {
        --brand-blue: #3f9bf3;
        --brand-blue-hover: #2f8de8;
        --brand-blue-soft: #edf7ff;
        --page-bg: #f6f9fc;
        --surface: #ffffff;
        --line: #dfe8f0;
        --line-soft: #edf3f7;
        --text: #223d57;
        --text-2: #587188;
        --muted: #8da0b2;
        --green: #36a777;
        --green-soft: #eaf8f1;
        --grey-soft: #f0f4f7;
        --shadow: 0 16px 42px rgba(58, 95, 126, .08);
    }

    * {
        box-sizing: border-box;
    }

    .offer-details-page {
        min-height: calc(100vh - 80px);
        padding: 34px 34px 60px;
        background: radial-gradient(circle at 8% 2%, rgba(63,155,243,.06), transparent 24%), linear-gradient(180deg, #f8fafc 0%, #f4f7fa 100%);
        color: var(--text);
    }

    .offer-details-shell {
        max-width: 1200px;
        margin: 0 auto;
    }

    .offer-form-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 22px;
        margin-bottom: 24px;
    }

    .offer-details-eyebrow {
        margin-bottom: 6px;
        color: var(--brand-blue);
        font-size: 10px;
        font-weight: 850;
        letter-spacing: 1.15px;
        text-transform: uppercase;
    }

    .offer-form-header h1 {
        margin: 0;
        color: #1f3c58;
        font-size: 30px;
        font-weight: 850;
        letter-spacing: -.4px;
    }

    .offer-form-header p {
        margin: 7px 0 0;
        color: var(--muted);
        font-size: 13px;
    }

    .offer-header-actions {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .offer-back-btn,
    .offer-edit-btn {
        min-height: 42px;
        padding: 0 15px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 11px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        transition: .18s ease;
    }

    .offer-back-btn {
        border: 1px solid #d9e5ef;
        background: #fff;
        color: #647e95;
    }

        .offer-back-btn:hover {
            color: #3f7fae;
            border-color: #bdd9ee;
            background: #f8fbfd;
        }

    .offer-edit-btn {
        border: 1px solid var(--brand-blue);
        background: var(--brand-blue);
        color: #fff;
        box-shadow: 0 10px 22px rgba(63,155,243,.20);
    }

        .offer-edit-btn:hover {
            background: var(--brand-blue-hover);
            border-color: var(--brand-blue-hover);
            color: white;
            transform: translateY(-1px);
        }

    .offer-details-card {
        margin-bottom: 18px;
        overflow: hidden;
        border: 1px solid var(--line);
        border-radius: 20px;
        background: var(--surface);
        box-shadow: var(--shadow);
    }

    .offer-details-heading {
        padding: 19px 23px;
        border-bottom: 1px solid var(--line-soft);
        background: #fbfdff;
    }

        .offer-details-heading h2 {
            margin: 0;
            color: #2d4c68;
            font-size: 16px;
            font-weight: 850;
        }

        .offer-details-heading p {
            margin: 5px 0 0;
            color: var(--muted);
            font-size: 10px;
        }

    .offer-details-body {
        padding: 24px;
    }

    .offer-details-grid {
        display: grid;
        grid-template-columns: 1.5fr .7fr .8fr;
        gap: 14px;
    }

    .offer-detail-item {
        min-height: 92px;
        padding: 16px;
        border: 1px solid #e6edf3;
        border-radius: 14px;
        background: #fbfdff;
    }

        .offer-detail-item > span {
            display: block;
            margin-bottom: 8px;
            color: #93a5b4;
            font-size: 9px;
            font-weight: 800;
            letter-spacing: .55px;
            text-transform: uppercase;
        }

        .offer-detail-item > strong {
            color: #36516a;
            font-size: 13px;
            font-weight: 850;
        }

    .offer-status {
        display: inline-flex;
        width: fit-content;
        min-height: 28px;
        padding: 0 10px;
        align-items: center;
        justify-content: center;
        border-radius: 999px;
        font-size: 9px !important;
        font-weight: 850 !important;
    }

        .offer-status.active {
            background: var(--green-soft);
            color: var(--green) !important;
        }

        .offer-status.inactive {
            background: var(--grey-soft);
            color: #8193a3 !important;
        }

    .offer-document-preview-wrap {
        padding: 28px;
        background: radial-gradient(circle, rgba(120, 145, 165, .08) 1px, transparent 1px);
        background-size: 14px 14px;
        background-color: #f3f5f7;
    }

    .offer-document-preview {
        max-width: 820px;
        min-height: 680px;
        margin: 0 auto;
        padding: 44px 48px;
        border: 1px solid #dfe7ed;
        background: #fff;
        box-shadow: 0 16px 38px rgba(45, 74, 97, .12);
        position: relative;
        overflow: hidden;
    }

        .offer-document-preview::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 160px;
            height: 14px;
            background: #b6dffc;
            clip-path: polygon(0 0,100% 0,88% 100%,0 100%);
        }

        .offer-document-preview::after {
            content: "";
            position: absolute;
            top: 0;
            right: 0;
            width: 220px;
            height: 24px;
            background: var(--brand-blue);
            clip-path: polygon(15% 0,100% 0,100% 100%,0 100%);
        }

    .offer-document-brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 8px 0 15px;
        border-bottom: 1px solid #aebcc8;
    }

    .offer-document-brand-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .offer-document-logo {
        width: 42px;
        height: 42px;
        display: grid;
        place-items: center;
        border-radius: 12px;
        background: var(--brand-blue-soft);
        color: var(--brand-blue);
        font-size: 18px;
        font-weight: 900;
    }

    .offer-document-brand strong {
        display: block;
        color: #273d51;
        font-size: 15px;
        font-weight: 900;
    }

    .offer-document-brand span {
        display: block;
        margin-top: 2px;
        color: #8498a9;
        font-size: 9px;
    }

    .offer-document-title {
        margin: 26px 0 24px;
        text-align: center;
        color: #1b2731;
        font-size: 24px;
        font-weight: 900;
        text-transform: uppercase;
    }

    .offer-details-content {
        color: #34495b;
        font-size: 13px;
        line-height: 1.85;
        white-space: pre-wrap;
    }

    .preview-variable-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

        .preview-variable-list span {
            padding: 7px 10px;
            border-radius: 8px;
            background: var(--brand-blue-soft);
            color: #4d7fa6;
            font-size: 10px;
            font-weight: 750;
        }

    .offer-empty-variables {
        color: #99aaba;
        font-size: 10px;
    }

    @@media (max-width: 800px) {
        .offer-details-page {
            padding: 22px 16px 42px;
        }

        .offer-form-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .offer-header-actions {
            width: 100%;
        }

        .offer-details-grid {
            grid-template-columns: 1fr;
        }

        .offer-document-preview-wrap {
            padding: 14px;
        }

        .offer-document-preview {
            padding: 34px 22px;
        }
    }
</style>

<div class="offer-details-page">

    <div class="offer-details-shell">

        <div class="offer-form-header">

            <div>

                <div class="offer-details-eyebrow">
                    OFFER LETTER STUDIO
                </div>

                <h1>
                    View Offer Template
                </h1>

                <p>
                    Preview the template content, variables and current status.
                </p>

            </div>

            <div class="offer-header-actions">

                <a asp-controller="OfferTemplate"
                   asp-action="Index"
                   class="offer-back-btn">
                    ← Back
                </a>

                <a asp-controller="OfferTemplate"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="offer-edit-btn">
                    Edit Template
                </a>

            </div>

        </div>

        <section class="offer-details-card">

            <div class="offer-details-heading">

                <h2>
                    Basic Information
                </h2>

                <p>
                    Template identity, availability and creation date.
                </p>

            </div>

            <div class="offer-details-body">

                <div class="offer-details-grid">

                    <div class="offer-detail-item">

                        <span>
                            Template Name
                        </span>

                        <strong>
                            @Model.Name
                        </strong>

                    </div>

                    <div class="offer-detail-item">

                        <span>
                            Status
                        </span>

                        @if (Model.IsActive)
                        {
                            <strong class="offer-status active">
                                Active
                            </strong>
                        }
                        else
                        {
                            <strong class="offer-status inactive">
                                Inactive
                            </strong>
                        }

                    </div>

                    <div class="offer-detail-item">

                        <span>
                            Created At
                        </span>

                        <strong>
                            @Model.CreatedDate.ToString("dd MMM yyyy")
                        </strong>

                    </div>

                </div>

            </div>

        </section>

        <section class="offer-details-card">

            <div class="offer-details-heading">

                <h2>
                    Template Preview
                </h2>

                <p>
                    This is how the reusable offer content is structured.
                </p>

            </div>

            <div class="offer-document-preview-wrap">

                <div class="offer-document-preview">

                    <div class="offer-document-brand">

                        <div class="offer-document-brand-left">

                            <div class="offer-document-logo">
                                H
                            </div>

                            <div>
                                <strong>HireTrack</strong>
                                <span>Recruitment & Hiring</span>
                            </div>

                        </div>

                        <div>
                            <span>Offer Template</span>
                        </div>

                    </div>

                    <div class="offer-document-title">
                        Job Offer Letter
                    </div>

                    <div class="offer-details-content">
                        @Model.Content
                    </div>

                </div>

            </div>

        </section>

        <section class="offer-details-card">

            <div class="offer-details-heading">

                <h2>
                    Available Variables
                </h2>

                <p>
                    These fields are filled when HR generates an offer letter.
                </p>

            </div>

            <div class="offer-details-body">

                <div class="preview-variable-list">

                    @if (variables.Any())
                    {
                        foreach (var variable in variables)
                        {
                            <span>
                                {{@variable}}
                            </span>
                        }
                    }
                    else
                    {
                        <div class="offer-empty-variables">
                            No variables detected in this template.
                        </div>
                    }

                </div>

            </div>

        </section>

    </div>

</div>
