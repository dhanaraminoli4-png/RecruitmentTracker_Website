@section Scripts {

    <script>

        const offerTemplates =
            JSON.parse(
                document.getElementById(
                    "offerTemplateData"
                ).textContent
            );


        let currentTemplate =
            offerTemplates.length > 0
                ? offerTemplates[0]
                : null;


        let currentLibraryFilter =
            "all";


        // =========================================================
        // SELECT TEMPLATE
        // =========================================================

        function selectTemplate(
            templateId,
            button) {

            const template =
                offerTemplates.find(
                    x => x.id === templateId
                );


            if (!template) {
                return;
            }


            currentTemplate =
                template;


            document
                .querySelectorAll(
                    ".offer-template-item"
                )
                .forEach(x =>
                    x.classList.remove(
                        "active"
                    )
                );


            if (button) {
                button.classList.add(
                    "active"
                );
            }


            updateStudio(
                template
            );
        }


        // =========================================================
        // UPDATE STUDIO
        // =========================================================

        function updateStudio(
            template) {

            document.getElementById(
                "studioTitle"
            ).textContent =
                template.name;


            document.getElementById(
                "documentTemplateName"
            ).textContent =
                template.name;


            document.getElementById(
                "documentTemplateMeta"
            ).textContent =
                `Created ${template.createdDate}`;


            document.getElementById(
                "rightTemplateName"
            ).textContent =
                template.name;


            document.getElementById(
                "rightCreatedDate"
            ).textContent =
                template.createdDate;


            const status =
                document.getElementById(
                    "rightTemplateStatus"
                );


            status.textContent =
                template.isActive
                    ? "Active"
                    : "Inactive";


            status.classList.toggle(
                "active",
                template.isActive
            );


            renderDocument(
                template
            );


            renderVariables(
                template.variables
            );


            updateActionLinks(
                template
            );
        }


        // =========================================================
        // DOCUMENT PREVIEW
        // =========================================================

        function renderDocument(
            template) {

            const paper =
                document.getElementById(
                    "offerLetterPaper"
                );


            const highlighted =
                highlightVariables(
                    escapeHtml(
                        template.content || ""
                    )
                );


            paper.innerHTML = `
                <div class="offer-letter-inner">

                    <div class="offer-letter-brand">

                        <div class="offer-letter-brand-left">

                            <div class="offer-letter-logo">
                                H
                            </div>

                            <div class="offer-letter-company">
                                <strong>HireTrack</strong>
                                <span>Recruitment & Hiring</span>
                            </div>

                        </div>

                        <div class="offer-letter-contact">
                            www.hiretrack.local<br />
                            +94 11 000 0000
                        </div>

                    </div>

                    <div class="offer-letter-title">
                        Job Offer Letter
                    </div>

                    <div class="offer-letter-meta-grid">

                        <div class="offer-company-block">
                            <strong>HireTrack Recruitment</strong><br />
                            123 Business Avenue<br />
                            Colombo, Sri Lanka<br />
                            recruitment@hiretrack.local
                        </div>

                        <div class="offer-letter-date">
                            ${new Date().toLocaleDateString(
                                "en-GB",
                                {
                                    day: "2-digit",
                                    month: "long",
                                    year: "numeric"
                                }
                            )}
                        </div>

                    </div>

                    <div class="offer-recipient-block">
                        <strong>To:</strong><br />
                        <span class="offer-variable-token">{{candidate_name}}</span><br />
                        <span class="offer-variable-token">{{candidate_address}}</span><br />
                        <span class="offer-variable-token">{{candidate_email}}</span>
                    </div>

                    <div class="offer-letter-body">
                        ${highlighted}
                    </div>

                    <div class="offer-letter-signoff">

                        <div class="offer-signature-block">

                            Warm Regards,

                            <div class="offer-signature-mark">
                                HireTrack HR
                            </div>

                            <strong>Human Resources Manager</strong><br />
                            HireTrack Recruitment

                        </div>

                        <div class="offer-footer-contact">

                            <span>
                                <b>⌖</b>
                                123 Business Avenue, Colombo
                            </span>

                            <span>
                                <b>☎</b>
                                +94 11 000 0000
                            </span>

                            <span>
                                <b>✉</b>
                                recruitment@hiretrack.local
                            </span>

                        </div>

                    </div>

                </div>
            `;
        }

        function highlightVariables(
            value) {

            return value.replace(
                /\{\{([^}]+)\}\}/g,
                '<span class="offer-variable-token">{{$1}}</span>'
            );
        }


        function escapeHtml(
            value) {

            const div =
                document.createElement(
                    "div"
                );

            div.textContent =
                value ?? "";

            return div.innerHTML;
        }


        // =========================================================
        // VARIABLES
        // =========================================================

        function renderVariables(
            variables) {

            const list =
                document.getElementById(
                    "rightVariableList"
                );


            list.innerHTML =
                "";


            if (!variables ||
                variables.length === 0) {

                list.innerHTML = `
                    <span class="offer-variable-empty">
                        No variables configured.
                    </span>
                `;

                return;
            }


            variables.forEach(
                variable => {

                    const chip =
                        document.createElement(
                            "span"
                        );

                    chip.className =
                        "offer-variable-chip";

                    chip.textContent =
                        variable;

                    list.appendChild(
                        chip
                    );

                }
            );
        }


        // =========================================================
        // ACTION LINKS
        // =========================================================

        function updateActionLinks(
            template) {

            const topEdit =
                document.getElementById(
                    "topEditButton"
                );

            const rightEdit =
                document.getElementById(
                    "rightEditButton"
                );

            const rightDetails =
                document.getElementById(
                    "rightDetailsButton"
                );


            if (topEdit) {
                topEdit.href =
                    `/OfferTemplate/Edit/${template.id}`;
            }


            if (rightEdit) {
                rightEdit.href =
                    `/OfferTemplate/Edit/${template.id}`;
            }


            if (rightDetails) {
                rightDetails.href =
                    `/OfferTemplate/Details/${template.id}`;
            }


            const topGenerate =
                document.getElementById(
                    "topGenerateButton"
                );

            const rightGenerate =
                document.getElementById(
                    "rightGenerateButton"
                );


            [topGenerate, rightGenerate]
                .filter(Boolean)
                .forEach(button => {

                    button.disabled =
                        !template.isActive;


                    button.textContent =
                        template.isActive
                            ? button.id ===
                                "topGenerateButton"
                                ? "Generate Offer"
                                : "Generate Offer Letter"
                            : "Template Inactive";


                    button.onclick =
                        template.isActive
                            ? () =>
                                openGenerateOffer(
                                    template.id
                                )
                            : null;

                });
        }


        // =========================================================
        // LIBRARY FILTER
        // =========================================================

        function setLibraryFilter(
            button,
            filter) {

            currentLibraryFilter =
                filter;


            document
                .querySelectorAll(
                    ".offer-sidebar-tab"
                )
                .forEach(x =>
                    x.classList.remove(
                        "active"
                    )
                );


            button.classList.add(
                "active"
            );


            filterTemplateLibrary();
        }


        function filterTemplateLibrary() {

            const search =
                document
                    .getElementById(
                        "templateLibrarySearch"
                    )
                    .value
                    .toLowerCase()
                    .trim();


            document
                .querySelectorAll(
                    ".offer-template-item"
                )
                .forEach(item => {

                    const matchesSearch =
                        !search ||
                        item.dataset
                            .templateName
                            .includes(search);


                    const matchesFilter =
                        currentLibraryFilter ===
                            "all"

                        ||

                        item.dataset
                            .templateStatus ===
                            currentLibraryFilter;


                    item.style.display =
                        matchesSearch &&
                        matchesFilter
                            ? ""
                            : "none";
                });
        }


        // =========================================================
        // GENERATE OFFER
        // =========================================================

        function openGenerateOffer(
            templateId) {

            const template =
                offerTemplates.find(
                    x => x.id === templateId
                );


            if (!template ||
                !template.isActive) {

                return;
            }


            document.getElementById(
                "generateTemplateId"
            ).value =
                template.id;


            document.getElementById(
                "generateTemplateName"
            ).textContent =
                template.name;


            const fields =
                document.getElementById(
                    "generateFields"
                );


            fields.innerHTML =
                "";


            if (!template.variables ||
                template.variables.length === 0) {

                fields.innerHTML = `
                    <p class="generate-description">
                        This template does not contain any variables.
                        You can still continue to preview the offer.
                    </p>
                `;
            }
            else {

                template.variables
                    .forEach(variable => {

                        const wrapper =
                            document.createElement(
                                "div"
                            );


                        wrapper.className =
                            "generate-field";


                        const label =
                            document.createElement(
                                "label"
                            );


                        label.textContent =
                            formatVariableName(
                                variable
                            );


                        const input =
                            document.createElement(
                                "input"
                            );


                        input.name =
                            `values[${variable}]`;


                        input.required =
                            true;


                        if (
                            variable
                                .toLowerCase()
                                .includes("date")
                        ) {

                            input.type =
                                "date";

                        }
                        else if (
                            variable
                                .toLowerCase()
                                .includes("email")
                        ) {

                            input.type =
                                "email";

                        }
                        else if (
                            variable
                                .toLowerCase()
                                .includes("salary")
                            ||
                            variable
                                .toLowerCase()
                                .includes("amount")
                        ) {

                            input.type =
                                "text";

                            input.placeholder =
                                "e.g. Rs. 200,000";

                        }
                        else {

                            input.type =
                                "text";

                            input.placeholder =
                                `Enter ${formatVariableName(variable).toLowerCase()}`;
                        }


                        wrapper.appendChild(
                            label
                        );


                        wrapper.appendChild(
                            input
                        );


                        fields.appendChild(
                            wrapper
                        );

                    });
            }


            document
                .getElementById(
                    "generateOfferOverlay"
                )
                .classList
                .add(
                    "show"
                );


            document.body
                .classList
                .add(
                    "modal-open"
                );
        }


        function closeGenerateOffer() {

            document
                .getElementById(
                    "generateOfferOverlay"
                )
                .classList
                .remove(
                    "show"
                );


            document.body
                .classList
                .remove(
                    "modal-open"
                );
        }


        function formatVariableName(
            value) {

            return value
                .replace(
                    /_/g,
                    " "
                )
                .replace(
                    /\b\w/g,
                    character =>
                        character.toUpperCase()
                );
        }


        function scrollVariablesIntoView() {

            document
                .getElementById(
                    "variableSection"
                )
                ?.scrollIntoView({
                    behavior: "smooth",
                    block: "center"
                });
        }


        // =========================================================
        // CLICK OUTSIDE MODAL
        // =========================================================

        document
            .getElementById(
                "generateOfferOverlay"
            )
            .addEventListener(
                "click",
                function (event) {

                    if (event.target === this) {
                        closeGenerateOffer();
                    }
                }
            );


        // =========================================================
        // INITIAL PREVIEW HIGHLIGHTING
        // =========================================================

        if (currentTemplate) {
            updateStudio(
                currentTemplate
            );
        }

    </script>

}



