@using System.Text.Json
@model IEnumerable<RecruitmentTracker.Models.OfferTemplate>

@{
    ViewData["Title"] = "Offer Templates";

    var templates = Model?.ToList()
        ?? new List<RecruitmentTracker.Models.OfferTemplate>();

    var total = templates.Count;
    var active = templates.Count(x => x.IsActive);
    var inactive = templates.Count(x => !x.IsActive);

    var firstTemplate = templates.FirstOrDefault();
}

<style>
    :root {
        --offer-blue: #69b7f4;
        --offer-blue-dark: #4b9ee4;
        --offer-blue-soft: #eaf5ff;
        --offer-blue-pale: #f6fbff;
        --offer-bg: #edf7ff;
        --offer-surface: rgba(255,255,255,.92);
        --offer-line: #dceaf6;
        --offer-line-soft: #edf4f9;
        --offer-text: #213f5d;
        --offer-text-2: #54708a;
        --offer-muted: #8da4b8;
        --offer-green: #38a878;
        --offer-green-bg: #eaf8f1;
        --offer-red: #c4616c;
        --offer-red-bg: #fff0f2;
        --offer-shadow: 0 18px 50px rgba(70, 121, 164, .10);
        --offer-shadow-soft: 0 8px 24px rgba(70, 121, 164, .08);
    }

    * {
        box-sizing: border-box;
    }

    body.modal-open {
        overflow: hidden;
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .offer-studio-page {
        min-height: calc(100vh - 80px);
        padding: 22px;
        background: radial-gradient(circle at 8% 2%, rgba(152, 211, 250, .24), transparent 26%), radial-gradient(circle at 92% 6%, rgba(205, 231, 251, .36), transparent 24%), linear-gradient(180deg, #edf7ff 0%, #f8fbff 100%);
        color: var(--offer-text);
    }

    .offer-studio-shell {
        max-width: 1680px;
        margin: 0 auto;
        overflow: hidden;
        border: 1px solid #d9e8f4;
        border-radius: 26px;
        background: rgba(255,255,255,.90);
        box-shadow: 0 24px 64px rgba(77, 126, 168, .13);
        backdrop-filter: blur(14px);
    }

    /* =========================================================
           TOP BAR
           ========================================================= */

    .offer-studio-topbar {
        min-height: 78px;
        padding: 14px 18px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border-bottom: 1px solid var(--offer-line-soft);
        background: rgba(255,255,255,.94);
    }

    .offer-topbar-left,
    .offer-topbar-actions {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .offer-back-circle {
        width: 38px;
        height: 38px;
        display: grid;
        place-items: center;
        border-radius: 50%;
        border: 1px solid var(--offer-line);
        background: #fff;
        color: #7992a8;
        text-decoration: none;
        font-size: 18px;
        transition: .18s ease;
    }

        .offer-back-circle:hover {
            background: var(--offer-blue-soft);
            color: var(--offer-blue-dark);
            transform: translateX(-2px);
        }

    .offer-title-copy h1 {
        margin: 0;
        color: #1e3d5b;
        font-size: 18px;
        font-weight: 850;
        letter-spacing: -.25px;
    }

    .offer-title-copy p {
        margin: 4px 0 0;
        color: var(--offer-muted);
        font-size: 10px;
    }

    .offer-top-btn {
        min-height: 40px;
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        border: 1px solid #d8e7f4;
        border-radius: 11px;
        background: white;
        color: #5f7890;
        text-decoration: none;
        font-size: 11px;
        font-weight: 800;
        cursor: pointer;
        transition: .18s ease;
    }

        .offer-top-btn:hover {
            border-color: #b8d8ee;
            background: #f8fcff;
            color: #3f82b2;
            transform: translateY(-1px);
        }

        .offer-top-btn.primary {
            border-color: #76bae9;
            background: linear-gradient(180deg, #91cdf7, #73b8ea);
            color: white;
            box-shadow: 0 8px 18px rgba(115, 184, 234, .22);
        }

            .offer-top-btn.primary:hover {
                background: linear-gradient(180deg, #84c6f3, #67afe4);
                color: white;
                box-shadow: 0 12px 24px rgba(103, 175, 228, .26);
            }

    /* =========================================================
           3-COLUMN STUDIO
           ========================================================= */

    .offer-studio-layout {
        display: grid;
        grid-template-columns: 260px minmax(560px, 1fr) 310px;
        min-height: 760px;
    }

    .offer-template-sidebar,
    .offer-detail-sidebar {
        background: rgba(250, 253, 255, .88);
        backdrop-filter: blur(12px);
    }

    .offer-template-sidebar {
        border-right: 1px solid var(--offer-line-soft);
    }

    .offer-detail-sidebar {
        border-left: 1px solid var(--offer-line-soft);
    }

    .offer-sidebar-inner {
        height: 100%;
        padding: 18px;
    }

    /* =========================================================
           LEFT — TEMPLATE LIBRARY
           ========================================================= */

    .offer-sidebar-tabs {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 5px;
        padding: 5px;
        margin-bottom: 16px;
        border-radius: 12px;
        background: #eaf4fd;
    }

    .offer-sidebar-tab {
        min-height: 35px;
        border: 0;
        border-radius: 9px;
        background: transparent;
        color: #7b91a5;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
    }

        .offer-sidebar-tab.active {
            background: white;
            color: var(--offer-blue-dark);
            box-shadow: 0 5px 12px rgba(75, 120, 157, .08);
        }

    .offer-library-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 10px;
    }

        .offer-library-title strong {
            color: #375673;
            font-size: 11px;
            font-weight: 850;
            letter-spacing: .35px;
            text-transform: uppercase;
        }

        .offer-library-title span {
            min-width: 24px;
            height: 22px;
            padding: 0 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: #eaf5ff;
            color: #5d9bc8;
            font-size: 9px;
            font-weight: 800;
        }

    .offer-search-box {
        height: 42px;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 0 12px;
        margin-bottom: 13px;
        border: 1px solid #dbe8f3;
        border-radius: 11px;
        background: white;
    }

        .offer-search-box span {
            color: #90a7ba;
            font-size: 14px;
        }

        .offer-search-box input {
            width: 100%;
            border: 0;
            outline: 0;
            background: transparent;
            color: #45627c;
            font-size: 11px;
        }

            .offer-search-box input::placeholder {
                color: #a3b4c3;
            }

    .offer-template-list {
        display: grid;
        gap: 8px;
        max-height: 610px;
        overflow-y: auto;
        padding-right: 3px;
    }

        .offer-template-list::-webkit-scrollbar {
            width: 5px;
        }

        .offer-template-list::-webkit-scrollbar-thumb {
            background: #c8dceb;
            border-radius: 999px;
        }

    .offer-template-item {
        width: 100%;
        padding: 11px;
        display: grid;
        grid-template-columns: 40px minmax(0,1fr);
        align-items: center;
        gap: 10px;
        border: 1px solid #e2edf6;
        border-radius: 13px;
        background: rgba(255,255,255,.82);
        text-align: left;
        cursor: pointer;
        transition: .18s ease;
    }

        .offer-template-item:hover {
            transform: translateY(-1px);
            border-color: #c7e0f2;
            background: white;
            box-shadow: 0 7px 16px rgba(75, 120, 157, .08);
        }

        .offer-template-item.active {
            border-color: #9dcff1;
            background: #eef8ff;
            box-shadow: 0 0 0 2px rgba(105,183,244,.08);
        }

    .offer-template-icon {
        width: 40px;
        height: 40px;
        display: grid;
        place-items: center;
        border-radius: 11px;
        background: #e8f4ff;
        color: #5a9dd0;
        font-size: 17px;
        font-weight: 900;
    }

    .offer-template-item.active .offer-template-icon {
        background: #dff1ff;
        color: #3e8fca;
    }

    .offer-template-copy {
        min-width: 0;
    }

        .offer-template-copy strong {
            display: block;
            overflow: hidden;
            color: #385773;
            font-size: 11px;
            font-weight: 850;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .offer-template-copy span {
            display: block;
            margin-top: 3px;
            color: #96a9b9;
            font-size: 8px;
        }

    .offer-template-status-dot {
        display: inline-block;
        width: 6px;
        height: 6px;
        margin-right: 4px;
        border-radius: 50%;
        background: #b2bdc7;
    }

        .offer-template-status-dot.active {
            background: #45b483;
        }

    .offer-new-template {
        width: 100%;
        min-height: 42px;
        margin-top: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        border: 1px dashed #a8d2ee;
        border-radius: 12px;
        background: #f5fbff;
        color: #4f95c7;
        text-decoration: none;
        font-size: 10px;
        font-weight: 800;
        transition: .18s ease;
    }

        .offer-new-template:hover {
            background: #ebf7ff;
            color: #3d85b9;
        }

    /* =========================================================
           CENTER — DOCUMENT CANVAS
           ========================================================= */

    .offer-document-workspace {
        padding: 34px 28px 46px;
        background: radial-gradient(circle, rgba(114, 156, 190, .10) 1px, transparent 1px);
        background-size: 13px 13px;
        background-color: #f6f9fc;
        overflow: auto;
    }

    .offer-document-toolbar {
        max-width: 780px;
        margin: 0 auto 16px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .offer-document-toolbar-left {
        min-width: 0;
    }

        .offer-document-toolbar-left strong {
            display: block;
            overflow: hidden;
            color: #4a667f;
            font-size: 11px;
            font-weight: 850;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .offer-document-toolbar-left span {
            display: block;
            margin-top: 3px;
            color: #98aabc;
            font-size: 9px;
        }

    .offer-document-toolbar-actions {
        display: flex;
        gap: 7px;
    }

    .offer-mini-btn {
        min-height: 34px;
        padding: 0 11px;
        border: 1px solid #d8e6f2;
        border-radius: 9px;
        background: rgba(255,255,255,.92);
        color: #698198;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
    }

        .offer-mini-btn:hover {
            background: #eef8ff;
            color: #4c8dbb;
        }

    .offer-letter-paper {
        max-width: 780px;
        min-height: 820px;
        margin: 0 auto;
        padding: 42px 46px 52px;
        border: 1px solid #e1e8ee;
        background: #ffffff;
        box-shadow: 0 18px 45px rgba(52, 79, 101, .13);
        position: relative;
    }

    .offer-letter-brand {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding-bottom: 15px;
        border-bottom: 2px solid #76b9ed;
    }

    .offer-letter-brand-left {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .offer-letter-logo {
        width: 34px;
        height: 34px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: linear-gradient(145deg,#dff1ff,#eef8ff);
        color: #4e95c8;
        font-weight: 900;
        font-size: 15px;
    }

    .offer-letter-company strong {
        display: block;
        color: #24435f;
        font-size: 13px;
        font-weight: 900;
    }

    .offer-letter-company span {
        display: block;
        margin-top: 2px;
        color: #8ca0b2;
        font-size: 8px;
    }

    .offer-letter-contact {
        text-align: right;
        color: #7c93a7;
        font-size: 8px;
        line-height: 1.5;
    }

    .offer-letter-title {
        margin: 28px 0 24px;
        text-align: center;
        color: #1e2f40;
        font-size: 22px;
        font-weight: 900;
    }

    .offer-letter-meta {
        margin-bottom: 22px;
        color: #526b82;
        font-size: 10px;
        line-height: 1.7;
    }

    .offer-letter-body {
        color: #35485b;
        font-size: 10px;
        line-height: 1.75;
        white-space: pre-wrap;
    }

        .offer-letter-body .offer-variable-token {
            padding: 1px 4px;
            border-radius: 4px;
            background: #fff7cc;
            color: #725f1b;
            font-weight: 750;
        }

    .offer-letter-empty {
        padding: 120px 30px;
        text-align: center;
        color: #91a5b6;
    }

    .offer-letter-empty-icon {
        width: 58px;
        height: 58px;
        margin: 0 auto 14px;
        display: grid;
        place-items: center;
        border-radius: 18px;
        background: #eaf5ff;
        color: #5e9fd0;
        font-size: 24px;
    }

    .offer-letter-empty strong {
        display: block;
        color: #49677f;
        font-size: 13px;
        font-weight: 850;
    }

    .offer-letter-empty span {
        display: block;
        margin-top: 6px;
        font-size: 9px;
    }

    /* =========================================================
           RIGHT — TEMPLATE DETAILS / GENERATION PANEL
           ========================================================= */

    .offer-right-section {
        padding-bottom: 18px;
        margin-bottom: 18px;
        border-bottom: 1px solid #e8f0f6;
    }

        .offer-right-section:last-child {
            border-bottom: 0;
        }

    .offer-right-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 12px;
    }

    .offer-right-heading-icon {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border-radius: 9px;
        background: #e9f5ff;
        color: #5d9cc8;
        font-size: 13px;
    }

    .offer-right-heading strong {
        color: #385873;
        font-size: 11px;
        font-weight: 850;
    }

    .offer-detail-grid {
        display: grid;
        gap: 10px;
    }

    .offer-detail-row {
        display: grid;
        grid-template-columns: 88px minmax(0,1fr);
        gap: 10px;
        align-items: start;
        color: #70879c;
        font-size: 9px;
    }

        .offer-detail-row span:first-child {
            color: #93a6b7;
        }

        .offer-detail-row strong {
            color: #46647e;
            font-weight: 800;
            word-break: break-word;
        }

    .offer-right-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        width: fit-content;
        padding: 5px 9px;
        border-radius: 999px;
        background: #eef2f5;
        color: #7b8e9f;
        font-size: 8px;
        font-weight: 850;
    }

        .offer-right-status.active {
            background: var(--offer-green-bg);
            color: var(--offer-green);
        }

    .offer-variable-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .offer-variable-chip {
        padding: 6px 8px;
        border-radius: 8px;
        background: #edf7ff;
        color: #528fb8;
        font-size: 8px;
        font-weight: 750;
    }

    .offer-variable-empty {
        color: #9aabb9;
        font-size: 9px;
    }

    .offer-generate-card {
        padding: 14px;
        border: 1px solid #d8e9f6;
        border-radius: 15px;
        background: linear-gradient(145deg, #eef8ff 0%, #fbfdff 100%);
    }

        .offer-generate-card strong {
            display: block;
            color: #315b7d;
            font-size: 11px;
            font-weight: 850;
        }

        .offer-generate-card p {
            margin: 5px 0 12px;
            color: #84a0b6;
            font-size: 9px;
            line-height: 1.55;
        }

    .offer-generate-main-btn {
        width: 100%;
        min-height: 42px;
        border: 1px solid #74b8e8;
        border-radius: 11px;
        background: linear-gradient(180deg,#91cdf7,#73b8ea);
        color: #fff;
        font-size: 10px;
        font-weight: 850;
        cursor: pointer;
        box-shadow: 0 8px 18px rgba(115,184,234,.20);
        transition: .18s ease;
    }

        .offer-generate-main-btn:hover {
            background: linear-gradient(180deg,#84c6f3,#67afe4);
            transform: translateY(-1px);
        }

    .offer-right-actions {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 7px;
        margin-top: 9px;
    }

    .offer-right-action {
        min-height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 1px solid #d8e6f2;
        border-radius: 10px;
        background: #fff;
        color: #6b8297;
        text-decoration: none;
        font-size: 9px;
        font-weight: 800;
        cursor: pointer;
    }

        .offer-right-action:hover {
            background: #f4faff;
            color: #4d8dbb;
        }

    /* =========================================================
           EMPTY LIBRARY
           ========================================================= */

    .offer-library-empty {
        padding: 30px 12px;
        text-align: center;
        color: #9bafbf;
        font-size: 9px;
    }

    /* =========================================================
           SUCCESS ALERT
           ========================================================= */

    .offer-success-message {
        max-width: 1680px;
        margin: 0 auto 12px;
        padding: 12px 14px;
        display: flex;
        align-items: center;
        gap: 8px;
        border: 1px solid #c8e8d8;
        border-radius: 12px;
        background: #effaf5;
        color: #438a68;
        font-size: 10px;
        font-weight: 750;
    }

    /* =========================================================
           GENERATE MODAL
           ========================================================= */

    .offer-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 9999;
        padding: 24px;
        align-items: center;
        justify-content: center;
        background: rgba(31, 54, 75, .30);
        backdrop-filter: blur(8px);
    }

        .offer-modal-overlay.show {
            display: flex;
        }

    .generate-offer-modal {
        width: min(560px, 100%);
        max-height: 88vh;
        overflow: hidden;
        border: 1px solid #d8e7f3;
        border-radius: 20px;
        background: #fff;
        box-shadow: 0 28px 70px rgba(31, 54, 75, .20);
    }

    .generate-offer-header {
        padding: 20px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        border-bottom: 1px solid #e9f0f6;
        background: #f8fcff;
    }

        .generate-offer-header h2 {
            margin: 0;
            color: #284d6c;
            font-size: 18px;
            font-weight: 850;
        }

        .generate-offer-header p {
            margin: 4px 0 0;
            color: #8da3b6;
            font-size: 9px;
        }

    .offer-modal-close {
        width: 34px;
        height: 34px;
        border: 1px solid #dbe8f3;
        border-radius: 10px;
        background: white;
        color: #7c92a7;
        cursor: pointer;
    }

    .generate-offer-body {
        max-height: 58vh;
        overflow-y: auto;
        padding: 20px 22px;
    }

    .generate-description {
        margin: 0 0 14px;
        color: #8298ac;
        font-size: 10px;
    }

    .generate-field {
        margin-bottom: 13px;
    }

        .generate-field label {
            display: block;
            margin-bottom: 6px;
            color: #4a657d;
            font-size: 10px;
            font-weight: 800;
        }

        .generate-field input {
            width: 100%;
            height: 43px;
            padding: 0 12px;
            border: 1px solid #d8e6f2;
            border-radius: 10px;
            background: #fbfdff;
            color: #395772;
            font-size: 11px;
            outline: none;
        }

            .generate-field input:focus {
                border-color: #8bc3ed;
                box-shadow: 0 0 0 4px rgba(105,183,244,.10);
            }

    .generate-offer-footer {
        padding: 15px 22px;
        display: flex;
        justify-content: flex-end;
        gap: 8px;
        border-top: 1px solid #e9f0f6;
        background: #fbfdff;
    }

    .offer-cancel-btn,
    .offer-create-btn {
        min-height: 40px;
        padding: 0 15px;
        border-radius: 10px;
        font-size: 10px;
        font-weight: 800;
        cursor: pointer;
    }

    .offer-cancel-btn {
        border: 1px solid #d7e5f0;
        background: white;
        color: #6d8498;
    }

    .offer-create-btn {
        border: 1px solid #75b9e9;
        background: linear-gradient(180deg,#91cdf7,#73b8ea);
        color: white;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1200px) {
        .offer-studio-layout

    {
        grid-template-columns: 230px minmax(520px, 1fr);
    }

    .offer-detail-sidebar {
        grid-column: 1 / -1;
        border-left: 0;
        border-top: 1px solid var(--offer-line-soft);
    }

        .offer-detail-sidebar .offer-sidebar-inner {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 18px;
        }

    .offer-right-section {
        border-bottom: 0;
        margin-bottom: 0;
        padding-bottom: 0;
    }

    }

    @@media (max-width: 800px) {
        .offer-studio-page

    {
        padding: 10px;
    }

    .offer-studio-topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .offer-topbar-actions {
        width: 100%;
        flex-wrap: wrap;
    }

    .offer-studio-layout {
        display: block;
    }

    .offer-template-sidebar {
        border-right: 0;
        border-bottom: 1px solid var(--offer-line-soft);
    }

    .offer-template-list {
        max-height: 260px;
    }

    .offer-document-workspace {
        padding: 22px 12px 30px;
    }

    .offer-letter-paper {
