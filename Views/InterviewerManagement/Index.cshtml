@model IEnumerable<RecruitmentTracker.Models.JobApplication>

@{
    ViewData["Title"] = "Candidates";

    var selectedStatus = ViewBag.Status as string ?? "all";
    var search = ViewBag.Search as string ?? "";
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
    var minScore = ViewBag.MinScore;

    var applications = Model?.ToList()
        ?? new List<RecruitmentTracker.Models.JobApplication>();

    var allCount = ViewBag.AllCount ?? 0;
    var passedCount = ViewBag.PassedCount ?? 0;
    var reviewCount = ViewBag.ReviewCount ?? 0;
    var failedCount = ViewBag.FailedCount ?? 0;
}

<style>
    /* =========================================================
           SOFT BLUE DASHBOARD THEME
           ========================================================= */

    .candidates-page {
        min-height: calc(100vh - 70px);
        padding: 30px;
        background: radial-gradient(circle at 0% 0%, rgba(120, 188, 255, .19), transparent 28%), radial-gradient(circle at 100% 100%, rgba(93, 164, 255, .13), transparent 28%), #edf6ff;
        color: #28445e;
        font-family: "Inter", "Segoe UI", sans-serif;
    }

    .candidates-shell {
        max-width: 1500px;
        margin: 0 auto;
        padding: 28px;
        border-radius: 28px;
        background: rgba(255, 255, 255, .86);
        border: 1px solid rgba(255, 255, 255, .95);
        box-shadow: 0 18px 55px rgba(74, 124, 173, .10);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .candidate-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 22px;
        margin-bottom: 24px;
    }

    .candidate-title-wrap {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .candidate-title-icon {
        width: 58px;
        height: 58px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        background: linear-gradient(145deg, #58afff, #2b8df1);
        box-shadow: 0 12px 28px rgba(43, 141, 241, .24);
        flex-shrink: 0;
    }

        .candidate-title-icon svg {
            width: 27px;
            height: 27px;
        }

    .candidate-heading-label {
        color: #4e9fe9;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .candidate-header h1 {
        margin: 0;
        color: #17324d;
        font-size: 31px;
        line-height: 1.1;
        font-weight: 800;
        letter-spacing: -.45px;
    }

    .candidate-header p {
        margin: 6px 0 0;
        color: #8da2b5;
        font-size: 13px;
    }

    /* =========================================================
           SEARCH
           ========================================================= */

    .candidate-search {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 520px;
    }

        .candidate-search form {
            display: flex;
            align-items: center;
            gap: 9px;
            width: 100%;
        }

    .candidate-search-box {
        flex: 1;
        position: relative;
    }

        .candidate-search-box svg {
            position: absolute;
            width: 17px;
            height: 17px;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #9bb0c4;
            pointer-events: none;
        }

        .candidate-search-box input {
            width: 100%;
            height: 46px;
            border: 1px solid #e2ecf5;
            border-radius: 14px;
            background: #fbfdff;
            padding: 0 15px 0 44px;
            color: #365069;
            font-size: 13px;
            outline: none;
            transition: .2s ease;
        }

            .candidate-search-box input::placeholder {
                color: #a0b2c2;
            }

            .candidate-search-box input:focus {
                background: #fff;
                border-color: #63aff3;
                box-shadow: 0 0 0 4px rgba(62, 151, 237, .10);
            }

    .search-btn,
    .filter-button {
        height: 46px;
        border-radius: 13px;
        padding: 0 17px;
        font-size: 12px;
        font-weight: 700;
        transition: .2s ease;
        white-space: nowrap;
    }

    .search-btn {
        border: none;
        color: white;
        background: linear-gradient(135deg, #4da7ff, #2b8df1);
        box-shadow: 0 8px 20px rgba(43, 141, 241, .18);
    }

        .search-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 11px 24px rgba(43, 141, 241, .23);
        }

    .filter-button {
        border: 1px solid #e0eaf3;
        color: #60798f;
        background: #fff;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

        .filter-button:hover {
            color: #338ee1;
            border-color: #a7cef2;
            background: #f8fcff;
        }

        .filter-button svg {
            width: 15px;
            height: 15px;
        }

    /* =========================================================
           STATS
           ========================================================= */

    .candidate-stats {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 22px;
    }

    .candidate-stat-card {
        background: #fff;
        border: 1px solid #edf3f8;
        border-radius: 19px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 8px 24px rgba(73, 117, 157, .055);
        transition: .2s ease;
    }

        .candidate-stat-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 28px rgba(73, 117, 157, .09);
        }

    .candidate-stat-icon {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .candidate-stat-icon svg {
            width: 21px;
            height: 21px;
        }

    .stat-all {
        color: #318ee6;
        background: #eaf5ff;
    }

    .stat-passed {
        color: #24966f;
        background: #e9f8f2;
    }

    .stat-review {
        color: #b17a2c;
        background: #fff6e8;
    }

    .stat-failed {
        color: #d25d68;
        background: #fff0f2;
    }

    .candidate-stat-data span {
        display: block;
        color: #91a5b8;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 3px;
    }

    .candidate-stat-data strong {
        color: #1e3a55;
        font-size: 23px;
        line-height: 1;
        font-weight: 800;
    }

    /* =========================================================
           TABS
           ========================================================= */

    .pipeline-tabs {
        display: flex;
        align-items: center;
        gap: 6px;
        width: fit-content;
        padding: 5px;
        margin-bottom: 18px;
        background: #edf5fc;
        border-radius: 14px;
    }

    .pipeline-tab {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 15px;
        border-radius: 10px;
        color: #7890a6;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: .2s ease;
    }

        .pipeline-tab:hover {
            color: #358edc;
        }

        .pipeline-tab.active {
            color: #318de2;
            background: #fff;
            box-shadow: 0 3px 12px rgba(52, 132, 202, .10);
        }

    .pipeline-count {
        min-width: 22px;
        height: 22px;
        padding: 0 6px;
        border-radius: 20px;
        background: rgba(255, 255, 255, .72);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: inherit;
        font-size: 10px;
        font-weight: 800;
    }

    /* =========================================================
           FILTER PANEL
           ========================================================= */

    .filter-panel {
        display: none;
        margin-bottom: 18px;
        padding: 20px;
        background: #fff;
        border: 1px solid #eaf1f7;
        border-radius: 18px;
        box-shadow: 0 8px 28px rgba(70, 110, 145, .06);
    }

        .filter-panel.show {
            display: block;
        }

    .filter-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 17px;
    }

        .filter-title strong {
            color: #203e59;
            font-size: 14px;
        }

        .filter-title span {
            display: block;
            color: #9aabba;
            font-size: 11px;
            margin-top: 3px;
        }

    .filter-panel .form-label {
        color: #698096;
        font-size: 11px;
        font-weight: 700;
        margin-bottom: 6px;
    }

    .filter-panel .form-control {
        height: 42px;
        border: 1px solid #e1ebf3;
        border-radius: 11px;
        background: #fbfdff;
        color: #435d73;
        font-size: 12px;
        box-shadow: none;
    }

        .filter-panel .form-control:focus {
            border-color: #63adf0;
            box-shadow: 0 0 0 4px rgba(69, 157, 239, .08);
        }

    .filter-apply-btn {
        height: 42px;
        border: 0;
        border-radius: 11px;
        color: white;
        background: linear-gradient(135deg, #4da7ff, #2b8df1);
        font-size: 12px;
        font-weight: 700;
    }

    .filter-reset-btn {
        height: 37px;
        padding: 0 14px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        text-decoration: none;
        color: #74889a;
        border: 1px solid #e2ebf3;
        background: #fff;
        font-size: 11px;
        font-weight: 700;
    }

    /* =========================================================
           TABLE CARD
           ========================================================= */

    .table-wrap {
        overflow: hidden;
        background: #fff;
        border: 1px solid #edf3f8;
        border-radius: 21px;
        box-shadow: 0 10px 35px rgba(72, 112, 149, .06);
    }

    .table-card-heading {
        padding: 20px 22px;
        border-bottom: 1px solid #edf2f6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

        .table-card-heading strong {
            display: block;
            color: #203b55;
            font-size: 16px;
            font-weight: 800;
            margin-bottom: 4px;
        }

        .table-card-heading span {
            color: #9aabba;
            font-size: 11px;
        }

    .candidate-selection-toolbar {
        padding: 16px 20px;
        border-bottom: 1px solid #edf2f6;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 18px;
        background: #fafdff;
    }

        .candidate-selection-toolbar strong {
            display: block;
            color: #24425c;
            font-size: 13px;
            font-weight: 800;
        }

        .candidate-selection-toolbar span {
            display: block;
            margin-top: 3px;
            color: #95a7b7;
            font-size: 11px;
        }

    .selection-actions {
        display: flex;
        align-items: center;
        gap: 7px;
        flex-wrap: wrap;
    }

    .selection-btn {
        height: 36px;
        padding: 0 13px;
        border-radius: 10px;
        border: 1px solid #dce7f0;
        background: #fff;
        color: #60778c;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: .2s ease;
    }

        .selection-btn:hover {
            color: #328dde;
            border-color: #9fcaf0;
            background: #f8fcff;
        }

    .pass-btn {
        color: #287a5b;
        border-color: #c0e2d3;
        background: #f6fdf9;
    }

        .pass-btn:hover {
            color: #21694e;
            border-color: #8ccdb0;
            background: #eaf8f2;
        }

    .fail-btn {
        color: #b64e55;
        border-color: #f0c9cd;
        background: #fffafa;
    }

        .fail-btn:hover {
            color: #a23e47;
            border-color: #e8aeb4;
            background: #fff2f4;
        }

    .send-hm-btn {
        color: white;
        border-color: transparent;
        background: linear-gradient(135deg, #4da7ff, #2b8df1);
        box-shadow: 0 7px 18px rgba(43, 141, 241, .15);
    }

        .send-hm-btn:hover {
            color: white;
            border-color: transparent;
            background: linear-gradient(135deg, #419fff, #237fdd);
        }

    /* =========================================================
           TABLE
           ========================================================= */

    .candidate-table {
        width: 100%;
        min-width: 1120px;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .candidate-table thead {
            background: #f7fbfe;
        }

        .candidate-table th {
            padding: 13px 15px;
            text-align: left;
            color: #8196aa;
            text-transform: uppercase;
            font-size: 9px;
            letter-spacing: .8px;
            font-weight: 800;
            border-bottom: 1px solid #edf3f8;
            white-space: nowrap;
        }

        .candidate-table td {
            padding: 15px;
            color: #5d7488;
            font-size: 12px;
            vertical-align: middle;
            border-bottom: 1px solid #f0f4f7;
        }

        .candidate-table tbody tr {
            transition: .15s ease;
        }

            .candidate-table tbody tr:hover {
                background: #fbfdff;
            }

            .candidate-table tbody tr:last-child td {
                border-bottom: none;
            }

    /* =========================================================
           CANDIDATE
           ========================================================= */

    .candidate-info {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 210px;
    }

    .candidate-avatar {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: #348fe3;
        background: linear-gradient(145deg, #e9f5ff, #dceeff);
        font-size: 11px;
        font-weight: 800;
    }

    .candidate-name {
        color: #25405a;
        font-size: 12.5px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .job-title {
        color: #28445f;
        font-size: 12.5px;
        font-weight: 800;
        margin-bottom: 3px;
    }

    .job-code {
        color: #9cafbf;
        font-size: 9.5px;
        font-weight: 600;
    }

    /* =========================================================
           SCORE
           ========================================================= */

    .score-wrapper {
        min-width: 110px;
    }

    .score-number {
        color: #29465f;
        font-size: 11.5px;
        font-weight: 800;
    }

    .score-progress {
        width: 88px;
        height: 6px;
        margin-top: 6px;
        overflow: hidden;
        border-radius: 10px;
        background: #e8eff5;
    }

    .score-progress-bar {
        height: 100%;
        border-radius: 10px;
        background: linear-gradient(90deg, #69b7ff, #2d8cf0);
    }

    /* =========================================================
           STATUS
           ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        white-space: nowrap;
    }

        .status-badge::before {
            content: "";
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: currentColor;
        }

    .status-passed {
        color: #287a5b;
        background: #e9f7f1;
    }

    .status-review {
        color: #a56820;
        background: #fff5e8;
    }

    .status-failed {
        color: #b64e55;
        background: #fbeeee;
    }

    .sent-hm-mark {
        display: inline-flex;
        align-items: center;
        padding: 5px 9px;
        border-radius: 20px;
        color: #2d8b68;
        background: #eaf8f2;
        font-size: 9.5px;
        font-weight: 800;
        white-space: nowrap;
    }

    /* =========================================================
           ACTIONS
           ========================================================= */

    .action-buttons {
        display: flex;
        align-items: center;
        gap: 6px;
        min-width: 190px;
        flex-wrap: wrap;
    }

    .candidate-action {
        height: 32px;
        padding: 0 11px;
        border-radius: 9px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: 1px solid #e2ebf3;
        background: #fff;
        color: #657d91;
        font-size: 10px;
        font-weight: 700;
        transition: .2s ease;
    }

        .candidate-action:hover {
            color: #318ddd;
            border-color: #a8cdf1;
            background: #f7fbff;
        }

    .review-action {
        color: #318de1;
        background: #eaf5ff;
        border-color: #d9edff;
    }

    .cv-action {
        color: #667f94;
    }

    .cover-action {
        color: #287a5b;
        border-color: #cbe8db;
        background: #f8fdfb;
    }

    /* =========================================================
           EMPTY
           ========================================================= */

    .empty-state {
        padding: 70px 22px;
        text-align: center;
        background: #fff;
    }

    .empty-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 15px;
        border-radius: 20px;
        background: #eaf5ff;
        color: #3894ea;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .empty-icon svg {
            width: 28px;
            height: 28px;
        }

    .empty-state h5 {
        color: #28445e;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .empty-state p {
        color: #94a7b8;
        font-size: 12px;
        margin: 0;
    }

    /* =========================================================
           CHECKBOXES
           ========================================================= */

    .select-column {
        width: 58px;
        min-width: 58px;
        text-align: center !important;
    }

    .candidate-checkbox,
    .hm-candidate-checkbox,
    #selectAllCheckbox {
        width: 17px !important;
        height: 17px !important;
        margin: 0 !important;
        cursor: pointer !important;
        accent-color: #318de2;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1100px) {
        .candidate-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .candidate-search {
            width: 100%;
            min-width: 0;
        }

        .candidate-stats {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 760px) {
        .candidates-page {
            padding: 15px;
        }

        .candidates-shell {
            padding: 17px;
            border-radius: 20px;
        }

        .candidate-title-wrap {
            align-items: flex-start;
        }

        .candidate-header h1 {
            font-size: 26px;
        }

        .candidate-search,
        .candidate-search form {
            flex-direction: column;
            align-items: stretch;
        }

        .search-btn,
        .filter-button {
            width: 100%;
        }

        .candidate-stats {
            grid-template-columns: 1fr;
        }

        .pipeline-tabs {
            width: 100%;
            overflow-x: auto;
        }

        .candidate-selection-toolbar {
            align-items: flex-start;
            flex-direction: column;
        }

        .selection-actions {
            width: 100%;
        }

        .table-card-heading {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>

<div class="candidates-page">
    <div class="candidates-shell">

        <!-- HEADER -->
        <div class="candidate-header">

            <div class="candidate-title-wrap">

                <div class="candidate-title-icon">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>

                <div>
                    <div class="candidate-heading-label">
                        HR workspace · candidates
                    </div>

                    <h1>Candidates</h1>

                    <p>
                        Review applicants, AI scores and hiring pipeline decisions from one workspace.
                    </p>
                </div>

            </div>

            <div class="candidate-search">

                <form method="get"
                      asp-action="Management">

                    <input type="hidden"
                           name="status"
                           value="@selectedStatus" />

                    <input type="hidden"
                           name="fromDate"
                           value="@fromDate" />

                    <input type="hidden"
                           name="toDate"
                           value="@toDate" />

                    <input type="hidden"
                           name="minScore"
                           value="@minScore" />

                    <div class="candidate-search-box">

                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="2">
                            <circle cx="11" cy="11" r="7"></circle>
                            <path d="m20 20-4-4"></path>
                        </svg>

                        <input type="text"
                               name="search"
                               value="@search"
                               placeholder="Search candidates..." />

                    </div>

                    <button type="submit"
                            class="search-btn">
                        Search
                    </button>

                </form>

                <button type="button"
                        class="filter-button"
                        onclick="toggleFilters()">

                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="2">
                        <path d="M4 6h16M7 12h10M10 18h4"></path>
                    </svg>

                    Filters
                </button>

            </div>

        </div>

        <!-- STATS -->
        <div class="candidate-stats">

            <div class="candidate-stat-card">
                <div class="candidate-stat-icon stat-all">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M19 8v6M16 11h6"></path>
                    </svg>
                </div>
                <div class="candidate-stat-data">
                    <span>All candidates</span>
                    <strong>@allCount</strong>
                </div>
            </div>

            <div class="candidate-stat-card">
                <div class="candidate-stat-icon stat-passed">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="m8 12 2.5 2.5L16 9"></path>
                    </svg>
                </div>
                <div class="candidate-stat-data">
                    <span>Passed</span>
                    <strong>@passedCount</strong>
                </div>
            </div>

            <div class="candidate-stat-card">
                <div class="candidate-stat-icon stat-review">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="M12 7v5l3 2"></path>
                    </svg>
                </div>
                <div class="candidate-stat-data">
                    <span>Needs review</span>
                    <strong>@reviewCount</strong>
                </div>
            </div>

            <div class="candidate-stat-card">
                <div class="candidate-stat-icon stat-failed">
                    <svg viewBox="0 0 24 24"
                         fill="none"
                         stroke="currentColor"
                         stroke-width="1.8">
                        <circle cx="12" cy="12" r="9"></circle>
                        <path d="m9 9 6 6M15 9l-6 6"></path>
                    </svg>
                </div>
                <div class="candidate-stat-data">
                    <span>Failed</span>
                    <strong>@failedCount</strong>
                </div>
            </div>

        </div>

        <!-- TABS -->
        <div class="pipeline-tabs">

            <a asp-action="Management"
               asp-route-status="all"
               asp-route-search="@search"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-minScore="@minScore"
               class="pipeline-tab @(selectedStatus == "all" ? "active" : "")">
                All
                <span class="pipeline-count">@allCount</span>
            </a>

            <a asp-action="Management"
               asp-route-status="passed"
               asp-route-search="@search"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-minScore="@minScore"
               class="pipeline-tab @(selectedStatus == "passed" ? "active" : "")">
                Passed
                <span class="pipeline-count">@passedCount</span>
            </a>

            <a asp-action="Management"
               asp-route-status="review"
               asp-route-search="@search"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-minScore="@minScore"
               class="pipeline-tab @(selectedStatus == "review" ? "active" : "")">
                Review
                <span class="pipeline-count">@reviewCount</span>
            </a>

            <a asp-action="Management"
               asp-route-status="failed"
               asp-route-search="@search"
               asp-route-fromDate="@fromDate"
               asp-route-toDate="@toDate"
               asp-route-minScore="@minScore"
               class="pipeline-tab @(selectedStatus == "failed" ? "active" : "")">
                Failed
                <span class="pipeline-count">@failedCount</span>
            </a>

        </div>

        <!-- FILTER PANEL -->
        <form method="get"
              asp-action="Management"
              id="filterPanel"
              class="filter-panel">

            <input type="hidden"
                   name="status"
                   value="@selectedStatus" />

            <input type="hidden"
                   name="search"
                   value="@search" />

            <div class="filter-title">

                <div>
                    <strong>Filter candidates</strong>
                    <span>
                        Narrow candidates by application date or minimum AI score.
                    </span>
                </div>

                <a asp-action="Management"
                   class="filter-reset-btn">
                    Reset
                </a>

            </div>

            <div class="row g-3">

                <div class="col-lg-3">
                    <label class="form-label">From date</label>

                    <input type="date"
                           name="fromDate"
                           value="@fromDate"
                           class="form-control" />
                </div>

                <div class="col-lg-3">
                    <label class="form-label">To date</label>

                    <input type="date"
                           name="toDate"
                           value="@toDate"
                           class="form-control" />
                </div>

                <div class="col-lg-3">
                    <label class="form-label">Minimum AI score</label>

                    <input type="number"
                           name="minScore"
                           value="@minScore"
                           min="0"
                           max="100"
                           step="1"
                           class="form-control"
                           placeholder="e.g. 70" />
                </div>

                <div class="col-lg-3 d-flex align-items-end">
                    <button type="submit"
                            class="filter-apply-btn w-100">
                        Apply filters
                    </button>
                </div>

            </div>

        </form>

        <!-- TABLE CARD -->
        <div class="table-wrap">

            <div class="table-card-heading">
                <div>
                    <strong>Candidate overview</strong>
                    <span>
                        @applications.Count @(applications.Count == 1 ? "candidate" : "candidates") displayed
                    </span>
                </div>
            </div>

            @if (!applications.Any())
            {
                <div class="empty-state">

                    <div class="empty-icon">
                        <svg viewBox="0 0 24 24"
                             fill="none"
                             stroke="currentColor"
                             stroke-width="1.8">
                            <circle cx="9" cy="8" r="4"></circle>
                            <path d="M3 20a6 6 0 0 1 12 0"></path>
                            <path d="M18 8v6M15 11h6"></path>
                        </svg>
                    </div>

                    <h5>No candidates found</h5>

                    <p>
                        Try changing your search or filter options.
                    </p>

                </div>
            }
            else
            {
                @if (selectedStatus == "review")
                {
                    <form method="post"
                          id="candidateForm">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="vacancyId"
                               id="vacancyId"
                               value="" />

                        <div class="candidate-selection-toolbar">

                            <div>
                                <strong>Review candidates</strong>
                                <span id="selectionText">
                                    Select candidates to pass or fail.
                                </span>
                            </div>

                            <div class="selection-actions">

                                <button type="button"
                                        id="selectAllBtn"
                                        class="selection-btn">
                                    Select All
                                </button>

                                <button type="submit"
                                        formaction="@Url.Action("MarkPassed", "HRApplication")"
                                        class="selection-btn pass-btn">
                                    Pass Selected
                                </button>

                                <button type="submit"
                                        formaction="@Url.Action("MarkFailed", "HRApplication")"
                                        class="selection-btn fail-btn">
                                    Fail Selected
                                </button>

                            </div>

                        </div>

                        <div class="table-responsive">

                            <table class="candidate-table">

                                <thead>
                                    <tr>
                                        <th class="select-column">
                                            <input type="checkbox"
                                                   id="selectAllCheckbox" />
                                        </th>
                                        <th>Candidate</th>
                                        <th>Job</th>
                                        <th>AI Score</th>
                                        <th>Status</th>
                                        <th>Applied</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var application in applications)
                                    {
                                        var candidateName =
                                        application.Candidate?.FullName
                                        ?? "Unknown Candidate";

                                        var initials = "??";

                                        if (!string.IsNullOrWhiteSpace(candidateName))
                                        {
                                            var nameParts = candidateName
                                            .Trim()
                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                            if (nameParts.Length >= 2)
                                            {
                                                initials =
                                                $"{nameParts[0][0]}{nameParts[^1][0]}"
                                                .ToUpper();
                                            }
                                            else if (nameParts.Length == 1)
                                            {
                                                initials = nameParts[0]
                                                .Substring(
                                                0,
                                                Math.Min(2, nameParts[0].Length)
                                                )
                                                .ToUpper();
                                            }
                                        }

                                        var score = Math.Min(
                                        100,
                                        Math.Max(0, application.AIScore)
                                        );

                                        <tr>

                                            <td class="select-column">
                                                <input type="checkbox"
                                                       class="candidate-checkbox"
                                                       name="selectedIds"
                                                       value="@application.Id"
                                                       data-vacancy-id="@application.JobVacancyId" />
                                            </td>

                                            <td>
                                                <div class="candidate-info">
                                                    <div class="candidate-avatar">
                                                        @initials
                                                    </div>

                                                    <div>
                                                        <div class="candidate-name">
                                                            @candidateName
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <div class="job-title">
                                                    @(application.JobVacancy?.JobTitle ?? "Unknown Job")
                                                </div>

                                                @if (application.JobVacancy != null)
                                                {
                                                    <div class="job-code">
                                                        @application.JobVacancy.JobCode
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <div class="score-wrapper">
                                                    <div class="score-number">
                                                        @application.AIScore.ToString("0.0")%
                                                    </div>

                                                    <div class="score-progress">
                                                        <div class="score-progress-bar"
                                                             style="width:@score%">
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="status-badge status-review">
                                                    Review
                                                </span>
                                            </td>

                                            <td>
                                                @application.AppliedDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                <div class="action-buttons">

                                                    <a asp-action="AIAnalysis"
                                                       asp-route-id="@application.Id"
                                                       asp-route-vacancyId="@application.JobVacancyId"
                                                       class="candidate-action review-action">
                                                        Review
                                                    </a>

                                                    @if (!string.IsNullOrWhiteSpace(application.CVFilePath))
                                                    {
                                                        <a asp-action="ViewCV"
                                                           asp-route-id="@application.Id"
                                                           asp-route-vacancyId="@application.JobVacancyId"
                                                           target="_blank"
                                                           class="candidate-action cv-action">
                                                            CV
                                                        </a>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(application.CoverLetterFilePath))
                                                    {
                                                        <a asp-action="ViewCoverLetter"
                                                           asp-route-id="@application.Id"
                                                           asp-route-vacancyId="@application.JobVacancyId"
                                                           target="_blank"
                                                           class="candidate-action cover-action">
                                                            Cover Letter
                                                        </a>
                                                    }

                                                </div>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </form>
                }
                else
                {
                    <form id="sendToHiringManagerForm"
                          asp-controller="HRApplication"
                          asp-action="SendToHiringManager"
                          method="post">

                        @Html.AntiForgeryToken()

                        @if (selectedStatus == "passed")
                        {
                            <div class="candidate-selection-toolbar">

                                <div>
                                    <strong>Passed candidates</strong>
                                    <span id="hmSelectionText">
                                        Select passed candidates to send to the Hiring Manager.
                                    </span>
                                </div>

                                <div class="selection-actions">

                                    <button type="button"
                                            id="hmSelectAllBtn"
                                            class="selection-btn">
                                        Select All
                                    </button>

                                    <button type="submit"
                                            class="selection-btn send-hm-btn">
                                        Send to Hiring Manager →
                                    </button>

                                </div>

                            </div>
                        }

                        <div class="table-responsive">

                            <table class="candidate-table">

                                <thead>
                                    <tr>

                                        @if (selectedStatus == "passed")
                                        {
                                            <th class="select-column">Select</th>
                                        }

                                        <th>Candidate</th>
                                        <th>Job</th>
                                        <th>AI Score</th>
                                        <th>Status</th>
                                        <th>Applied</th>
                                        <th>Actions</th>

                                    </tr>
                                </thead>

                                <tbody>

                                    @foreach (var application in applications)
                                    {
                                        var candidateName =
                                        application.Candidate?.FullName
                                        ?? "Unknown Candidate";

                                        var initials = "??";

                                        if (!string.IsNullOrWhiteSpace(candidateName))
                                        {
                                            var nameParts = candidateName
                                            .Trim()
                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

                                            if (nameParts.Length >= 2)
                                            {
                                                initials =
                                                $"{nameParts[0][0]}{nameParts[^1][0]}"
                                                .ToUpper();
                                            }
                                            else if (nameParts.Length == 1)
                                            {
                                                initials = nameParts[0]
                                                .Substring(
                                                0,
                                                Math.Min(2, nameParts[0].Length)
                                                )
                                                .ToUpper();
                                            }
                                        }

                                        var score = Math.Min(
                                        100,
                                        Math.Max(0, application.AIScore)
                                        );

                                        string displayStatus;
                                        string statusClass;

                                        if (application.HRShortlisted)
                                        {
                                            displayStatus = "Sent to HM";
                                            statusClass = "status-passed";
                                        }
                                        else if (application.Status == "Passed")
                                        {
                                            displayStatus = "Passed";
                                            statusClass = "status-passed";
                                        }
                                        else if (application.Status == "Not Shortlisted")
                                        {
                                            displayStatus = "Failed";
                                            statusClass = "status-failed";
                                        }
                                        else if (application.Status == "Under Review")
                                        {
                                            displayStatus = "Review";
                                            statusClass = "status-review";
                                        }
                                        else if (application.AIScore >= 70)
                                        {
                                            displayStatus = "Passed";
                                            statusClass = "status-passed";
                                        }
                                        else if (application.AIScore >= 50)
                                        {
                                            displayStatus = "Review";
                                            statusClass = "status-review";
                                        }
                                        else
                                        {
                                            displayStatus = "Failed";
                                            statusClass = "status-failed";
                                        }

                                        <tr>

                                            @if (selectedStatus == "passed")
                                            {
                                                <td class="select-column">

                                                    @if (!application.HRShortlisted)
                                                    {
                                                        <input type="checkbox"
                                                               class="hm-candidate-checkbox"
                                                               name="selectedIds"
                                                               value="@application.Id" />
                                                    }
                                                    else
                                                    {
                                                        <span class="sent-hm-mark"
                                                              title="Already sent to Hiring Manager">
                                                            ✓ Sent
                                                        </span>
                                                    }

                                                </td>
                                            }

                                            <td>
                                                <div class="candidate-info">
                                                    <div class="candidate-avatar">
                                                        @initials
                                                    </div>

                                                    <div>
                                                        <div class="candidate-name">
                                                            @candidateName
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <div class="job-title">
                                                    @(application.JobVacancy?.JobTitle ?? "Unknown Job")
                                                </div>

                                                @if (application.JobVacancy != null)
                                                {
                                                    <div class="job-code">
                                                        @application.JobVacancy.JobCode
                                                    </div>
                                                }
                                            </td>

                                            <td>
                                                <div class="score-wrapper">
                                                    <div class="score-number">
                                                        @application.AIScore.ToString("0.0")%
                                                    </div>

                                                    <div class="score-progress">
                                                        <div class="score-progress-bar"
                                                             style="width:@score%">
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>

                                            <td>
                                                <span class="status-badge @statusClass">
                                                    @displayStatus
                                                </span>
                                            </td>

                                            <td>
                                                @application.AppliedDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td>
                                                <div class="action-buttons">

                                                    <a asp-action="AIAnalysis"
                                                       asp-route-id="@application.Id"
                                                       asp-route-vacancyId="@application.JobVacancyId"
                                                       class="candidate-action review-action">
                                                        Review
                                                    </a>

                                                    @if (!string.IsNullOrWhiteSpace(application.CVFilePath))
                                                    {
                                                        <a asp-action="ViewCV"
                                                           asp-route-id="@application.Id"
                                                           asp-route-vacancyId="@application.JobVacancyId"
                                                           target="_blank"
                                                           class="candidate-action cv-action">
                                                            CV
                                                        </a>
                                                    }

                                                    @if (!string.IsNullOrWhiteSpace(application.CoverLetterFilePath))
                                                    {
                                                        <a asp-action="ViewCoverLetter"
                                                           asp-route-id="@application.Id"
                                                           asp-route-vacancyId="@application.JobVacancyId"
                                                           target="_blank"
                                                           class="candidate-action cover-action">
                                                            Cover Letter
                                                        </a>
                                                    }

                                                </div>
                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>

                    </form>
                }
            }

        </div>

    </div>
</div>

<!-- JAVASCRIPT -->
@if (selectedStatus == "review")
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("candidateForm");

            if (!form) {
                return;
            }

            const selectAllCheckbox =
                document.getElementById("selectAllCheckbox");

            const selectAllBtn =
                document.getElementById("selectAllBtn");

            const selectionText =
                document.getElementById("selectionText");

            const checkboxes =
                Array.from(
                    document.querySelectorAll(".candidate-checkbox")
                );

            function updateSelection() {

                const selected =
                    checkboxes.filter(
                        checkbox => checkbox.checked
                    );

                const count = selected.length;

                selectionText.textContent =
                    count === 0
                        ? "Select candidates to pass or fail."
                        : count + " candidate(s) selected.";

                const allSelected =
                    checkboxes.length > 0 &&
                    selected.length === checkboxes.length;

                if (selectAllCheckbox) {
                    selectAllCheckbox.checked = allSelected;
                }

                if (selectAllBtn) {
                    selectAllBtn.textContent =
                        allSelected
                            ? "Deselect All"
                            : "Select All";
                }
            }

            if (selectAllCheckbox) {
                selectAllCheckbox.addEventListener(
                    "change",
                    function () {

                        checkboxes.forEach(
                            checkbox => {
                                checkbox.checked =
                                    selectAllCheckbox.checked;
                            }
                        );

                        updateSelection();
                    }
                );
            }

            if (selectAllBtn) {
                selectAllBtn.addEventListener(
                    "click",
                    function () {

                        const allSelected =
                            checkboxes.length > 0 &&
                            checkboxes.every(
                                checkbox => checkbox.checked
                            );

                        checkboxes.forEach(
                            checkbox => {
                                checkbox.checked =
                                    !allSelected;
                            }
                        );

                        updateSelection();
                    }
                );
            }

            checkboxes.forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        updateSelection
                    );
                }
            );

            form.addEventListener(
                "submit",
                function (event) {

                    const selected =
                        checkboxes.filter(
                            checkbox => checkbox.checked
                        );

                    if (selected.length === 0) {

                        event.preventDefault();

                        alert(
                            "Please select at least one candidate."
                        );

                        return;
                    }

                    const vacancyIds =
                        selected.map(
                            checkbox =>
                                checkbox.dataset.vacancyId
                        );

                    const firstVacancyId =
                        vacancyIds[0];

                    const differentVacancy =
                        vacancyIds.some(
                            id =>
                                id !== firstVacancyId
                        );

                    if (differentVacancy) {

                        event.preventDefault();

                        alert(
                            "Please select candidates from the same job vacancy."
                        );

                        return;
                    }

                    document.getElementById("vacancyId").value =
                        firstVacancyId;
                }
            );

            updateSelection();
        });
    </script>
}

@if (selectedStatus == "passed")
{
    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("sendToHiringManagerForm");

            const selectAllBtn =
                document.getElementById("hmSelectAllBtn");

            const selectionText =
                document.getElementById("hmSelectionText");

            const checkboxes =
                Array.from(
                    document.querySelectorAll(".hm-candidate-checkbox")
                );

            if (!form) {
                return;
            }

            function updateHmSelection() {

                const count =
                    checkboxes.filter(
                        checkbox => checkbox.checked
                    ).length;

                selectionText.textContent =
                    count === 0
                        ? "Select passed candidates to send to the Hiring Manager."
                        : count + " candidate(s) selected.";
            }

            checkboxes.forEach(
                checkbox => {
                    checkbox.addEventListener(
                        "change",
                        updateHmSelection
                    );
                }
            );

            if (selectAllBtn) {
                selectAllBtn.addEventListener(
                    "click",
                    function () {

                        const shouldSelect =
                            checkboxes.some(
                                checkbox => !checkbox.checked
                            );

                        checkboxes.forEach(
                            checkbox => {
                                checkbox.checked =
                                    shouldSelect;
                            }
                        );

                        updateHmSelection();

                        selectAllBtn.textContent =
                            shouldSelect
                                ? "Clear All"
                                : "Select All";
                    }
                );
            }

            form.addEventListener(
                "submit",
                function (event) {

                    const selected =
                        checkboxes.filter(
                            checkbox => checkbox.checked
                        );

                    if (selected.length === 0) {

                        event.preventDefault();

                        alert(
                            "Please select at least one candidate."
                        );

                        return;
                    }

                    if (
                        !confirm(
                            `Send ${selected.length} selected candidate(s) to the Hiring Manager for interview approval?`
                        )
                    ) {
                        event.preventDefault();
                    }
                }
            );

            updateHmSelection();
        });
    </script>
}

<script>
    function toggleFilters() {

        const panel =
            document.getElementById("filterPanel");

        if (panel) {
            panel.classList.toggle("show");
        }
    }
</script>
