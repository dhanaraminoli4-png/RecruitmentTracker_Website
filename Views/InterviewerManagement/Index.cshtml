<form id="calendarAntiForgery">

    @Html.AntiForgeryToken()

</form>


<script>

    (() => {


        const STORAGE_KEY =
            "hiretrack_last_hr_interviewer";


        const avatarButtons =
            Array.from(
                document.querySelectorAll(
                    ".avatar-button"
                )
            );


        if (
            avatarButtons.length === 0 ||
            typeof FullCalendar === "undefined"
        ) {

            return;
        }


        let selectedInterviewerId =
            null;


        let mainCalendar =
            null;


        let miniCalendar =
            null;


        let modalMode =
            "create";


        let currentCalendarEvent =
            null;


        /* =========================================================
           BASIC HELPERS
           ========================================================= */

        function element(id) {

            return document.getElementById(
                id
            );
        }


        function findAvatar(
            interviewerId) {

            return avatarButtons.find(
                button =>
                    button.dataset.interviewerId ===
                    interviewerId
            ) || null;
        }


        function currentAvatar() {

            return findAvatar(
                selectedInterviewerId
            );
        }


        function safe(value) {

            if (
                value === undefined ||
                value === null ||
                value === ""
            ) {

                return "-";
            }

            return value;
        }


        function antiForgeryToken() {

            return document
                .querySelector(
                    '#calendarAntiForgery input[name="__RequestVerificationToken"]'
                )
                ?.value ?? "";
        }


        function escapeCalendarText(
            value) {

            return String(
                value ?? ""
            )
            .replaceAll(
                "&",
                "&amp;"
            )
            .replaceAll(
                "<",
                "&lt;"
            )
            .replaceAll(
                ">",
                "&gt;"
            )
            .replaceAll(
                '"',
                "&quot;"
            )
            .replaceAll(
                "'",
                "&#039;"
            );
        }


        function toInputDateTime(
            date) {

            if (!date) {

                return "";
            }


            const pad =
                value =>
                    String(value)
                        .padStart(
                            2,
                            "0"
                        );


            return (
                date.getFullYear() +
                "-" +

                pad(
                    date.getMonth() + 1
                ) +

                "-" +

                pad(
                    date.getDate()
                ) +

                "T" +

                pad(
                    date.getHours()
                ) +

                ":" +

                pad(
                    date.getMinutes()
                )
            );
        }


        function formatDateTime(
            value) {

            if (!value) {

                return "-";
            }


            const date =
                new Date(
                    value
                );


            if (
                Number.isNaN(
                    date.getTime()
                )
            ) {

                return "-";
            }


            return new Intl.DateTimeFormat(
                undefined,
                {
                    dateStyle:
                        "medium",

                    timeStyle:
                        "short"
                }
            )
            .format(
                date
            );
        }


        function eventColors(
            type) {

            const key =
                String(
                    type || "Other"
                )
                .toLowerCase();


            const map = {

                interview: {
                    background:
                        "#cfc7ff",

                    text:
                        "#40328f"
                },

                meeting: {
                    background:
                        "#d8eef8",

                    text:
                        "#2f6680"
                },

                training: {
                    background:
                        "#f2d8eb",

                    text:
                        "#8e4e77"
                },

                leave: {
                    background:
                        "#d9f0df",

                    text:
                        "#34734b"
                },

                companyevent: {
                    background:
                        "#fae4c7",

                    text:
                        "#87601d"
                },

                personal: {
                    background:
                        "#f7d8dc",

                    text:
                        "#8d474e"
                },

                other: {
                    background:
                        "#e7e9ee",

                    text:
                        "#596677"
                }
            };


            return map[key] ||
                map.other;
        }


