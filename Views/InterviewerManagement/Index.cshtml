        /* =========================================================
           EXISTING EVENT
           ========================================================= */

        function openExistingEvent(
            event) {


            modalMode =
                "edit";


            currentCalendarEvent =
                event;


            const props =
                event.extendedProps ||
                {};


            const systemGenerated =
                props.isSystemGenerated ===
                true;


            /*
                System Interview:
                hide Event Type completely.
            */

            element(
                "eventTypeField"
            ).style.display =
                systemGenerated
                    ? "none"
                    : "block";


            element(
                "eventModalHeading"
            ).textContent =
                systemGenerated
                    ? "Interview Event"
                    : "Edit Event";


            element(
                "eventId"
            ).value =
                event.id ||
                "";


            element(
                "eventTitle"
            ).value =
                event.title ||
                "";


            element(
                "eventType"
            ).value =
                props.scheduleType === "Interview"
                    ? "Other"
                    : (
                        props.scheduleType ||
                        "Other"
                    );


            element(
                "eventStart"
            ).value =
                toInputDateTime(
                    event.start
                );


            /*
                Use the actual DB end time,
                not the visually shortened Month end.
            */

            const originalEnd =
                props.originalEnd;


            const actualEnd =
                originalEnd
                    ? new Date(
                        originalEnd
                    )
                    : (
                        event.end ||
                        new Date(
                            event.start.getTime() +
                            30 * 60 * 1000
                        )
                    );


            element(
                "eventEnd"
            ).value =
                toInputDateTime(
                    actualEnd
                );


            element(
                "eventNotes"
            ).value =
                props.notes ||
                "";


            element(
                "auditCard"
            ).style.display =
                "block";


            element(
                "deleteEventButton"
            ).style.display =
                systemGenerated
                    ? "none"
                    : "inline-flex";


            element(
                "saveEventButton"
            ).style.display =
                systemGenerated
                    ? "none"
                    : "inline-flex";


            element(
                "saveEventButton"
            ).textContent =
                "Save Changes";


            populateAudit(
                event
            );


            lockModal(
                systemGenerated
            );


            showModalError(
                ""
            );


            element(
                "eventModalOverlay"
            ).classList.add(
                "show"
            );
        }


        function closeEventModal() {


            element(
                "eventModalOverlay"
            )
            ?.classList.remove(
                "show"
            );


            showModalError(
                ""
            );
        }


        /* =========================================================
           POST
           ========================================================= */

        async function postCalendarData(
            url,
            values) {


            const body =
                new URLSearchParams();


            Object.entries(
                values
            )
            .forEach(
                ([key, value]) => {


                    body.append(
                        key,
                        value ?? ""
                    );

                }
            );


            body.append(
                "__RequestVerificationToken",
                antiForgeryToken()
            );


            const response =
                await fetch(
                    url,
                    {


                        method:
                            "POST",


                        headers: {

                            "Content-Type":
                                "application/x-www-form-urlencoded; charset=UTF-8"

                        },


                        body:
                            body.toString()

                    }
                );


            if (!response.ok) {


                const message =
                    await response.text();


                throw new Error(
                    message ||
                    "The operation could not be completed."
                );
            }


            return response;
        }


        /* =========================================================
           SAVE EVENT
           ========================================================= */

        async function saveEvent() {


            const title =
                element(
                    "eventTitle"
                ).value.trim();


            const eventType =
                element(
                    "eventType"
                ).value;


            const start =
                element(
                    "eventStart"
                ).value;


            const end =
                element(
                    "eventEnd"
                ).value;


            const notes =
                element(
                    "eventNotes"
                ).value.trim();


            if (
                !start ||
                !end
            ) {


                showModalError(
                    "Please choose a start and end time."
                );


                return;
            }


            if (
                new Date(end) <=
                new Date(start)
            ) {


                showModalError(
                    "End time must be after the start time."
                );


                return;
            }


            element(
                "saveEventButton"
            ).disabled =
                true;


            try {


                if (
                    modalMode ===
                    "create"
                ) {


                    await postCalendarData(
                        "/InterviewerManagement/AddEvent",
                        {


                            interviewerId:
                                selectedInterviewerId,


                            start:
                                start,


                            end:
                                end,


                            scheduleType:
                                eventType,


                            title:
                                title,


                            notes:
                                notes,


                            isAllDay:
                                false

                        }
                    );


                }
                else {


                    await postCalendarData(
                        "/InterviewerManagement/UpdateEvent",
                        {


                            id:
                                element(
                                    "eventId"
                                ).value,


                            start:
                                start,


                            end:
                                end,


                            scheduleType:
                                eventType,


                            title:
                                title,


                            notes:
                                notes,


                            isAllDay:
                                false

                        }
                    );

                }


                closeEventModal();


                mainCalendar.refetchEvents();


                loadUpcomingEvents();

            }
            catch (error) {


                showModalError(
                    error.message
                );

            }
            finally {


                element(
                    "saveEventButton"
                ).disabled =
                    false;

            }
        }


        /* =========================================================
           DELETE EVENT
           ========================================================= */

        async function deleteEvent() {


            const id =
                element(
                    "eventId"
                ).value;


            if (!id) {

                return;
            }


            if (
                !confirm(
                    "Delete this calendar event?"
                )
            ) {

                return;
            }


            element(
                "deleteEventButton"
            ).disabled =
                true;


            try {


                await postCalendarData(
                    "/InterviewerManagement/DeleteEvent",
                    {
                        id:
                            id
                    }
                );


                closeEventModal();


                mainCalendar.refetchEvents();


                loadUpcomingEvents();

            }
            catch (error) {


                showModalError(
                    error.message
                );

            }
            finally {


                element(
                    "deleteEventButton"
                ).disabled =
                    false;

            }
        }


        /* =========================================================
           AVATAR EVENTS
           ========================================================= */

        avatarButtons.forEach(
            button => {


                button.addEventListener(
                    "click",
                    function () {


                        selectInterviewer(
                            this.dataset
                                .interviewerId
                        );

                    }
                );

            }
        );


        document
            .querySelectorAll(
                "[data-open-interviewer]"
            )
            .forEach(
                button => {


                    button.addEventListener(
                        "click",
                        function () {


                            selectInterviewer(
                                this.dataset
                                    .openInterviewer
                            );

                        }
                    );

                }
            );


        /* =========================================================
           FILTERS
           ========================================================= */

        const allEventsToggle =
            element(
                "allEventsToggle"
            );


        const eventTypeToggles =
            Array.from(
                document.querySelectorAll(
                    ".event-type-toggle"
                )
            );


        allEventsToggle
            ?.addEventListener(
                "change",
                function () {


                    eventTypeToggles
                        .forEach(
                            toggle => {


                                toggle.checked =
                                    this.checked;

                            }
                        );


                    mainCalendar
                        ?.refetchEvents();

                }
            );


        eventTypeToggles
            .forEach(
                toggle => {


                    toggle.addEventListener(
                        "change",
                        function () {


                            const allChecked =
                                eventTypeToggles.every(
                                    item =>
                                        item.checked
                                );


                            const noneChecked =
                                eventTypeToggles.every(
                                    item =>
                                        !item.checked
                                );


                            allEventsToggle.checked =
                                allChecked;


                            allEventsToggle.indeterminate =
                                !allChecked &&
                                !noneChecked;


                            mainCalendar
                                ?.refetchEvents();

                        }
                    );

                }
            );


        /* =========================================================
           WEEK / MONTH SWITCH
           ========================================================= */

        document
            .querySelectorAll(
                ".view-button"
            )
            .forEach(
                button => {


                    button.addEventListener(
                        "click",
                        function () {


                            const view =
                                this.dataset.view;


                            mainCalendar.changeView(
                                view
                            );


                            document
                                .querySelectorAll(
                                    ".view-button"
                                )
                                .forEach(
                                    item => {


                                        item.classList.toggle(
                                            "active",
                                            item === this
                                        );

                                    }
                                );


                            updateMainCalendarTitle();

                        }
                    );

                }
            );


        /* =========================================================
           NAVIGATION
           ========================================================= */

        element(
            "prevBtn"
        )
        ?.addEventListener(
            "click",
            function () {

                mainCalendar.prev();

            }
        );


        element(
            "nextBtn"
        )
        ?.addEventListener(
            "click",
            function () {

                mainCalendar.next();

            }
        );


        element(
            "todayBtn"
        )
        ?.addEventListener(
            "click",
            function () {

                mainCalendar.today();

            }
        );


        element(
            "miniPrevBtn"
        )
        ?.addEventListener(
            "click",
            function () {

                miniCalendar.prev();

            }
        );


        element(
            "miniNextBtn"
        )
        ?.addEventListener(
            "click",
            function () {

                miniCalendar.next();

            }
        );


        /* =========================================================
           MODAL BUTTONS
           ========================================================= */

        element(
            "eventModalClose"
        )
        ?.addEventListener(
            "click",
            closeEventModal
        );


        element(
            "cancelEventButton"
        )
        ?.addEventListener(
            "click",
            closeEventModal
        );


        element(
            "saveEventButton"
        )
        ?.addEventListener(
            "click",
            saveEvent
        );


        element(
            "deleteEventButton"
        )
        ?.addEventListener(
            "click",
            deleteEvent
        );


        element(
            "eventModalOverlay"
        )
        ?.addEventListener(
            "click",
            function (event) {


                if (
                    event.target ===
                    this
                ) {

                    closeEventModal();

                }

            }
        );


        /* =========================================================
           LAST CLICKED INTERVIEWER
           ========================================================= */

        let initialInterviewerId =
            null;


        try {


            initialInterviewerId =
                localStorage.getItem(
                    STORAGE_KEY
                );

        }
        catch {


            initialInterviewerId =
                null;

        }


        if (
            !findAvatar(
                initialInterviewerId
            )
        ) {


            initialInterviewerId =
                avatarButtons[0]
                    .dataset
                    .interviewerId;

        }


        selectedInterviewerId =
            initialInterviewerId;


        avatarButtons.forEach(
            avatar => {

                avatar.classList.toggle(
                    "active",
                    avatar.dataset.interviewerId ===
                        selectedInterviewerId
                );

            }
        );


        /* =========================================================
           START
           ========================================================= */

        initialiseMainCalendar();


        initialiseMiniCalendar();


        updateMainCalendarTitle();


        loadUpcomingEvents();


    })();

</script>