@model IEnumerable<RecruitmentTracker.Models.ApplicationUser>

@{
    ViewData["Title"] = "Interviewer Management";

    var interviewers =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.ApplicationUser>();
}


<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.css" />

<script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js"></script>


<style>

    /* ============================================================
           PAGE
           ============================================================ */

    .calendar-page {
        min-height: calc(100vh - 75px);
        padding: 16px;
        background: #f6f6fb;
    }

    .calendar-shell {
        max-width: 1540px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 68px 285px minmax(0, 1fr);
        gap: 14px;
        align-items: stretch;
    }

    .calendar-surface {
        background: #ffffff;
        border: 1px solid #e8e8ef;
        border-radius: 19px;
        box-shadow: 0 4px 18px rgba(23, 23, 45, .035);
    }


    /* ============================================================
           AVATAR RAIL
           ============================================================ */

    .avatar-rail {
        min-height: 790px;
        padding: 12px 8px;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        overflow: visible;
        z-index: 100;
    }

    .avatar-rail-logo {
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #806cf4;
        color: #ffffff;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 11px;
    }

    .avatar-rail-divider {
        width: 38px;
        height: 1px;
        background: #ededf2;
        margin-bottom: 12px;
    }

    .avatar-list {
        width: 100%;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .avatar-person {
        width: 100%;
        position: relative;
        display: flex;
        justify-content: center;
    }

    .avatar-button {
        width: 45px;
        height: 45px;
        padding: 0;
        border: none;
        border-radius: 50%;
        background: #eeeaff;
        color: #654fda;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 0 0 1px #e0e2e9;
        transition: transform .22s cubic-bezier(.22, .8, .25, 1), box-shadow .22s ease;
    }

        .avatar-button:hover {
            transform: translateY(-2px) scale(1.035);
            box-shadow: 0 0 0 4px #efecff, 0 8px 18px rgba(97, 76, 210, .13);
        }

        .avatar-button.active {
            outline: 2px solid #806cf4;
            outline-offset: 2px;
            box-shadow: 0 0 0 4px #efecff;
        }

        .avatar-button img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }


    /* ============================================================
           SMOOTH HOVER PROFILE POPUP
           ============================================================ */

    .avatar-profile-popup {
        position: absolute;
        left: calc(100% + 14px);
        top: 50%;
        width: 300px;
        padding: 16px;
        background: #ffffff;
        border: 1px solid #e3e5ec;
        border-radius: 16px;
        box-shadow: 0 22px 55px rgba(15, 23, 42, .14), 0 5px 15px rgba(15, 23, 42, .04);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(-50%) translateX(-12px) scale(.97);
        transform-origin: left center;
        transition: opacity .24s ease, transform .24s cubic-bezier(.22, .8, .25, 1), visibility .24s ease;
        will-change: opacity, transform;
        z-index: 5000;
    }

        .avatar-profile-popup::before {
            content: "";
            position: absolute;
            width: 13px;
            height: 13px;
            left: -7px;
            top: 50%;
            background: #ffffff;
            border-left: 1px solid #e3e5ec;
            border-bottom: 1px solid #e3e5ec;
            transform: translateY(-50%) rotate(45deg);
        }

    .avatar-person:hover .avatar-profile-popup,
    .avatar-person:focus-within .avatar-profile-popup {
        opacity: 1;
        visibility: visible;
        pointer-events: auto;
        transform: translateY(-50%) translateX(0) scale(1);
    }

    .profile-popup-head {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-bottom: 14px;
    }

    .profile-popup-avatar {
        width: 46px;
        height: 46px;
        flex: 0 0 46px;
        border-radius: 50%;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eeeaff;
        color: #654fda;
        font-size: 12px;
        font-weight: 800;
    }

        .profile-popup-avatar img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .profile-popup-name {
        color: #17172d;
        font-size: 13px;
        font-weight: 800;
    }

    .profile-popup-role {
        margin-top: 3px;
        color: #9299a7;
        font-size: 10px;
    }

    .profile-popup-grid {
        padding: 12px 0;
        display: grid;
        grid-template-columns: 83px 1fr;
        gap: 8px 10px;
        border-top: 1px solid #efeff4;
        border-bottom: 1px solid #efeff4;
    }

    .profile-popup-label {
        color: #a0a6b2;
        font-size: 8px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .profile-popup-value {
        color: #4f5b6c;
        font-size: 9px;
        font-weight: 600;
        word-break: break-word;
    }

    .profile-popup-skills {
        margin-top: 11px;
        color: #697486;
        font-size: 9px;
        line-height: 1.5;
    }

        .profile-popup-skills strong {
            display: block;
            margin-bottom: 4px;
            color: #a0a6b2;
            font-size: 8px;
            text-transform: uppercase;
        }

    .profile-popup-button {
        width: 100%;
        height: 37px;
        margin-top: 12px;
        border: none;
        border-radius: 9px;
        background: #0b1f3a;
        color: white;
        font-size: 9px;
        font-weight: 750;
        cursor: pointer;
        transition: transform .15s ease, background .15s ease;
    }

        .profile-popup-button:hover {
            background: #152f52;
            transform: translateY(-1px);
        }


    /* ============================================================
           LEFT COLUMN
           ============================================================ */

    .left-column {
        min-height: 790px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }


    


    /* ============================================================
           REMINDERS
           ============================================================ */

    .reminders-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e8e8ef;
        border-radius: 17px;
        box-shadow: 0 4px 14px rgba(20, 25, 45, .035);
    }

    .reminders-header {
        min-height: 52px;
        padding: 0 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #efeff4;
    }

        .reminders-header h3 {
            margin: 0;
            color: #17172c;
            font-size: 14px;
            font-weight: 800;
        }

    .reminders-menu {
        color: #a3a8b2;
        font-size: 17px;
        letter-spacing: 2px;
    }

    .reminder-list {
        padding: 8px 17px 11px;
    }

    .reminder-item {
        padding: 10px 0;
        border-bottom: 1px solid #f2f2f6;
    }

        .reminder-item:last-child {
            border-bottom: none;
        }

    .reminder-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 9px;
    }

    .reminder-copy {
        min-width: 0;
    }

    .reminder-title {
        overflow: hidden;
        color: #29293a;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .reminder-time {
        margin-top: 3px;
        color: #9198a6;
        font-size: 8px;
    }

    .reminder-type {
        min-height: 21px;
        padding: 0 8px;
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 7px;
        font-weight: 750;
    }

        .reminder-type.interview {
            background: #eeeaff;
            color: #6853d8;
        }

        .reminder-type.meeting {
            background: #e2f3fc;
            color: #4684aa;
        }

        .reminder-type.training {
            background: #f5e5f2;
            color: #9e5e8a;
        }

        .reminder-type.leave {
            background: #e4f4e8;
            color: #558567;
        }

        .reminder-type.companyevent {
            background: #fff0da;
            color: #9b732e;
        }

        .reminder-type.personal {
            background: #ffe7e9;
            color: #a9585f;
        }

        .reminder-type.other {
            background: #eef0f3;
            color: #697586;
        }

    .empty-reminder {
        padding: 14px 0;
        color: #9da4b0;
        font-size: 9px;
    }


    /* ============================================================
           EVENT TYPE CARD
           ============================================================ */

    .event-type-card {
        overflow: hidden;
        background: #ffffff;
        border: 1px solid #e8e8ef;
        border-radius: 17px;
        box-shadow: 0 4px 14px rgba(20, 25, 45, .035);
    }

    .event-type-header {
        min-height: 52px;
        padding: 0 17px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border-bottom: 1px solid #efeff4;
    }

        .event-type-header h3 {
            margin: 0;
            color: #17172c;
            font-size: 14px;
            font-weight: 800;
        }

    .event-type-chevron {
        color: #969eaa;
        font-size: 13px;
    }

    .event-type-list {
        padding: 13px 17px 16px;
        display: flex;
        flex-direction: column;
        gap: 9px;
    }

    .event-filter-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        cursor: pointer;
    }

    .event-pill {
        min-height: 22px;
        padding: 0 8px;
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        font-size: 8px;
        font-weight: 750;
    }

        .event-pill::before {
            content: "";
            width: 6px;
            height: 6px;
            margin-right: 5px;
            border-radius: 50%;
        }

        .event-pill.all {
            background: #f1f2f5;
            color: #697487;
        }

            .event-pill.all::before {
                background: #9ba4b2;
            }

        .event-pill.interview {
            background: #eeeaff;
            color: #6956da;
        }

            .event-pill.interview::before {
                background: #806cf4;
            }

        .event-pill.meeting {
            background: #e4f3fc;
            color: #4784aa;
        }

            .event-pill.meeting::before {
                background: #58a8dc;
            }

        .event-pill.training {
            background: #f6e7f2;
            color: #9f6089;
        }

            .event-pill.training::before {
                background: #d58fbd;
            }

        .event-pill.leave {
            background: #e5f4e9;
            color: #548665;
        }

            .event-pill.leave::before {
                background: #6eb780;
            }

        .event-pill.companyevent {
            background: #fff1dc;
            color: #99702d;
        }

            .event-pill.companyevent::before {
                background: #e6ad4d;
            }

        .event-pill.personal {
            background: #ffe7e9;
            color: #aa575f;
        }

            .event-pill.personal::before {
                background: #df787f;
            }

        .event-pill.other {
            background: #eef0f3;
            color: #6a7585;
        }

            .event-pill.other::before {
                background: #9aa4b1;
            }


    /* ============================================================
           SWITCHES
           ============================================================ */

    .pretty-switch {
        width: 34px;
        height: 19px;
        position: relative;
        flex: 0 0 34px;
    }

        .pretty-switch input {
            position: absolute;
            width: 0;
            height: 0;
            opacity: 0;
        }

    .pretty-slider {
        position: absolute;
        inset: 0;
        border-radius: 999px;
        background: #c7cbd4;
        transition: background .18s ease;
    }

        .pretty-slider::before {
            content: "";
            position: absolute;
            width: 15px;
            height: 15px;
            left: 2px;
            top: 2px;
            border-radius: 50%;
            background: #ffffff;
            box-shadow: 0 1px 4px rgba(0,0,0,.15);
            transition: transform .18s ease;
        }

    .pretty-switch input:checked + .pretty-slider {
        background: #2d7cf0;
    }

        .pretty-switch input:checked + .pretty-slider::before {
            transform: translateX(15px);
        }


    /* ============================================================
           MAIN CALENDAR
           ============================================================ */

    .main-calendar {
        min-width: 0;
        min-height: 790px;
        overflow: hidden;
    }

    .main-calendar-header {
        min-height: 79px;
        padding: 16px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 18px;
        border-bottom: 1px solid #f0f0f4;
    }

    .calendar-navigation {
        display: flex;
        align-items: center;
        gap: 7px;
    }

    .calendar-title {
        margin: 0 4px;
        color: #17172b;
        font-size: 20px;
        font-weight: 800;
        white-space: nowrap;
    }

    .calendar-arrow {
        width: 31px;
        height: 31px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #979eaa;
        font-size: 19px;
        cursor: pointer;
    }

        .calendar-arrow:hover {
            background: #f4f4f8;
            color: #4f5060;
        }

    .today-button {
        height: 29px;
        padding: 0 11px;
        border: none;
        border-radius: 8px;
        background: #161628;
        color: #ffffff;
        font-size: 8px;
        font-weight: 750;
        cursor: pointer;
    }

    .view-switch {
        padding: 4px;
        display: flex;
        gap: 3px;
        background: #f2f2f6;
        border-radius: 11px;
    }

    .view-button {
        min-width: 76px;
        height: 31px;
        padding: 0 13px;
        border: none;
        border-radius: 8px;
        background: transparent;
        color: #9297a4;
        font-size: 9px;
        font-weight: 700;
        cursor: pointer;
    }

        .view-button.active {
            background: #ffffff;
            color: #1f1f30;
            box-shadow: 0 2px 7px rgba(15,23,42,.08);
        }

    .calendar-container {
        position: relative;
        padding: 14px 18px 22px;
        background: linear-gradient( 180deg, #fbfbfe 0, #ffffff 130px );
    }


    /* ============================================================
           FULLCALENDAR BASE
           ============================================================ */

    #mainCalendar .fc-toolbar {
        display: none;
    }

    #mainCalendar .fc-scrollgrid {
        border: none !important;
    }

    #mainCalendar .fc-theme-standard td,
    #mainCalendar .fc-theme-standard th {
        border-color: #efeff4;
    }


    /* ============================================================
           WEEK VIEW HEADER CARDS
           ============================================================ */

    #mainCalendar
    .fc-timeGridWeek-view
    .fc-col-header-cell {
        padding: 5px;
        border: none !important;
        background: transparent;
    }

    #mainCalendar
    .fc-timeGridWeek-view
    .fc-col-header-cell-cushion {
        width: calc(100% - 8px);
        min-height: 81px;
        margin: 0 auto;
        padding: 12px 7px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        background: #f8f8fb;
        border-radius: 15px;
        text-decoration: none;
        transition: transform .16s ease, background .16s ease;
    }

        #mainCalendar
        .fc-timeGridWeek-view
        .fc-col-header-cell-cushion:hover {
            transform: translateY(-2px);
            background: #f3f2f8;
        }

    #mainCalendar
    .fc-timeGridWeek-view
    .fc-day-today
    .fc-col-header-cell-cushion {
        background: linear-gradient( 135deg, #dff6f4, #edf8ff );
    }

    .week-day-name {
        color: #959ba7;
        font-size: 8px;
        font-weight: 650;
    }

    .week-day-number {
        color: #1f202c;
        font-size: 26px;
        font-weight: 800;
        line-height: 1;
    }

    #mainCalendar
    .fc-day-today
    .week-day-number {
        color: #163b50;
    }


    /* ============================================================
           WEEK GRID
           ============================================================ */

    #mainCalendar .fc-timegrid-axis {
        width: 62px !important;
    }

    #mainCalendar .fc-timegrid-slot {
        height: 43px;
        border-top: 1px solid #f1f0f5;
    }

    #mainCalendar .fc-timegrid-slot-label {
        border: none;
    }

    #mainCalendar
    .fc-timegrid-slot-label-cushion {
        padding-right: 10px;
        color: #9297a3;
        font-size: 8px;
    }

    #mainCalendar
    .fc-timegrid-col {
        background: #ffffff;
    }

        #mainCalendar
        .fc-timegrid-col.fc-day-today {
            background: rgba(223,246,244,.17) !important;
        }

    #mainCalendar
    .fc-timegrid-now-indicator-line {
        border-color: #4c89f7;
        border-width: 2px;
    }


    /* ============================================================
           MONTHLY PRETTY CARDS
           ============================================================ */

    #mainCalendar .fc-dayGridMonth-view {
        padding: 9px;
        background: #f8f8fc;
        border-radius: 17px;
    }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-scrollgrid-section > td {
            border: none !important;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-col-header-cell {
            padding: 0 5px 8px;
            border: none !important;
            background: transparent;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-col-header-cell-cushion {
            padding: 8px 0;
            color: #b0b2bc;
            font-size: 8px;
            font-weight: 750;
            text-transform: uppercase;
            text-decoration: none;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-daygrid-day {
            padding: 5px;
            border: none !important;
            background: transparent !important;
            overflow: hidden;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-daygrid-day-frame {
            min-height: 120px;
            padding: 8px;
            overflow: hidden;
            border-radius: 15px;
            background: #ffffff;
            box-shadow: 0 2px 8px rgba(20,25,45,.025);
            transition: transform .15s ease, box-shadow .15s ease;
        }

            #mainCalendar
            .fc-dayGridMonth-view
            .fc-daygrid-day-frame:hover {
                transform: translateY(-2px);
                box-shadow: 0 7px 16px rgba(20,25,45,.055);
            }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-daygrid-day-top {
            flex-direction: row;
            justify-content: flex-end;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-daygrid-day-number {
            width: 28px;
            height: 28px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            color: #484956;
            font-size: 10px;
            font-weight: 750;
            text-decoration: none;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-day-other
        .fc-daygrid-day-number {
            color: #c7c9d0;
        }

        #mainCalendar
        .fc-dayGridMonth-view
        .fc-day-today {
            background: transparent !important;
        }

            #mainCalendar
            .fc-dayGridMonth-view
            .fc-day-today
            .fc-daygrid-day-number {
                background: #4f68e8;
                color: #ffffff;
                box-shadow: 0 3px 8px rgba(79,104,232,.22);
            }


    /* ============================================================
           CUTE EVENT CARDS
           ONLY TITLE + TIME
           ============================================================ */

    #mainCalendar .fc-event {
        padding: 0 !important;
        border: none !important;
        border-radius: 12px !important;
        overflow: hidden;
        cursor: pointer;
        box-shadow: 0 3px 10px rgba(32,32,50,.035);
    }

    #mainCalendar .fc-event-main {
        padding: 0 !important;
    }

    .cute-event {
        width: 100%;
        height: 100%;
        padding: 7px 8px;
        overflow: hidden;
        color: inherit;
    }

    .cute-event-title {
        overflow: hidden;
        color: inherit;
        font-size: 9px;
        font-weight: 750;
        line-height: 1.2;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .cute-event-time {
        margin-top: 4px;
        display: flex;
        align-items: center;
        gap: 3px;
        overflow: hidden;
        color: inherit;
        font-size: 7px;
        font-weight: 600;
        opacity: .68;
        white-space: nowrap;
        text-overflow: ellipsis;
    }

    .cute-event-clock {
        flex: 0 0 auto;
        font-size: 8px;
    }

    #mainCalendar
    .fc-timeGridWeek-view
    .cute-event {
        padding: 8px 9px;
    }

    #mainCalendar
    .fc-timeGridWeek-view
    .cute-event-title {
        font-size: 9px;
        white-space: normal;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    #mainCalendar
    .fc-timeGridWeek-view
    .cute-event-time {
        margin-top: 5px;
        font-size: 7px;
    }

    #mainCalendar
    .fc-dayGridMonth-view
    .fc-daygrid-event {
        max-width: 100% !important;
        margin: 3px 0 0 !important;
        padding: 0 !important;
        overflow: hidden !important;
        border-radius: 7px !important;
    }

    #mainCalendar
    .fc-dayGridMonth-view
    .cute-event {
        padding: 4px 6px;
    }

    #mainCalendar
    .fc-dayGridMonth-view
    .cute-event-title {
        font-size: 7px;
        line-height: 1.1;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    #mainCalendar
    .fc-dayGridMonth-view
    .cute-event-time {
        margin-top: 2px;
        font-size: 6px;
    }


    /* ============================================================
           MODAL
           ============================================================ */

    .event-modal-overlay {
        position: fixed;
        inset: 0;
        padding: 20px;
        display: none;
        align-items: center;
