<div class="calendar-page">


    @if (!interviewers.Any())
    {
        <div class="calendar-surface"
             style="padding:60px;text-align:center;color:#8e97a7;">

            No interviewer accounts found.

        </div>
    }
    else
    {

        <div class="calendar-shell">


            <!-- =================================================
                 INTERVIEWER AVATAR RAIL
                 ================================================= -->

            <aside class="calendar-surface avatar-rail">


                <div class="avatar-rail-logo"
                     title="Interviewer Calendars">

                    ◷

                </div>


                <div class="avatar-rail-divider"></div>


                <div class="avatar-list">


                    @foreach (var employee in interviewers)
                    {

                        var displayName =
                        employee.FullName
                        ?? employee.Email
                        ?? "Unknown";


                        var initial =
                        !string.IsNullOrWhiteSpace(displayName)
                        ? displayName.Substring(0, 1).ToUpper()
                        : "?";


                        <div class="avatar-person">


                            <button type="button"
                                    class="avatar-button"
                                    data-interviewer-id="@employee.Id"
                                    data-name="@displayName"
                                    data-email="@(employee.Email ?? "")"
                                    data-job-title="@(employee.JobTitle ?? "Interviewer")"
                                    data-department="@(employee.Department ?? "-")"
                                    data-seniority="@(employee.SeniorityLevel ?? "-")"
                                    data-experience="@employee.YearsOfExperience"
                                    data-skills="@(employee.Skills ?? "")"
                                    data-image="@(employee.ProfileImagePath ?? "")"
                                    data-initial="@initial">

                                @if (!string.IsNullOrWhiteSpace(
                                                        employee.ProfileImagePath))
                                {
                                    <img src="@employee.ProfileImagePath"
                                         alt="@displayName" />
                                }
                                else
                                {
                                    @initial
                                }

                            </button>


                            <!-- HOVER -->

                            <div class="avatar-profile-popup">


                                <div class="profile-popup-head">


                                    <div class="profile-popup-avatar">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                        employee.ProfileImagePath))
                                        {
                                            <img src="@employee.ProfileImagePath"
                                                 alt="@displayName" />
                                        }
                                        else
                                        {
                                            @initial
                                        }

                                </div>


                                <div>

                                    <div class="profile-popup-name">
                                        @displayName
                                    </div>

                                    <div class="profile-popup-role">
                                        @(employee.JobTitle ?? "Interviewer")
                                    </div>

                                </div>


                            </div>


                            <div class="profile-popup-grid">


                                <div class="profile-popup-label">
                                    Department
                                </div>

                                <div class="profile-popup-value">
                                    @(employee.Department ?? "-")
                                </div>


                                <div class="profile-popup-label">
                                    Seniority
                                </div>

                                <div class="profile-popup-value">
                                    @(employee.SeniorityLevel ?? "-")
                                </div>


                                <div class="profile-popup-label">
                                    Experience
                                </div>

                                <div class="profile-popup-value">
                                    @employee.YearsOfExperience year(s)
                                </div>


                                <div class="profile-popup-label">
                                    Email
                                </div>

                                <div class="profile-popup-value">
                                    @(employee.Email ?? "-")
                                </div>


                            </div>


                            <div class="profile-popup-skills">

                                <strong>
                                    Skills
                                </strong>

                                @(string.IsNullOrWhiteSpace(employee.Skills)
                                                            ? "No skills added"
                                                            : employee.Skills)

                        </div>


                               


                            </div>


                        </div>
                                }


                </div>


            </aside>


            <!-- =================================================
                 LEFT COLUMN
                 ================================================= -->

            <aside class="left-column">



                <!-- REMINDERS -->

                <div class="reminders-card">


                    <div class="reminders-header">

                        <h3>
                            Reminders
                        </h3>

                        <span class="reminders-menu">
                            •••
                        </span>

                    </div>


                    <div class="reminder-list"
                         id="reminderList">

                        <div class="empty-reminder">

                            Loading upcoming schedule...

                        </div>

                    </div>


                </div>


                <!-- EVENT TYPE -->

                <div class="event-type-card">


                    <div class="event-type-header">

                        <h3>
                            Event Type
                        </h3>

                        <span class="event-type-chevron">
                            ⌃
                        </span>

                    </div>


                    <div class="event-type-list">


                        <label class="event-filter-row">

                            <span class="event-pill all">
                                All Events
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       id="allEventsToggle"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        


                        <label class="event-filter-row">

                            <span class="event-pill meeting">
                                Meeting
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="Meeting"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        <label class="event-filter-row">

                            <span class="event-pill training">
                                Training
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="Training"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        <label class="event-filter-row">

                            <span class="event-pill leave">
                                Leave
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="Leave"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        <label class="event-filter-row">

                            <span class="event-pill companyevent">
                                Company Event
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="CompanyEvent"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        <label class="event-filter-row">

                            <span class="event-pill personal">
                                Personal
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="Personal"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                        <label class="event-filter-row">

                            <span class="event-pill other">
                                Other
                            </span>

                            <span class="pretty-switch">

                                <input type="checkbox"
                                       class="event-type-toggle"
                                       value="Other"
                                       checked />

                                <span class="pretty-slider"></span>

                            </span>

                        </label>


                    </div>


                </div>


            </aside>


            <!-- =================================================
                 MAIN CALENDAR
                 ================================================= -->

            <main class="calendar-surface main-calendar">


                <div class="main-calendar-header">


                    <div class="calendar-navigation">


                        <button type="button"
                                class="calendar-arrow"
                                id="prevBtn">

                            ‹

                        </button>


                        <div class="calendar-title"
                             id="calendarTitle">

                            Calendar

                        </div>


                        <button type="button"
                                class="calendar-arrow"
                                id="nextBtn">

                            ›

                        </button>


                        <button type="button"
                                class="today-button"
                                id="todayBtn">

                            Today

                        </button>


                    </div>


                    <div class="view-switch">


                        <button type="button"
                                class="view-button active"
                                data-view="timeGridWeek">

                            Weekly

                        </button>


                        <button type="button"
                                class="view-button"
                                data-view="dayGridMonth">

                            Monthly

                        </button>


                    </div>


                </div>


                <div class="calendar-container">

                    <div id="mainCalendar"></div>

                </div>


            </main>


        </div>
    }


</div>


