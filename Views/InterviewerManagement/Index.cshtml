        /* =========================================================
           SELECT INTERVIEWER
           ========================================================= */

        function selectInterviewer(
            interviewerId) {


            const button =
                findAvatar(
                    interviewerId
                );


            if (!button) {

                return;
            }


            selectedInterviewerId =
                interviewerId;


            avatarButtons.forEach(
                avatar => {

                    avatar.classList.toggle(
                        "active",
                        avatar === button
                    );

                }
            );


            try {

                localStorage.setItem(
                    STORAGE_KEY,
                    interviewerId
                );

            }
            catch {

            }


            closeEventModal();


            if (mainCalendar) {

                mainCalendar.refetchEvents();
            }


            loadUpcomingEvents();
        }


        /* =========================================================
           UPCOMING / REMINDERS
           ========================================================= */

        async function loadUpcomingEvents() {


            const container =
                element(
                    "reminderList"
                );


            if (
                !container ||
                !selectedInterviewerId
            ) {

                return;
            }


            container.innerHTML =
                '<div class="empty-reminder">Loading schedule...</div>';


            const start =
                new Date();


            const end =
                new Date();


            end.setDate(
                end.getDate() + 14
            );


            const url =
                `/InterviewerManagement/GetEvents` +
                `?interviewerId=${encodeURIComponent(selectedInterviewerId)}` +
                `&start=${encodeURIComponent(start.toISOString())}` +
                `&end=${encodeURIComponent(end.toISOString())}`;


            try {


                const response =
                    await fetch(
                        url
                    );


                if (!response.ok) {

                    throw new Error();
                }


                const events =
                    await response.json();


                const upcoming =
                    events
                        .filter(
                            event =>
                                new Date(
                                    event.end
                                ) >=
                                new Date()
                        )

                        .sort(
                            (a, b) =>
                                new Date(a.start) -
                                new Date(b.start)
                        )

                        .slice(
                            0,
                            5
                        );


                container.innerHTML =
                    "";


                if (
                    upcoming.length === 0
                ) {

                    container.innerHTML =
                        '<div class="empty-reminder">No upcoming events.</div>';

                    return;
                }


                upcoming.forEach(
                    event => {


                        const item =
                            document.createElement(
                                "div"
                            );


                        item.className =
                            "reminder-item";


                        const row =
                            document.createElement(
                                "div"
                            );


                        row.className =
                            "reminder-row";


                        const copy =
                            document.createElement(
                                "div"
                            );


                        copy.className =
                            "reminder-copy";


                        const title =
                            document.createElement(
                                "div"
                            );


                        title.className =
                            "reminder-title";


                        title.textContent =
                            event.title ||
                            "Calendar Event";


                        const time =
                            document.createElement(
                                "div"
                            );


                        time.className =
                            "reminder-time";


                        time.textContent =
                            formatDateTime(
                                event.start
                            );


                        copy.appendChild(
                            title
                        );


                        copy.appendChild(
                            time
                        );


                        const type =
                            String(
                                event.scheduleType ||
                                "Other"
                            );


                        const badge =
                            document.createElement(
                                "span"
                            );


                        badge.className =
                            `reminder-type ${type.toLowerCase()}`;


                        badge.textContent =
                            type;


                        row.appendChild(
                            copy
                        );


                        row.appendChild(
                            badge
                        );


                        item.appendChild(
                            row
                        );


                        container.appendChild(
                            item
                        );

                    }
                );

            }
            catch {


                container.innerHTML =
                    '<div class="empty-reminder">Could not load schedule.</div>';

            }
        }


        /* =========================================================
           MAIN CALENDAR
           ========================================================= */

        function initialiseMainCalendar() {


            mainCalendar =
                new FullCalendar.Calendar(
                    element(
                        "mainCalendar"
                    ),
                    {


                        initialView:
                            "timeGridWeek",


                        firstDay:
                            1,


                        headerToolbar:
                            false,


                        nowIndicator:
                            true,


                        selectable:
                            true,


                        selectMirror:
                            true,


                        allDaySlot:
                            false,


                        slotMinTime:
                            "08:00:00",


                        slotMaxTime:
                            "18:00:00",


                        slotDuration:
                            "00:30:00",


                        height:
                            "auto",


                        fixedWeekCount:
                            false,


                        dayMaxEvents:
                            3,


                        /* =========================================
                           TITLE + SMALL TIME ONLY
                           ========================================= */

                        eventContent:
                            function (arg) {


                                const calendarEvent =
                                    arg.event;


                                const title =
                                    calendarEvent.title ||
                                    "Event";


                                const formatTime =
                                    date => {


                                        if (!date) {

                                            return "";
                                        }


                                        return new Intl.DateTimeFormat(
                                            undefined,
                                            {
                                                hour:
                                                    "numeric",

                                                minute:
                                                    "2-digit"
                                            }
                                        )
                                        .format(
                                            date
                                        );
                                    };


                                const startTime =
                                    formatTime(
                                        calendarEvent.start
                                    );


                                const endTime =
                                    formatTime(
                                        calendarEvent.end
                                    );


                                const timeText =
                                    endTime
                                        ? `${startTime} – ${endTime}`
                                        : startTime;


                                return {

                                    html:
                                        `
                                        <div class="cute-event">

                                            <div class="cute-event-title">

                                                ${escapeCalendarText(title)}

                                            </div>

                                            <div class="cute-event-time">

                                                <span class="cute-event-clock">
                                                    ◷
                                                </span>

                                                ${escapeCalendarText(timeText)}

                                            </div>

                                        </div>
                                        `
                                };
                            },


                        /* =========================================
                           WEEK HEADER
                           ========================================= */

                        dayHeaderContent:
                            function (info) {


                                if (
                                    mainCalendar &&
                                    mainCalendar.view.type ===
                                    "timeGridWeek"
                                ) {


                                    const day =
                                        new Intl.DateTimeFormat(
                                            undefined,
                                            {
                                                weekday:
                                                    "long"
                                            }
                                        )
                                        .format(
                                            info.date
                                        );


                                    const number =
                                        info.date.getDate();


                                    return {

                                        html:
                                            `<span class="week-day-name">${day}</span>` +
                                            `<span class="week-day-number">${number}</span>`

                                    };
                                }


                                return {

                                    html:
                                        new Intl.DateTimeFormat(
                                            undefined,
                                            {
                                                weekday:
                                                    "short"
                                            }
                                        )
                                        .format(
                                            info.date
                                        )
                                };
                            },


                        /* =========================================
                           LOAD EVENTS
                           ========================================= */

                        events:
                            function (
                                info,
                                successCallback,
                                failureCallback) {


                                if (
                                    !selectedInterviewerId
                                ) {

                                    successCallback([]);

                                    return;
                                }


                                const url =
                                    `/InterviewerManagement/GetEvents` +
                                    `?interviewerId=${encodeURIComponent(selectedInterviewerId)}` +
                                    `&start=${encodeURIComponent(info.startStr)}` +
                                    `&end=${encodeURIComponent(info.endStr)}`;


                                fetch(
                                    url
                                )

                                .then(
                                    response => {


                                        if (!response.ok) {

                                            throw new Error(
                                                "Could not load calendar."
                                            );
                                        }


                                        return response.json();

                                    }
                                )

                                .then(
                                    events => {


                                        const enabledTypes =
                                            selectedEventTypes();


                                        const visibleEvents =
                                            events.filter(
                                                event =>
                                                    enabledTypes.includes(
                                                        event.scheduleType
                                                    )
                                            );


                                        const formatted =
                                            visibleEvents.map(
                                                event => {


                                                    const colours =
                                                        eventColors(
                                                            event.scheduleType
                                                        );


                                                    const originalStart =
                                                        event.start
                                                            ? new Date(event.start)
                                                            : null;


                                                    const originalEnd =
                                                        event.end
                                                            ? new Date(event.end)
                                                            : null;


                                                    let displayEnd =
                                                        originalEnd;


                                                    /*
                                                       Prevent event stretching
                                                       across different month cells.
                                                    */

                                                    if (
                                                        originalStart &&
                                                        originalEnd &&
                                                        !event.allDay &&
                                                        originalStart.toDateString() !==
                                                            originalEnd.toDateString()
                                                    ) {


                                                        displayEnd =
                                                            new Date(
                                                                originalStart
                                                            );


                                                        displayEnd.setHours(
                                                            23,
                                                            59,
                                                            59,
                                                            999
                                                        );
                                                    }


                                                    return {

                                                        ...event,


                                                        end:
                                                            displayEnd
                                                                ? displayEnd.toISOString()
                                                                : event.end,


                                                        backgroundColor:
                                                            colours.background,


                                                        borderColor:
                                                            colours.background,


                                                        textColor:
                                                            colours.text,


                                                        extendedProps: {

                                                            ...event,


                                                            originalEnd:
                                                                event.end

                                                        }

                                                    };
                                                }
                                            );


                                        successCallback(
                                            formatted
                                        );

                                    }
                                )

                                .catch(
                                    failureCallback
                                );

                            },


                        /* =========================================
                           BLANK SPACE = CREATE
                           ========================================= */

                        select:
                            function (info) {


                                openCreateEvent(
                                    info.start,
                                    info.end
                                );

                            },


                        /* =========================================
                           CLICK EVENT = VIEW / EDIT
                           ========================================= */

                        eventClick:
                            function (info) {


                                openExistingEvent(
                                    info.event
                                );

                            },


                        datesSet:
                            function () {


                                updateMainCalendarTitle();


                                if (
                                    miniCalendar
                                ) {


                                    miniCalendar.gotoDate(
                                        mainCalendar.getDate()
                                    );

                                }

                            }

                    }
                );


            mainCalendar.render();
        }


       


