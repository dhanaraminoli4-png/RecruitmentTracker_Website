
@{
    ViewData["Title"] = "System Administration";
}

<div class="container mt-4">

    <div class="mb-4">
        <h2>System Administration</h2>

        <p class="text-muted">
            Manage users, roles and system administration.
        </p>
    </div>


    <div class="row g-4">

        <!-- ROLE MANAGEMENT -->

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        Role Management
                    </h5>

                    <p class="card-text text-muted">
                        Manage user roles and access
                        permissions.
                    </p>

                    <a asp-controller="SystemAdmin"
                       asp-action="Roles"
                       class="btn btn-primary">

                        Manage Roles

                    </a>

                </div>

            </div>

        </div>


        <!-- USER MANAGEMENT -->

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        User Management
                    </h5>

                    <p class="card-text text-muted">
                        View and manage registered users.
                    </p>

                    <button class="btn btn-secondary"
                            disabled>

                        Coming Soon

                    </button>

                </div>

            </div>

        </div>


        <!-- SYSTEM OVERVIEW -->

        <div class="col-md-4">

            <div class="card h-100 shadow-sm">

                <div class="card-body">

                    <h5 class="card-title">
                        System Overview
                    </h5>

                    <p class="card-text text-muted">
                        View system information and
                        recruitment statistics.
                    </p>

                    <button class="btn btn-secondary"
                            disabled>

                        Coming Soon

                    </button>

                </div>

            </div>

        </div>

    </div>


    <div class="card mt-5">

        <div class="card-header bg-dark text-white">

            <h5 class="mb-0">
                System Administrator Responsibilities
            </h5>

        </div>

        <div class="card-body">

            <ul class="mb-0">

                <li>
                    Manage system users
                </li>

                <li>
                    Assign user roles
                </li>

                <li>
                    Manage access permissions
                </li>

                <li>
                    Maintain system-level configuration
                </li>

            </ul>

        </div>

    </div>

</div>
