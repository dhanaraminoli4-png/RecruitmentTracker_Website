    }

    .helper-text {
        color: #8fa2b3 !important;
        font-size: 11px !important;
        line-height: 1.45 !important;
    }

    /* ACTIONS */
    .edit-actions {
        margin-top: 28px !important;
        padding-top: 22px !important;
        border-top: 1px solid var(--ep-line-soft) !important;
        gap: 10px !important;
    }

    .cancel-btn,
    .save-btn {
        min-height: 44px !important;
        padding: 0 18px !important;
        border-radius: 10px !important;
        font-size: 12px !important;
        font-weight: 850 !important;
        transition: .18s ease !important;
    }

    .cancel-btn {
        border: 1px solid var(--ep-line) !important;
        background: rgba(255,255,255,.72) !important;
        color: #637d93 !important;
    }

        .cancel-btn:hover {
            color: var(--ep-blue-hover) !important;
            border-color: #bddcf1 !important;
            background: rgba(255,255,255,.92) !important;
        }

    .save-btn {
        border: 1px solid var(--ep-blue) !important;
        background: var(--ep-blue) !important;
        color: #fff !important;
        box-shadow: 0 8px 18px rgba(63,155,243,.20) !important;
    }

        .save-btn:hover {
            background: var(--ep-blue-hover) !important;
            border-color: var(--ep-blue-hover) !important;
            transform: translateY(-1px);
            box-shadow: 0 11px 24px rgba(47,141,232,.24) !important;
        }

    @@media(max-width:760px) {
        .edit-profile-page {
            padding: 20px 14px 45px !important;
        }

        .edit-profile-header {
            align-items: flex-start !important;
            flex-direction: column !important;
        }

            .edit-profile-header h1 {
                font-size: 28px !important;
            }

        .edit-card {
            padding: 20px 16px !important;
        }

        .edit-grid {
            grid-template-columns: 1fr !important;
        }

        .form-group.full {
            grid-column: auto !important;
        }

        .profile-photo-section {
            align-items: flex-start !important;
            flex-direction: column !important;
        }

        .edit-actions {
            flex-direction: column-reverse !important;
        }

        .cancel-btn,
        .save-btn {
            width: 100% !important;
        }
    }
</style>
