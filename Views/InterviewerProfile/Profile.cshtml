@model RecruitmentTracker.Models.ApplicationUser

@{
    ViewData["Title"] = "My Profile";

    string displayName =
        Model.FullName
        ?? Model.Email
        ?? "Interviewer";

    string initial =
        !string.IsNullOrWhiteSpace(displayName)
        ? displayName.Substring(0, 1).ToUpper()
        : "?";

    int? age = null;

    if (Model.DateOfBirth.HasValue)
    {
        var today = DateTime.Today;

        age =
            today.Year -
            Model.DateOfBirth.Value.Year;

        if (Model.DateOfBirth.Value.Date >
            today.AddYears(-age.Value))
        {
            age--;
        }
    }
}

<style>

    .profile-page {
        min-height: calc(100vh - 70px);
        background: #f6f8fb;
        padding: 28px 38px 60px;
    }

    .profile-wrapper {
        max-width: 1400px;
        margin: 0 auto;
    }


    /* =========================================================
               HEADER
               ========================================================= */

    .profile-page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 20px;
    }

        .profile-page-header h1 {
            margin: 0;
            color: #0b1f3a;
            font-size: 28px;
            font-weight: 700;
        }

        .profile-page-header p {
            margin: 5px 0 0;
            color: #8491a2;
            font-size: 11px;
        }

    .back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        height: 39px;
        padding: 0 15px;
        border: 1px solid #d9e0e8;
        border-radius: 9px;
        background: white;
        color: #536174;
        text-decoration: none;
        font-size: 11px;
        font-weight: 700;
    }


    /* =========================================================
               MAIN
               ========================================================= */

    .profile-layout {
        display: grid;
        grid-template-columns: 310px minmax(0, 1fr);
        gap: 20px;
        align-items: start;
    }


    /* =========================================================
               LEFT PROFILE CARD
               ========================================================= */

    .profile-summary {
        background: white;
        border: 1px solid #e2e8ef;
        border-radius: 16px;
        padding: 28px 22px;
    }

    .profile-image {
        width: 145px;
        height: 145px;
        margin: 0 auto 18px;
        border-radius: 50%;
        overflow: hidden;
        background: #ebe8ff;
        border: 4px solid #f3f1ff;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #6251b9;
        font-size: 40px;
        font-weight: 800;
    }

        .profile-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .profile-summary-name {
        text-align: center;
        color: #122136;
        font-size: 20px;
        font-weight: 700;
    }

    .profile-summary-position {
        text-align: center;
        color: #68778a;
        font-size: 11px;
        margin-top: 5px;
    }

    .profile-status {
        width: fit-content;
        margin: 13px auto 22px;
        padding: 5px 10px;
        border-radius: 20px;
        background: #e8f8ef;
        color: #27815a;
        font-size: 9px;
        font-weight: 700;
    }

    .summary-info {
        border-top: 1px solid #edf0f4;
        padding-top: 10px;
    }

    .summary-row {
        display: flex;
        gap: 10px;
        align-items: flex-start;
        padding: 10px 0;
        color: #536174;
        font-size: 10px;
    }

    .summary-icon {
        width: 19px;
        color: #8491a2;
        flex-shrink: 0;
    }


    /* =========================================================
               RIGHT CONTENT
               ========================================================= */

    .profile-content {
        min-width: 0;
    }

    .profile-tabs {
        background: #eef1f4;
        border-radius: 13px;
        padding: 5px;
        display: flex;
        gap: 5px;
        margin-bottom: 17px;
    }

    .profile-tab {
        flex: 1;
        border: none;
        border-radius: 9px;
        padding: 11px 15px;
        background: transparent;
        color: #69778a;
        font-size: 11px;
        font-weight: 600;
        cursor: pointer;
    }

        .profile-tab.active {
            background: white;
            color: #17243a;
            box-shadow: 0 2px 8px rgba(30,45,65,.06);
        }


    /* =========================================================
               INFO CARD
               ========================================================= */

    .profile-card {
        display: none;
        background: white;
        border: 1px solid #e2e8ef;
        border-radius: 16px;
        padding: 26px 28px;
    }

        .profile-card.active {
            display: block;
        }

        .profile-card h2 {
            margin: 0 0 22px;
            color: #122136;
            font-size: 18px;
            font-weight: 700;
        }

    .detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 26px 40px;
    }

    .detail-label {
        color: #718095;
        font-size: 10px;
        margin-bottom: 5px;
    }

    .detail-value {
        color: #17243a;
        font-size: 12px;
        font-weight: 600;
        word-break: break-word;
    }

    .skill-list {
        display: flex;
        flex-wrap: wrap;
        gap: 7px;
    }

    .skill-chip {
        background: #f0edff;
        color: #6251b9;
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 9px;
        font-weight: 700;
    }

    .edit-profile-btn {
        margin-top: 24px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 9px 15px;
        border-radius: 8px;
        background: #0b1f3a;
        color: white;
        text-decoration: none;
        font-size: 10px;
        font-weight: 700;
    }


    @@media(max-width: 900px) {

        .profile-layout {
            grid-template-columns: 1fr;
        }

        .profile-summary {
            max-width: none;
        }
    }

    @@media(max-width: 650px) {

        .profile-page {
            padding: 20px 14px 45px;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }

        .profile-tabs {
            flex-direction: column;
        }
    }

</style>


<div class="profile-page">

    <div class="profile-wrapper">


        <!-- HEADER -->

        <div class="profile-page-header">

            <div>

                <h1>
                    @displayName
                </h1>

                <p>
                    View your interviewer profile and eligibility information.
                </p>

            </div>


            <a asp-controller="Dashboard"
               asp-action="Interviewer"
               class="back-button">

                ← Back

            </a>

        </div>


        <div class="profile-layout">


            <!-- =================================================
                 LEFT PROFILE
                 ================================================= -->

            <div class="profile-summary">


                <div class="profile-image">

                    @if (!string.IsNullOrWhiteSpace(
                                        Model.ProfileImagePath))
                    {
                        <img src="@Model.ProfileImagePath"
                             alt="@displayName" />
                    }
                    else
                    {
                        @initial
                    }

                </div>


                <div class="profile-summary-name">
                    @displayName
                </div>


                <div class="profile-summary-position">

                    @(Model.JobTitle ?? "Interviewer")

                </div>


                <div class="profile-status">
                    Active
                </div>


                <div class="summary-info">


                    <div class="summary-row">

                        <span class="summary-icon">
                            ✉
                        </span>

                        <span>
                            @(Model.Email ?? "-")
                        </span>

                    </div>


                    <div class="summary-row">

                        <span class="summary-icon">
                            ☎
                        </span>

                        <span>
                            @(Model.PhoneNumber ?? "-")
                        </span>

                    </div>


                    <div class="summary-row">

                        <span class="summary-icon">
                            ◫
                        </span>

                        <span>

                            @(Model.DateOfBirth.HasValue
                                                        ? Model.DateOfBirth.Value
                                                        .ToString("yyyy-MM-dd")
                                                        : "-")

                        </span>

                    </div>


                    <div class="summary-row">

                        <span class="summary-icon">
                            ▦
                        </span>

                        <span>
                            @(Model.Department ?? "-")
                        </span>

                    </div>


                    <div class="summary-row">

                        <span class="summary-icon">
                            ◇
                        </span>

                        <span>
                            @(Model.SeniorityLevel ?? "-")
                        </span>

                    </div>


                    <div class="summary-row">

                        <span class="summary-icon">
                            ▣
                        </span>

                        <span>
                            @Model.YearsOfExperience year(s) experience
                        </span>

                    </div>

                </div>

            </div>



            <!-- =================================================
                 RIGHT SIDE
                 ================================================= -->

            <div class="profile-content">


                <div class="profile-tabs">


                    <button type="button"
                            class="profile-tab active"
                            onclick="showProfileTab(
                                'basic',
                                this)">

                        Basic Info

                    </button>


                    <button type="button"
                            class="profile-tab"
                            onclick="showProfileTab(
                                'professional',
                                this)">

                        Professional / Eligibility

                    </button>


                </div>



                <!-- =============================================
                     BASIC
                     ============================================= -->

                <div id="basic"
                     class="profile-card active">


                    <h2>
                        Basic Information
                    </h2>


                    <div class="detail-grid">


                        <div>

                            <div class="detail-label">
                                Full Name
                            </div>

                            <div class="detail-value">
                                @displayName
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Email
                            </div>

                            <div class="detail-value">
                                @(Model.Email ?? "-")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Phone Number
                            </div>

                            <div class="detail-value">
                                @(Model.PhoneNumber ?? "-")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Date of Birth
                            </div>

                            <div class="detail-value">

                                @(Model.DateOfBirth.HasValue
                                                                ? Model.DateOfBirth.Value
                                                                .ToString("yyyy-MM-dd")
                                                                : "-")

                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Age
                            </div>

                            <div class="detail-value">

                                @(age.HasValue
                                                                ? $"{age.Value} years"
                                                                : "-")

                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Gender
                            </div>

                            <div class="detail-value">
                                @(Model.Gender ?? "-")
                            </div>

                        </div>


                    </div>

                </div>



                <!-- =============================================
                     PROFESSIONAL
                     ============================================= -->

                <div id="professional"
                     class="profile-card">


                    <h2>
                        Professional & Eligibility Information
                    </h2>


                    <div class="detail-grid">


                        <div>

                            <div class="detail-label">
                                Department
                            </div>

                            <div class="detail-value">
                                @(Model.Department ?? "-")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Current Position
                            </div>

                            <div class="detail-value">
                                @(Model.JobTitle ?? "-")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Seniority Level
                            </div>

                            <div class="detail-value">
                                @(Model.SeniorityLevel ?? "-")
                            </div>

                        </div>


                        <div>

                            <div class="detail-label">
                                Years of Experience
                            </div>

                            <div class="detail-value">
                                @Model.YearsOfExperience year(s)
                            </div>

                        </div>


                        <div style="grid-column:1 / -1;">

                            <div class="detail-label">
                                Skills
                            </div>


                            <div class="skill-list">

                                @if (!string.IsNullOrWhiteSpace(
                                                                Model.Skills))
                                {
                                    foreach (
                                    var skill in
                                    Model.Skills.Split(
                                    ',',
                                    StringSplitOptions.RemoveEmptyEntries))
                                    {
                                        <span class="skill-chip">
                                            @skill.Trim()
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="detail-value">
                                        No skills added.
                                    </span>
                                }

                            </div>

                        </div>


                    </div>


                    <a asp-controller="InterviewerProfile"
                       asp-action="Edit"
                       class="edit-profile-btn">

                        Edit Profile

                    </a>

                </div>


            </div>

        </div>

    </div>

</div>


<script>

    function showProfileTab(
        tabId,
        button) {

        document
            .querySelectorAll(
                ".profile-card"
            )
            .forEach(card => {

                card.classList.remove(
                    "active"
                );
            });


        document
            .querySelectorAll(
                ".profile-tab"
            )
            .forEach(tab => {

                tab.classList.remove(
                    "active"
                );
            });


        document
            .getElementById(
                tabId
            )
            .classList.add(
                "active"
            );


        button.classList.add(
            "active"
        );
    }

</script>


<style>
