           FINAL INTERVIEWER PROFILE THEME
           Larger readable text + neat sections + soft blue blur
           ========================================================= */

    :root {
        --profile-blue: #3f9bf3;
        --profile-blue-hover: #2f8de8;
        --profile-blue-soft: rgba(237,247,255,.82);
        --profile-bg: #eef5fa;
        --profile-glass: rgba(255,255,255,.68);
        --profile-glass-strong: rgba(255,255,255,.82);
        --profile-line: rgba(211,225,236,.90);
        --profile-line-soft: rgba(229,238,245,.90);
        --profile-text: #263f58;
        --profile-text-2: #536e86;
        --profile-muted: #8499ac;
        --profile-green: #3fa477;
        --profile-green-soft: rgba(234,248,241,.86);
