            .schedule-field select:focus,
            .schedule-field textarea:focus {
                border-color: #84c1f1 !important;
                box-shadow: 0 0 0 4px rgba(84, 167, 231, .10) !important;
                background: #ffffff !important;
            }

    .schedule-row {
        gap: 14px !important;
    }

    .candidate-heading,
    .interviewer-picker-header {
        margin-bottom: 9px !important;
    }

    .select-all-button {
        min-height: 34px !important;
        padding: 0 12px !important;
        border: 1px solid #cfe3f4 !important;
        border-radius: 10px !important;
        background: #edf7ff !important;
        color: #4e8fbe !important;
        font-size: 10px !important;
        font-weight: 800 !important;
        transition: .18s ease !important;
    }

        .select-all-button:hover:not(:disabled) {
            background: #e2f2ff !important;
            border-color: #b7d9f1 !important;
            color: #377eaf !important;
            transform: translateY(-1px);
        }

        .select-all-button:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .candidate-selection,
    .available-interviewers {
        border: 1px solid #dceaf6 !important;
        border-radius: 14px !important;
        background: rgba(247,251,255,.86) !important;
