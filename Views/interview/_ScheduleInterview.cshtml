    }

        .schedule-save:hover {
            background: linear-gradient(180deg, #86c5f2 0%, #6cb2e8 100%) !important;
            transform: translateY(-1px);
            box-shadow: 0 12px 24px rgba(108,178,232,.26) !important;
        }

    .text-danger {
        color: #c96975 !important;
        font-size: 10px !important;
    }

    @@media (prefers-reduced-motion: reduce) {
        .schedule-close, .select-all-button, .schedule-cancel, .schedule-save, .schedule-field input, .schedule-field select, .schedule-field textarea

    {
        transition: none !important;
    }

    }
</style>
