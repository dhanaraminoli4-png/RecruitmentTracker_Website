        padding: 24px 26px !important;
        border-bottom: 1px solid #e4eef7 !important;
        background: linear-gradient(180deg, rgba(245,250,255,.96), rgba(255,255,255,.94)) !important;
    }

        .schedule-modal-header h2 {
            color: #1f3d5b !important;
            font-size: 24px !important;
            font-weight: 850 !important;
