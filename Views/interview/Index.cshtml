</style>



<!-- =============================================================
     SCHEDULE INTERVIEW MODAL
     ============================================================= -->

<div id="scheduleModalOverlay"
     class="schedule-modal-overlay">


    <div id="scheduleModalContainer"
         class="schedule-modal-container">

        <!-- Schedule partial loads here -->

    </div>


</div>



@section Scripts {

    <script>

            /* =========================================================
               GLOBAL
               ========================================================= */

            let selectedInterviewStatus =
                @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                                    initialStatus
                    )
                                );


    let selectedInterviewerIds =
        [];


    /* =========================================================
       OPEN SCHEDULE MODAL
       ========================================================= */

    async function openScheduleModal() {

        try {

            const response =
                await fetch(
                    "/Interview/Schedule"
                );


            if (!response.ok) {

                throw new Error(
                    "Could not load scheduling form."
                );
            }


            const html =
                await response.text();


            const container =
                document.getElementById(
                    "scheduleModalContainer"
                );


            if (!container) {

                return;
            }


            container.innerHTML =
                html;


            selectedInterviewerIds =
                [];


            document
                .getElementById(
                    "scheduleModalOverlay"
                )
                ?.classList
                .add(
                    "show"
                );


            document.body
                .classList
                .add(
                    "modal-open"
                );

        }
        catch (error) {

            console.error(
                "Schedule modal error:",
                error
            );


            alert(
                "Could not open the interview scheduling form."
            );
        }
    }



    /* =========================================================
       CLOSE SCHEDULE MODAL
       ========================================================= */

    function closeScheduleModal() {

        document
            .getElementById(
                "scheduleModalOverlay"
            )
            ?.classList
            .remove(
                "show"
            );


        document.body
            .classList
            .remove(
                "modal-open"
            );


        selectedInterviewerIds =
            [];
    }



    /* =========================================================
       LOAD JOB
       ========================================================= */

    async function loadJobInformation() {

        const jobSelect =
            document.getElementById(
                "scheduleJob"
            );


        const candidateList =
            document.getElementById(
                "candidateList"
            );


        const roundSelect =
            document.getElementById(
                "scheduleRound"
            );


        const selectAllButton =
            document.getElementById(
                "selectAllCandidatesButton"
            );


        if (
            !jobSelect ||
            !candidateList ||
            !roundSelect
        ) {

            return;
        }


        const jobId =
            jobSelect.value;


        candidateList.innerHTML = `
            <div class="candidate-empty">
                Loading approved candidates...
            </div>
        `;


        roundSelect.innerHTML = `
            <option value="">
                Loading interview rounds...
            </option>
        `;


        clearSelectedInterviewers();


        clearAssessmentSelection();


        if (selectAllButton) {

            selectAllButton.disabled =
                true;


            selectAllButton.textContent =
                "Select All";
        }


        if (!jobId) {

            candidateList.innerHTML = `
                <div class="candidate-empty">
                    Select a job first to view approved candidates.
                </div>
            `;


            roundSelect.innerHTML = `
                <option value="">
                    Select Interview Round
                </option>
            `;


            return;
        }


        await loadApprovedCandidates(
            jobId,
            candidateList,
            selectAllButton
        );


        await loadInterviewRounds(
            jobId,
            roundSelect
        );
    }



    /* =========================================================
       APPROVED CANDIDATES
       ========================================================= */

    async function loadApprovedCandidates(
        jobId,
        candidateList,
        selectAllButton) {

        try {

            const response =
                await fetch(
                    `/Interview/GetCandidates?jobId=${encodeURIComponent(jobId)}`
                );


            if (!response.ok) {

                throw new Error(
                    "Could not load candidates."
                );
            }


            const candidates =
                await response.json();


            candidateList.innerHTML =
                "";


            if (
                !candidates ||
                candidates.length === 0
            ) {

                candidateList.innerHTML = `
                    <div class="candidate-empty">
                        No candidates have been approved
                        for interview for this job.
                    </div>
                `;


                if (selectAllButton) {

                    selectAllButton.disabled =
                        true;
                }


                return;
            }


            candidates.forEach(
                candidate => {

                    const card =
                        document.createElement(
                            "label"
                        );


                    card.className =
                        "candidate-select-card";


                    const candidateName =
                        candidate.name ||
                        "Unknown Candidate";


                    const score =
                        candidate.aiScore !== null &&
                        candidate.aiScore !== undefined

                            ? Number(
                                candidate.aiScore
                            ).toFixed(1)

                            : "0.0";


                    card.innerHTML = `

                        <input type="checkbox"
                               name="SelectedApplicationIds"
                               value="${candidate.applicationId}"
                               class="candidate-checkbox schedule-candidate-checkbox" />


                        <div class="candidate-select-avatar">

                            ${getInitials(candidateName)}

                        </div>


                        <div class="candidate-select-info">

                            <strong>
                                ${escapeHtml(candidateName)}
                            </strong>

                            <span>
                                ${escapeHtml(candidate.email || "")}
                            </span>

                        </div>


                        <div class="candidate-ai-score">

                            ${score}%

                        </div>

                    `;


                    candidateList.appendChild(
                        card
                    );
                }
            );


            if (selectAllButton) {

                selectAllButton.disabled =
                    false;
            }

        }
        catch (error) {

            console.error(
                error
            );


            candidateList.innerHTML = `
                <div class="candidate-empty">
                    Unable to load approved candidates.
                </div>
            `;


            if (selectAllButton) {

                selectAllButton.disabled =
                    true;
            }
        }
    }



    /* =========================================================
       INTERVIEW ROUNDS
       ========================================================= */

    async function loadInterviewRounds(
        jobId,
        roundSelect) {

        try {

            const response =
                await fetch(
                    `/Interview/GetRounds?jobId=${encodeURIComponent(jobId)}`
                );


            if (!response.ok) {

                throw new Error(
                    "Could not load interview rounds."
                );
            }


            const rounds =
                await response.json();


            roundSelect.innerHTML = `
                <option value="">
                    Select Interview Round
                </option>
            `;


            if (
                !rounds ||
                rounds.length === 0
            ) {

                roundSelect.innerHTML += `
                    <option value="" disabled>
                        No interview rounds available
                    </option>
                `;


                return;
            }


            rounds.forEach(
                round => {

                    const option =
                        document.createElement(
                            "option"
                        );


                    option.value =
                        round.id;


                    option.textContent =
                        round.sequence !== null &&
                        round.sequence !== undefined

                            ? `Round ${round.sequence} — ${round.name}`

                            : round.name;


                    roundSelect.appendChild(
                        option
                    );
                }
            );

        }
        catch (error) {

            console.error(
                error
            );


            roundSelect.innerHTML = `
                <option value="">
                    Unable to load interview rounds
                </option>
            `;
        }
    }



    /* =========================================================
       ASSESSMENTS
       ========================================================= */

    function clearAssessmentSelection() {

        const assessment =
            document.getElementById(
                "scheduleAssessment"
            );


        if (!assessment) {

            return;
        }


        assessment.innerHTML = `
            <option value="">
                Select Assessment
            </option>
        `;
    }


    async function loadAssessmentsForRound() {

        const job =
            document.getElementById(
                "scheduleJob"
            );


        const round =
            document.getElementById(
                "scheduleRound"
            );


        const assessment =
            document.getElementById(
                "scheduleAssessment"
            );


        if (
            !job ||
            !round ||
            !assessment
        ) {

            return;
        }


        const jobId =
            job.value;


        const roundId =
            round.value;


        if (
            !jobId ||
            !roundId
        ) {

            clearAssessmentSelection();

            return;
        }


        try {

            assessment.disabled =
                true;


            assessment.innerHTML = `
                <option value="">
                    Loading assessments...
                </option>
            `;


            const response =
                await fetch(
                    `/Interview/GetAssessments?jobId=${encodeURIComponent(jobId)}&roundId=${encodeURIComponent(roundId)}`
                );


            if (!response.ok) {

                throw new Error(
                    "Unable to load assessments."
                );
            }


            const data =
                await response.json();


            assessment.innerHTML = `
                <option value="">
                    Select Assessment
                </option>
            `;


            if (
                !data ||
                data.length === 0
            ) {

                assessment.innerHTML = `
                    <option value="">
                        No assessment available for this round
                    </option>
                `;


                return;
            }


            data.forEach(
                item => {

                    const option =
                        document.createElement(
                            "option"
                        );


                    option.value =
                        item.id;


                    option.textContent =
                        item.name;


                    assessment.appendChild(
                        option
                    );
                }
            );

        }
        catch (error) {

            console.error(
                error
            );


            assessment.innerHTML = `
                <option value="">
                    Unable to load assessments
                </option>
            `;

        }
        finally {

            assessment.disabled =
                false;
        }
    }



    /* =========================================================
       SELECT ALL CANDIDATES
       ========================================================= */

    function toggleAllCandidates() {

        const checkboxes =
            Array.from(
                document.querySelectorAll(
                    "#candidateList .schedule-candidate-checkbox"
                )
            );


        if (
            checkboxes.length === 0
        ) {

            return;
        }


        const shouldSelect =
            checkboxes.some(
                x =>
                    !x.checked
            );


        checkboxes.forEach(
            checkbox => {

                checkbox.checked =
                    shouldSelect;
            }
        );


        const button =
            document.getElementById(
                "selectAllCandidatesButton"
            );


        if (button) {

            button.textContent =
                shouldSelect
                    ? "Clear All"
                    : "Select All";
        }
    }



    /* =========================================================
       AVAILABLE INTERVIEWERS
       ========================================================= */

    async function loadAvailableInterviewers() {

        const job =
            document.getElementById(
                "scheduleJob"
            )?.value;


        const date =
            document.getElementById(
                "scheduleDate"
            )?.value;


        const time =
            document.getElementById(
                "scheduleTime"
            )?.value;


        const duration =
            document.getElementById(
                "scheduleDuration"
            )?.value;


        const container =
            document.getElementById(
                "availableInterviewers"
            );


        const count =
            document.getElementById(
                "interviewerAvailabilityCount"
            );


        if (!container) {

            return;
        }


        if (
            !job ||
            !date ||
            !time ||
            !duration
        ) {

            container.innerHTML = `

                <div class="interviewer-empty-state">

                    <div class="interviewer-empty-icon">
                        ◷
                    </div>

                    <strong>
                        Select interview details first
                    </strong>

                    <span>
                        Choose job, date, time and duration.
                    </span>

                </div>

            `;


            if (count) {

                count.style.display =
                    "none";
            }


            clearSelectedInterviewers();


            return;
        }


        container.innerHTML = `
            <div class="interviewer-loading">
                Checking interviewer availability...
            </div>
        `;


        try {

            const response =
                await fetch(

                    `/Interview/GetAvailableInterviewers` +

                    `?jobId=${encodeURIComponent(job)}` +

                    `&date=${encodeURIComponent(date)}` +

                    `&time=${encodeURIComponent(time)}` +

                    `&durationMinutes=${encodeURIComponent(duration)}`
                );


            if (!response.ok) {

                throw new Error(
                    "Unable to load interviewers."
                );
            }


            const interviewers =
                await response.json();


            clearSelectedInterviewers();


            if (
                !interviewers ||
                interviewers.length === 0
            ) {

                container.innerHTML = `

                    <div class="interviewer-empty-state">

                        <div class="interviewer-empty-icon">
                            !
                        </div>

                        <strong>
                            No interviewers available
                        </strong>

                        <span>
                            Try another date or time.
                        </span>

                    </div>

                `;


                if (count) {

                    count.textContent =
                        "0 available";


                    count.style.display =
                        "inline-flex";
                }


                return;
            }


            if (count) {

                count.textContent =
                    `${interviewers.length} available`;


                count.style.display =
                    "inline-flex";
            }


            container.innerHTML =
                interviewers

                    .map(
                        interviewer =>
                            createInterviewerCard(
                                interviewer
                            )
                    )

                    .join("");

        }
        catch (error) {

            console.error(
                error
            );


            container.innerHTML = `

                <div class="interviewer-empty-state">

                    <div class="interviewer-empty-icon">
                        !
                    </div>

                    <strong>
                        Could not load interviewers
                    </strong>

                </div>

            `;


            if (count) {

                count.style.display =
                    "none";
            }
        }
    }



    /* =========================================================
       INTERVIEWER CARD
       ========================================================= */

    function createInterviewerCard(
        interviewer) {

        const name =
            interviewer.name ||
            "Interviewer";


        const metadata =
            [];


        if (interviewer.department) {

            metadata.push(`

                <span class="interviewer-meta-chip">

                    ${escapeHtml(
                        interviewer.department
                    )}

                </span>

            `);
        }


        if (interviewer.seniority) {

            metadata.push(`

                <span class="interviewer-meta-chip">

                    ${escapeHtml(
                        interviewer.seniority
                    )}

                </span>

            `);
        }


        if (
            interviewer.yearsOfExperience !== null &&
            interviewer.yearsOfExperience !== undefined
        ) {

            metadata.push(`

                <span class="interviewer-meta-chip">

                    ${interviewer.yearsOfExperience}
                    yrs experience

                </span>

            `);
        }


        return `

            <div class="interviewer-option-card"
                 id="interviewer-card-${interviewer.id}"
                 onclick="toggleInterviewerSelection('${interviewer.id}')">


                <div class="interviewer-avatar">

                    ${getInitials(name)}

                </div>


                <div class="interviewer-card-info">


                    <div class="interviewer-card-top">


                        <div class="interviewer-card-name">

                            ${escapeHtml(name)}

                        </div>


                        <span class="interviewer-available-badge">

                            ✓ Available

                        </span>


                    </div>


                    <div class="interviewer-card-role">

                        ${escapeHtml(
                            interviewer.jobTitle ||
                            "Interviewer"
                        )}

                    </div>


                    <div class="interviewer-card-meta">

                        ${metadata.join("")}

                    </div>


                </div>


                <div class="interviewer-select-indicator">

                    ✓

                </div>


            </div>

        `;
    }



    /* =========================================================
       SELECT INTERVIEWER
       ========================================================= */

    function toggleInterviewerSelection(
        interviewerId) {

        const index =
            selectedInterviewerIds
                .indexOf(
                    interviewerId
                );


        const card =
            document.getElementById(
                `interviewer-card-${interviewerId}`
            );


        if (index === -1) {

            selectedInterviewerIds.push(
                interviewerId
            );


            card?.classList
                .add(
                    "selected"
                );

        }
        else {

            selectedInterviewerIds.splice(
                index,
                1
            );


            card?.classList
                .remove(
                    "selected"
                );
        }


        rebuildInterviewerInputs();
    }



    function rebuildInterviewerInputs() {

        const container =
            document.getElementById(
                "selectedInterviewerInputs"
            );


        if (!container) {

            return;
        }


        container.innerHTML =
            selectedInterviewerIds

                .map(
                    id => `

                        <input type="hidden"
                               name="SelectedInterviewerIds"
                               value="${escapeHtml(id)}" />

                    `
                )

                .join("");
    }



    function clearSelectedInterviewers() {

        selectedInterviewerIds =
            [];


        const inputs =
            document.getElementById(
                "selectedInterviewerInputs"
            );


        if (inputs) {

            inputs.innerHTML =
                "";
        }


        document
            .querySelectorAll(
                ".interviewer-option-card.selected"
            )

            .forEach(
                card => {

                    card.classList.remove(
                        "selected"
                    );
                }
            );
    }



    /* =========================================================
       SCHEDULE FORM VALIDATION
       ========================================================= */

    document.addEventListener(
        "submit",
        function (event) {

            const form =
                event.target;


            if (
                !form ||
                form.id !==
                "scheduleInterviewForm"
            ) {

                return;
            }


            const selectedCandidates =
                form.querySelectorAll(
                    'input[name="SelectedApplicationIds"]:checked'
                );


            if (
                selectedCandidates.length === 0
            ) {

                event.preventDefault();


                alert(
                    "Please select at least one candidate."
                );


                return;
            }


            if (
                selectedInterviewerIds.length === 0
            ) {

                event.preventDefault();


                alert(
                    "Please select at least one interviewer."
                );


                return;
            }
        }
    );



    /* =========================================================
       BOARD STATUS TAB
       ========================================================= */

    function setInterviewStatus(
        button,
        status) {

        selectedInterviewStatus =
            status;


        document
            .querySelectorAll(
                ".interview-tab"
            )
            .forEach(
                tab => {

                    tab.classList.remove(
                        "active"
                    );
                }
            );


        button.classList.add(
            "active"
        );


        filterInterviews();
    }



    /* =========================================================
       BOARD FILTER
       ========================================================= */

    function filterInterviews() {

        const search =
            (
                document
                    .getElementById(
                        "interviewSearch"
                    )
                    ?.value
                || ""
            )
            .trim()
            .toLowerCase();


        const vacancy =
            document
                .getElementById(
                    "vacancyFilter"
                )
                ?.value
            || "";


        let visibleTotal =
            0;


        const visibleByStatus =
            {};


        document
            .querySelectorAll(
                ".interview-board-column"
            )
            .forEach(
                column => {

                    const status =
                        column.dataset.boardStatus
                        || "";


                    const showColumn =
                        !selectedInterviewStatus

                        ||

                        status ===
                            selectedInterviewStatus;


                    column.classList.toggle(
                        "board-hidden",
                        !showColumn
                    );


                    let visibleInColumn =
                        0;


                    column
                        .querySelectorAll(
                            ".interview-board-card"
                        )
                        .forEach(
                            card => {

                                const cardSearch =
                                    (
                                        card.dataset.search
                                        || ""
                                    )
                                    .toLowerCase();


                                const cardVacancy =
                                    card.dataset.job
                                    || "";


                                const matchesSearch =
                                    !search

                                    ||

                                    cardSearch.includes(
                                        search
                                    );


                                const matchesVacancy =
                                    !vacancy

                                    ||

                                    cardVacancy ===
                                        vacancy;


                                const visible =
                                    showColumn &&
                                    matchesSearch &&
                                    matchesVacancy;


                                card.style.display =
                                    visible

                                        ? ""

                                        : "none";


                                if (
                                    visible
                                ) {

                                    visibleInColumn++;

                                    visibleTotal++;
                                }
                            }
                        );


                    visibleByStatus[
                        status
                    ] =
                        visibleInColumn;


                    const columnCount =
                        column.querySelector(
                            ".board-count"
                        );


                    if (
                        columnCount
                    ) {

                        columnCount.textContent =
                            String(
                                visibleInColumn
                            );
                    }


                    const emptyState =
                        column.querySelector(
                            ".board-empty"
                        );


                    if (
                        emptyState
                    ) {

                        emptyState.style.display =
                            visibleInColumn === 0

                                ? ""

                                : "none";
                    }
                }
            );


        // Update tab counts so they match the selected vacancy/search.
        document
            .querySelectorAll(
                ".interview-tab"
            )
            .forEach(
                tab => {

                    const status =
                        tab.dataset.status
                        || "";


                    const countElement =
                        tab.querySelector(
                            "span"
                        );


                    if (
                        !countElement
                    ) {

                        return;
                    }


                    countElement.textContent =
                        status

                            ? String(
                                visibleByStatus[
                                    status
                                ] || 0
                            )

                            : String(
                                visibleTotal
                            );
                }
            );
    }



    /* =========================================================
       HELPERS
       ========================================================= */

    function getInitials(
        name) {

        if (!name) {

            return "IN";
        }


        const parts =
            String(name)
                .trim()
                .split(/\s+/);


        if (
            parts.length >= 2
        ) {

            return (
                parts[0][0] +
                parts[1][0]
            )
            .toUpperCase();
        }


        return String(name)
            .substring(
                0,
                2
            )
            .toUpperCase();
    }



    function escapeHtml(
        value) {

        if (
            value === null ||
            value === undefined
        ) {

            return "";
        }


        const div =
            document.createElement(
                "div"
            );


        div.textContent =
            String(value);


        return div.innerHTML;
    }



    /* =========================================================
       RESTORE TAB AFTER CANCEL
       ========================================================= */

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            if (
                selectedInterviewStatus
            ) {

                const tab =
                    document.querySelector(
                        `.interview-tab[data-status="${selectedInterviewStatus}"]`
                    );


                if (tab) {

                    document
                        .querySelectorAll(
                            ".interview-tab"
                        )
                        .forEach(
                            item => {

                                item.classList.remove(
                                    "active"
                                );
                            }
                        );


                    tab.classList.add(
                        "active"
                    );
                }
            }


            filterInterviews();
        }
    );



    /* =========================================================
       MODAL BACKDROP
       ========================================================= */

    document
        .getElementById(
            "scheduleModalOverlay"
        )
        ?.addEventListener(
            "click",
            function (event) {

                if (
                    event.target === this
                ) {

                    closeScheduleModal();
                }
            }
        );


</script>
}