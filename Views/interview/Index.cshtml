@model IEnumerable<RecruitmentTracker.Models.Interview>

@{
    ViewData["Title"] = "Interviews";


    // =========================================================
    // ALL INTERVIEW RECORDS
    // =========================================================

    var allInterviews =
        Model?.ToList()
        ?? new List<RecruitmentTracker.Models.Interview>();


    var interviewerDirectory =
        ViewBag.InterviewerDirectory
        as Dictionary<string, RecruitmentTracker.Models.ApplicationUser>
        ?? new Dictionary<string, RecruitmentTracker.Models.ApplicationUser>();


    var activeRoundIdsByVacancy =
        ViewBag.ActiveRoundIdsByVacancy
        as Dictionary<int, List<int>>
        ?? new Dictionary<int, List<int>>();


    // =========================================================
    // ONE CARD PER CANDIDATE APPLICATION
    // =========================================================
    //
    // Old passed rounds stay inside the candidate's history.
    // The candidate itself appears only once on the board.
    // =========================================================

    var interviewGroups =
        allInterviews

            .GroupBy(x =>
                x.JobApplicationId)

            .Select(group =>
            {
                var history =
                    group

                        .OrderBy(x =>
                            x.InterviewRound?.SequenceNumber ?? 0)

                        .ThenBy(x =>
                            x.InterviewDate)

                        .ThenBy(x =>
                            x.InterviewTime)

                        .ToList();


                var current =
                    history

                        .OrderByDescending(x =>
                            x.InterviewRound?.SequenceNumber ?? 0)

                        .ThenByDescending(x =>
                            x.InterviewDate)

                        .ThenByDescending(x =>
                            x.InterviewTime)

                        .ThenByDescending(x =>
                            x.Id)

                        .First();


                return new
                {
                    Current = current,
                    History = history
                };
            })

            .ToList();


    // =========================================================
    // BOARD STATUS
    // =========================================================

    string GetCandidateBoardStatus(
        RecruitmentTracker.Models.Interview current,
        List<RecruitmentTracker.Models.Interview> history)
    {
        var application =
            current.JobApplication;


        // =====================================================
        // 1. FAILED PROCESS ALWAYS WINS
        // =====================================================

        if (application?.InterviewStageStatus == "Failed" ||
            history.Any(x =>
                x.RoundResult == "Failed"))
        {
            return "Failed";
        }


        // =====================================================
        // 2. CANCELLED / NO SHOW CURRENT INTERVIEW
        // =====================================================

        if (current.Status == "Cancelled")
        {
            return "Cancelled";
        }


        if (current.Status == "No Show")
        {
            return "No Show";
        }


        // =====================================================
        // 3. HAS THE CANDIDATE PASSED EVERY REQUIRED ROUND?
        // =====================================================
        //
        // This is based on the active round definitions for the
        // vacancy, NOT only on InterviewProcessCompleted.
        //
        // Therefore an existing candidate whose final round was
        // already marked Passed will immediately appear under
        // Completed even if the old database row still has:
        //
        // InterviewProcessCompleted = false
        // InterviewStageStatus = "In Progress"
        // =====================================================

        var vacancyId =
            application?.JobVacancyId;


        if (vacancyId.HasValue &&
            activeRoundIdsByVacancy.TryGetValue(
                vacancyId.Value,
                out var requiredRoundIds) &&
            requiredRoundIds.Any())
        {
            var passedRoundIds =
                history

                    .Where(x =>
                        x.RoundResult == "Passed")

                    .Select(x =>
                        x.InterviewRoundId)

                    .Distinct()

                    .ToHashSet();


            var allRequiredRoundsPassed =
                requiredRoundIds

                    .All(roundId =>
                        passedRoundIds.Contains(
                            roundId));


            if (allRequiredRoundsPassed)
            {
                return "Completed";
            }
        }


        // Keep support for records that were explicitly completed
        // by the Hiring Manager action.
        if (application?.InterviewProcessCompleted == true &&
            application.InterviewStageStatus == "Completed")
        {
            return "Completed";
        }


        // =====================================================
        // 4. INTERVIEWER FINISHED, WAITING FOR HM
        // =====================================================

        if (current.Status == "Completed" &&
            current.RoundResult == "Pending")
        {
            return "Awaiting Decision";
        }


        // =====================================================
        // 5. CURRENT INTERVIEW BEING WORKED ON
        // =====================================================

        if (current.Status == "In Progress")
        {
            return "In Progress";
        }


        // =====================================================
        // 6. CURRENT INTERVIEW STILL SCHEDULED
        // =====================================================

        if (current.Status == "Scheduled")
        {
            return "Scheduled";
        }


        // =====================================================
        // 7. A ROUND PASSED BUT MORE ROUNDS REMAIN
        // =====================================================
        //
        // Keep the ONE candidate card in progression.
        // The passed round is displayed in Interview History.
        // HR can then schedule the next required round.
        // =====================================================

        if (current.RoundResult == "Passed")
        {
            return "In Progress";
        }


        return "Scheduled";
    }


    // =========================================================
    // VACANCY FILTER
    // =========================================================

    var vacancyOptions =
        interviewGroups

            .Select(x =>
                x.Current.JobApplication?.JobVacancy)

            .Where(x =>
                x != null)

            .Select(x =>
                x!)

            .GroupBy(x =>
                x.Id)

            .Select(x =>
                x.First())

            .OrderBy(x =>
                x.JobTitle)

            .ThenBy(x =>
                x.JobCode)

            .ToList();


    var selectedVacancyId =
        Context.Request.Query["jobId"]
            .ToString();


    // =========================================================
    // COUNTS
    // =========================================================

    var total =
        interviewGroups.Count;


    var scheduled =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "Scheduled");


    var inProgress =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "In Progress");


    var awaitingDecision =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "Awaiting Decision");


    var completed =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "Completed");


    var failed =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "Failed");


    var cancelled =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "Cancelled");


    var noShow =
        interviewGroups.Count(x =>
            GetCandidateBoardStatus(
                x.Current,
                x.History) == "No Show");


    var initialStatus =
        Context.Request.Query["status"]
            .ToString();


    // =========================================================
    // BOARD COLUMNS
    // =========================================================

    var boardStatuses =
        new[]
        {
            new
            {
                Name = "Scheduled",
                Css = "scheduled"
            },

            new
            {
                Name = "In Progress",
                Css = "in-progress"
            },

            new
            {
                Name = "Awaiting Decision",
                Css = "awaiting-decision"
            },

            new
            {
                Name = "Completed",
                Css = "completed"
            },

            new
            {
                Name = "Failed",
                Css = "failed"
            },

            new
            {
                Name = "Cancelled",
                Css = "cancelled"
            },

            new
            {
                Name = "No Show",
                Css = "no-show"
            }
        };
}

<div class="interview-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="interview-page-header">

        <div>

            <h1>
                Interviews
            </h1>

            <p>
                Schedule and manage candidate interviews.
            </p>

        </div>


        <button type="button"
                class="interview-primary-btn"
                onclick="openScheduleModal()">

            <span class="plus-icon">
                +
            </span>

            Schedule Interview

        </button>

    </div>



    <!-- =========================================================
         STAT CARDS
         ========================================================= -->
    <!-- =========================================================
         FILTER
         ========================================================= -->

    <div class="interview-filter-card">


        <div class="interview-filter-top">


            <div class="interview-search">

                <span>
                    ⌕
                </span>

                <input type="text"
                       id="interviewSearch"
                       placeholder="Search candidate, job, round..."
                       oninput="filterInterviews()" />

            </div>


            <div class="vacancy-filter-wrap">

                <label for="vacancyFilter">
                    Current Vacancy
                </label>

                <select id="vacancyFilter"
                        onchange="filterInterviews()">

                    <option value="">
                        All Current Vacancies
                    </option>

                    @foreach (var vacancyOption in vacancyOptions)
                    {
                        var vacancyLabel =
                        string.IsNullOrWhiteSpace(
                        vacancyOption.JobCode)

                        ? vacancyOption.JobTitle

                        : $"{vacancyOption.JobTitle} · {vacancyOption.JobCode}";


                        if (selectedVacancyId ==
                        vacancyOption.Id.ToString())
                        {
                            <option value="@vacancyOption.Id"
                                    selected>
                                @vacancyLabel
                            </option>
                        }
                        else
                        {
                            <option value="@vacancyOption.Id">
                                @vacancyLabel
                            </option>
                        }
                    }

                </select>

            </div>


        </div>



        <!-- =====================================================
             TABS
             ===================================================== -->

        <div class="interview-tabs">


            <button type="button"
                    class="interview-tab active"
                    data-status=""
                    onclick="setInterviewStatus(this, '')">

                All

                <span>
                    @total
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="Scheduled"
                    onclick="setInterviewStatus(this, 'Scheduled')">

                Scheduled

                <span>
                    @scheduled
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="In Progress"
                    onclick="setInterviewStatus(this, 'In Progress')">

                In Progress

                <span>
                    @inProgress
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="Awaiting Decision"
                    onclick="setInterviewStatus(this, 'Awaiting Decision')">

                Awaiting Decision

                <span>
                    @awaitingDecision
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="Completed"
                    onclick="setInterviewStatus(this, 'Completed')">

                Completed

                <span>
                    @completed
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="Failed"
                    onclick="setInterviewStatus(this, 'Failed')">

                Failed

                <span>
                    @failed
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="Cancelled"
                    onclick="setInterviewStatus(this, 'Cancelled')">

                Cancelled

                <span>
                    @cancelled
                </span>

            </button>


            <button type="button"
                    class="interview-tab"
                    data-status="No Show"
                    onclick="setInterviewStatus(this, 'No Show')">

                No Show

                <span>
                    @noShow
                </span>

            </button>


        </div>


    </div>



    <!-- =========================================================
         BOARD
         ========================================================= -->

    <div class="interview-board-wrapper"
         id="interviewBoard">


        @foreach (var boardStatus in boardStatuses)
        {
            var statusGroups =
            interviewGroups

            .Where(x =>
            GetCandidateBoardStatus(
            x.Current,
            x.History) == boardStatus.Name)

            .ToList();


            <section class="interview-board-column @boardStatus.Css"
                     data-board-status="@boardStatus.Name">


                <div class="board-column-header">

                    <div class="board-column-heading">

                        <span class="board-status-dot">
                        </span>

                        <h3>
                            @boardStatus.Name
                        </h3>

                        <span class="board-count">
                            @statusGroups.Count
                        </span>

                    </div>

                </div>


                <div class="board-card-scroll">


                    @if (!statusGroups.Any())
                    {
                        <div class="board-empty">

                            <div class="board-empty-icon">
                                ◌
                            </div>

                            <strong>
                                No @boardStatus.Name candidates
                            </strong>

                            <span>
                                Candidate interview progress will appear here.
                            </span>

                        </div>
                    }
                    else
                    {
                        foreach (var candidateGroup in statusGroups)
                        {
                            var interview =
                            candidateGroup.Current;

                            var history =
                            candidateGroup.History;

                            var application =
                            interview.JobApplication;

                            var candidate =
                            application?.Candidate;

                            var vacancy =
                            application?.JobVacancy;


                            var candidateName =
                            candidate?.FullName
                            ?? "Unknown Candidate";


                            var candidateRole =
                            vacancy?.JobTitle
                            ?? "Candidate";


                            var initials =
                            "UC";


                            if (!string.IsNullOrWhiteSpace(candidateName))
                            {
                                var nameParts =
                                candidateName

                                .Split(
                                ' ',
                                StringSplitOptions.RemoveEmptyEntries
                                );

                                initials =
                                string.Concat(
                                nameParts
                                .Take(2)
                                .Select(x =>
                                x.Substring(0, 1)
                                .ToUpper())
                                );

                                if (string.IsNullOrWhiteSpace(initials))
                                {
                                    initials = "UC";
                                }
                            }


                            var assignedIds =
                            (interview.InterviewerIds ?? "")

                            .Split(
                            ',',
                            StringSplitOptions.RemoveEmptyEntries
                            )

                            .Select(x =>
                            x.Trim())

                            .Where(x =>
                            !string.IsNullOrWhiteSpace(x))

                            .Distinct()

                            .ToList();


                            var assignedInterviewers =
                            assignedIds

                            .Where(x =>
                            interviewerDirectory.ContainsKey(x))

                            .Select(x =>
                            interviewerDirectory[x])

                            .ToList();


                            var passedRounds =
                            history

                            .Where(x =>
                            x.RoundResult == "Passed")

                            .OrderBy(x =>
                            x.InterviewRound?.SequenceNumber ?? 0)

                            .ToList();


                            var failedRound =
                            history

                            .Where(x =>
                            x.RoundResult == "Failed")

                            .OrderByDescending(x =>
                            x.InterviewRound?.SequenceNumber ?? 0)

                            .FirstOrDefault();


                            var searchable =
                            (
                            $"{candidateName} " +
                            $"{candidateRole} " +
                            $"{vacancy?.JobCode} " +
                            $"{interview.InterviewRound?.Name} " +
                            $"{interview.InterviewType?.Name} " +
                            $"{string.Join(" ", assignedInterviewers.Select(x => x.FullName))}"
                            )
                            .ToLowerInvariant();


                            <article class="interview-board-card"
                                     data-card-status="@boardStatus.Name"
                                     data-candidate="@candidate?.Id"
                                     data-job="@vacancy?.Id"
                                     data-search="@searchable">


                                <!-- CANDIDATE -->

                                <div class="board-person-row">

                                    <div class="board-avatar">

                                        @if (!string.IsNullOrWhiteSpace(
                                                                    candidate?.ProfileImagePath))
                                        {
                                            <img src="@candidate.ProfileImagePath"
                                                 alt="@candidateName"
                                                 class="candidate-profile-image" />
                                        }
                                        else
                                        {
                                            @initials
                                        }

                                    </div>


                                    <div class="board-person-info">

                                        <strong>
                                            @candidateName
                                        </strong>

                                        <span>
                                            @candidateRole
                                            @if (!string.IsNullOrWhiteSpace(vacancy?.JobCode))
                                            {
                                                <text> · @vacancy.JobCode</text>
                                            }
                                        </span>

                                    </div>


                                    <div class="board-card-actions">

                                        @if (boardStatus.Name == "Scheduled" ||
                                                                    boardStatus.Name == "In Progress")
                                        {
                                            <a asp-controller="Interview"
                                               asp-action="Edit"
                                               asp-route-id="@interview.Id"
                                               class="board-icon-action"
                                               title="Edit current interview">

                                                ✎

                                            </a>
                                        }


                                        @if (boardStatus.Name == "Scheduled")
                                        {
                                            <form asp-controller="Interview"
                                                  asp-action="Cancel"
                                                  asp-route-id="@interview.Id"
                                                  method="post">

                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="board-icon-action danger"
                                                        title="Cancel current interview"
                                                        onclick="return confirm('Cancel this interview?')">

                                                    ×

                                                </button>

                                            </form>
                                        }

                                    </div>

                                </div>


                                <div class="board-divider">
                                </div>


                                <!-- CURRENT INTERVIEW PROGRESS -->
                                @if (boardStatus.Name == "Completed")
                                {
                                    <div class="candidate-process-message success">

                                        <strong>
                                            All required interview rounds passed
                                        </strong>

                                        <span>
                                            The candidate has completed the full interview process.
                                        </span>

                                    </div>
                                }
                                else if (boardStatus.Name == "Failed")
                                {
                                    <div class="candidate-process-message failed">

                                        <strong>
                                            Interview process stopped
                                        </strong>

                                        <span>
                                            Failed at @(failedRound?.InterviewRound?.Name ?? "an interview round").
                                        </span>

                                    </div>
                                }
                                else
                                {
                                    <div class="current-round-label">
                                        CURRENT INTERVIEW
                                    </div>


                                    <div class="current-round-title">

                                        <strong>
                                            @(interview.InterviewRound?.Name
                                                                        ?? "Interview Round")
                                                                                         </strong>

                                        <span>
                                            @(interview.InterviewType?.Name
                                                                        ?? "Interview")
                        </span>

                                    </div>


                                    <div class="board-detail-row">

                                        <span class="board-detail-icon">
                                            ▣
                                        </span>

                                        <span>

                                            @interview.InterviewDate.ToString("dd MMM yyyy")
                                            at
                                            @interview.InterviewTime.ToString(@"hh\:mm")

                                        </span>

                                        <span class="board-duration">
                                            ◷ @interview.DurationMinutes mins
                                        </span>

                                    </div>


                                    <div class="board-detail-row location">

                                        <span class="board-detail-icon">
                                            ⌖
                                        </span>

                                        <span>

                            @if (!string.IsNullOrWhiteSpace(interview.Location))
                                            {
                                                @interview.Location
                                            }
                                            else if (!string.IsNullOrWhiteSpace(interview.MeetingLink))
                                            {
                                                @("Online")
                                            }
                                            else
                                            {
                                                @("Not specified")
                                            }

                                        </span>

                                    </div>


                                    @if (boardStatus.Name == "Awaiting Decision")
                                    {
                                        <div class="candidate-process-message waiting">

                                            <strong>
                                                Awaiting Hiring Manager decision
                                            </strong>

                                            <span>
                                                Assessment and required interviewer feedback are complete.
                                            </span>

                                        </div>
                                    }
                                    else if (interview.RoundResult == "Passed")
                                    {
                                        <div class="candidate-process-message waiting">

                                            <strong>
                                                Current round passed
                                            </strong>

                                            <span>
                                                The next interview round can now be scheduled.
                                            </span>

                                        </div>
                                    }


                                    <div class="board-divider">
                                    </div>


                                    <!-- ASSIGNED INTERVIEWERS -->

                                    <div class="assigned-interviewer-block">

                                        <div class="assigned-interviewer-heading">

                                            <span>
                                                ASSIGNED INTERVIEWER@(assignedInterviewers.Count == 1 ? "" : "S")
                                            </span>

                                            <small>
                                                @interview.FeedbackStatus feedback
                                            </small>

                                        </div>


                                        @if (!assignedInterviewers.Any())
                                        {
                                            <div class="assigned-interviewer-empty">
                                                No interviewer assigned
                                            </div>
                                        }
                                        else
                                        {
                                            foreach (var assigned in assignedInterviewers)
                                            {
                                                <div class="assigned-interviewer-row">

                                                    <div class="assigned-interviewer-avatar">

                                                        @{
                                                            var assignedInitial =
                                                            !string.IsNullOrWhiteSpace(assigned.FullName)
                                                            ? assigned.FullName.Substring(0, 1).ToUpper()
                                                            : "I";
                                                        }

                                @assignedInitial

                            </div>


                            <div class="assigned-interviewer-copy">

                                <strong>
                                    @(assigned.FullName
                                                                        ?? assigned.Email
                                                                        ?? "Interviewer")
                                                                                     </strong>

                                <span>
                                    @(assigned.JobTitle
                                                                        ?? "Interviewer")

                                    @if (!string.IsNullOrWhiteSpace(assigned.SeniorityLevel))
                                                            {
                                                                <text> · @assigned.SeniorityLevel</text>
                                                            }
                                                        </span>

                                                    </div>

                                                </div>
                                            }
                                        }

                                    </div>
                                }


                                <!-- ROUND HISTORY -->

                                <div class="board-divider">
                                </div>


                                <div class="round-history-block">

                                    <div class="round-history-heading">

                                        <span>
                                            INTERVIEW HISTORY
                                        </span>

                                        <small>
                                            @passedRounds.Count passed
                                        </small>

                                    </div>


                                    @if (!passedRounds.Any())
                                    {
                                        <div class="round-history-empty">
                                            No passed rounds yet.
                                        </div>
                                    }
                                    else
                                    {
                                        foreach (var passed in passedRounds)
                                        {
                                            <div class="round-history-item">

                                                <span class="round-history-check">
                                                    ✓
                                                </span>

                                                <div>

                                                    <strong>
                                                        @(passed.InterviewRound?.Name
                                                                                            ?? "Interview Round")
                                                                                                             </strong>

                                                    <span>
                                                        @(passed.InterviewType?.Name
                                                                                            ?? "Interview")
                                    · Passed
                                </span>

                                                </div>

                                            </div>
                                                }
                                    }

                                </div>

                            </article>
                        }
                    }

                </div>

            </section>
        }

    </div>

</div>



<style>

    /* ============================================================
                       CANDIDATE PROGRESSION BOARD ADDITIONS
                       ============================================================ */

    .interview-board-column.awaiting-decision {
        background: #fffaf0;
        border-color: #f1dfb9;
    }

        .interview-board-column.awaiting-decision .board-status-dot {
            background: #dca548;
            box-shadow: 0 0 0 5px rgba(220,165,72,.12);
        }

    .current-round-label {
        margin-bottom: 7px;
        color: #9aabba;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .10em;
    }

    .current-round-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 11px;
    }

        .current-round-title strong {
            color: #35536e;
            font-size: 11px;
            font-weight: 800;
        }

        .current-round-title span {
            padding: 4px 7px;
            border-radius: 999px;
            background: #eef6fd;
            color: #5d83a2;
            font-size: 8px;
            font-weight: 750;
        }

    .candidate-process-message {
        margin: 10px 0;
        padding: 10px 11px;
        border-radius: 11px;
        border: 1px solid #e3edf5;
        background: #f8fbfe;
    }

        .candidate-process-message strong,
        .candidate-process-message span {
            display: block;
        }

        .candidate-process-message strong {
            color: #42617b;
            font-size: 9px;
            font-weight: 800;
        }

        .candidate-process-message span {
            margin-top: 3px;
            color: #92a7b7;
            font-size: 8px;
            line-height: 1.45;
        }

        .candidate-process-message.success {
            border-color: #d7ecdf;
            background: #f3fbf6;
        }

        .candidate-process-message.failed {
            border-color: #f0dada;
            background: #fff7f7;
        }

        .candidate-process-message.waiting {
            border-color: #eedfbf;
            background: #fffaf1;
        }

    .assigned-interviewer-block,
    .round-history-block {
        display: grid;
        gap: 8px;
    }

    .assigned-interviewer-heading,
    .round-history-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
    }

        .assigned-interviewer-heading > span,
        .round-history-heading > span {
            color: #98aaba;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .08em;
        }

        .assigned-interviewer-heading small,
        .round-history-heading small {
            color: #91a5b4;
            font-size: 8px;
        }

    .assigned-interviewer-row {
        display: flex;
        align-items: center;
